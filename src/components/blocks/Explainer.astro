---
/**
 * Explainer w artykule — baner, który przed danymi tłumaczy, o czym mowa: pytanie w tytule,
 * grafika poglądowa, „drabina” pozycji (np. zabiegów) z wyceną i paskiem w jednej skali,
 * a na końcu odpowiedź na pytanie „po co to wiedzieć” (slot — Markdown z MDX).
 * Pasek ma tę samą skalę we wszystkich szczeblach (`max`); wyróżniony szczebel — kobalt.
 * `imageDark` — wersja grafiki na ciemny motyw (podmieniana jak tokeny: system albo przełącznik strony).
 * Bez `image` z `placeholder` — ramka z opisem grafiki do wygenerowania (tylko szkic, nie publikować).
 *
 *   <Explainer eyebrow="Wyjaśniamy" title="…" lead="…" image={img} imageAlt="…" max={14000} unit="pkt"
 *              steps={[{ tag: 'Z13', title: '…', text: '…', value: 1039, display: '1 039 pkt' }]}>
 *     **Po co …?** Odpowiedź.
 *   </Explainer>
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { typo } from '@/lib/format';

interface Step {
  /** krótka etykieta szczebla, np. kod grupy */
  tag: string;
  title: string;
  text: string;
  value: number;
  /** wartość z jednostką, np. „13 837 pkt” */
  display: string;
  /** dopisek pod wartością, np. „pobyt planowy” */
  note?: string;
  highlight?: boolean;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  /** ta sama grafika na ciemne tło */
  imageDark?: ImageMetadata;
  imageAlt?: string;
  /** szkic: opis grafiki w miejscu, gdzie jeszcze jej nie ma */
  placeholder?: string;
  steps: Step[];
  /** wartość pełnego paska */
  max: number;
  /** podpis nad szczeblami, np. „Wycena NFZ w punktach” */
  scaleLabel?: string;
  /** tytuł odpowiedzi pod drabiną */
  takeaway?: string;
}

const { eyebrow = 'Wyjaśniamy', title, lead, image, imageDark, imageAlt = '', placeholder, steps, max, scaleLabel, takeaway } = Astro.props;
const imgProps = { widths: [640, 960, 1280, 1600], sizes: '(min-width: 1025px) 760px, calc(100vw - 32px)' };
---
<section class="ex" aria-label={title}>
  <header class="ex__head">
    <p class="ex__eyebrow">{eyebrow}</p>
    <h3 class="ex__title" data-no-anchor>{typo(title)}</h3>
    {lead && <p class="ex__lead">{typo(lead)}</p>}
  </header>

  {image ? (
    <div class="ex__figure">
      <Image class:list={['ex__img', { 'ex__img--light': imageDark }]} src={image} alt={imageAlt} {...imgProps} />
      {imageDark && <Image class="ex__img ex__img--dark" src={imageDark} alt={imageAlt} {...imgProps} />}
    </div>
  ) : placeholder && (
    <div class="ex__placeholder" role="img" aria-label={imageAlt}>
      <span>Grafika do wygenerowania</span>
      <p>{typo(placeholder)}</p>
    </div>
  )}

  {scaleLabel && <p class="ex__scale">{typo(scaleLabel)}</p>}
  <ol class="ex__steps">
    {steps.map((s, i) => (
      <li class:list={['ex__step', { 'is-hl': s.highlight }]}>
        <div class="ex__step-head">
          <span class="ex__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="ex__tag">{s.tag}</span>
          <h4 class="ex__step-title" data-no-anchor>{typo(s.title)}</h4>
        </div>
        <p class="ex__text">{typo(s.text)}</p>
        <div class="ex__bar" style={`--w: ${((s.value / max) * 100).toFixed(2)}%`} aria-hidden="true"><span /></div>
        <p class="ex__val">{typo(s.display)}{s.note && <span>{typo(s.note)}</span>}</p>
      </li>
    ))}
  </ol>

  {Astro.slots.has('default') && (
    <div class="ex__takeaway">
      {takeaway && <p class="ex__takeaway-title">{typo(takeaway)}</p>}
      <div class="ex__body"><slot /></div>
    </div>
  )}
</section>

<style>
  .ex { margin: 40px 0; padding: 28px; display: grid; gap: 22px; background: var(--blue-50); border-top: 3px solid var(--blue); }
  .ex__eyebrow { margin: 0; font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--blue); }
  .ex__title { margin: 8px 0 0; font: 500 1.5rem/1.25 var(--f-display); letter-spacing: -0.02em; color: var(--ink); }
  .ex__lead { margin: 12px 0 0; font: 400 1.0625rem/1.6 var(--f-body); color: var(--prose, var(--text-strong)); }

  .ex__img { display: block; width: 100%; height: auto; }
  .ex__img--dark { display: none; }
  :global(:root[data-theme="dark"]) .ex__img--light { display: none; }
  :global(:root[data-theme="dark"]) .ex__img--dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ex__img--light { display: none; }
    :global(:root:not([data-theme="light"])) .ex__img--dark { display: block; }
  }
  .ex__placeholder {
    display: grid; gap: 8px; place-content: center; min-height: 220px; padding: 24px; text-align: center;
    border: 1px dashed var(--blue); background: var(--surface);
  }
  .ex__placeholder span { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--blue); }
  .ex__placeholder p { margin: 0; max-width: 52ch; font: 400 0.875rem/1.5 var(--f-body); color: var(--text); }

  .ex__scale { margin: 0 0 -10px; font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .ex__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .ex__step { display: grid; gap: 8px; padding: 16px 18px; background: var(--surface); }
  .ex__step-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ex__num { font: 400 0.75rem/1 var(--f-mono); color: var(--muted); }
  .ex__tag { padding: 2px 6px; font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .04em; color: var(--ink); background: var(--blue-100); }
  .ex__step-title { margin: 0; font: 500 1.0625rem/1.3 var(--f-display); letter-spacing: -0.01em; color: var(--ink); }
  .ex__text { margin: 0; font: 400 0.9375rem/1.55 var(--f-body); color: var(--prose, var(--text-strong)); }
  .ex__bar { height: 10px; background: transparent; }
  .ex__bar span { display: block; width: var(--w); height: 100%; background: var(--chart); }
  .ex__step.is-hl .ex__bar span { background: var(--blue); }
  .ex__val { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font: 400 1.125rem/1.2 var(--f-display); letter-spacing: -0.01em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .ex__val span { font: 400 0.75rem/1.3 var(--f-mono); letter-spacing: .02em; color: var(--muted); }

  .ex__takeaway { padding: 18px 20px; background: var(--surface); border-left: 3px solid var(--blue); }
  .ex__takeaway-title { margin: 0 0 8px; font: 500 1.125rem/1.3 var(--f-display); letter-spacing: -0.01em; color: var(--ink); }
  .ex__body :global(p) { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--prose, var(--text-strong)); }
  .ex__body :global(p + p) { margin-top: 10px; }
  .ex__body :global(a:not([data-footnote-ref])) { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 720px) {
    .ex { padding: 20px 16px; margin-inline: -16px; }
    .ex__title { font-size: 1.3125rem; }
  }
</style>
