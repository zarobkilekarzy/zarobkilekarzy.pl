---
/** /program/ — jak czytać program: jedno żądanie (postulat) i osiem kierunków poza nim, trzy zasady. */
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import NumberedList from '@/components/blocks/NumberedList.astro';
import { howToRead } from '@/data/program';
import { postulatPage } from '@/data/postulat';
import { typo } from '@/lib/format';
---
<Section id="jak-czytac" tone="soft" aria-labelledby="jak-czytac-title">
  <div class="read">
    <div>
      <Eyebrow>Jak czytać program</Eyebrow>
      <Heading id="jak-czytac-title" class="read__title">{typo(howToRead.title)}</Heading>
      <p class="read__text">{typo(howToRead.text)}</p>
      <LinkArrow href="/postulat/">Postulat: {postulatPage.title.toLowerCase()}</LinkArrow>
    </div>
    <NumberedList items={howToRead.principles} />
  </div>
</Section>

<style>
  .read { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 40px clamp(40px, 6vw, 96px); align-items: start; }
  .read__title { max-width: 14ch; }
  .read__text { margin: 24px 0 28px; font-size: 1.0625rem; line-height: 1.7; max-width: 46ch; color: var(--ink-2); }

  @media (max-width: 1024px) {
    .read { grid-template-columns: minmax(0, 1fr); }
  }
</style>
