---
/**
 * Rozrzut na wspólnej skali: każdy wiersz to jedno badanie albo miara, każda kropka to jeden podmiot
 * (np. kraj). Wyróżniony podmiot (`value`) jest w kobalcie z liczbą nad kropką, średnia to włoskowa
 * kreska z podpisem, a skrajne kropki są podpisane pod osią. Wiersz bez `dots` pokazuje sam wynik
 * (badanie bez porównania). Skala wspólna dla wszystkich wierszy, od zera do `max`.
 * Wiersz może mieć własną skalę (`max`, a gdy nie od zera — `min`), jednostkę (`unit`) i liczbę miejsc po przecinku (`decimals`) — gdy miary
 * mają różne jednostki (strona /kraje/); wspólnej osi pod wykresem wtedy nie ma, skalę pokazują podpisy skrajnych kropek.
 * `pick` — lista wyboru nad wykresem: wybrany podmiot dostaje ciemną kropkę i podpis w drugim wierszu pod osią
 * w każdym wierszu, w którym występuje; w pozostałych wierszach stoi dopisek `absent`. Bez JS lista jest ukryta.
 * Każda kropka ma dymek ui/Popover (wariant `cell`) z nazwą podmiotu i wynikiem: po najechaniu, fokusie
 * albo dotknięciu. Rysunek jest dla oka (`aria-hidden`), czytnik dostaje przyciski kropek i `caption`.
 */
import Popover from '@/components/ui/Popover.astro';
import { formatNumber, typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';

interface Row {
  label: string;
  /** dopisek za nazwą, np. co mierzy liczba */
  note?: string;
  /** wynik wyróżnionego podmiotu */
  value: number;
  /** pozostałe podmioty: nazwa i wynik */
  /** `display` — gotowy tekst wartości, gdy różni się od domyślnego formatu (np. „ok. 50,5%*”) */
  dots?: { label: string; value: number; display?: string }[];
  average?: number;
  /** podpis pod osią, gdy wiersz nie ma kropek (np. „badanie tylko w Polsce”) */
  empty?: string;
  /** własna skala, jednostka i liczba miejsc po przecinku tego wiersza (domyślnie wspólne `max` i `unit`, liczba bez formatowania) */
  max?: number;
  /** początek skali wiersza (domyślnie 0) — gdy wartości leżą wąsko daleko od zera, np. długość życia w latach */
  min?: number;
  unit?: string;
  decimals?: number;
}

interface Props {
  rows: Row[];
  max?: number;
  unit?: string;
  /** nazwa wyróżnionego podmiotu, do legendy */
  subject: string;
  /** co oznacza zwykła kropka, do legendy */
  dotLabel: string;
  averageLabel: string;
  ticks?: number[];
  /** lista wyboru podmiotu do porównania: etykieta pola, opcja „brak wyboru” i dopisek w wierszu bez tego podmiotu */
  pick?: { label: string; none: string; absent: string };
  /** pełny opis danych dla czytników ekranu */
  caption: string;
}

const { rows, max = 100, unit = '%', subject, dotLabel, averageLabel, ticks = [0, 25, 50, 75, 100], pick, caption } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const options = [...new Set(rows.flatMap((r) => (r.dots ?? []).map((d) => d.label)))].sort((a, b) => a.localeCompare(b, locale));
const pos = (v: number, r?: Row) => `${(((v - (r?.min ?? 0)) / ((r?.max ?? max) - (r?.min ?? 0))) * 100).toFixed(2)}%`;
const show = (r: Row, v: number) => `${r.decimals === undefined ? v : formatNumber(v, r.decimals, locale)}${r.unit ?? unit}`;
const disp = (r: Row, d: { value: number; display?: string }) => d.display ?? show(r, d.value);
/** wiersze mają własne skale — wspólna oś nic by nie znaczyła */
const ownScales = rows.some((r) => r.max !== undefined);
/** Kropki o tej samej wartości leżą na sobie — jeden dymek wymienia wszystkie podmioty. */
const groups = (r: Row) => {
  const by = new Map<string, { value: number; display: string; labels: string[] }>();
  for (const d of r.dots ?? []) {
    const display = disp(r, d);
    const key = `${d.value}|${display}`;
    by.set(key, { value: d.value, display, labels: [...(by.get(key)?.labels ?? []), d.label] });
  }
  return [...by.values()].map((g) => ({ value: g.value, display: g.display, label: g.labels.join(', ') }));
};
const ends = (r: Row) => {
  const all = [...(r.dots ?? [])].sort((a, b) => a.value - b.value);
  return all.length ? { lo: all[0], hi: all.at(-1)! } : undefined;
};
---
<figure class="spread" data-unit={unit}>
  {pick && (
    <label class="spread__pick" hidden>
      <span>{pick.label}</span>
      <select data-spread-pick>
        <option value="">{pick.none}</option>
        {options.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
  )}
  <p class="spread__legend" aria-hidden="true">
    <span><i class="spread__key spread__key--hi"></i>{subject}</span>
    <span><i class="spread__key"></i>{dotLabel}</span>
    <span><i class="spread__key spread__key--avg"></i>{averageLabel}</span>
  </p>
  <ol class="spread__rows">
    {rows.map((r) => {
      const e = ends(r);
      return (
        <li class="spread__row">
          <span class="spread__label">{typo(r.label)}{r.note && <em> {typo(r.note)}</em>}{pick && <span class="spread__absent" hidden> · {pick.absent}</span>}</span>
          <span class="spread__track">
            {(r.dots ?? []).map((d) => <i class="spread__dot" aria-hidden="true" data-label={d.label} data-value={d.value} data-display={disp(r, d)} style={`left: ${pos(d.value, r)}`}></i>)}
            {r.average !== undefined && <i class:list={['spread__avg', { 'spread__avg--left': r.average < r.value }]} aria-hidden="true" style={`left: ${pos(r.average, r)}`}><b>{show(r, r.average)}</b></i>}
            <i class="spread__dot spread__dot--hi" aria-hidden="true" style={`left: ${pos(r.value, r)}`}><b>{show(r, r.value)}</b></i>
            {e && e.lo.value < r.value && <span class="spread__end spread__end--lo" aria-hidden="true" style={`left: ${pos(e.lo.value, r)}`}>{typo(`${e.lo.label} ${disp(r, e.lo)}`)}</span>}
            {e && <span class="spread__end spread__end--hi" aria-hidden="true" style={`left: ${pos(e.hi.value, r)}`}>{typo(`${e.hi.label} ${disp(r, e.hi)}`)}</span>}
            {!e && r.empty && <span class="spread__end spread__end--lo" aria-hidden="true" style={`left: ${pos(r.value, r)}`}>{typo(r.empty)}</span>}
            {pick && <span class="spread__mark" hidden></span>}
            {groups(r).map((d) => (
              <Popover variant="cell" class="spread__hit" style={`left: ${pos(d.value, r)}`} label={`${r.label}, ${d.label}: ${d.display}`} heading={d.display}>
                {d.label}
              </Popover>
            ))}
            <Popover variant="cell" class="spread__hit spread__hit--hi" style={`left: ${pos(r.value, r)}`} label={`${r.label}, ${subject}: ${show(r, r.value)}`} heading={show(r, r.value)}>
              {subject}
            </Popover>
          </span>
        </li>
      );
    })}
  </ol>
  {!ownScales && <p class="spread__axis" aria-hidden="true">
    {ticks.map((t, i) => <span style={`left: ${pos(t)}`} class:list={{ 'is-first': i === 0, 'is-last': i === ticks.length - 1 }}>{t}{i === ticks.length - 1 ? unit : ''}</span>)}
  </p>}
  <figcaption class="sr-only">{caption}</figcaption>
</figure>

<style>
  .spread { --dot: 9px; --hi: 15px; }
  .spread__legend { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0 0 22px; font: 500 0.6875rem/1.4 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .spread__legend span { display: inline-flex; align-items: center; gap: 8px; }
  .spread__key { flex: none; width: var(--dot); height: var(--dot); border-radius: 50%; background: var(--chart); }
  .spread__key--hi { width: 12px; height: 12px; background: var(--blue); }
  .spread__key--avg { width: 1px; height: 14px; border-radius: 0; background: var(--ink); }

  .spread__rows { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .spread__row { display: grid; gap: 0; margin: 0; padding: 0; }
  .spread__row::before { content: none; }
  .spread__label { font-size: 0.90625rem; line-height: 1.3; color: var(--ink); }
  .spread__label em { font-style: normal; color: var(--muted); }

  /* tor: miejsce na liczbę nad kropką i podpisy skrajnych kropek pod osią */
  .spread__track { position: relative; display: block; height: 78px; margin: 0 8px; }
  .spread__track::before { content: ""; position: absolute; left: -8px; right: -8px; top: 42px; height: 1px; background: var(--line); }
  .spread__dot { position: absolute; top: 42px; width: var(--dot); height: var(--dot); margin: calc(var(--dot) / -2) 0 0 calc(var(--dot) / -2); border-radius: 50%; background: var(--chart); opacity: .8; }
  .spread__dot--hi { z-index: 2; width: var(--hi); height: var(--hi); margin: calc(var(--hi) / -2) 0 0 calc(var(--hi) / -2); background: var(--blue); opacity: 1; box-shadow: 0 0 0 3px var(--under, var(--bg)); }
  .spread__dot--hi b { position: absolute; bottom: calc(100% + 7px); left: 50%; transform: translateX(-50%); font: 400 1.5rem/1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); white-space: nowrap; }
  /* pole dymka nad kropką: większe niż kropka, żeby dało się w nią trafić palcem */
  .spread :global(.spread__hit) { position: absolute; top: 42px; z-index: 3; width: 18px; height: 18px; margin: -9px 0 0 -9px; }
  .spread :global(.spread__hit--hi) { z-index: 4; width: 22px; height: 22px; margin: -11px 0 0 -11px; }
  /* lista wyboru i wybrany podmiot: ciemna kropka, podpis w drugim wierszu pod osią (pod podpisami skrajnych kropek) */
  .spread__pick { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin: 0 0 18px; font-size: 0.875rem; color: var(--text); }
  .spread__pick[hidden] { display: none; }
  .spread__pick select { min-width: 12rem; padding: 7px 10px; border: 1px solid var(--line); border-radius: 0; background: var(--under, var(--bg)); color: var(--ink); font: inherit; }
  .spread__pick select:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .spread__absent { color: var(--muted); }
  .spread__track--marks { height: 98px; }
  .spread__dot.is-picked { z-index: 2; width: 13px; height: 13px; margin: -6.5px 0 0 -6.5px; background: var(--ink); opacity: 1; box-shadow: 0 0 0 3px var(--under, var(--bg)); }
  .spread__mark { position: absolute; top: 74px; transform: translateX(-50%); padding-top: 2px; font: 500 0.75rem/1.3 var(--f-body); color: var(--ink); white-space: nowrap; }
  .spread__mark::before { content: ""; position: absolute; left: 50%; bottom: 100%; width: 1px; height: 22px; background: var(--ink); }
  .spread__avg { position: absolute; top: 20px; height: 34px; width: 1px; background: var(--ink); z-index: 1; }
  .spread__avg b { position: absolute; bottom: 100%; left: 6px; font: 500 0.65625rem/1.6 var(--f-mono); letter-spacing: .06em; color: var(--ink); white-space: nowrap; }
  /* podpis średniej po stronie dalszej od wyniku podmiotu, żeby nie wchodził pod dużą liczbę */
  .spread__avg--left b { left: auto; right: 6px; }
  /* średnia tuż przy wyniku: podpis pod osią (ustawia skrypt, gdy mimo to podpisy się nakładają) */
  .spread__avg.is-below b { bottom: auto; top: 100%; }
  .spread__end { position: absolute; top: 54px; font: 400 0.75rem/1.3 var(--f-body); color: var(--muted); white-space: nowrap; }
  .spread__end--lo { transform: translateX(-4px); }
  .spread__end--hi { transform: translateX(calc(-100% + 4px)); }

  .spread__axis { position: relative; height: 18px; margin: 4px 8px 0; padding-top: 6px; border-top: 1px solid var(--line); font: 400 0.6875rem/1 var(--f-mono); color: var(--muted); }
  .spread__axis span { position: absolute; transform: translateX(-50%); }
  .spread__axis .is-first { transform: none; }
  .spread__axis .is-last { transform: translateX(-100%); }
</style>

<script>
  // Podpis średniej, który mimo przeniesienia na dalszą stronę nachodzi na wynik podmiotu, odsuwa się w bok
  // poza liczbę; dopiero gdy wyszedłby poza wykres, schodzi pod oś.
  const hit = (a: DOMRect, b: DOMRect) => a.left < b.right + 4 && a.right > b.left - 4 && a.top < b.bottom && a.bottom > b.top;
  const avgClear = () => document.querySelectorAll<HTMLElement>('.spread__row').forEach((row) => {
    const avg = row.querySelector<HTMLElement>('.spread__avg');
    const label = avg?.querySelector<HTMLElement>('b');
    const value = row.querySelector<HTMLElement>('.spread__dot--hi b');
    const track = row.querySelector<HTMLElement>('.spread__track');
    if (!avg || !label || !value || !track) return;
    avg.classList.remove('is-below');
    label.style.translate = '';
    const a = label.getBoundingClientRect();
    const v = value.getBoundingClientRect();
    if (!hit(a, v)) return;
    const left = avg.classList.contains('spread__avg--left');
    const dx = left ? v.left - 6 - a.right : v.right + 6 - a.left;
    const t = track.getBoundingClientRect();
    if (a.left + dx >= t.left - 8 && a.right + dx <= t.right + 8) label.style.translate = `${dx}px 0`;
    else avg.classList.add('is-below');
  });
  avgClear();
  addEventListener('resize', avgClear);

  // Wybór podmiotu z listy: ciemna kropka i podpis w każdym wierszu, w którym występuje.
  document.querySelectorAll<HTMLElement>('.spread').forEach((root) => {
    const field = root.querySelector<HTMLElement>('.spread__pick');
    const select = root.querySelector<HTMLSelectElement>('[data-spread-pick]');
    if (!field || !select) return;
    field.hidden = false;
    const unit = root.dataset.unit ?? '';
    const update = () => {
      const picked = select.value;
      root.querySelectorAll<HTMLElement>('.spread__row').forEach((row) => {
        const track = row.querySelector<HTMLElement>('.spread__track')!;
        const mark = row.querySelector<HTMLElement>('.spread__mark');
        const absent = row.querySelector<HTMLElement>('.spread__absent');
        let found: HTMLElement | undefined;
        row.querySelectorAll<HTMLElement>('.spread__dot[data-label]').forEach((dot) => {
          const hit = picked !== '' && dot.dataset.label === picked;
          dot.classList.toggle('is-picked', hit);
          if (hit) found = dot;
        });
        track.classList.toggle('spread__track--marks', !!found);
        if (mark) {
          mark.hidden = !found;
          if (found) {
            mark.textContent = `${picked} ${found.dataset.display ?? `${found.dataset.value}${unit}`}`;
            mark.style.left = found.style.left;
          }
        }
        if (absent) absent.hidden = picked === '' || !!found;
      });
    };
    select.addEventListener('change', update);
    update();
  });
</script>
