---
/**
 * Odebrania prawa wykonywania zawodu lekarzom rok po roku: Polska (sądy lekarskie, prawomocne),
 * Norwegia i Szwecja (urzędy państwowe), Wielka Brytania (trybunał MPTS), z sumami i wskaźnikiem na 100 tys. lekarzy dla okna porównania.
 * Pięć wąskich kolumn liczb mieści się także na telefonie, więc tabela zostaje tabelą (bez kart).
 * Kolumna Polski to temat tekstu — jedyny akcent (--blue); zera są wyciszone, żeby było widać lata z decyzjami.
 * Liczby pochodzą z czterech wydawców, więc źródła są tu, w podpisie, a nie w jednym linku Figure.
 * Dwujęzyczny: na stronie /en/ napisy z obiektu TEXT.en i nazwy krajów z src/data/en/odpowiedzialnosc-zawodowa-lekarzy.ts;
 * wyjście polskie bez zmian.
 */
import Figure from '@/components/blocks/Figure.astro';
import Icon from '@/components/ui/Icon.astro';
import {
  COUNTRIES as COUNTRIES_PL,
  FIRST_YEAR,
  LAST_YEAR,
  LINKS,
  REVOCATIONS,
  WINDOW,
  ratePer100k,
  total,
  type Country,
  type CountryKey,
} from '@/data/odpowiedzialnosc-zawodowa-lekarzy';
import { localeOf } from '@/i18n/locales';
import { formatNumber, typo } from '@/lib/format';
import { linkAttrs } from '@/lib/links';

const locale = localeOf(Astro.url.pathname);
// moduł EN tylko na stronach /en/ — jego strażniki (brak tłumaczenia = błąd) nie mogą zatrzymać polskiego buildu
const { COUNTRY_EN } = (localeOf(Astro.url.pathname) === 'en' ? await import('@/data/en/odpowiedzialnosc-zawodowa-lekarzy') : {}) as typeof import('@/data/en/odpowiedzialnosc-zawodowa-lekarzy');
const en = locale === 'en';
const COUNTRIES: Country[] = en ? COUNTRIES_PL.map((c) => ({ ...c, ...COUNTRY_EN[c.key] })) : COUNTRIES_PL;

const plWindow = total('pl', WINDOW.from, WINDOW.to);
const doctors = (key: CountryKey) => {
  const c = COUNTRIES.find((x) => x.key === key)!;
  return `${c.name} ${c.doctorsLabel} ${c.doctorsNote}`;
};
const span = `${WINDOW.from}–${WINDOW.to}`;

const TEXT = {
  pl: {
    title: `W latach ${span} polskie sądy lekarskie prawomocnie odebrały prawo do zawodu ${plWindow} lekarzom. Urzędy w Norwegii i Szwecji oraz trybunał w Wielkiej Brytanii — po kilkadziesiąt rocznie.`,
    caption: `Odebrania prawa wykonywania zawodu lekarzom w latach ${FIRST_YEAR}–${LAST_YEAR}: Polska (prawomocne), Norwegia, Szwecja, Wielka Brytania; sumy i średnia roczna na 100 tys. lekarzy w latach ${span}.`,
    year: 'Rok',
    total: 'Razem',
    rate: 'Rocznie na 100 tys. lekarzy',
    note: `Polska: pozbawienia prawa wykonywania zawodu, które się uprawomocniły — orzeczenia okręgowych sądów lekarskich bez odwołania oraz utrzymane albo wydane przez Naczelny Sąd Lekarski, suma 24 izb, w roku uprawomocnienia. Za lata 2021 i 2022 sumujemy kolumny izb, bo komórka sumy w plikach NIL podaje 0. Rok ${LAST_YEAR} bez izby w Koszalinie, a orzeczenia z tego roku mogą się jeszcze uprawomocnić. Norwegia i Szwecja: odebrania autoryzacji (legitymacji) lekarzom w roku decyzji urzędu. Wielka Brytania: skreślenia z rejestru orzeczone przez trybunał w roku decyzji, z prawem odwołania do sądu. Wskaźnik: średnia roczna z lat ${span} podzielona przez liczbę lekarzy (${doctors('pl')}; ${doctors('no')}; ${doctors('se')}; ${doctors('uk')}) — mianowniki pochodzą z różnych rejestrów, więc wynik jest przybliżony.`,
    source: 'Źródło',
    doctors: 'liczba lekarzy',
    nil: 'NIL (zestawienie własne)',
  },
  en: {
    title: `In ${span} Polish medical courts revoked the licence to practise of ${plWindow} doctors with final effect. The authorities in Norway and Sweden and the tribunal in the United Kingdom — dozens a year each.`,
    caption: `Revocations of doctors’ licences to practise in ${FIRST_YEAR}–${LAST_YEAR}: Poland (final), Norway, Sweden, United Kingdom; totals and annual average per 100,000 doctors in ${span}.`,
    year: 'Year',
    total: 'Total',
    rate: 'Per year per 100,000 doctors',
    note: `Poland: revocations of the licence to practise that became final — decisions of regional medical courts that were not appealed and decisions upheld or issued by the Supreme Medical Court, total for the 24 chambers, in the year the decision became final. For 2021 and 2022 we add up the chambers’ columns, because the total cell in the NIL files shows 0. The year ${LAST_YEAR} excludes the Koszalin chamber, and decisions from that year may still become final. Norway and Sweden: withdrawals of doctors’ authorisation (licence) in the year of the authority’s decision. United Kingdom: erasures from the register ordered by the tribunal in the year of the decision, with a right of appeal to a court. Rate: annual average for ${span} divided by the number of doctors (${doctors('pl')}; ${doctors('no')}; ${doctors('se')}; ${doctors('uk')}) — the denominators come from different registers, so the result is approximate.`,
    source: 'Source',
    doctors: 'number of doctors',
    nil: 'NIL (our compilation)',
  },
}[locale];

const sources = [
  { label: TEXT.nil, href: LINKS.nilCourts },
  { label: 'Helsetilsynet', href: LINKS.helsetilsynet },
  { label: 'HSAN', href: LINKS.hsan },
  { label: 'GMC', href: LINKS.gmc2025 },
];
const denominators = [
  { label: 'NIL', href: LINKS.nilRegister },
  { label: 'SSB', href: LINKS.ssb },
  { label: 'Socialstyrelsen', href: LINKS.socialstyrelsen },
  { label: 'GMC', href: LINKS.gmcWorkforce },
];
---
<Figure
  title={TEXT.title}
>
  <table class="revo">
    <caption class="sr-only">
      {TEXT.caption}
    </caption>
    <thead>
      <tr>
        <th scope="col">{TEXT.year}</th>
        {COUNTRIES.map((c) => (
          <th scope="col" class:list={{ 'is-pl': c.key === 'pl' }}>
            {c.name}<span>{c.body}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {REVOCATIONS.map((r) => (
        <tr class:list={{ 'is-before-window': r.year === WINDOW.from - 1 }}>
          <th scope="row">{r.year}</th>
          {COUNTRIES.map((c) => (
            <td class:list={{ 'is-pl': c.key === 'pl', 'is-zero': r[c.key] === 0 }}>{r[c.key]}</td>
          ))}
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <th scope="row">{TEXT.total} {FIRST_YEAR}–{LAST_YEAR}</th>
        {COUNTRIES.map((c) => <td class:list={{ 'is-pl': c.key === 'pl' }}>{total(c.key)}</td>)}
      </tr>
      <tr>
        <th scope="row">{TEXT.total} {span}</th>
        {COUNTRIES.map((c) => <td class:list={{ 'is-pl': c.key === 'pl' }}>{total(c.key, WINDOW.from, WINDOW.to)}</td>)}
      </tr>
      <tr class="is-rate">
        <th scope="row">{TEXT.rate}, {span}</th>
        {COUNTRIES.map((c) => <td class:list={{ 'is-pl': c.key === 'pl' }}>≈{formatNumber(ratePer100k(c.key), 1, locale)}</td>)}
      </tr>
    </tfoot>
  </table>

  <div class="revo__caption">
    <p>
      {typo(TEXT.note)}
    </p>
    <p class="revo__source">
      {TEXT.source}: {sources.map((s, i) => <>{i > 0 && ', '}<a {...linkAttrs(s.href)}>{s.label}<Icon name="arrow-ne" size={10} /></a></>)}; {TEXT.doctors}: {denominators.map((s, i) => <>{i > 0 && ', '}<a {...linkAttrs(s.href)}>{s.label}<Icon name="arrow-ne" size={10} /></a></>)}
    </p>
  </div>
</Figure>

<style>
  .revo { width: 100%; border-collapse: collapse; table-layout: fixed; font-variant-numeric: tabular-nums; }
  /* .revo przed selektorem — tabela stoi w Prose, która stylizuje th/td potomków */
  .revo thead th {
    padding: 0 8px 10px 0; text-align: right; vertical-align: bottom;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .revo thead th:first-child { width: 24%; text-align: left; color: var(--muted); }
  .revo thead th span {
    display: block; margin-top: 3px;
    font: 400 0.6875rem/1.3 var(--f-body); letter-spacing: 0; text-transform: none; color: var(--muted);
  }
  .revo thead th.is-pl, .revo thead th.is-pl span { color: var(--blue); }

  .revo tbody th, .revo tbody td, .revo tfoot th, .revo tfoot td {
    padding: 7px 8px 7px 0; border-bottom: 1px solid var(--line); vertical-align: baseline;
  }
  .revo tbody th { text-align: left; font: 400 0.75rem/1.4 var(--f-mono); color: var(--muted); }
  .revo td { text-align: right; font: 400 0.9375rem/1.4 var(--f-body); color: var(--ink); }
  .revo td.is-zero { color: var(--muted); }
  .revo td.is-pl:not(.is-zero) { color: var(--blue); font-weight: 600; }
  /* Linie atramentowe: nad oknem porównania i nad sumami. W border-collapse przy równej grubości
     wygrywa krawędź komórki wyżej, więc kolor zmienia dolna krawędź wiersza nad linią. */
  .revo tr.is-before-window > *, .revo tbody tr:last-child > * { border-bottom-color: var(--ink); }

  .revo tfoot th { text-align: left; font: 500 0.84375rem/1.35 var(--f-body); color: var(--ink); }
  .revo tfoot td { font: 500 1.0625rem/1.2 var(--f-display); letter-spacing: -0.01em; }
  .revo tfoot td.is-pl { color: var(--blue); }
  .revo tfoot .is-rate > * { border-bottom: 0; }

  /* Podpis jak w Figure: uwaga w Plex Sans, źródła w mono */
  .revo__caption { display: grid; gap: 6px; margin-top: 16px; font: 400 0.84375rem/1.55 var(--f-body); color: var(--text); }
  .revo__source { font: 400 0.75rem/1.55 var(--f-mono); color: var(--muted); }
  .revo__source a {
    display: inline-flex; align-items: center; gap: 4px; color: var(--text);
    text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px;
    transition: color .2s, text-decoration-color .2s;
  }
  .revo__source a:hover { color: var(--blue); text-decoration-color: currentColor; }
</style>
