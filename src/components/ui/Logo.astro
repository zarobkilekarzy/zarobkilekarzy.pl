---
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---
<a class:list={['logo', `logo--${tone}`]} href="/" aria-label="zarobkilekarzy.pl — strona główna">
  <svg class="logo__mark" aria-hidden="true"><use href="#i-logo" /></svg>
  <span class="logo__word">zarobkilekarzy<span>.pl</span></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo__mark { width: 22px; height: 22px; }
  .logo__word { font: 500 1.125rem/1 var(--f-display); letter-spacing: -0.03em; }
  .logo__word span { color: var(--muted); }
  .logo--light { color: #fff; } /* kolor-stały: wariant tylko na tło zawsze ciemne lub kobaltowe */
  .logo--light .logo__word span { color: rgba(255, 255, 255, .5); }
</style>
