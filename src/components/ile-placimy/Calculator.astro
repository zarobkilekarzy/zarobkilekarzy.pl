---
/**
 * „Twoja płaca brutto”: suwak, własna kwota i dwa gotowe punkty → składka zdrowotna przy umowie o pracę.
 * Wynik wypełnia elementy `data-my` na całej stronie (kroki ścieżki i rachunki), a zdarzenie `zl-wage` uruchamia
 * ruch na linii ścieżki. Liczy przeglądarka, nic nie jest wysyłane ani zapisywane. Bez JS strona zostaje przy medianie.
 */
import Card from '@/components/ui/Card.astro';
import { localeOf } from '@/i18n/locales';
import { formatNumber, typo } from '@/lib/format';

const locale = localeOf(Astro.url.pathname);
const en = locale === 'en';
const { AOS_AVERAGE, PER_PERSON, startFigures, WAGE_RANGE, wagePresets, YEARLY_RATE } = en ? await import('@/data/en/ile-placimy') : await import('@/data/ile-placimy');
const eurPerPln = en ? (await import('@/data/en/ile-placimy')).EUR_PER_PLN : undefined;
const T = en
  ? {
      label: 'Your gross pay', input: 'Your gross pay, PLN per month', presets: 'Preset amounts', range: 'Gross pay, slider', currency: 'PLN',
      move: 'Move it and watch the path below', unit: 'PLN contribution per month',
      note: 'Employment contract: 9% of gross pay after deducting social contributions. Calculated in your browser, nothing is saved.',
      custom: 'at PLN {w} gross', about: 'about {n}',
    }
  : {
      label: 'Twoja płaca brutto', input: 'Twoja płaca brutto, zł miesięcznie', presets: 'Gotowe kwoty', range: 'Płaca brutto, suwak', currency: 'zł',
      move: 'Przesuń i patrz na ścieżkę poniżej', unit: 'zł składki miesięcznie',
      note: 'Umowa o pracę: 9% od płacy brutto po odjęciu składek społecznych. Liczy przeglądarka, nic nie zapisujemy.',
      custom: 'przy {w} zł brutto', about: 'ok. {n}',
    };
const scale = (n: number) => `${formatNumber(n, 0, locale)} ${T.currency}`;

const start = wagePresets[0];
const pct = ((start.wage - WAGE_RANGE.min) / (WAGE_RANGE.max - WAGE_RANGE.min)) * 100;
---
<zl-contribution id="placa" data-rate={YEARLY_RATE} data-aos={AOS_AVERAGE} data-person={PER_PERSON} data-locale={locale} data-custom={T.custom} data-about={T.about} data-eur={eurPerPln}>
  <Card label={T.label}>
    <div class="calc__controls">
      <div class="calc__row">
        <label class="calc__input"><span class="sr-only">{T.input}</span><input type="number" inputmode="numeric" min="0" max="1000000" step="100" value={Math.round(start.wage)} data-input /><span aria-hidden="true">{T.currency}</span></label>
        <div class="calc__chips" role="group" aria-label={T.presets}>
          {wagePresets.map((p, i) => (
            <button type="button" class="calc__chip" data-wage={p.wage} data-phrase={p.phrase} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>
          ))}
        </div>
      </div>
      <input class="calc__range" type="range" min={WAGE_RANGE.min} max={WAGE_RANGE.max} step={WAGE_RANGE.step} value={Math.round(start.wage)} style={`--p: ${pct}%`} aria-label={T.range} data-range />
      <p class="calc__scale" aria-hidden="true"><span>{scale(WAGE_RANGE.min)}</span><span>{T.move}</span><span>{scale(WAGE_RANGE.max)}</span></p>
    </div>
    <p class="calc__value"><span data-my="month">{startFigures.month}</span> <span class="calc__unit">{T.unit}</span></p>
    <p class="calc__note"><span data-my="phrase">{startFigures.phrase}</span>. {typo(T.note)}</p>
  </Card>
</zl-contribution>

<script>
  import { formatNumber } from '@/lib/format';
  import type { Locale } from '@/i18n/locales';

  class Contribution extends HTMLElement {
    connectedCallback() {
      const rate = Number(this.dataset.rate), aos = Number(this.dataset.aos), person = Number(this.dataset.person);
      const locale = (this.dataset.locale ?? 'pl') as Locale;
      const eurRate = Number(this.dataset.eur ?? 0);
      const num = (n: number) => formatNumber(Math.round(n), 0, locale);
      // po angielsku składka także w euro, jak inne kwoty: 3 cyfry znaczące (src/i18n/money.ts)
      const eur = (pln: number) => {
        const value = pln * eurRate;
        const factor = 10 ** (Math.floor(Math.log10(Math.max(value, 1))) - 2);
        return `≈ €${formatNumber(Math.round(value / factor) * factor, 0, locale)}`;
      };
      const chips = [...this.querySelectorAll<HTMLButtonElement>('.calc__chip')];
      const input = this.querySelector<HTMLInputElement>('[data-input]')!;
      const range = this.querySelector<HTMLInputElement>('[data-range]')!;
      const min = Number(range.min), max = Number(range.max);

      document.querySelectorAll<HTMLElement>('[data-wage-link]').forEach((link) => { link.hidden = false; });

      const fill = (key: string, text: string) => document.querySelectorAll(`[data-my="${key}"]`).forEach((el) => { el.textContent = text; });

      const apply = (wage: number, phrase: string) => {
        const year = wage * rate;
        fill('month', num(year / 12));
        fill('year', num(year));
        fill('phrase', phrase);
        fill('ratio', num((year / person) * 100));
        fill('visits', (this.dataset.about ?? '').replace('{n}', num(year / aos)));
        if (eurRate) fill('yearEur', eur(year));
        const clamped = Math.min(max, Math.max(min, wage));
        range.value = String(clamped);
        range.style.setProperty('--p', `${((clamped - min) / (max - min)) * 100}%`);
        chips.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.wage) === wage)));
        document.dispatchEvent(new CustomEvent('zl-wage'));
      };

      const custom = (wage: number) => (this.dataset.custom ?? '').replace('{w}', num(wage));

      // stan startowy: po angielsku trzeba wstawić euro, polskie liczby stoją już w HTML-u
      if (eurRate) fill('yearEur', eur(Number(range.value) * rate));

      chips.forEach((chip) => chip.addEventListener('click', () => {
        const wage = Number(chip.dataset.wage);
        input.value = String(Math.round(wage));
        apply(wage, chip.dataset.phrase ?? '');
      }));

      range.addEventListener('input', () => {
        const wage = Number(range.value);
        input.value = String(wage);
        apply(wage, custom(wage));
      });

      input.addEventListener('input', () => {
        const wage = Math.min(Number(input.value), Number(input.max));
        if (wage > 0) apply(wage, custom(wage));
      });
    }
  }

  if (!customElements.get('zl-contribution')) customElements.define('zl-contribution', Contribution);
</script>

<style>
  zl-contribution { display: block; }
  zl-contribution:not(:defined) .calc__controls { display: none; }
  .calc__controls { display: grid; gap: 14px; margin-top: 14px; }
  .calc__row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }

  .calc__input { display: flex; align-items: center; gap: 8px; flex: 1 1 8rem; min-width: 8rem; padding-inline: 12px; border: 1px solid var(--line-2); background: var(--bg); color: var(--muted); transition: border-color .15s; }
  .calc__input:focus-within { border-color: var(--blue); }
  .calc__input input { flex: 1; min-width: 0; min-height: 44px; padding: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: 400 1.125rem/1 var(--f-body); }

  .calc__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .calc__chip {
    min-height: 44px; padding: 8px 10px; background: transparent; border: 1px solid var(--line-2); cursor: pointer;
    color: var(--ink); font: 400 0.875rem/1.2 var(--f-body); transition: background .15s, border-color .15s, color .15s;
  }
  .calc__chip:hover { border-color: var(--ink); }
  .calc__chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }

  /* suwak jak w symulatorze podaży; pan-y, bo pełne przechwycenie dotyku blokuje przewijanie strony na telefonie */
  .calc__range { appearance: none; -webkit-appearance: none; display: block; width: 100%; height: 36px; margin: 0; background: transparent; cursor: pointer; touch-action: pan-y; }
  .calc__range::-webkit-slider-runnable-track { height: 4px; background: linear-gradient(var(--blue), var(--blue)) 0 / var(--p, 50%) 100% no-repeat, var(--line-2); }
  .calc__range::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -10px; background: var(--blue-fill); border: 0; border-radius: 0; }
  .calc__range::-moz-range-track { height: 4px; background: var(--line-2); }
  .calc__range::-moz-range-progress { height: 4px; background: var(--blue); }
  .calc__range::-moz-range-thumb { width: 24px; height: 24px; background: var(--blue-fill); border: 0; border-radius: 0; }
  .calc__range:focus-visible { outline: 0; }
  .calc__range:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--ink); outline-offset: 2px; }
  .calc__range:focus-visible::-moz-range-thumb { outline: 2px solid var(--ink); outline-offset: 2px; }
  .calc__scale { display: flex; justify-content: space-between; gap: 8px; margin-top: -10px; font: 400 0.6875rem/1.3 var(--f-mono); color: var(--muted); }

  .calc__value { margin-top: 18px; font: 300 clamp(2.5rem, 4.5vw, 3.25rem)/1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); }
  .calc__unit { font: 400 1rem/1.2 var(--f-body); letter-spacing: 0; color: var(--text); }
  .calc__note { margin-top: 10px; font-size: 0.875rem; line-height: 1.5; color: var(--text); }
  .calc__note [data-my]::first-letter { text-transform: uppercase; }
  .calc__note [data-my] { display: inline-block; }
</style>
