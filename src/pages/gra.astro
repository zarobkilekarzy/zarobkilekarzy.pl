/* ── karta decyzji ── */
let fonZajety = false;
function decyzja(o) {
  if (fonZajety) return false;
  fonZajety = true;
  $('planszaRamka').classList.add('alarm');
  $('fonTytul').innerHTML = o.tytul;
  $('fonTresc').innerHTML = o.opis;
  const ak = $('fonAkcje'); ak.innerHTML = '';
  const lnk = $('fonLink');
  if (o.link) { lnk.href = LINK(o.link); lnk.classList.remove('hide'); } else lnk.classList.add('hide');
  let zamkniety = false;
  const zamknij = (wybor, cicho) => {
    if (zamkniety) return; zamkniety = true; fonZajety = false;
    $('fon').classList.remove('dzwoni');
    $('planszaRamka').classList.remove('alarm');
    if (wybor && !cicho) {
      const skutek = wybor.fn ? wybor.fn() : null;
      toast({ wynik: true, html: iko('check') + ' <b>' + wybor.label + '</b> → ' + (skutek || wybor.kons), ttl: 6000 });
    } else if (wybor && cicho && wybor.fn) wybor.fn();
  };
  o.opcje.forEach(op => {
    const b = document.createElement('button');
    b.innerHTML = op.label + '<small>' + op.kons + '</small>';
    b.addEventListener('click', () => zamknij(op));
    ak.appendChild(b);
  });
  $('fon').classList.add('dzwoni');
  const ttl = o.ttl || 16000;
  const z = $('fonZegar');
  z.style.transition = 'none'; z.style.width = '100%';
  requestAnimationFrame(() => { z.style.transition = 'width ' + ttl + 'ms linear'; z.style.width = '0%'; });
  setTimeout(() => {
    if (zamkniety) return;
    if (o.naTimeout) { zamknij(null); o.naTimeout(); }
    else zamknij(o.opcje[o.opcje.length - 1]);
  }, ttl);
  czytnik('Zdarzenie: ' + $('fonTytul').textContent);
  return true;
}

/* ── toasty ── */
let toastAktywny = false, toastTimer = 0; const toastKolejka = [];
function toast(o) { toastKolejka.push(o); if (!toastAktywny) nastToast(); }
function zamknijToast() {
  clearTimeout(toastTimer);
  $('toast').classList.remove('on');
  setTimeout(nastToast, 300);
}
function nastToast() {
  const o = toastKolejka.shift();
  if (!o) { toastAktywny = false; return; }
  toastAktywny = true;
  const t = $('toast');
  t.classList.toggle('alertowy', !!o.alert);
  t.classList.toggle('wynikowy', !!o.wynik);
  $('toastTxt').innerHTML = o.html;
  t.classList.add('on');
  const ttl = o.ttl || 9000;
  const z = $('toastZegar');
  z.style.transition = 'none'; z.style.width = '100%';
  requestAnimationFrame(() => { z.style.transition = 'width ' + ttl + 'ms linear'; z.style.width = '0%'; });
  toastTimer = setTimeout(zamknijToast, ttl);
  czytnik(o.sr || $('toastTxt').textContent);
}
$('toastOk').addEventListener('click', zamknijToast);

