---
/**
 * Zdjęcie w kadrze o stałych proporcjach (object-fit: cover).
 * Astro (sharp) w czasie budowania kompresuje je do WebP w kilku szerokościach
 * i generuje srcset — przeglądarka pobiera najmniejszy wystarczający wariant.
 *
 * Dlaczego WebP, a nie AVIF: przy ziarnistych zdjęciach B&W AVIF o tej samej
 * jakości wychodził o 20–50% cięższy, a WebP obsługują wszystkie współczesne
 * przeglądarki — zbędny jest też zapasowy JPG.
 *
 * `sizes` opisuje szerokość, w jakiej obraz jest faktycznie RYSOWANY.
 * Przy `cover` i poziomym zdjęciu w pionowym kadrze to więcej niż szerokość
 * kadru (obraz skaluje się do wysokości), więc podajemy ją jawnie.
 *
 * Wygląd obrazu można zmienić z rodzica: --img-filter, --img-transform.
 * Slot domyślny: nakładki (np. <Badge />).
 */
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { variantWidths } from '@/lib/images';

interface Props extends HTMLAttributes<'div'> {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  /** szerokości wariantów (większe niż oryginał Astro pomija — nie powiększa obrazów) */
  widths?: number[];
  /** CSS aspect-ratio kadru, np. "5/6" */
  ratio?: string;
  /** object-position — punkt kadrowania */
  position?: string;
  /** obraz nad zgięciem: eager + fetchpriority=high */
  priority?: boolean;
  /** narożne „uchwyty” i cień jak w referencji */
  frame?: boolean;
  /** wypełnia wysokość rodzica zamiast trzymać proporcje */
  fill?: boolean;
}

const {
  src,
  alt,
  sizes,
  widths = [480, 720, 960, 1280, 1600],
  ratio,
  position = '50% 50%',
  priority = false,
  frame = false,
  fill = false,
  class: className,
  ...rest
} = Astro.props;
---
<div class:list={['media', { 'media--frame': frame, 'media--fill': fill }, className]} style={ratio ? `--ar: ${ratio}` : undefined} {...rest}>
  <Image
    class="media__img"
    src={src}
    alt={alt}
    widths={variantWidths(src, widths)}
    sizes={sizes}
    format="webp"
    quality={72}
    priority={priority}
    style={`object-position: ${position}`}
  />
  <slot />
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ar, 4/5);
    overflow: hidden;
    background: light-dark(#ECEEF2, #161E31);
    isolation: isolate;
  }
  .media__img {
    position: absolute; inset: 0; z-index: 1;
    width: 100%; height: 100%; object-fit: cover;
    filter: var(--img-filter, grayscale(1) contrast(1.05)) var(--photo-filter);
    transform: var(--img-transform, none);
    transition: transform 1.2s var(--ease), filter .6s;
  }
  .media--fill { aspect-ratio: auto; height: 100%; background: var(--ink-soft); }

  /* Ramka z „uchwytami” w narożnikach — jak w referencji */
  .media--frame { overflow: visible; box-shadow: var(--shadow-photo); }
  .media--frame::before, .media--frame::after {
    content: ""; position: absolute; z-index: 5;
    width: 7px; height: 7px; background: var(--blue);
  }
  .media--frame::before { top: -3px; left: -3px; }
  .media--frame::after { bottom: -3px; right: -3px; }
</style>
