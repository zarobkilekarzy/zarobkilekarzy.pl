---
/** Lista z „ptaszkami” w dwóch kolumnach (np. prawa pacjenta). */
import type { HTMLAttributes } from 'astro/types';
import Icon from '@/components/ui/Icon.astro';
import type { TextItem } from '@/types';
import { typo } from '@/lib/format';

interface Props extends HTMLAttributes<'ul'> {
  items: TextItem[];
}

const { items, class: className, ...rest } = Astro.props;
---
<ul class:list={['checklist', className]} {...rest}>
  {items.map((item) => (
    <li data-reveal>
      <Icon name="check" class="checklist__icon" />
      <div>
        <h3>{typo(item.title)}</h3>
        <p>{typo(item.text)}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .checklist { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  li { display: flex; gap: 14px; padding: 22px 20px 22px 0; border-bottom: 1px solid var(--line); }
  li:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
  .checklist__icon { color: var(--blue); margin-top: 2px; }
  h3 { font: 500 1.0625rem/1.3 var(--f-display); letter-spacing: -0.015em; color: var(--ink); margin-bottom: 6px; }
  p { font-size: 0.90625rem; line-height: 1.55; }

  @media (max-width: 720px) {
    .checklist { grid-template-columns: 1fr; }
    li:nth-child(even) { padding-left: 0; border-left: 0; }
  }
</style>
