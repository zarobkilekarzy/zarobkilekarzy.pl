---
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import NumberedCards from '@/components/blocks/NumberedCards.astro';
import { paths } from '@/data/home';
---
<Section id="start" aria-labelledby="start-title">
  <SectionHead
    eyebrow="Od czego zacząć"
    title="Trzy ścieżki przez temat"
    id="start-title"
    aside="Nie musisz czytać wszystkiego. Wybierz punkt wyjścia, który pasuje do Ciebie — każda ścieżka prowadzi od podstaw do szczegółowych danych."
  />
  <NumberedCards items={paths} />
</Section>
