---
/** Graf danych strukturalnych (schema.org) jako jeden bezpiecznie zserializowany <script>. */
import { serializeJsonLd } from '@/lib/seo';

interface Props {
  /** wynik lib/seo/schema/graph.ts → buildGraph; brak = strona bez danych strukturalnych */
  graph?: object;
}

const { graph } = Astro.props;
---
{graph && <script is:inline type="application/ld+json" set:html={serializeJsonLd(graph)} />}
