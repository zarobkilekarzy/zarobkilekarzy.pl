---
/**
 * „Weź to ze sobą” — zapowiedź karty kieszonkowej z miniaturą i akcjami (wersja do druku, PDF).
 * Miniatura jest dekoracyjna (aria-hidden): treść karty jest i tak na tej stronie.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/icons';
import { typo } from '@/lib/format';

interface Action {
  label: string;
  href: string;
  icon: IconName;
  /** podpis pod etykietą, np. „PDF · 120 kB” */
  meta?: string;
  download?: string;
}

interface Props extends Omit<HTMLAttributes<'div'>, 'title'> {
  title: string;
  text: string;
  phone: string;
  actions: Action[];
}

const { title, text, phone, actions, class: className, ...rest } = Astro.props;
---
<div class:list={['promo', className]} {...rest}>
  <div class="promo__art" aria-hidden="true">
    <div class="mini mini--back">
      <span class="mini__h"></span>
      <span class="mini__l"></span><span class="mini__l"></span><span class="mini__l mini__l--s"></span>
      <span class="mini__h"></span>
      <span class="mini__l"></span><span class="mini__l mini__l--s"></span>
    </div>
    <div class="mini mini--front">
      <span class="mini__title">Prawa pacjenta</span>
      <span class="mini__phone">{phone}</span>
      <span class="mini__l"></span><span class="mini__l"></span><span class="mini__l"></span><span class="mini__l mini__l--s"></span><span class="mini__l"></span><span class="mini__l mini__l--s"></span>
    </div>
  </div>

  <div class="promo__copy">
    <p class="promo__label">Weź to ze sobą</p>
    <h2 class="promo__title" id="druk-title">{typo(title)}</h2>
    <p class="promo__text">{typo(text)}</p>
    <ul class="promo__actions">
      {actions.map((a, i) => (
        <li>
          <a href={a.href} download={a.download} class:list={{ 'is-primary': i === 0 }}>
            <span class="promo__icon"><Icon name={a.icon} size={20} /></span>
            <span class="promo__a-text">
              <span>{a.label}</span>
              {a.meta && <span class="promo__meta">{a.meta}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .promo { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2.5rem clamp(40px, 6vw, 96px); align-items: center; }

  /* Miniatura karty A6: tył lekko obrócony za przodem */
  .promo__art { position: relative; justify-self: center; width: min(100%, 22rem); aspect-ratio: 1.15; }
  .mini {
    color-scheme: light; /* miniatura wydruku — zawsze papier */
    position: absolute; width: 58%; aspect-ratio: 105 / 148; padding: 7% 6%;
    display: flex; flex-direction: column; gap: 5%;
    background: #fff; border: 1px solid var(--ink); box-shadow: 0 24px 40px -24px rgba(4, 11, 27, .35); /* kolor-stały: papier */
  }
  .mini--back { right: 4%; top: 2%; rotate: 6deg; }
  .mini--front { left: 4%; bottom: 2%; rotate: -4deg; }
  .mini__title { font: 500 1rem/1 var(--f-display); letter-spacing: -0.02em; color: var(--ink); }
  .mini__phone { margin: 4% 0 6%; padding-bottom: 6%; border-bottom: 1px solid var(--ink); font: 400 1.375rem/1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); white-space: nowrap; }
  .mini__h { height: 6px; width: 45%; background: var(--ink); margin-top: 4%; }
  .mini__l { height: 4px; width: 100%; background: var(--line-2); }
  .mini__l--s { width: 62%; }

  .promo__label { font: 500 0.75rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--blue-700); }
  .promo__title { margin: 0.875rem 0 1rem; font: 400 clamp(2rem, 3.4vw, 3rem)/1.05 var(--f-display); letter-spacing: -0.035em; color: var(--ink); text-wrap: balance; }
  .promo__text { max-width: 34em; font-size: 1.0625rem; line-height: 1.65; color: var(--text); }

  .promo__actions { display: grid; gap: 0.625rem; margin-top: 1.75rem; max-width: 26rem; }
  .promo__actions a {
    display: flex; align-items: center; gap: 0.875rem; min-height: 3.5rem; padding: 0.375rem 1rem 0.375rem 0.375rem;
    border: 1px solid var(--line-2); background: var(--surface); color: var(--ink);
    transition: border-color .2s, background .2s;
  }
  .promo__actions a:hover { border-color: var(--ink); }
  .promo__icon { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; background: var(--blue-50); color: var(--blue); }
  .promo__actions a.is-primary { background: var(--blue-fill); border-color: var(--blue-fill); color: #fff; }
  .promo__actions a.is-primary .promo__icon { background: #fff; color: var(--blue-fill); } /* kolor-stały: biały kwadrat na kobalcie */
  .promo__actions a.is-primary:hover { background: var(--blue-600); }
  .promo__a-text { display: grid; gap: 0.25rem; font: 500 1rem/1.2 var(--f-body); }
  .promo__meta { font: 400 0.75rem/1.2 var(--f-mono); opacity: .8; }

  @media (max-width: 1024px) {
    .promo { grid-template-columns: minmax(0, 1fr); }
    .promo__art { order: 2; width: min(100%, 18rem); }
  }
</style>
