// Markdown nie przyjmuje komponentów — dzielimy skompilowany HTML w miejscach znaczników
// <div data-slot="…"></div>. Każdy znacznik musi wystąpić dokładnie raz.
const SLOTY = ['os-historia', 'os-quebec', 'os-ontario', 'os-alberta'] as const;
type Slot = (typeof SLOTY)[number];
const czesci = (await compiledContent()).split(/<div data-slot="([a-z-]+)"><\/div>/);
const znalezione = czesci.filter((_, i) => i % 2 === 1);
for (const slot of SLOTY) {
  const ile = znalezione.filter((z) => z === slot).length;
  if (ile !== 1) throw new Error(`Znacznik „${slot}” w treści: ${ile} (oczekiwano 1)`);
}
if (znalezione.length !== SLOTY.length) throw new Error(`Nieznane znaczniki w treści: ${znalezione.join(', ')}`);
