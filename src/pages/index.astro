---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import StartPaths from '@/components/home/StartPaths.astro';
import Latest from '@/components/home/Latest.astro';
import News from '@/components/home/News.astro';
import Perspectives from '@/components/home/Perspectives.astro';
import DataHighlights from '@/components/home/DataHighlights.astro';
import PayMap from '@/components/home/PayMap.astro';
import Film from '@/components/home/Film.astro';
import Explainer from '@/components/home/Explainer.astro';
import Patient from '@/components/home/Patient.astro';
import Tools from '@/components/home/Tools.astro';
import Principles from '@/components/home/Principles.astro';
import { identity } from '@/data/seo/identity';
---
<BaseLayout
  seo={{
    title: 'Zarobki lekarzy — przewodnik ze źródłami',
    description: identity.description,
    social: { title: 'Zarobki lekarzy. Bez emocji, ze źródłami.' },
    translations: [{ locale: 'en', path: '/en/', indexable: true }],
  }}
>
  <Hero />
  <StartPaths />
  <Latest />
  <News />
  <Perspectives />
  <DataHighlights />
  <PayMap />
  <Film />
  <Explainer />
  <Patient />
  <Tools />
  <Principles />
</BaseLayout>
