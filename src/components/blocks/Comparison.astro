---
/**
 * Tabela porównania (stan obecny / projektowany, tekst ujednolicony). Wiersz `marked` jest wyróżniony.
 * W wąskim kontenerze każdy wiersz staje się kartą: komórki z etykietą kolumny nad treścią.
 * Pierwsza kolumna z pustym nagłówkiem to nazwa wiersza (nagłówek karty).
 */
import type { HTMLAttributes } from 'astro/types';
import type { CompareTable } from '@/types';
import { typo } from '@/lib/format';

interface Props extends HTMLAttributes<'div'> {
  table: CompareTable;
  /** tekst wyróżnionych wierszy, np. „nowy przepis” */
  markLabel?: string;
}

const { table, markLabel, class: className, ...rest } = Astro.props;
const rowHeader = table.columns[0] === '' || table.columns.length > 2;
// gdy choć jeden wiersz jest wyróżniony (pasek z lewej + wcięcie), wszystkie dostają to samo wcięcie — tekst w jednej linii
const hasMarks = table.rows.some((row) => row.marked);
---
<div class:list={['cmp-wrap', className]} {...rest}>
  <table class:list={['cmp', { 'cmp--marks': hasMarks }]}>
    {table.caption && <caption>{typo(table.caption)}</caption>}
    <thead>
      <tr>{table.columns.map((c) => <th scope="col">{typo(c)}</th>)}</tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr class:list={{ 'is-marked': row.marked }}>
          {row.cells.map((cell, i) =>
            i === 0 && rowHeader ? (
              <th scope="row" data-label={table.columns[0]}>{typo(cell)}</th>
            ) : (
              <td data-label={table.columns[i]}>
                {row.marked && markLabel && cell !== '—' && <span class="cmp__mark">{markLabel}</span>}
                {typo(cell)}
              </td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .cmp-wrap { container-type: inline-size; }
  .cmp { width: 100%; border-collapse: collapse; font-size: 0.9375rem; line-height: 1.6; }
  caption { caption-side: top; text-align: left; padding-bottom: 14px; font: 400 0.84375rem/1.5 var(--f-body); color: var(--text); }
  /* .cmp przed selektorem — tabela bywa osadzona w Prose, która stylizuje th/td potomków */
  .cmp thead th {
    text-align: left; vertical-align: bottom; padding: 10px 16px 10px 0;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
    border-bottom: 1px solid var(--ink);
  }
  .cmp tbody th, .cmp td { text-align: left; vertical-align: top; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); color: var(--prose, var(--text-strong)); }
  .cmp tbody th { font: 500 0.9375rem/1.45 var(--f-display); letter-spacing: -0.01em; text-transform: none; color: var(--ink); width: 22%; }
  .cmp td { color: var(--ink-2); }

  .cmp .is-marked > * { background: var(--blue-50); }
  .cmp .is-marked > :first-child { box-shadow: inset 3px 0 0 var(--blue); padding-left: 14px; }
  .cmp--marks tr > :first-child { padding-left: 14px; }
  .cmp__mark {
    display: inline-block; margin-right: 8px; padding: 2px 6px; vertical-align: 1px;
    font: 500 0.625rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; background: var(--blue-fill); color: #fff;
  }

  /* Wąsko: wiersz = karta, etykieta kolumny nad komórką */
  @container (max-width: 640px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .cmp, .cmp caption, .cmp tbody, .cmp tr, .cmp tbody th, .cmp td { display: block; width: auto; }
    .cmp tr { padding: 14px 0; border-bottom: 1px solid var(--line-2); }
    .cmp tbody th, .cmp td { padding: 4px 0; border: 0; }
    .cmp tbody th { padding-bottom: 8px; font-size: 1rem; }
    .cmp td[data-label]::before { content: attr(data-label); display: block; margin: 8px 0 2px; font: 500 0.65625rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
    .cmp .is-marked { padding-inline: 14px; background: var(--blue-50); box-shadow: inset 3px 0 0 var(--blue); }
    .cmp .is-marked > *, .cmp .is-marked > :first-child { background: none; box-shadow: none; padding-left: 0; }
    .cmp--marks tr { padding-inline: 14px; }
    .cmp--marks tr > :first-child { padding-left: 0; }
  }
</style>
