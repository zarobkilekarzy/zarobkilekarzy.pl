---
/**
 * Szkielet każdej strony: <head> (SEO, fonty), nagłówek, stopka, wyszukiwarka.
 * To tu konfiguracja serwisu trafia do komponentów — one same nie importują danych.
 */
import { Font, fontData } from 'astro:assets';
import { fontFamilies } from '../lib/fonts';

import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/footnotes.css';

import Sprite from '@/components/ui/Sprite.astro';
import Topbar from '@/components/site/Topbar.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import SearchDialog from '@/components/site/SearchDialog.astro';
import Analytics from '@/components/site/Analytics.astro';
import HeadingAnchors from '@/components/site/HeadingAnchors.astro';
import SelectionShare from '@/components/site/SelectionShare.astro';
import CopySource from '@/components/site/CopySource.astro';

import SeoHead from '@/components/seo/SeoHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';

import { site, mainNav, mobileExtras, topbarLinks, footerNav } from '@/data/navigation';
import { identity } from '@/data/seo/identity';
import { newsletter, newsletterOn } from '@/data/newsletter';
import { getPopularSearches } from '@/lib/search/build';
import { OG_HEIGHT, OG_WIDTH, ogImageFor } from '@/lib/og/registry';
import { buildGraph, resolveSeo, type SeoInput } from '@/lib/seo';

interface Props {
  /** SEO strony: tytuł bez nazwy serwisu, opis, okruszki, rodzaj strony i byty — zob. lib/seo/types.ts */
  seo?: SeoInput;
  /** @deprecated pełny tytuł — użyj `seo` */
  title?: string;
  /** @deprecated użyj `seo` */
  description?: string;
}

const props = Astro.props;
// Stare wywołania (title/description) działają dalej, ale bez okruszków i danych strukturalnych strony
if (!props.seo) console.warn(`[seo] ${Astro.url.pathname}: BaseLayout bez propsa seo — przejdź z title/description na seo`);
const input: SeoInput = props.seo ?? { title: props.title ?? site.name, titleAbsolute: true, description: props.description ?? '' };

// Obrazek OG wynika ze ścieżki strony (lib/og/registry.ts) — strony niczego nie przekazują.
// Strony poza indeksem go nie potrzebują (i nie mają wpisu w rejestrze).
const ogImage = input.index === false ? undefined : await ogImageFor(Astro.url.pathname);
const seo = resolveSeo(input, {
  site: Astro.site!,
  pathname: Astro.url.pathname,
  siteName: identity.name,
  image: ogImage && { ...ogImage, width: OG_WIDTH, height: OG_HEIGHT },
});
const graph = buildGraph(input, seo, identity, Astro.site!);
const popularSearches = await getPopularSearches();
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead seo={seo} siteName={identity.name} locale={identity.locale} twitter={identity.twitter} />
    <meta name="theme-color" content={identity.themeColor} />
    <meta name="color-scheme" content="light dark" />
    {/* Motyw (site/ThemeToggle.astro) i „Większy tekst” (site/TextSizeToggle.astro) z zapisu —
        ustawione przed pierwszym malowaniem, bez mignięcia i przeskoku tekstu */}
    <script is:inline>
      try {
        const t = localStorage.getItem('zl-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        if (localStorage.getItem('zl-text-size') === 'lg') document.documentElement.dataset.textSize = 'lg';
      } catch {}
    </script>
    <meta name="generator" content={Astro.generator} />

    {/* Fonty z naszej domeny (bez Google Fonts). Preload tylko plików z pierwszego ekranu (latin + polskie
        litery) — który to plik, mówi src/lib/fonts.ts; fontData trzyma pliki w kolejności wariantów */}
    {fontFamilies.map(({ cssVariable }) => <Font cssVariable={cssVariable} />)}
    {fontFamilies.flatMap(({ cssVariable, variants }) =>
      fontData[cssVariable]
        .filter((_, i) => variants[i]?.preload)
        .map(({ src }) => <link rel="preload" href={src[0].url} as="font" type="font/woff2" crossorigin />),
    )}

    <Analytics />
    {/* Jeden graf danych strukturalnych strony (lib/seo/schema) */}
    <JsonLd graph={graph} />
    {/* Dodatkowe znaczniki od konkretnej strony (np. preload danych) */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Sprite />
    <Topbar updated={site.updated} announcement={site.announcement} links={topbarLinks} />
    <Header nav={mainNav} mobileExtras={mobileExtras} />

    <main id="tresc">
      <slot />
    </main>

    <Footer groups={footerNav} newsletter={newsletterOn ? newsletter : undefined} />
    <SearchDialog popular={popularSearches} />
    {/* Linki do sekcji (ikona przy nagłówku) i do zaznaczonego fragmentu (pasek przy zaznaczeniu) */}
    <HeadingAnchors />
    <SelectionShare />
    {/* Dopisek „źródło: …” do tekstu kopiowanego ze strony */}
    <CopySource name={site.name} />

    <script>
      import '@/scripts/reveal';
      import '@/scripts/open-target';
    </script>
  </body>
</html>
