---
/** Etykieta nad nagłówkiem: niebieski kwadrat + tekst mono wersalikami. */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'p'>;
const { class: className, ...rest } = Astro.props;
---
<p class:list={['eyebrow', className]} {...rest}><span class="eyebrow__sq" aria-hidden="true"></span><slot /></p>

<style>
  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font: 500 0.75rem/1 var(--f-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 22px;
  }
  .eyebrow__sq { width: 8px; height: 8px; background: var(--blue); }
</style>
