---
/**
 * Ilustracja strony 503: kardiomonitor z płaską linią i alarmem, odpięte elektrody, wtyczka leży obok gniazdka.
 * Kolory z palety ilustracji (light-dark), więc tryb nocny przygasza scenę sam; animacje tylko bez „ogranicz ruch”.
 * Identyfikatory (clipPath, gradient, title) mają losowy przedrostek — komponent może wystąpić na stronie dwa razy.
 */
const uid = `il${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="il" viewBox="0 0 800 480" role="img" aria-labelledby={`${uid}-t`}>
  <title id={`${uid}-t`}>Kardiomonitor na statywie: płaska linia EKG, brak odczytów i alarm; wtyczka leży na podłodze obok gniazdka</title>
  <defs>
    <clipPath id={`${uid}-scr5xx`}><rect x="236" y="96" width="290" height="196" rx="4"/></clipPath>
    <radialGradient id={`${uid}-glow5xx`}><stop offset="0" stop-color="#E5483D" stop-opacity=".55"/><stop offset="1" stop-color="#E5483D" stop-opacity="0"/></radialGradient>
  </defs>
  <g>
    <rect class="c-wall" width="800" height="480"/>
    <rect class="c-floor" y="380" width="800" height="100"/>
    <rect class="c-base" y="372" width="800" height="8"/>

    <!-- gniazdko na ścianie -->
    <rect class="c-shadow" x="685" y="304" width="52" height="52" rx="10"/>
    <rect class="c-white" x="682" y="300" width="52" height="52" rx="10"/>
    <circle class="c-white2" cx="708" cy="326" r="18"/>
    <circle class="c-hole" cx="701" cy="326" r="3.2"/>
    <circle class="c-hole" cx="715" cy="326" r="3.2"/>
    <rect class="c-metal" x="706" y="308" width="4" height="5" rx="1"/>
    <rect class="c-metal" x="706" y="339" width="4" height="5" rx="1"/>

    <!-- cień statywu -->
    <ellipse class="c-shadow" cx="392" cy="446" rx="120" ry="10"/>

    <!-- statyw na kółkach -->
    <rect class="c-metal" x="385" y="318" width="14" height="112" rx="3"/>
    <rect class="c-metal2" x="385" y="318" width="5" height="112"/>
    <path class="c-metal2" d="M392 424 L300 440 L300 448 L392 434 Z"/>
    <path class="c-metal2" d="M392 424 L486 440 L486 448 L392 434 Z"/>
    <path class="c-metal" d="M392 424 L346 454 L354 458 L396 432 Z"/>
    <path class="c-metal" d="M392 424 L444 454 L436 458 L388 432 Z"/>
    <ellipse class="c-metal" cx="392" cy="428" rx="16" ry="7"/>
    <g class="c-navy">
      <circle cx="300" cy="452" r="8"/><circle cx="486" cy="452" r="8"/>
      <circle cx="348" cy="462" r="8"/><circle cx="440" cy="462" r="8"/>
    </g>
    <g class="c-metal"><circle cx="300" cy="452" r="3"/><circle cx="486" cy="452" r="3"/><circle cx="348" cy="462" r="3"/><circle cx="440" cy="462" r="3"/></g>
    <!-- koszyk na kable -->
    <rect class="c-plastic2" x="356" y="350" width="72" height="26" rx="4"/>
    <rect class="c-plastic3" x="356" y="350" width="72" height="5" rx="2"/>

    <!-- kabel do wtyczki -->
    <path class="k-cable" d="M560 300 C610 318 600 372 566 394 C540 412 560 438 600 436 C624 434 640 428 652 424"/>
    <!-- wtyczka na podłodze -->
    <ellipse class="c-shadow" cx="668" cy="434" rx="22" ry="3.5"/>
    <path class="c-white" d="M650 414 H672 C680 414 684 418 684 426 C684 432 680 434 672 434 H650 Z"/>
    <rect class="c-white2" x="648" y="416" width="8" height="16" rx="3"/>
    <rect class="c-metal" x="684" y="419" width="11" height="3.5" rx="1.7"/>
    <rect class="c-metal" x="684" y="427" width="11" height="3.5" rx="1.7"/>

    <!-- odpięte odprowadzenia EKG -->
    <path class="k-lead" d="M250 306 C246 330 236 344 238 366" style="stroke:var(--il-white2)"/>
    <path class="k-lead" d="M262 306 C262 334 270 350 262 380" style="stroke:var(--il-white2)"/>
    <path class="k-lead" d="M274 306 C280 326 292 338 290 356" style="stroke:var(--il-white2)"/>
    <circle cx="238" cy="370" r="6" fill="#E5483D"/><circle cx="262" cy="384" r="6" fill="#F2C94C"/><circle cx="290" cy="360" r="6" fill="#3BB273"/>
    <circle class="c-white" cx="238" cy="370" r="2"/><circle class="c-white" cx="262" cy="384" r="2"/><circle class="c-white" cx="290" cy="360" r="2"/>
    <!-- ramię mocujące -->
    <rect class="c-plastic3" x="372" y="300" width="40" height="22" rx="4"/>

    <!-- korpus monitora -->
    <rect class="c-shadow" x="220" y="84" width="370" height="232" rx="22"/>
    <path class="k-handle" d="M300 82 V64 C300 56 306 52 314 52 H486 C494 52 500 56 500 64 V82"/>
    <rect class="c-plastic" x="212" y="76" width="370" height="232" rx="22"/>
    <rect class="c-plastic2" x="212" y="284" width="370" height="24" rx="12"/>
    <rect class="c-plastic" x="212" y="276" width="370" height="20"/>
    <!-- alarm na górze -->
    <circle class="led" cx="548" cy="68" r="26" fill={`url(#${uid}-glow5xx)`}/>
    <rect class="c-plastic3" x="534" y="68" width="28" height="10" rx="2"/>
    <path class="c-red led" d="M536 70 C536 56 560 56 560 70 Z"/>

    <!-- ekran -->
    <rect class="c-screen" x="230" y="90" width="302" height="208" rx="8"/>
    <g clip-path={`url(#${uid}-scr5xx)`}>
      <!-- pasek alarmu -->
      <rect x="236" y="96" width="290" height="20" fill="#B42318"/>
      <text class="tx-alarm" x="244" y="110">ALARM · BRAK SYGNAŁU</text>
      <text class="tx-dim" x="518" y="110" text-anchor="end">ŁÓŻKO 404</text>
      <!-- siatka -->
      <path d="M236 168 H426 M236 220 H426 M236 270 H526 M430 116 V270" style="stroke:var(--il-grid);stroke-width:1.5"/>
      <!-- EKG: dwa ostatnie skurcze, potem linia płaska -->
      <text class="tx-lbl" x="242" y="130" style="fill:var(--il-ecg)">II</text>
      <path class="k-ecg" style="opacity:.45" d="M240 148 H252 l4 -4 l4 4 h6 l3 6 l5 -34 l6 40 l4 -12 h8 q6 -8 12 0 H318 l4 -4 l4 4 h6 l3 6 l5 -34 l6 40 l4 -12 h8 q6 -8 12 0 H366"/>
      <path class="k-ecg" d="M366 148 H426"/>
      <rect class="sweep" x="366" y="118" width="10" height="48" style="fill:var(--il-screen)"/>
      <!-- pletyzmografia -->
      <text class="tx-lbl" x="242" y="182" style="fill:var(--il-spo2)">Pleth</text>
      <path class="k-spo2" d="M240 200 H426"/>
      <!-- oddech -->
      <text class="tx-lbl" x="242" y="234" style="fill:var(--il-resp)">Resp</text>
      <path class="k-resp" d="M240 252 H426"/>
      <!-- liczby -->
      <text class="tx-lbl" x="438" y="132" style="fill:var(--il-ecg)">HR</text>
      <text class="tx-big" x="518" y="160" text-anchor="end" style="fill:var(--il-ecg)">– –</text>
      <text class="tx-lbl" x="438" y="184" style="fill:var(--il-spo2)">SpO₂</text>
      <text class="tx-big" x="518" y="212" text-anchor="end" style="fill:var(--il-spo2)">– –</text>
      <text class="tx-lbl" x="438" y="236" style="fill:var(--il-resp)">RR</text>
      <text class="tx-big" x="518" y="262" text-anchor="end" style="fill:var(--il-resp)">– –</text>
      <!-- stopka ekranu -->
      <text class="tx-dim" x="242" y="285">NIBP  ---/--- mmHg</text>
      <text class="tx-dim" x="518" y="285" text-anchor="end">03:40</text>
    </g>
    <!-- panel boczny -->
    <circle class="c-plastic2" cx="557" cy="132" r="14"/>
    <circle class="c-plastic3" cx="557" cy="132" r="9"/>
    <rect class="c-plastic2" x="545" y="164" width="24" height="10" rx="3"/>
    <rect class="c-plastic2" x="545" y="182" width="24" height="10" rx="3"/>
    <rect class="c-plastic2" x="545" y="200" width="24" height="10" rx="3"/>
    <rect class="c-red" x="545" y="226" width="24" height="10" rx="3"/>
    <circle class="c-plastic3" cx="557" cy="262" r="5"/>
    <!-- gniazda przewodów na dole -->
  </g>
</svg>

<style>
  .il { display: block; width: 100%; height: auto; }
  .il {
    --il-wall: light-dark(#EEF2FA, #111A30);
    --il-floor: light-dark(#DFE6F2, #18223A);
    --il-base: light-dark(#CCD6E6, #222D47);
    --il-shadow: light-dark(rgba(23, 43, 94, .13), rgba(0, 0, 0, .38));
    --il-white: light-dark(#FFFFFF, #DDE3EE);
    --il-white2: light-dark(#DCE3EE, #AEB9CC);
    --il-navy: light-dark(#1E2740, #3A4766);
    --il-metal: light-dark(#A9B4C6, #7C88A0);
    --il-metal2: light-dark(#8592A8, #59647D);
    --il-red: #E5483D; /* kolor-stały: ekran monitora i drobne akcenty, te same w obu trybach */
    --il-plastic: light-dark(#E8ECF3, #2B3652);
    --il-plastic2: light-dark(#CBD3E0, #1F2840);
    --il-plastic3: light-dark(#B3BDCD, #475373);
    --il-screen: #050B1A; /* kolor-stały: ekran monitora i drobne akcenty, te same w obu trybach */
    --il-grid: #13203B; /* kolor-stały: ekran monitora i drobne akcenty, te same w obu trybach */
    --il-ecg: #3EE08F; /* kolor-stały: ekran monitora i drobne akcenty, te same w obu trybach */
    --il-spo2: #45D2F2; /* kolor-stały: ekran monitora i drobne akcenty, te same w obu trybach */
    --il-resp: #F2C94C; /* kolor-stały: ekran monitora i drobne akcenty, te same w obu trybach */
    --il-hole: light-dark(#5F6B86, #070B16);
  }
  .il text { font-family: "IBM Plex Mono", monospace; }
  .c-wall { fill: var(--il-wall); }
  .c-floor { fill: var(--il-floor); }
  .c-base { fill: var(--il-base); }
  .c-shadow { fill: var(--il-shadow); }
  .c-white { fill: var(--il-white); }
  .c-white2 { fill: var(--il-white2); }
  .c-navy { fill: var(--il-navy); }
  .c-metal { fill: var(--il-metal); }
  .c-metal2 { fill: var(--il-metal2); }
  .c-red { fill: var(--il-red); }
  .c-plastic { fill: var(--il-plastic); }
  .c-plastic2 { fill: var(--il-plastic2); }
  .c-plastic3 { fill: var(--il-plastic3); }
  .c-screen { fill: var(--il-screen); }
  .c-hole { fill: var(--il-hole); }
  .k-cable { fill: none; stroke: var(--il-navy); stroke-width: 5; stroke-linecap: round; }
  .k-handle { fill: none; stroke: var(--il-plastic3); stroke-width: 12; stroke-linecap: round; }
  .k-lead { fill: none; stroke-width: 3; stroke-linecap: round; }
  .k-ecg { fill: none; stroke: var(--il-ecg); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .k-spo2 { fill: none; stroke: var(--il-spo2); stroke-width: 2.5; }
  .k-resp { fill: none; stroke: var(--il-resp); stroke-width: 2.5; }
  .tx-alarm { font: 600 10px "IBM Plex Mono", monospace; letter-spacing: .1em; fill: #FFFFFF; } /* kolor-stały: napis na stałym tle */
  .tx-dim { font: 500 9.5px "IBM Plex Mono", monospace; letter-spacing: .06em; fill: #8A97B3; white-space: pre; } /* kolor-stały: napis na stałym tle */
  .tx-lbl { font: 600 11px "IBM Plex Mono", monospace; }
  .tx-big { font: 600 34px "IBM Plex Mono", monospace; }
  @media (prefers-reduced-motion: no-preference) {
    .sweep { animation: il-sweep 3s linear infinite; }
    .led { animation: il-led 1.2s steps(1) infinite; }
    @keyframes il-sweep { from { transform: translateX(-110px); } to { transform: translateX(60px); } }
    @keyframes il-led { 50% { opacity: .25; } }
  }
</style>
