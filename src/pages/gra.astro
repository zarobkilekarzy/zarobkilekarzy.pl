---
// „Drugi licznik" — satyryczny symulator kariery w ochronie zdrowia.
// CICHY START: bez wpisu w pages.ts (brak linku w nawigacji i hubach), noindex,
// poza mapą strony (filtr w astro.config.mjs) — dostępny tylko z bezpośredniego URL.
// Fonty gry bundlowane przez fontsource (CSP: font-src 'self' — bez hostów Google).
// Koncepcja i decyzje projektowe: research/gra-idle-clicker/00-synteza.md
import '@fontsource/baloo-2/600.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Drugi licznik — symulator kariery"
  description="Idle clicker o polskim systemie ochrony zdrowia: grafik, dyżury, kontrakty i dwa liczniki — jawny i prawdziwy. Mechanizmy z gry istnieją naprawdę."
  noindex={true}
>
<style is:inline>
  #gra-app {
    --noc:#0a1120; --panel:#141f33; --panel-2:#1a2740; --wglad:#0d1526;
    --linia:#26375a; --linia-2:#39508a;
    --tekst:#e8eefb; --tekst-2:#9fb0cc; --tekst-3:#6f809e;
    --zloto:#f5c542; --zloto-2:#ffdf7e; --kasa:#7ee08a;
    --teal:#45c4cf; --czerwien:#ff6b61; --amber:#ffb84d; --fiolet:#c48bff;
    --gra:"Baloo 2","Trebuchet MS",sans-serif;
    --ui:"Nunito","Segoe UI",system-ui,sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  }
  #gra-app *, #gra-app *::before, #gra-app *::after { box-sizing:border-box; }
  #gra-app {
    background:var(--noc);
    border-radius:16px; margin:10px auto 28px; max-width:1240px;
    overflow:clip; border:1px solid #26375a; color:var(--tekst);
    font-family:var(--ui); font-size:15px; line-height:1.45;
    background-image:radial-gradient(ellipse 120% 60% at 50% -10%, #16233d 0%, var(--noc) 60%);
    min-height:100vh;
  }
  #gra-app a { color:var(--teal); }
  #gra-app button { font-family:inherit; }
  .mono { font-family:var(--mono); font-variant-numeric:tabular-nums; }
  .hide { display:none !important; }
  .i { width:1em; height:1em; vertical-align:-0.14em; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .wrap { max-width:700px; margin:0 auto; padding:0 10px 46px; }
  @media (min-width:1000px) {
    .wrap { max-width:1180px; display:grid; grid-template-columns:1.05fr .95fr; gap:0 28px; align-items:start; }
    .hud { grid-column:1 / -1; }
    .kol-l { position:sticky; top:10px; }
  }
  .wrap.trzesie { animation:shake .45s; }
  @keyframes shake {
    0%,100%{transform:translate(0,0)} 20%{transform:translate(-6px,2px)}
    40%{transform:translate(5px,-3px)} 60%{transform:translate(-4px,-2px)} 80%{transform:translate(3px,2px)}
  }

  .hud { display:flex; align-items:center; gap:10px; flex-wrap:wrap; padding:10px 2px 6px; }
  .hud .kasa-box { display:flex; flex-direction:column; }
  .hud .etyk { font-size:.58rem; letter-spacing:.16em; color:var(--tekst-3); text-transform:uppercase; font-weight:700; }
  .hud .portfel {
    font-family:var(--mono); font-weight:600; color:var(--zloto);
    font-size:clamp(1.2rem, 5.2vw, 1.6rem); line-height:1.1; white-space:nowrap;
    text-shadow:0 0 18px rgba(245,197,66,.25);
  }
  .hud .tempo { font-family:var(--mono); font-size:.7rem; color:var(--kasa); }
  .hud .spacer { flex:1; }
  .chips { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .chip { font-family:var(--mono); font-size:.68rem; padding:3px 10px; border-radius:99px; background:var(--panel); border:1px solid var(--linia); color:var(--tekst-2); }
  button.chip { cursor:help; }
  button.chip:hover { border-color:var(--linia-2); color:var(--tekst); }
  button.chip .znak { opacity:.6; font-size:.6rem; margin-left:2px; }
  .chip.rozjazd b { color:var(--amber); }
  .chip.rozjazd.mega b { color:var(--czerwien); }
  #resetBtn { cursor:pointer; }

  /* ── PLANSZA ── */
  .plansza-ramka {
    position:relative; border-radius:14px; border:1px solid var(--linia);
    background:var(--wglad); box-shadow:0 14px 40px rgba(0,0,0,.45);
    padding:10px 10px 8px; transition:border-color .3s, box-shadow .3s;
  }
  .plansza-ramka.alarm { border-color:var(--amber); box-shadow:0 0 26px rgba(255,184,77,.35); }
  .p-naglowek { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:4px; }
  .p-naglowek .marka { font-family:var(--gra); font-weight:600; font-size:.62rem; color:rgba(232,238,251,.45); }
  .p-naglowek .tydzien { font-family:var(--mono); font-size:.62rem; color:var(--teal); }
  .p-oko {
    font-family:var(--mono); font-size:.64rem; cursor:zoom-in; user-select:none; -webkit-user-select:none;
    color:var(--tekst-2); background:var(--panel); border:1px solid var(--linia-2);
    border-radius:99px; padding:3px 11px;
  }
  .p-oko b { color:var(--tekst); font-weight:600; }
  .p-oko.podglad { border-color:var(--kasa); color:var(--kasa); box-shadow:0 0 10px rgba(126,224,138,.35); }
  .p-oko.rejestr { border-color:var(--kasa); color:var(--kasa); cursor:default; }
  .p-oko.rejestr b { color:var(--kasa); }
  .p-taby { display:flex; gap:6px; margin-bottom:6px; }
  .p-taby button {
    font-family:var(--gra); font-weight:600; font-size:.7rem; cursor:pointer;
    background:var(--panel); color:var(--tekst-2); border:1px solid var(--linia);
    border-radius:8px; padding:3px 12px;
  }
  .p-taby button.on { background:var(--panel-2); color:var(--tekst); border-color:var(--linia-2); }
  .p-taby button .i { width:.9em; height:.9em; }
  .p-dni { display:grid; grid-template-columns:26px repeat(7,1fr); font-family:var(--mono); font-size:.58rem; color:var(--tekst-3); text-align:center; margin-bottom:2px; }
  .p-cialo { display:grid; grid-template-columns:26px 1fr; }
  .p-godz { display:grid; grid-template-rows:repeat(6,1fr); font-family:var(--mono); font-size:.5rem; color:var(--tekst-3); text-align:right; padding-right:5px; }
  .p-godz span { align-self:center; }
  #plansza {
    position:relative; height:246px; border-radius:8px; cursor:pointer; touch-action:manipulation;
    background:
      repeating-linear-gradient(90deg, transparent 0, transparent calc(100%/7 - 1px), var(--linia) calc(100%/7 - 1px), var(--linia) calc(100%/7)),
      repeating-linear-gradient(0deg, transparent 0, transparent calc(100%/6 - 1px), var(--linia) calc(100%/6 - 1px), var(--linia) calc(100%/6)),
      var(--panel);
  }
  @media (min-width:1000px) { #plansza { height:308px; } }
  .p-hint { position:absolute; inset:0; display:grid; place-items:center; font-size:.72rem; color:var(--tekst-3); text-align:center; padding:0 20px; pointer-events:none; }
  .blok {
    position:absolute; border-radius:3px; font-family:var(--mono); font-size:.52rem; font-weight:600;
    padding:1px 3px; overflow:hidden; white-space:nowrap; transition:opacity .4s, left .3s, width .3s, top .3s, height .3s;
    animation:spad .45s cubic-bezier(.2,1.6,.4,1); line-height:1.3;
  }
  @keyframes spad { from { transform:translateY(-30px); opacity:0; } to { transform:none; opacity:1; } }
  .blok.t-etat { background:rgba(69,196,207,.3); border:1px solid var(--teal); color:#a9e6ec; }
  .blok.t-dyzur { background:rgba(255,107,97,.24); border:1px solid var(--czerwien); color:#ffb3ad; }
  .blok.t-poradnia { background:rgba(245,197,66,.2); border:1px solid var(--zloto); color:#ffe6a1; }
  .blok.t-kontrakt { background:rgba(196,139,255,.2); border:1px solid var(--fiolet); color:#e3ccff; }
  .blok.t-obok { background:rgba(245,197,66,.26); border:1px solid #d99b28; color:#ffe6a1; }
  .blok.t-cito { background:rgba(245,197,66,.45); border:1px solid var(--zloto); color:#fff3cd; box-shadow:0 0 10px rgba(245,197,66,.55); z-index:3; }
  .blok.kreska { background-image:repeating-linear-gradient(45deg, transparent 0 3px, rgba(255,255,255,.1) 3px 5px); }
  .swiat-widok .blok.kreska { opacity:.07; }
  .playhead { position:absolute; top:-4px; bottom:-4px; width:2px; background:var(--kasa); box-shadow:0 0 10px rgba(126,224,138,.7); z-index:5; transition:left .25s linear; }
  .playhead.przeskok { transition:none; }
  .p-float { position:absolute; z-index:6; font-family:var(--mono); font-size:.62rem; font-weight:600; color:var(--kasa); animation:frunie .8s ease-out forwards; pointer-events:none; white-space:nowrap; }
  .p-float.zly { color:var(--czerwien); }
  .p-float.zloty { color:var(--zloto); }
  @keyframes frunie { to { transform:translateY(-36px); opacity:0; } }
  .p-blip { position:absolute; width:6px; height:6px; border-radius:50%; background:var(--kasa); box-shadow:0 0 8px rgba(126,224,138,.8); z-index:4; animation:blipznik 2.4s forwards; }
  @keyframes blipznik { to { opacity:0; } }

  #przyjmij {
    display:block; width:100%; margin-top:10px; min-height:58px; cursor:pointer;
    font-family:var(--gra); font-weight:800; font-size:1.15rem; letter-spacing:.03em;
    color:#1c2606; border:none; border-radius:14px;
    background:linear-gradient(180deg,#a8e063,#7cb93e);
    box-shadow:0 5px 0 #4e7a22, 0 10px 24px rgba(124,185,62,.28);
    transition:transform .06s, box-shadow .06s;
  }
  #przyjmij.wcisniety { transform:translateY(4px); box-shadow:0 1px 0 #4e7a22; }
  #przyjmij:focus-visible, button:focus-visible, a:focus-visible { outline:3px solid var(--teal); outline-offset:2px; }
  #przyjmij small { display:block; font-family:var(--ui); font-weight:700; font-size:.64rem; color:#2c4010; }
  .akcje-strip { display:flex; gap:8px; margin-top:8px; }
  .akcje-strip button {
    flex:1; font-family:var(--gra); font-weight:600; font-size:.78rem; cursor:pointer;
    background:var(--panel-2); color:var(--tekst); border:1px solid var(--linia-2);
    border-radius:12px; padding:7px 10px;
  }
  .akcje-strip button:disabled { opacity:.5; cursor:default; }
  .akcje-strip button small { display:block; font-family:var(--mono); font-size:.58rem; color:var(--tekst-3); }

  .stany { display:flex; flex-direction:column; gap:7px; margin-top:12px; }
  .stan { display:none; align-items:center; gap:8px; }
  .stan.on { display:flex; }
  .stan .ikona { width:22px; text-align:center; font-size:.95rem; color:var(--tekst-2); }
  .stan .ikona.dobrze { color:var(--kasa); }
  .stan .ikona.srednio { color:var(--amber); }
  .stan .ikona.malo { color:var(--czerwien); animation:puls-czerw 1s infinite; }
  @keyframes puls-czerw { 50% { opacity:.4; } }
  .stan .tor { flex:1; height:12px; background:var(--panel); border-radius:7px; overflow:hidden; border:1px solid var(--linia); cursor:pointer; }
  .stan .tor i { display:block; height:100%; border-radius:7px; transition:width .3s; }
  .stan .op { font-family:var(--mono); font-size:.66rem; color:var(--tekst-2); min-width:92px; text-align:right; }
  #energiaPas i { background:linear-gradient(90deg,#7ee08a,#a8e063); }
  #energiaPas.srednio i { background:linear-gradient(90deg,#ffb84d,#ffd27e); }
  #energiaPas.malo i { background:linear-gradient(90deg,#ff6b61,#ff8f7a); }
  #tydzienPas i { background:linear-gradient(90deg,#45c4cf,#6fdbe4); }
  #tydzienPas.ponad i { background:linear-gradient(90deg,#ff6b61,#ffb84d); }
  #dobaPas i { background:linear-gradient(90deg,#c48bff,#e0b8ff); }
  #dobaPas.absurd i { background:linear-gradient(90deg,#ff6b61,#c48bff); }
  .stan .akcja { font-size:.64rem; font-weight:700; border-radius:8px; padding:3px 9px; cursor:pointer; background:var(--panel-2); color:var(--tekst-2); border:1px solid var(--linia); white-space:nowrap; }
  .stan .akcja:disabled { opacity:.45; cursor:default; }

  .kariera { display:none; margin-top:12px; gap:5px; flex-wrap:wrap; }
  .kariera.on { display:flex; }
  .kariera .k { font-family:var(--gra); font-weight:600; font-size:.64rem; padding:2px 9px; border-radius:99px; background:var(--panel); border:1px solid var(--linia); color:var(--tekst-3); }
  .kariera .k.teraz { background:#243c1e; border-color:#7cb93e; color:#c9f29b; }
  .kariera .k.byl { color:var(--tekst-2); }

  .sklepy { display:none; margin-top:14px; }
  .taby { display:flex; gap:6px; flex-wrap:wrap; }
  .taby [role="tab"] { font-family:var(--gra); font-weight:600; font-size:.8rem; cursor:pointer; background:var(--panel); color:var(--tekst-2); border:1px solid var(--linia); border-radius:10px; padding:6px 12px; }
  .taby [aria-selected="true"] { background:var(--panel-2); color:var(--tekst); border-color:var(--linia-2); }
  .taby [role="tab"]:disabled { color:var(--tekst-3); font-family:var(--mono); cursor:default; }
  .taby .tab-system[aria-selected="true"] { border-color:var(--czerwien); color:#ffb3ad; }
  .lista { list-style:none; margin:0; padding:10px 0 0; display:flex; flex-direction:column; gap:8px; }
  .karta { position:relative; background:var(--panel); border:1px solid var(--linia); border-radius:12px; padding:10px 12px; }
  .karta.kat-praca { border-left:3px solid var(--teal); }
  .karta.kat-system { border-left:3px solid var(--czerwien); }
  .karta.kat-majatek { border-left:3px solid var(--zloto); }
  .karta .rzad { display:flex; gap:8px; align-items:baseline; }
  .karta .ikonka { color:var(--tekst-2); }
  .karta .ikonka .i { width:17px; height:17px; }
  .karta h3 { margin:0; font-family:var(--gra); font-weight:600; font-size:.94rem; flex:1; }
  .karta .koszt { font-family:var(--mono); font-size:.8rem; color:var(--zloto); white-space:nowrap; }
  .karta .zysk { margin:5px 0 2px; font-size:.8rem; font-weight:700; color:var(--kasa); }
  .karta .zysk::before { content:"▸ "; opacity:.7; }
  .karta .flavor { font-size:.73rem; color:var(--tekst-3); margin:2px 0 8px; }
  .karta .dol { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .karta .kup {
    font-family:var(--gra); font-weight:800; font-size:.82rem; cursor:pointer; color:#1c2606;
    background:linear-gradient(180deg,#f5c542,#dfa32b); border:none; border-radius:9px;
    padding:6px 16px; box-shadow:0 3px 0 #a67a1c; touch-action:manipulation;
  }
  .karta .kup:not(:disabled) { animation:puls 1.6s infinite; }
  @keyframes puls { 0%,100%{ box-shadow:0 3px 0 #a67a1c, 0 0 0 rgba(245,197,66,0);} 50%{ box-shadow:0 3px 0 #a67a1c, 0 0 16px rgba(245,197,66,.5);} }
  .karta .kup:disabled { background:var(--panel-2); color:var(--tekst-3); box-shadow:none; cursor:default; animation:none; }
  .karta .ile { font-family:var(--mono); font-size:.7rem; color:var(--teal); }
  .karta .zrodlo { margin-left:auto; font-size:.66rem; opacity:.85; }
  .karta .powod { font-size:.68rem; color:var(--amber); margin-top:4px; }
  .karta .powod button { background:none; border:none; color:var(--amber); text-decoration:underline; font-size:.68rem; cursor:pointer; padding:0; }
  .karta.oplacona::after { content:"✓"; position:absolute; right:10px; top:8px; font-family:var(--gra); font-weight:800; color:#7ee08a; font-size:1rem; }

  .dziennik { display:none; margin-top:14px; }
  .dziennik summary { cursor:pointer; font-family:var(--gra); font-weight:600; font-size:.76rem; color:var(--tekst-3); }
  .dziennik ol { list-style:none; margin:6px 0 0; padding:8px 10px; background:#0d1526; border:1px solid var(--linia); border-radius:10px; font-family:var(--mono); font-size:.66rem; line-height:1.6; color:var(--tekst-2); max-height:9rem; overflow-y:auto; }
  .dziennik li b { color:var(--tekst); font-weight:600; }
  .dziennik li .czas { color:var(--tekst-3); }

  /* ── gablota ── */
  .gablota { margin-top:14px; }
  .gablota summary { cursor:pointer; font-family:var(--gra); font-weight:600; font-size:.76rem; color:var(--tekst-3); }
  .gablota ul { list-style:none; margin:6px 0 0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:7px; }
  @media (max-width:520px) { .gablota ul { grid-template-columns:1fr; } }
  .gablota li { background:var(--panel); border:1px solid var(--linia); border-radius:10px; padding:8px 10px; font-size:.7rem; color:var(--tekst-3); }
  .gablota li.zdobyte { border-color:#7a6320; color:var(--tekst-2); }
  .gablota li .n { font-family:var(--gra); font-weight:600; font-size:.74rem; color:var(--tekst-3); display:block; }
  .gablota li.zdobyte .n { color:var(--zloto-2); }
  .gablota li.zdobyte .n .i { color:var(--zloto); }
  .gablota li a { font-size:.64rem; }

  /* ── KARTA DECYZJI ── */
  .fon {
    position:fixed; z-index:47; left:50%; top:42%; transform:translate(-50%,-50%) scale(.92);
    width:min(92vw, 500px); opacity:0; pointer-events:none;
    background:var(--panel-2); border:2px solid var(--amber); border-radius:18px;
    padding:18px 20px 14px; transition:transform .22s ease-out, opacity .2s;
    box-shadow:0 24px 70px rgba(0,0,0,.7), 0 0 34px rgba(255,184,77,.22);
  }
  .fon.dzwoni { transform:translate(-50%,-50%) scale(1); opacity:1; pointer-events:auto; }
  .fon-tytul { font-family:var(--gra); font-weight:800; font-size:1.1rem; margin-bottom:5px; color:var(--amber); }
  .fon-tytul .i { width:1.1em; height:1.1em; }
  .fon-tresc { font-size:.92rem; color:var(--tekst-2); margin-bottom:12px; line-height:1.45; }
  .fon-akcje button {
    display:block; width:100%; text-align:left; border:1px solid var(--linia-2); background:var(--panel);
    color:var(--tekst); border-radius:12px; padding:10px 14px; margin-bottom:8px;
    font-family:var(--gra); font-weight:700; font-size:.9rem; cursor:pointer;
  }
  .fon-akcje button:hover { border-color:var(--amber); }
  .fon-akcje button:first-child { background:linear-gradient(180deg,#a8e063,#7cb93e); color:#1c2606; border:none; font-weight:800; box-shadow:0 3px 0 #4e7a22; }
  .fon-akcje button small { display:block; font-family:var(--mono); font-weight:500; font-size:.68rem; opacity:.85; margin-top:2px; }
  .fon-zegar { height:3px; background:var(--panel); border-radius:2px; overflow:hidden; margin-top:4px; }
  .fon-zegar i { display:block; height:100%; background:var(--amber); }
  .fon-link { font-size:.7rem; display:inline-block; margin-bottom:8px; }

  .toast {
    position:fixed; z-index:46; left:50%; top:42%; transform:translate(-50%,-50%);
    width:min(92vw, 480px);
    background:var(--panel-2); border:2px solid var(--linia-2); border-radius:18px;
    padding:16px 18px 13px; box-shadow:0 24px 70px rgba(0,0,0,.7); display:none;
  }
  .toast.on { display:block; animation:toastIn .22s ease-out; }
  @keyframes toastIn { from { transform:translate(-50%,-50%) scale(.92); opacity:0; } to { transform:translate(-50%,-50%) scale(1); opacity:1; } }
  .toast.alertowy { border-color:var(--czerwien); box-shadow:0 24px 70px rgba(0,0,0,.7), 0 0 30px rgba(255,107,97,.25); }
  .toast.wynikowy { border-color:var(--kasa); }
  .toast .tt { font-size:.95rem; line-height:1.5; }
  .toast .tt b { font-family:var(--gra); }
  .toast .tt .i { width:1.15em; height:1.15em; }
  .toast .toast-ok {
    display:block; margin:11px auto 0; font-family:var(--gra); font-weight:800; font-size:.82rem;
    cursor:pointer; color:#1c2606; background:linear-gradient(180deg,#a8e063,#7cb93e);
    border:none; border-radius:10px; padding:6px 22px; box-shadow:0 3px 0 #4e7a22;
  }
  .toast .zegar { height:3px; background:var(--panel); border-radius:2px; margin-top:10px; overflow:hidden; }
  .toast .zegar i { display:block; height:100%; background:var(--amber); }

  .zaslona { position:fixed; inset:0; z-index:50; background:rgba(4,8,16,.72); display:none; align-items:center; justify-content:center; padding:14px; }
  .zaslona.on { display:flex; }
  .akt {
    background:var(--panel-2); border:2px solid var(--zloto); border-radius:18px;
    max-width:460px; width:100%; padding:20px 20px 16px; text-align:center;
    box-shadow:0 0 60px rgba(245,197,66,.18); max-height:88vh; overflow-y:auto;
  }
  .akt .eyebrow { font-family:var(--mono); font-size:.58rem; letter-spacing:.22em; text-transform:uppercase; color:var(--tekst-3); }
