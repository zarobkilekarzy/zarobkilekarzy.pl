const kartyRef = {};
function sprawdzKsiegi() { if (S.mieszkania + S.apartamenty >= 3) achievement('ksiegi'); }

function budujSklepy() {
  for (const p of PRZEDMIOTY) {
    const li = document.createElement('li');
    li.className = 'karta ' + (p.kat || '');
    li.innerHTML =
      '<div class="rzad"><span class="ikonka">' + iko(p.ikona) + '</span><h3></h3><span class="koszt"></span></div>' +
      '<p class="zysk"></p>' +
      '<p class="flavor"></p>' +
      '<div class="dol"><button class="kup">Kup</button><span class="ile"></span>' +
      '<a class="zrodlo" href="' + LINK(p.link) + '" target="_blank" rel="noopener">to działa naprawdę →</a></div>' +
      '<div class="powod"></div>';
    const btn = li.querySelector('.kup');
    const kupuj = () => {
      const k = p.koszt();
      if (S.portfel < k || (p.max && p.max())) return;
      if (p.wymog && p.wymog()) return;
      if (p.slotyPotrzebne && p.slotyPotrzebne() > 0 && !znajdzSloty(p.slotyPotrzebne(), p.preferRows, null, p.slotyPlansza || 0)) return;
      S.portfel -= k;
      p.kup();
      czytnik('Kupiono: ' + (typeof p.nazwa === 'function' ? p.nazwa() : p.nazwa));
      postep(); renderSklepy();
    };
    btn.addEventListener('pointerdown', e => { if (e.button === 0 || e.pointerType !== 'mouse') { e.preventDefault(); kupuj(); } });
    btn.addEventListener('click', e => { if (e.detail === 0) kupuj(); });
    li.querySelector('.powod').addEventListener('click', e => {
      if (e.target.matches('[data-godziny]')) godzinyModal();
    });
    $(p.panel).appendChild(li);
    kartyRef[p.id] = { li, btn, cache: {}, el: {
      h3: li.querySelector('h3'), flavor: li.querySelector('.flavor'), zysk: li.querySelector('.zysk'),
      koszt: li.querySelector('.koszt'), ile: li.querySelector('.ile'), powod: li.querySelector('.powod'),
    } };
  }
}

function renderSklepy() {
  for (const p of PRZEDMIOTY) {
    const r = kartyRef[p.id], c = r.cache;
    const maxed = p.max && p.max();
    const wymog = p.wymog ? p.wymog() : null;
    const brakSlotow = !maxed && !wymog && p.slotyPotrzebne && p.slotyPotrzebne() > 0
      && !znajdzSloty(p.slotyPotrzebne(), p.preferRows, null, p.slotyPlansza || 0);
    const v = {
      h3: typeof p.nazwa === 'function' ? p.nazwa() : p.nazwa,
      flavor: typeof p.flavor === 'function' ? p.flavor() : p.flavor,
      zysk: p.efekt(),
      koszt: maxed ? '' : fmt(p.koszt()),
      ile: p.ile && p.ile() > 0 ? '×' + p.ile() : '',
      oplacona: !!maxed,
      disabled: maxed || !!wymog || brakSlotow || S.portfel < p.koszt(),
      btnTekst: maxed ? 'Masz' : 'Kup',
      powod: wymog ? wymog : brakSlotow ? powodSlotow() : '',
    };
    if (c.h3 !== v.h3) { r.el.h3.textContent = v.h3; c.h3 = v.h3; }
    if (c.flavor !== v.flavor) { r.el.flavor.textContent = v.flavor; c.flavor = v.flavor; }
    if (c.zysk !== v.zysk) { r.el.zysk.textContent = v.zysk; c.zysk = v.zysk; }
    if (c.koszt !== v.koszt) { r.el.koszt.textContent = v.koszt; c.koszt = v.koszt; }
    if (c.ile !== v.ile) { r.el.ile.textContent = v.ile; c.ile = v.ile; }
    if (c.oplacona !== v.oplacona) { r.li.classList.toggle('oplacona', v.oplacona); c.oplacona = v.oplacona; }
    if (c.disabled !== v.disabled) { r.btn.disabled = v.disabled; c.disabled = v.disabled; }
    if (c.btnTekst !== v.btnTekst) { r.btn.textContent = v.btnTekst; c.btnTekst = v.btnTekst; }
    if (c.powod !== v.powod) { r.el.powod.innerHTML = v.powod; c.powod = v.powod; }
  }
}

