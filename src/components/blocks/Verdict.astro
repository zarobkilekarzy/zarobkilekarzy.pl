---
/**
 * Wniosek z danych jako ciąg liczb: „to → to → to”, pod spodem jedno zdanie werdyktu.
 * Ton „jedna kluczowa myśl” (kobalt), nie alarm — liczby w kolorach tekstu, akcent tylko na krawędzi.
 * Strzałki są dekoracyjne (CSS); czytnik ekranu dostaje listę kroków w kolejności.
 * Poniżej 560 px szerokości kontenera kroki układają się w kolumnę, strzałki obracają się w dół.
 */
import type { HTMLAttributes } from 'astro/types';
import { typo } from '@/lib/format';
import { uiOf } from '@/i18n/ui';

interface Step {
  /** duża liczba, np. „+55,6%” */
  value: string;
  /** co ta liczba mierzy */
  desc: string;
}

interface Props extends HTMLAttributes<'aside'> {
  /** etykieta nad tytułem */
  label?: string;
  /** werdykt jednym zdaniem — bez kropki na końcu */
  title: string;
  steps: Step[];
  /** dopowiedzenie pod liczbami */
  text?: string;
}

const { label = uiOf(Astro.url).blocks.verdict, title, steps, text, class: className, ...rest } = Astro.props;
---
<aside class:list={['verdict', className]} {...rest}>
  <p class="verdict__label">{label}</p>
  <p class="verdict__title">{typo(title)}</p>
  <ol class="verdict__steps">
    {steps.map((s) => (
      <li class="verdict__step">
        <span class="verdict__value">{s.value}</span>
        <span class="verdict__desc">{typo(s.desc)}</span>
      </li>
    ))}
  </ol>
  {text && <p class="verdict__text">{typo(text)}</p>}
</aside>

<style>
  .verdict {
    container-type: inline-size;
    margin: 28px 0; padding: 22px 24px 24px;
    background: var(--blue-50); border-left: 4px solid var(--blue);
  }
  .verdict__label { margin: 0 0 6px; font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--blue-700); }
  .verdict__title { margin: 0 0 20px; font: 600 clamp(1.25rem, 4.2cqi, 1.625rem)/1.2 var(--f-display); letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }

  .verdict__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 48px; }
  .verdict__step { position: relative; display: grid; align-content: start; gap: 6px; }
  /* strzałka między krokami — w odstępie kolumn */
  .verdict__step + .verdict__step::before {
    content: "→"; position: absolute; left: -36px; top: calc(clamp(1.75rem, 7cqi, 2.5rem) / 2 - 0.75rem);
    font: 400 1.5rem/1 var(--f-body); color: var(--blue);
  }
  .verdict__value { font: 600 clamp(1.75rem, 7cqi, 2.5rem)/1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .verdict__desc { font: 400 0.875rem/1.4 var(--f-body); color: var(--text-strong); }
  .verdict__text { margin: 20px 0 0; font: 400 0.9375rem/1.55 var(--f-body); color: var(--text-strong); }

  @container (max-width: 560px) {
    .verdict__steps { grid-auto-flow: row; gap: 28px; }
    .verdict__step + .verdict__step::before { content: "↓"; left: 0; top: -26px; font-size: 1.25rem; }
  }
</style>
