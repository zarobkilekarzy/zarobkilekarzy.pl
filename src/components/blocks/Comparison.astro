---
/**
 * Tabela porównania (stan obecny / projektowany, tekst ujednolicony). Wiersz `marked` jest wyróżniony.
 * W wąskim kontenerze każdy wiersz staje się kartą: komórki z etykietą kolumny nad treścią.
 * Pierwsza kolumna z pustym nagłówkiem to nazwa wiersza (nagłówek karty).
 * `hints` (kolumny) i `hint` (wiersz) dodają przy nazwie dymek „?” z objaśnieniem (ui/Popover, wariant `hint`);
 * `cellHints` — objaśnienie pojedynczej liczby: sama wartość jest wyzwalaczem dymka (wariant `term`).
 * `sortable` — klik w nagłówek kolumny sortuje wiersze (bez JS tabela zostaje w układzie pierwotnym).
 * Wiersz z polem `more` ma pod sobą zwinięty dodatek (<details>): małą tabelę, np. głosy klubów pod wynikiem głosowania.
 */
import type { HTMLAttributes } from 'astro/types';
import type { CompareTable } from '@/types';
import Popover from '@/components/ui/Popover.astro';
import { localeOf } from '@/i18n/locales';
import { typo } from '@/lib/format';

interface Props extends HTMLAttributes<'div'> {
  table: CompareTable;
  /** tekst wyróżnionych wierszy, np. „nowy przepis” */
  markLabel?: string;
  /** nagłówki kolumn sortują wiersze (klik: malejąco → rosnąco → układ pierwotny); komórki bez liczby idą na koniec */
  sortable?: boolean;
  /** nazwa pierwszej kolumny na przycisku sortowania, gdy jej nagłówek jest pusty (domyślnie „Nazwa”) */
  sortLabel?: string;
}

// etykiety dostępności dymków w języku strony (język z adresu)
const en = localeOf(Astro.url.pathname) === 'en';
const a11y = en
  ? { column: 'how to read it', row: 'where the figures come from', cell: 'explanation', name: 'Name' }
  : { column: 'jak czytać', row: 'skąd te liczby', cell: 'objaśnienie', name: 'Nazwa' };
const { table, markLabel, sortable = false, sortLabel = a11y.name, class: className, ...rest } = Astro.props;
const rowHeader = table.columns[0] === '' || table.columns.length > 2;
// gdy choć jeden wiersz jest wyróżniony (pasek z lewej + wcięcie), wszystkie dostają to samo wcięcie — tekst w jednej linii
const hasMarks = table.rows.some((row) => row.marked);
---
<div class:list={['cmp-wrap', className]} {...rest}>
  <table class:list={['cmp', { 'cmp--marks': hasMarks }]} data-sortable={sortable ? '' : undefined}>
    {table.caption && <caption>{typo(table.caption)}</caption>}
    <thead>
      <tr>
        {table.columns.map((c, i) => {
          const text = typo(c || sortLabel);
          const cut = text.lastIndexOf(' ');
          const hint = table.hints?.[i];
          return (
            <th scope="col">
              <span class="cmp__head">
                {sortable ? (
                  <button type="button" class="cmp__sort" data-col={i}>{text.slice(0, cut + 1)}<span class="cmp__last">{text.slice(cut + 1)}<i class="cmp__sort-ind" aria-hidden="true"></i></span></button>
                ) : typo(c)}
                {hint && <Popover variant="hint" placement="bottom" class="cmp__hint" label={`${c}: ${a11y.column}`} heading={c}>{typo(hint)}</Popover>}
              </span>
            </th>
          );
        })}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <>
          <tr class:list={{ 'is-marked': row.marked, 'has-more': row.more }}>
            {row.cells.map((cell, i) =>
              i === 0 && rowHeader ? (
                <th scope="row" data-label={table.columns[0]}>{typo(cell)}{row.hint && <Popover variant="hint" class="cmp__hint" label={`${cell}: ${a11y.row}`} heading={cell}>{typo(row.hint)}</Popover>}{row.docs && <span class="cmp__docs">{row.docs.map((d) => <a href={d.href}>{typo(d.label)}</a>)}</span>}</th>
              ) : (
                <td data-label={table.columns[i]}>
                  {row.marked && markLabel && cell !== '—' && <span class="cmp__mark">{markLabel}</span>}
                  {row.cellHints?.[i] ? <Popover variant="term" class="cmp__cell-hint" label={`${row.cells[0]}, ${table.columns[i]}: ${cell} — ${a11y.cell}`} heading={`${row.cells[0]} — ${table.columns[i]}`}><Fragment slot="trigger">{typo(cell)}</Fragment>{typo(row.cellHints[i]!)}</Popover> : typo(cell)}
                </td>
              ),
            )}
          </tr>
          {row.more && (
            <tr class:list={['cmp__more-row', { 'is-marked': row.marked }]}>
              <td colspan={table.columns.length}>
                <details class="cmp__more">
                  <summary>{typo(row.more.label)}</summary>
                  <table class="cmp__sub">
                    <thead>
                      <tr>{row.more.columns.map((c) => <th scope="col">{typo(c)}</th>)}</tr>
                    </thead>
                    <tbody>
                      {row.more.rows.map((cells) => (
                        <tr>{cells.map((cell, i) => (i === 0 ? <th scope="row">{typo(cell)}</th> : <td>{typo(cell)}</td>))}</tr>
                      ))}
                    </tbody>
                  </table>
                  {row.more.link && <p class="cmp__more-link"><a href={row.more.link.href}>{typo(row.more.link.label)}</a></p>}
                </details>
              </td>
            </tr>
          )}
        </>
      ))}
    </tbody>
  </table>
</div>

<style>
  .cmp-wrap { container-type: inline-size; }
  .cmp { width: 100%; border-collapse: collapse; font-size: 0.9375rem; line-height: 1.6; }
  caption { caption-side: top; text-align: left; padding-bottom: 14px; font: 400 0.84375rem/1.5 var(--f-body); color: var(--text); }
  /* .cmp przed selektorem — tabela bywa osadzona w Prose, która stylizuje th/td potomków */
  .cmp thead th {
    text-align: left; vertical-align: bottom; padding: 10px 16px 10px 0;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
    border-bottom: 1px solid var(--ink);
  }
  .cmp tbody th, .cmp td { text-align: left; vertical-align: top; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); color: var(--prose, var(--text-strong)); }
  .cmp tbody th { font: 500 0.9375rem/1.45 var(--f-display); letter-spacing: -0.01em; text-transform: none; color: var(--ink); width: var(--cmp-th, 22%); }
  .cmp td { color: var(--ink-2); }

  .cmp tbody th :global(.cmp__hint) { margin-left: 6px; vertical-align: 1px; }
  .cmp :global(.cmp__hint) { flex: none; text-transform: none; letter-spacing: 0; font-weight: 400; }
  /* nagłówek: tekst może się łamać, a strzałka sortowania trzyma się ostatniego słowa; „?” stoi obok, przy dolnej linii */
  .cmp__head { display: inline-flex; align-items: flex-end; gap: 6px; }
  .cmp__last { white-space: nowrap; }
  .cmp__sort { display: inline; padding: 0; border: 0; background: none; font: inherit; letter-spacing: inherit; text-transform: inherit; text-align: left; color: inherit; cursor: pointer; }
  .cmp__sort:hover, .cmp__sort:focus-visible { color: var(--blue); }
  .cmp__sort-ind { display: inline-block; width: 0; height: 0; margin-left: 5px; border: 4px solid transparent; border-top-color: var(--line-2); border-bottom-width: 0; vertical-align: 2px; }
  th[aria-sort="descending"] .cmp__sort-ind { border-top-color: var(--ink); }
  th[aria-sort="ascending"] .cmp__sort-ind { border-top-width: 0; border-bottom: 4px solid var(--ink); vertical-align: 3px; }
  .cmp .is-marked > * { background: var(--blue-50); }
  .cmp .is-marked > :first-child { box-shadow: inset 3px 0 0 var(--blue); padding-left: 14px; }
  .cmp--marks tr > :first-child { padding-left: 14px; }
  .cmp__mark {
    display: inline-block; margin-right: 8px; padding: 2px 6px; vertical-align: 1px;
    font: 500 0.625rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; background: var(--blue-fill); color: #fff;
  }

  /* Zwinięty dodatek pod wierszem: wiersz i dodatek czytają się jako jedna pozycja (linia dopiero pod dodatkiem) */
  .cmp tr.has-more > * { border-bottom: 0; padding-bottom: 6px; }
  .cmp .cmp__more-row > td { padding: 0 0 14px; }
  .cmp--marks .cmp__more-row > td, .cmp .cmp__more-row.is-marked > td { padding-left: 14px; }
  .cmp__more > summary {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; list-style: none;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--blue);
  }
  .cmp__more > summary::-webkit-details-marker { display: none; }
  .cmp__more > summary::before { content: "+" / ""; font: 400 0.9375rem/1 var(--f-mono); }
  .cmp__more[open] > summary::before { content: "–" / ""; }
  .cmp__more > summary:hover { color: var(--ink); }
  .cmp .cmp__sub { width: 100%; max-width: 640px; margin-top: 10px; border-collapse: collapse; font-size: 0.84375rem; line-height: 1.4; }
  .cmp .cmp__sub thead th { padding: 6px 12px 6px 0; border-bottom: 1px solid var(--line-2); background: none; box-shadow: none; font: 500 0.625rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .cmp .cmp__sub tbody th, .cmp .cmp__sub td { width: auto; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--line); background: none; box-shadow: none; font: 400 0.84375rem/1.4 var(--f-body); letter-spacing: 0; color: var(--ink-2); }
  .cmp .cmp__sub tbody th { color: var(--ink); }
  /* Dokumenty wiersza (np. druk, nad którym głosowano) — pod nazwą wiersza, mniejsze, jak link źródła */
  .cmp__docs { display: flex; flex-wrap: wrap; gap: 2px 12px; margin-top: 6px; font: 400 0.8125rem/1.4 var(--f-body); letter-spacing: 0; text-transform: none; }
  .cmp__docs a { color: var(--text); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; }
  .cmp__docs a:hover { color: var(--blue); }
  .cmp__more-link { margin-top: 10px; font-size: 0.8125rem; }
  .cmp__more-link a { color: var(--text); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; }
  .cmp__more-link a:hover { color: var(--blue); }

  /* Wąsko: wiersz = karta, etykieta kolumny nad komórką */
  @container (max-width: 640px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .cmp, .cmp caption, .cmp tbody, .cmp tr, .cmp tbody th, .cmp td { display: block; width: auto; }
    .cmp tr { padding: 14px 0; border-bottom: 1px solid var(--line-2); }
    .cmp tbody th, .cmp td { padding: 4px 0; border: 0; }
    .cmp tbody th { padding-bottom: 8px; font-size: 1rem; }
    .cmp td[data-label]::before { content: attr(data-label); display: block; margin: 8px 0 2px; font: 500 0.65625rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
    .cmp .is-marked { padding-inline: 14px; background: var(--blue-50); box-shadow: inset 3px 0 0 var(--blue); }
    .cmp .is-marked > *, .cmp .is-marked > :first-child { background: none; box-shadow: none; padding-left: 0; }
    .cmp--marks tr { padding-inline: 14px; }
    .cmp--marks tr > :first-child { padding-left: 0; }
    /* dodatek domyka kartę wiersza; mała tabela zostaje tabelą */
    .cmp tr.has-more { padding-bottom: 6px; border-bottom: 0; }
    .cmp tr.cmp__more-row { padding-top: 0; }
    .cmp .cmp__more-row > td { padding: 0; }
    .cmp .cmp__sub { display: table; table-layout: fixed; width: 100%; max-width: none; }
    .cmp .cmp__sub thead { display: table-header-group; position: static; width: auto; height: auto; overflow: visible; clip: auto; }
    .cmp .cmp__sub tbody { display: table-row-group; }
    .cmp .cmp__sub tr { display: table-row; padding: 0; border: 0; }
    .cmp .cmp__sub tbody th, .cmp .cmp__sub td, .cmp .cmp__sub thead th { display: table-cell; padding: 6px 6px 6px 0; border-bottom: 1px solid var(--line); font-size: 0.8125rem; }
    /* cztery kolumny liczb muszą się zmieścić w karcie: nagłówki zwykłym pismem, z dzieleniem wyrazów */
    .cmp .cmp__sub thead th { font: 400 0.625rem/1.25 var(--f-body); letter-spacing: 0; text-transform: none; hyphens: auto; overflow-wrap: break-word; vertical-align: bottom; }
    .cmp .cmp__sub thead th:first-child { width: 35%; }
  }
</style>

<script>
  // Sortowanie po nagłówku: liczba z tekstu komórki („ok. 50,5%*”, „2,86× (2024)”, „1 234”); komórka bez liczby na końcu.
  const num = (text: string) => {
    const m = text.replace(/\(\d{4}\)/g, '').replace(/[\s\u00a0\u202f]/g, '').replace(',', '.').match(/-?\d+(\.\d+)?/);
    return m ? Number(m[0]) : null;
  };
  for (const table of document.querySelectorAll<HTMLTableElement>('table.cmp[data-sortable]')) {
    const body = table.tBodies[0];
    const original = [...body.rows];
    const heads = [...table.tHead!.rows[0].cells];
    table.tHead!.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.cmp__sort');
      if (!button) return;
      const col = Number(button.dataset.col);
      const th = heads[col];
      // liczby najpierw malejąco, nazwy najpierw alfabetycznie; trzeci klik wraca do układu pierwotnego
      const order = col === 0 ? ['ascending', 'descending'] : ['descending', 'ascending'];
      const next = order[order.indexOf(th.getAttribute('aria-sort') ?? '') + 1] ?? null;
      heads.forEach((h) => h.removeAttribute('aria-sort'));
      let rows = original;
      if (next) {
        th.setAttribute('aria-sort', next);
        const dir = next === 'descending' ? -1 : 1;
        const text = (r: HTMLTableRowElement) => r.cells[col]?.textContent?.trim() ?? '';
        rows = [...original].sort((a, b) => {
          if (col === 0) return dir * text(a).localeCompare(text(b), document.documentElement.lang || 'pl');
          const x = num(text(a));
          const y = num(text(b));
          if (x === null || y === null) return x === null ? (y === null ? 0 : 1) : -1;
          return dir * (x - y);
        });
      }
      body.append(...rows);
    });
  }
</script>
