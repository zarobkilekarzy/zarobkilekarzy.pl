---
/** /postulat/ — co dokładnie postulujemy: cztery elementy, co jawne, co chronione, czego nie chcemy. */
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import NumberedList from '@/components/blocks/NumberedList.astro';
import TwoLists from '@/components/blocks/TwoLists.astro';
import Aside from '@/components/blocks/Aside.astro';
import { demands, disclosure, notDemanded } from '@/data/postulat';
import { typo } from '@/lib/format';
---
<Section id="postulat" aria-labelledby="postulat-title">
  <SectionHead
    eyebrow="Co postulujemy"
    title="Cztery elementy, jeden przepis"
    id="postulat-title"
    aside="Wszystkie cztery mieszczą się w jednym artykule jednej ustawy — art. 27a ustawy o działalności leczniczej. Nie trzeba zbierać nowych danych: państwo może ich już żądać."
  />

  <NumberedList items={demands} layout="columns" />

  <TwoLists yes={disclosure.public} no={disclosure.protected} class="demands__lists" />

  <Aside title="Czego nie postulujemy" class="demands__not">
    <p>{typo(notDemanded)}</p>
  </Aside>
</Section>

<style>
  .demands__lists { margin-top: clamp(48px, 6vw, 80px); }
  .demands__not { margin-top: 24px; max-width: 760px; }
</style>
