---
/** /postulat/ — zmiana postulatu: dlaczego publikacja bez nazwisk (i link do archiwum petycji). */
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import NumberedList from '@/components/blocks/NumberedList.astro';
import { withoutNames } from '@/data/postulat';
import { petycja } from '@/data/petycja';
import { typo } from '@/lib/format';
---
<Section id="bez-nazwisk" tone="soft" aria-labelledby="bez-nazwisk-title">
  <div class="names">
    <div class="names__intro">
      <Eyebrow>Zmiana postulatu</Eyebrow>
      <Heading id="bez-nazwisk-title" class="names__title">{typo(withoutNames.title)}</Heading>
      <p class="names__lead">{typo(withoutNames.lead)}</p>
      <LinkArrow href={petycja.href}>Petycja z lipca 2026 r. — archiwum</LinkArrow>
    </div>
    <NumberedList items={withoutNames.reasons} />
  </div>
</Section>

<style>
  .names { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 40px clamp(40px, 6vw, 96px); align-items: start; }
  .names__title { max-width: 12ch; }
  .names__lead { margin: 24px 0 28px; font-size: 1.0625rem; line-height: 1.7; max-width: 44ch; color: var(--ink-2); }

  @media (max-width: 1024px) {
    .names { grid-template-columns: minmax(0, 1fr); }
  }
</style>
