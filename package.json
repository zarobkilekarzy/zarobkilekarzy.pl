{
  "name": "zarobkilekarzy",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Obywatelska inicjatywa na rzecz jawności wynagrodzeń w ochronie zdrowia.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "petycja:pdf": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-petycja-pdf.mjs",
    "preview:cf": "astro build && npx wrangler@4 pages dev dist --kv SONDA_KV --binding BASIC_AUTH_ENABLED=false",
    "deploy": "astro build && npx wrangler@4 pages deploy dist --project-name=zarobkilekarzy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.2.9",
    "jspdf": "^4.2.1",
    "satori": "^0.33.4",
    "satori-html": "^0.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "pdfkit": "^0.20.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
