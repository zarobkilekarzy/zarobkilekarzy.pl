---
/**
 * Wykres rozrzutu: każda kropka to jedna obserwacja (np. egzamin: czas × wynik). Skale od zera.
 * Siatka i linie odniesienia to SVG rozciągnięty na pole (`preserveAspectRatio="none"`,
 * `non-scaling-stroke`), a kropki i podpisy to HTML — nie skalują się z polem.
 * Kropki `highlight` w akcencie (--blue), pozostałe w --chart z lekką przezroczystością,
 * żeby nakładające się punkty było widać jako gęstsze miejsce.
 * Kropka z `tip` ma dymek ui/Popover (wariant `cell`): nagłówek i tekst, po najechaniu, fokusie albo dotknięciu.
 * Rysunek jest dla oka (`aria-hidden`), czytnik dostaje przyciski dymków i `caption`.
 */
import Popover from '@/components/ui/Popover.astro';
import { typo } from '@/lib/format';

interface Tick { value: number; label: string }

interface Props {
  /** `label` podpisuje kropkę obok (`side`: z lewej, z prawej, nad nią albo pod nią), `tip` to dymek kropki */
  points: { x: number; y: number; highlight?: boolean; label?: string; side?: 'left' | 'right' | 'above' | 'below'; tip?: { heading: string; text: string } }[];
  /** zakres i podpisy osi poziomej; `min` domyślnie 0 (oś nie od zera — np. długość życia w latach) */
  x: { min?: number; max: number; ticks: Tick[]; title?: string };
  /** zakres osi pionowej i podpisy linii siatki */
  y: { min?: number; max: number; ticks: Tick[]; title?: string };
  /** poziome linie odniesienia: `ink` przerywana (np. próg), `muted` kropkowana (np. poziom zgadywania) */
  lines?: { value: number; label: string; tone?: 'ink' | 'muted' }[];
  /** linia trendu przez cały wykres: wartości y na lewym (`from`) i prawym (`to`) brzegu */
  trend?: { from: number; to: number };
  /** pełny opis danych dla czytników ekranu */
  caption: string;
}

const { points, x, y, lines = [], trend, caption } = Astro.props;
const x0 = x.min ?? 0;
const y0 = y.min ?? 0;
const px = (v: number) => (((v - x0) / (x.max - x0)) * 100).toFixed(2);
const py = (v: number) => (100 - ((v - y0) / (y.max - y0)) * 100).toFixed(2);
---
<figure class="sc">
  <div class:list={['sc__plot', { 'has-title': y.title }]}>
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {y.ticks.map((t) => <line x1="0" x2="100" y1={py(t.value)} y2={py(t.value)} class="sc__grid" />)}
      {lines.map((l) => <line x1="0" x2="100" y1={py(l.value)} y2={py(l.value)} class:list={['sc__line', `sc__line--${l.tone ?? 'ink'}`]} />)}
      {trend && <line x1="0" x2="100" y1={py(trend.from)} y2={py(trend.to)} class="sc__line sc__line--ink" />}
    </svg>
    {y.title && <span class="sc__title sc__title--y" aria-hidden="true">{typo(y.title)}</span>}
    {y.ticks.filter((t) => t.value > y0).map((t) => <span class="sc__y" style={`top: ${py(t.value)}%`} aria-hidden="true">{t.label}</span>)}
    {lines.map((l) => <span class:list={['sc__line-label', `sc__line-label--${l.tone ?? 'ink'}`]} style={`top: ${py(l.value)}%`} aria-hidden="true">{typo(l.label)}</span>)}
    {points.map((p) => (
      <span class:list={['sc__dot', { 'is-hi': p.highlight }]} style={`left: ${px(p.x)}%; top: ${py(p.y)}%`} aria-hidden="true">
        {p.label && <span class:list={['sc__label', `sc__label--${p.side ?? 'right'}`]}>{typo(p.label)}</span>}
      </span>
    ))}
    {points.filter((p) => p.tip).map((p) => (
      <Popover variant="cell" class={p.highlight ? 'sc__hit sc__hit--hi' : 'sc__hit'} style={`left: ${px(p.x)}%; top: ${py(p.y)}%`} label={`${p.tip!.text}: ${p.tip!.heading}`} heading={p.tip!.heading}>
        {p.tip!.text}
      </Popover>
    ))}
  </div>
  <div class="sc__x" aria-hidden="true">
    {x.ticks.map((t) => <span style={`left: ${px(t.value)}%`} class:list={{ 'is-first': t.value === x0, 'is-last': t.value === x.max }}>{typo(t.label)}</span>)}
  </div>
  {x.title && <p class="sc__title sc__title--x" aria-hidden="true">{typo(x.title)}</p>}
  <figcaption class="sr-only">{caption}</figcaption>
</figure>

<style>
  .sc { container-type: inline-size; margin: 0; }
  .sc__plot { position: relative; height: clamp(240px, 52cqi, 340px); margin-top: 8px; border-bottom: 1px solid var(--line-2); }
  .sc__plot.has-title { margin-top: 40px; }
  .sc__plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .sc__grid { stroke: var(--line); vector-effect: non-scaling-stroke; }
  .sc__line { vector-effect: non-scaling-stroke; }
  .sc__line--ink { stroke: var(--ink); stroke-dasharray: 4 3; }
  .sc__line--muted { stroke: var(--muted); stroke-dasharray: 1 3; }

  /* Podpis linii siatki nad nią, przy lewej krawędzi */
  .sc__y { position: absolute; left: 0; translate: 0 calc(-100% - 3px); font: 400 0.6875rem/1 var(--f-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
  /* Podpis linii odniesienia przy prawej krawędzi, wycięty tłem */
  .sc__line-label {
    position: absolute; right: 0; translate: 0 -50%; z-index: 1; padding: 2px 0 2px 6px; background: var(--under);
    font: 500 0.65625rem/1.2 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap;
  }
  .sc__line-label--ink { color: var(--ink); }
  .sc__line-label--muted { color: var(--muted); }

  .sc__dot {
    position: absolute; width: 9px; height: 9px; translate: -50% -50%; border-radius: 50%;
    background: var(--chart); opacity: .85;
  }
  .sc__dot.is-hi { z-index: 2; background: var(--blue); opacity: 1; }
  /* Podpis kropki: nazwa obok, wyróżniona w kobalcie */
  .sc__label { position: absolute; top: 50%; translate: 0 -50%; white-space: nowrap; font: 400 0.6875rem/1 var(--f-mono); color: var(--muted); }
  .sc__label--right { left: 12px; }
  .sc__label--left { right: 12px; }
  .sc__label--above, .sc__label--below { left: 50%; translate: -50% 0; }
  .sc__label--above { top: auto; bottom: calc(100% + 5px); }
  .sc__label--below { top: calc(100% + 5px); }
  /* pole dymka nad kropką: większe niż kropka, żeby dało się w nią trafić palcem */
  .sc :global(.sc__hit) { position: absolute; z-index: 3; width: 16px; height: 16px; margin: -8px 0 0 -8px; }
  .sc :global(.sc__hit--hi) { z-index: 4; width: 20px; height: 20px; margin: -10px 0 0 -10px; }
  .is-hi > .sc__label { font: 600 0.75rem/1 var(--f-body); color: var(--blue); }
  /* Nazwy osi: pionowej nad wykresem, poziomej pod podpisami osi, przy prawej krawędzi */
  .sc__title { font: 400 0.6875rem/1.3 var(--f-mono); color: var(--muted); }
  .sc__title--y { position: absolute; left: 0; top: 0; translate: 0 calc(-100% - 18px); }
  .sc__title--x { margin: 2px 0 0; text-align: right; }

  .sc__x { position: relative; height: 1.4rem; margin-top: 6px; }
  .sc__x span { position: absolute; top: 0; translate: -50% 0; font: 400 0.6875rem/1.2 var(--f-mono); color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .sc__x span.is-first { translate: 0 0; }
  .sc__x span.is-last { translate: -100% 0; }
  @container (max-width: 420px) {
    .sc__dot { width: 7px; height: 7px; }
    .sc__line-label { font-size: 0.5625rem; }
  }
</style>
