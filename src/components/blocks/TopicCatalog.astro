---
/**
 * Spis strony-indeksu (/dane/, /analizy/): działy jeden pod drugim — po lewej opis działu
 * (przyklejony przy przewijaniu), po prawej materiały w wierszach.
 * Materiały: polskie artykuły albo pozycje spisu (src/i18n/entries.ts) — strony /en/data/, /en/analysis/.
 * `noun` po angielsku: ['text', 'texts', 'texts'] (plural() wybiera pierwszą formę tylko dla 1).
 */
import ArticleTable from '@/components/blocks/ArticleTable.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import type { Article } from '@/lib/content';
import type { Entry } from '@/i18n/entries';
import type { TopicInfo } from '@/types';
import { pad2, plural, typo } from '@/lib/format';

interface Props {
  groups: { topic: string; info: TopicInfo; articles: (Article | Entry)[] }[];
  /** odmiana licznika, np. ['zestawienie', 'zestawienia', 'zestawień'] */
  noun: [string, string, string];
  /** kolumna formy materiału (Wykresy, Tabela…) */
  format?: boolean;
}

const { groups, noun, format = true } = Astro.props;
---
<div class="catalog">
  {groups.map(({ topic, info, articles }, i) => (
    <section class="cat" id={topic} aria-labelledby={`${topic}-title`}>
      <header class="cat__head">
        <p class="cat__num">{pad2(i + 1)}</p>
        <h2 class="cat__title" id={`${topic}-title`}>{typo(info.label)}</h2>
        <p class="cat__lead">{typo(info.lead)}</p>
        <p class="cat__count">{articles.length} {plural(articles.length, noun)}</p>
        {info.more && <p class="cat__more"><LinkArrow href={info.more.href}>{typo(info.more.label)}</LinkArrow></p>}
      </header>
      <ArticleTable articles={articles} format={format} />
    </section>
  ))}
</div>

<style>
  .catalog { display: grid; gap: clamp(64px, 7vw, 104px); }
  .cat { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 32px clamp(40px, 6vw, 96px); align-items: start; scroll-margin-top: calc(var(--header-h) + 24px); }
  .cat__head { position: sticky; top: calc(var(--header-h) + 32px); }
  .cat__num { font: 300 3.5rem/1 var(--f-display); letter-spacing: -0.05em; color: var(--blue); }
  .cat__title { margin: 20px 0 12px; font: 400 clamp(1.75rem, 2.6vw, 2.25rem)/1.1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); }
  .cat__lead { font-size: 0.96875rem; line-height: 1.6; }
  .cat__more { margin-top: 12px; }
  .cat__count { margin-top: 20px; font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 1024px) {
    .cat { grid-template-columns: minmax(0, 1fr); }
    .cat__head { position: static; display: grid; grid-template-columns: auto 1fr; column-gap: 20px; align-items: baseline; }
    .cat__num { grid-row: span 3; font-size: 2.5rem; }
    .cat__title { margin: 0 0 8px; }
  }
</style>
