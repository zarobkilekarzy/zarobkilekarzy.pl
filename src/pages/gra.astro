      opis: 'W powiecie zmienił się zarząd. Nowa księgowa porównuje grafiki placówek godzina po godzinie. To jedyny sposób, w jaki KIEDYKOLWIEK wykrywano nakładki.',
      opcje: [
        { label: 'Prawnik: 25 000 zł', kons: 'audyt „utajniony proceduralnie" · nic się nie dzieje', fn() { if (S.portfel < 25000) return 'nie stać cię — audyt trwa…'; S.portfel -= 25000; return 'procedura utajniona. Spokój'; } },
        { label: 'Niech liczą', kons: '50%: nie umieją sumować · 50%: zwrot 10% portfela i −2 tory', fn() {
          if (Math.random() < 0.5) return 'policzyli źle. Nikt nie umie sumować godzin jednego PWZ';
          const kara = Math.floor(S.portfel * 0.1);
          S.portfel -= kara; S.ryzyko += 10;
          const nadTory = S.bloki.filter(b => b.lane > 0);
          for (let i = 0; i < 2 && nadTory.length; i++) {
            const b = nadTory.pop();
            S.bloki.splice(S.bloki.indexOf(b), 1);
          }
          renderPlansza();
          return 'wykryli nakładki: −' + fmt(kara) + ', 2 tory wycięte z grafiku';
        } },
      ],
      link: '/dane/rekordy',
    }) },
  { id: 'stazysta', cd: 0, min: 130, max: 220, gdy: () => S.tier >= 2,
    buduj: () => ({
      tytul: iko('ludzie') + ' Stażysta prosi o pomoc',
      opis: '„Doktorze, wesele siostry… weźmie pan mój dyżur? Dyrekcja płaci podwójnie za zastępstwo z łapanki."',
      opcje: [
        { label: 'Weź dyżur', kons: 'złoty blok CITO + energia −10', fn() {
          S.energia = Math.max(0, S.energia - 10);
          const sloty = znajdzSloty(1, [0, 1, 5]);
          if (sloty) { const s = sloty[0]; S.bloki.push({ c: s.c, r: s.r, lane: s.lane, typ: 'cito', kreska: S.b2b, cito: true, p: s.p }); renderPlansza(); return 'blok CITO w grafiku, młody zapamięta'; }
          return 'grafik pełny — młody radzi sobie sam';
        } },
        { label: 'Odmów', kons: 'energia +5 · młody zapamięta co innego', fn() { S.energia = Math.min(100, S.energia + 5); return 'weekend twój'; } },
      ],
      link: '/dane/pensje-rezydentow',
    }) },
  { id: 'ryczalt', cd: 0, min: 150, max: 250, gdy: () => S.b2b,
    buduj: () => ({
      tytul: iko('gov') + ' Domknięcie ryczałtu',
      opis: 'Szpitalowi brakuje 2% wykonania planu NFZ. Dyrekcja prosi o serię szybkich teleporad „na statystykę" — do końca kwartału zostały godziny.',
      opcje: [
        { label: 'Klikam serię', kons: '+12 000 zł od dyrekcji · energia −15', fn() { S.portfel += 12000; S.energia = Math.max(0, S.energia - 15); return '+12 000 zł, punkty domknięte'; } },
        { label: 'Nie ma mnie', kons: 'ryczałt się nie domknie · dyrekcja pamięta', fn() { return 'plan niedomknięty. Nie twój problem. Na razie'; } },
      ],
      link: '/mechanizmy/rozliczenia-nfz',
    }) },
  { id: 'rejestr', cd: 0, min: 100, max: 170, gdy: () => S.b2b && S.lifetime >= T.REJESTR_OD && !S.fin,
    buduj: () => {
      const koszt = kosztBlokady();
      const stac = S.portfel >= koszt;
      const opcje = [];
      if (stac) opcje.push({ label: 'Zablokuj (lobbing): ' + fmt(koszt), kons: 'projekt odłożony · wróci ' + T.REJESTR_R + '× droższy', fn() {
        S.portfel -= koszt; S.blokadyRejestru++;
        if (S.blokadyRejestru >= 3) achievement('lobbysta');
        return 'projekt odłożony (blokada #' + S.blokadyRejestru + '). Następna: ' + fmt(kosztBlokady());
      } });
      opcje.push({ label: stac ? 'Pozwól przejść' : 'Nie stać cię na blokadę', kons: 'rejestr wchodzi w życie — wszyscy widzą wszystko', fn() { finalRejestru(stac ? 'wybor' : 'brak'); return 'rejestr uchwalony'; } });
      return {
        tytul: iko('gov') + ' Projekt jawnego rejestru',
        opis: 'Obywatele znów zebrali podpisy: rejestr wynagrodzeń ze środków publicznych per PWZ. ' +
          (S.blokadyRejestru > 0 ? 'Blokowałeś już ' + S.blokadyRejestru + ' raz(y) — cena wzrosła. ' : '') +
          'Sejm głosuje jutro.',
        opcje, ttl: 22000, link: '/postulat',
        naTimeout: () => toast({ html: iko('gov') + ' <b>Głosowanie przełożone.</b> Projekt wróci — z większym poparciem.', ttl: 6000 }),
      };
    } },
];
let decyzjaTimer = 40;
function eventyDecyzje(sek) {
  if (S.fin || fonZajety) return;
  decyzjaTimer -= sek;
  if (decyzjaTimer > 0) return;
  const teraz = S.gh;
  const dostepne = DECYZJE.filter(d => d.gdy() && teraz >= d.cd);
  if (!dostepne.length) { decyzjaTimer = 20; return; }
  const rejestr = dostepne.find(d => d.id === 'rejestr');
  const d = (rejestr && Math.random() < 0.45) ? rejestr : dostepne[Math.floor(Math.random() * dostepne.length)];
  d.cd = teraz + (d.min + Math.random() * (d.max - d.min)) * T.H_NA_SEK; // cooldown w godzinach gry
  decyzjaTimer = 45 + Math.random() * 45;
  decyzja(d.buduj());
}

/* ── kontrola + ankieta (toasty) ── */
let nastepnaKontrola = 0, nastepnaAnkieta = 0;
function eventyToasty(sek) {
  if (S.fin) return;
  if (S.ryzyko >= 10) {
    nastepnaKontrola -= sek;
    if (nastepnaKontrola <= 0) {
      nastepnaKontrola = 90 + Math.random() * 60;
      S.kontrole++;
      const kara = S.ryzyko >= 40 ? Math.floor(S.portfel * 0.005) : 0;
      if (kara > 0) S.portfel -= kara;
      toast({
        alert: true,
        html: iko('alert') + ' <b>KONTROLA NFZ.</b> ' + (kara > 0
          ? 'Wykryto nieprawidłowości. Kara: zwrot środków — ' + fmt(kara) + '. Bez odsetek.'
          : 'Skontrolowano 2% dokumentacji. Nie stwierdzono nieprawidłowości.') +
          '<br><span class="mono" style="font-size:.7rem">Kontrole: ' + S.kontrole + ' · realne sankcje: 0</span>',
        ttl: 10000,
      });
      if (S.kontrole === 3) achievement('kontrole');
    }
  }
  if (S.b2b && !S.rejestrDziala) {
    nastepnaAnkieta -= sek;
    if (nastepnaAnkieta <= 0) {
      nastepnaAnkieta = 240 + Math.random() * 140;
      toast({ html: iko('gov') + ' <b>PAŃSTWO CIĘ POLICZY.</b> Ankieta o wynagrodzeniach. Rubryki „jeżeli dotyczy" zostawiasz puste. Sankcji: brak. <a href="' + LINK('/analizy/ustawa-o-danych-a-jawny-rejestr') + '" target="_blank" rel="noopener">tak uchwalono →</a>', ttl: 11000 });
    }
  }
}

/* ── postęp ── */
function postep() {
  if (S.portfel >= 100 && !S.odslony.sklep) { S.odslony.sklep = true; $('sklepy').style.display = 'block'; log('Stać cię na pierwsze szkolenie.', true); }
  if (S.lifetime >= 250 && !S.odslony.praca) { S.odslony.praca = true; $('tabPraca').classList.remove('hide'); }
  if (S.tier >= 1 && !S.odslony.energia) { S.odslony.energia = true; $('energiaStan').classList.add('on'); $('tydzienStan').classList.add('on'); }
  if (S.tier >= 2 && !S.odslony.neg) { S.odslony.neg = true; $('negocjujBtn').classList.remove('hide'); }
  if (S.bilokacja >= 1 && !S.odslony.doba) { S.odslony.doba = true; $('dobaStan').classList.add('on'); }
  if (S.tier >= 2 && S.lifetime >= 12000 && !S.systemOtwarty) {
    S.systemOtwarty = true;
    const t = $('tabSystem');
    t.classList.remove('hide'); t.disabled = false;
    t.innerHTML = iko('system') + ' System';
    log('Zrozumiałeś, jak to działa.', true);
  } else if (S.tier >= 1 && !S.odslony.tajny) {
    S.odslony.tajny = true; $('tabSystem').classList.remove('hide');
  }
  if ((S.b2b || S.portfel >= 30000) && !S.odslony.majatek) {
    S.odslony.majatek = true; $('tabMajatek').classList.remove('hide');
    log('Dzwonił doradca z banku. Podobno lekarzom „nie odmawia się kredytu".', true);
  }
  const doba = dobaRozliczana();
  if (doba > 24) achievement('doba27');
  if (doba >= 36) achievement('doba36');
  if (S.lifetime >= 1000000) achievement('milion');
}

/* ── finał: rejestr wchodzi w życie ── */
function finalRejestru(powod) {
  S.fin = true;
  $('wrap').classList.add('trzesie');
  setTimeout(() => $('wrap').classList.remove('trzesie'), 500);
  const intro = powod === 'wybor'
    ? 'Pozwoliłeś. Sejm uchwalił <b>jawny rejestr wynagrodzeń ze środków publicznych</b> — pierwszy raz od lat w tempie ekspresowym.'
    : 'Tym razem lobbing kosztował więcej, niż zdążyłeś zarobić. Sejm uchwalił <b>jawny rejestr wynagrodzeń ze środków publicznych</b>.';
  modal(
    '<div class="eyebrow">Finał</div><h2>Rejestr wszedł w życie</h2>' +
    '<p>' + intro + (S.blokadyRejestru > 0 ? ' Odwlekałeś to ' + S.blokadyRejestru + ' raz(y) — łącznie za ' + fmt(T.REJESTR_KOSZT0 * (Math.pow(T.REJESTR_R, S.blokadyRejestru) - 1) / (T.REJESTR_R - 1)) + '.' : '') + '</p>' +
    '<div class="split">' +
    '<div><h3>Widział świat</h3><div class="w">' + fmt(S.jawneCum) + '</div><div class="mala">do dziś</div></div>' +
    '<div><h3>Wpłynęło naprawdę</h3><div class="w" style="color:var(--kasa)">' + fmt(S.realCum) + '</div><div class="mala">od dziś widzą to wszyscy</div></div>' +
    '</div>' +
    '<p class="mala">Czego nie widział żaden licznik: ' + Math.floor(S.pacjenci).toLocaleString('pl-PL') + ' przyjętych pacjentów.</p>' +
    ((S.mieszkania + S.apartamenty > 0 || S.panamerka)
      ? '<p class="mala">Co widzieli sąsiedzi od dawna: ' + (S.mieszkania + S.apartamenty) + ' nieruchomości' + (S.panamerka ? ' i panamerka pod szpitalem' : '') + '.</p>' : '') +
    '<p>Nic ci nie zabrano. Po prostu kreskowane bloki przestały być kreskowane.</p>' +
    '<a class="zrodlo-a" href="' + LINK('/postulat') + '" target="_blank" rel="noopener">tak mógłby wyglądać naprawdę →</a>',
    'Graj dalej (rejestr już działa)',
    () => {
      S.rejestrDziala = true;
      S.jawneCum = S.realCum;
      renderPlansza();
      const oko = $('okoBtn');
      oko.classList.add('rejestr');
      $('okoEtyk').textContent = 'rejestr — widzą wszyscy:';
      log('Jawny rejestr wszedł w życie. Cały grafik stał się publiczny.', true);
    });
}

/* ── pętla główna ── */
const playheadEl = $('playhead');
let ostatni = Date.now(), floatTimer = 0, prevKom = null, prevH = 0, kolejkaTimer = 0;
setInterval(() => {
  const teraz = Date.now(), sek = Math.min(2, (teraz - ostatni) / 1000);
  ostatni = teraz;
  const gh = sek * T.H_NA_SEK;
  S.gh += gh;

  const { c, r, poz } = aktualnaKomorka();
  const h = S.gh % 168;
  if (h < prevH) {
    S.tydzienNr++;
    S.kawyTydzien = 0;
    if (S.tydzienSuma > 500 && !S.fin) toast({ wynik: true, html: iko('log') + ' <b>Wypłata tygodnia ' + (S.tydzienNr - 1) + ':</b> +' + fmt(S.tydzienSuma), ttl: 4500 });
    S.tydzienSuma = 0;
    playheadEl.classList.add('przeskok');
  } else playheadEl.classList.remove('przeskok');
  prevH = h;
  playheadEl.style.left = (poz * 100) + '%';

  const kom = kluczKom(c, r);
  if (prevKom && prevKom !== kom) {
    const [pc, pr] = prevKom.split(',').map(Number);
    const cita = S.bloki.filter(b => b.cito && b.c === pc && b.r === pr);
    if (cita.length) {
      S.bloki = S.bloki.filter(b => !(b.cito && b.c === pc && b.r === pr));
      renderPlansza();
      log('Dyżur na cito odbyty. Blok znika z grafiku. Wypłata nie.');
    }
  }
  prevKom = kom;

  // kolejka pacjentów: rośnie sama, nadmiar idzie prywatnie
  kolejkaTimer += sek;
  const interwal = Math.max(3, 8 - S.tier);
  if (kolejkaTimer >= interwal) {
    kolejkaTimer = 0;
    if (S.kolejka < 8) S.kolejka++;
    else if (Math.random() < 0.6) pFloat('pacjent poszedł prywatnie', 30 + Math.random() * 40, 80, 'zly');
  }

  let zysk = 0;
  if (!naUrlopie()) {
    const tu = blokiW(c, r);
    let jawneH = 0, kreskH = 0;
    for (const b of tu) {
      const st = stawkaBloku(b);
      if (b.kreska) kreskH += st; else jawneH += st;
    }
    const netto = jawneH * klinUoP() + kreskH * nettoB2B();
    zysk = netto * gh;
    S.portfel += zysk;
    S.lifetime += (jawneH + kreskH) * gh;
    S.realCum += (jawneH + kreskH) * gh;
    S.jawneCum += (S.rejestrDziala ? (jawneH + kreskH) : jawneH) * gh;
    S.tydzienSuma += zysk;
    if (tu.length) S.pacjenci += sek * 0.4;

    /* energia: praca (tor 0) kosztuje; sen tylko w WOLNE noce */
    const tor0 = tu.filter(b => b.lane === 0);
    if (tor0.length) {
      S.energia -= Math.max(...tor0.map(b => TYPY[b.typ].dren)) * gh;
    } else {
      const regen = (r === 0 || r === 5) ? 0.9 : (r === 1 ? 0.4 : 0.1);
      S.energia += regen * gh;
    }
    S.energia = Math.max(0, Math.min(100, S.energia));
    if (S.energia === 0) achievement('zombie');
    if (S.energia < 25 && !S.odslony.zmeczony) { S.odslony.zmeczony = true; log('Ledwo stoisz. Wszystko, co robisz osobiście, jest warte ułamek stawki. Kawa albo wolna noc.', true); }
  } else {
    S.energia = Math.min(100, S.energia + 1.2 * gh);
  }
  const czynsz = czynszNaGodzine() * gh * 0.915;
  S.portfel += czynsz; S.tydzienSuma += czynsz;

  if (S.cegielki > 0) S.indeks *= Math.pow(1 + T.CEGIELKA_TYG * S.cegielki, gh / 168);

  floatTimer += sek;
  if (floatTimer > 0.7) {
    floatTimer = 0;
    if (zysk > 0) pFloat('+' + Math.floor(zysk / sek).toLocaleString('pl-PL') + ' zł/s', poz * 100 + 1.5, 8, blokiW(c, r).some(b => b.typ === 'cito') ? 'zloty' : '');
  }

  eventyDecyzje(sek);
  eventyToasty(sek);
  postep();
  render();
}, 250);

/* ── render ── */
function kawaCena() { return Math.round(T.KAWA_CENA0 * Math.pow(T.KAWA_R, S.kawyTydzien)); }
function render() {
  $('portfelW').textContent = fmt(S.portfel);
  const { c, r } = aktualnaKomorka();
  const tu = blokiW(c, r);
  let chwilowe = 0;
  for (const b of tu) chwilowe += stawkaBloku(b) * (b.kreska ? nettoB2B() : klinUoP());
  chwilowe = (chwilowe + czynszNaGodzine() * 0.915) * T.H_NA_SEK;
  $('tempoW').textContent = naUrlopie() ? 'urlop — grafik stoi' : chwilowe > 0 ? '+' + fmt(chwilowe) + '/s teraz' : 'pusty slot — klikaj';
  $('tydzienNr').textContent = 'tydzień ' + S.tydzienNr;
  $('indeksW').textContent = S.indeks.toLocaleString('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  if (S.negocjacje > 0) $('negW').textContent = '+' + Math.round((mnoznikNeg() - 1) * 100) + '%';
  $('jawnyMies').textContent = fmt(jawneTygodniowo() * 4.33);
  $('klikInfo').textContent = '+' + Math.floor(wartoscKlikuBrutto() * (S.b2b ? nettoB2B() : klinUoP())).toLocaleString('pl-PL') + ' zł'
    + (S.kolejka > 0 ? ' · kolejka: ' + S.kolejka + ' (×1,5)' : ' · z ulicy')
    + (naDyzurze() ? ' · dyżur ×2' : '');

  const nb = $('negocjujBtn');
  if (!nb.classList.contains('hide')) {
    const zostalo = Math.max(0, negCd - Date.now());
    nb.disabled = zostalo > 0;
    $('negocjujInfo').textContent = zostalo > 0
      ? 'dyrektor unika cię jeszcze ' + Math.ceil(zostalo / 1000) + ' s'
      : 'szansa ~' + Math.round(szansaNeg() * 100) + '% — rośnie, gdy lekarzy brak';
  }

  const ratio = S.jawneCum > 0 ? S.realCum / S.jawneCum : 1;
  if (ratio >= 1.25 && !S.rejestrDziala) {
    const rz = $('rozjazd');
    rz.classList.remove('hide');
    rz.classList.toggle('mega', ratio >= 4);
    $('rozjazdX').textContent = fmtX(ratio);
  } else if (S.rejestrDziala) $('rozjazd').classList.add('hide');

  const e = Math.round(S.energia);
  const pas = $('energiaPas');
  pas.querySelector('i').style.width = e + '%';
  pas.classList.toggle('malo', e < 25);
  pas.classList.toggle('srednio', e >= 25 && e < 60);
  $('energiaOp').textContent = e + '% sił';
  const ei = $('energiaIkona');
  ei.classList.toggle('dobrze', e >= 60);
  ei.classList.toggle('srednio', e >= 25 && e < 60);
  ei.classList.toggle('malo', e < 25);
  const urlopCzeka = Date.now() < (S.urlopCd || 0);
  $('urlopBtn').disabled = naUrlopie() || urlopCzeka;
  $('kawaBtn').disabled = S.portfel < kawaCena() || S.energia >= 95;
  $('kawaCena').textContent = fmt(kawaCena());

  const fiz = hFizyczne();
  $('hUz').textContent = fiz; $('hCap').textContent = S.hCap;
  $('tydzienPas').querySelector('i').style.width = Math.min(100, fiz / S.hCap * 100) + '%';
  $('tydzienPas').classList.toggle('ponad', fiz > 78);

  const doba = dobaRozliczana();
  $('dobaW').textContent = doba.toLocaleString('pl-PL', { maximumFractionDigits: 1 });
  $('dobaPas').querySelector('i').style.width = Math.min(100, doba / 48 * 100) + '%';
  $('dobaPas').classList.toggle('absurd', doba > 24);

  renderSklepy();
}

/* ── akcje ── */
$('urlopBtn').addEventListener('click', () => {
  if (naUrlopie() || Date.now() < (S.urlopCd || 0)) return;
  S.urlopDo = Date.now() + T.URLOP_MS;
  S.urlopCd = Date.now() + T.URLOP_MS + T.URLOP_CD_MS;
  S.energia = Math.min(100, S.energia + T.URLOP_PLUS);
  log('Urlop. 20 sekund ciszy. Telefon i tak zadzwoni.');
});
$('kawaBtn').addEventListener('click', () => {
  const cena = kawaCena();
  if (S.portfel < cena) return;
  S.portfel -= cena;
  S.kawyTydzien++; S.kawyRazem++;
  S.energia = Math.min(100, S.energia + T.KAWA_PLUS);
  if (S.kawyRazem >= 15) achievement('kawoholik');
  render();
});

/* „co widzi świat" ── przytrzymanie oka na planszy */
const okoEl = $('okoBtn');
function swiatOn() {
  if (S.rejestrDziala) return;
  $('planszaRamka').classList.add('swiat-widok');
  okoEl.classList.add('podglad');
  if (!S.odslony.swiat && S.b2b) { S.odslony.swiat = true; log('Tak wygląda twój tydzień w rejestrze płac. Spokojny, prawda?', true); }
}
function swiatOff() {
  $('planszaRamka').classList.remove('swiat-widok');
  okoEl.classList.remove('podglad');
}
okoEl.addEventListener('mouseenter', swiatOn);
okoEl.addEventListener('mouseleave', swiatOff);
okoEl.addEventListener('pointerdown', e => { e.preventDefault(); swiatOn(); });
addEventListener('pointerup', swiatOff);
addEventListener('pointercancel', swiatOff);
okoEl.addEventListener('focus', swiatOn);
okoEl.addEventListener('blur', swiatOff);

/* ── zapis + MIGRACJE ── */
const ZAPIS = 'drugi-licznik-zapis';
const STARE_KLUCZE = ['drugi-licznik-proto-v5', 'drugi-licznik-proto-v4'];
function zapisz() {
  try {
    const kopia = Object.assign({}, S, {
      ostatnioOnline: Date.now(),
      bloki: S.bloki.map(b => ({ c: b.c, r: b.r, lane: b.lane, typ: b.typ, kreska: b.kreska, cito: b.cito, p: b.p || 0 })),
    });
    localStorage.setItem(ZAPIS, JSON.stringify(kopia));
  } catch (e) {}
}
function migruj(stan) {
  const w = stan.wersja || 5;
  if (w < 6) {
    stan.bloki = (stan.bloki || []).map(b => Object.assign({ p: b.typ === 'obok' ? 1 : 0 }, b, { p: b.typ === 'obok' ? 1 : (b.p || 0) }));
    stan.plansze = stan.bloki.some(b => b.p === 1) ? 2 : 1;
    stan.aktywnaPlansza = 0;
    stan.kolejka = 2; stan.zKolejki = 0;
    stan.kawyTydzien = 0; stan.kawyRazem = 0;
    stan.mnoznikObok = 1; stan.blokadyRejestru = 0;
    stan.wersja = 6;
  }
  return stan;
}
function wczytaj() {
  try {
    let z = localStorage.getItem(ZAPIS);
    if (!z) {
      for (const k of STARE_KLUCZE) {
        const stary = localStorage.getItem(k);
        if (stary) { z = stary; localStorage.removeItem(k); break; }
      }
    }
    if (!z) return;
    S = Object.assign(S, migruj(JSON.parse(z)), { urlopDo: 0, urlopCd: 0 });
    S.wersja = T.WERSJA;
  } catch (e) {}
}
let resetTrwa = false;
setInterval(() => { if (!resetTrwa) zapisz(); }, 5000);
addEventListener('beforeunload', () => { if (!resetTrwa) zapisz(); });
$('resetBtn').addEventListener('click', () => {
  if (confirm('Zaczynasz od nowa. Nikt się nie dowie — jak zwykle.')) {
    resetTrwa = true;
    try { localStorage.removeItem(ZAPIS); for (const k of STARE_KLUCZE) localStorage.removeItem(k); } catch (e) {}
    location.reload();
  }
});
window.__nowaGra = () => { resetTrwa = true; try { localStorage.removeItem(ZAPIS); for (const k of STARE_KLUCZE) localStorage.removeItem(k); } catch (e) {} location.reload(); };

/* ── OFFLINE: system pracował za ciebie ── */
function rozliczOffline() {
  if (!S.ostatnioOnline || !S.bloki.length) return;
  const sekOff = (Date.now() - S.ostatnioOnline) / 1000;
  if (sekOff < T.OFFLINE_MIN_S) return;
  const eff = Math.min(sekOff, T.OFFLINE_CAP_S);
  const tygodnie = (eff / 28) * T.OFFLINE_TEMPO;         // 28 s realnych = tydzień gry
  const jawneTyg = jawneTygodniowo(), kreskTyg = kreskoweTygodniowo();
  const bruttoTyg = jawneTyg + kreskTyg;
  const nettoTyg = jawneTyg * klinUoP() + kreskTyg * nettoB2B() + czynszNaGodzine() * 168 * 0.915;
  const zysk = nettoTyg * tygodnie;
  S.portfel += zysk;
  S.lifetime += bruttoTyg * tygodnie;
  S.realCum += bruttoTyg * tygodnie;
  S.jawneCum += (S.rejestrDziala ? bruttoTyg : jawneTyg) * tygodnie;
  S.tydzienNr += Math.floor(tygodnie);
  S.energia = 100;
  S.kolejka = 8;
  const godzOff = Math.round(sekOff / 3600 * 10) / 10;
  modal(
    '<div class="eyebrow">Wróciłeś</div><h2>System pracował za ciebie</h2>' +
    '<table>' +
    '<tr><td>Nie było cię</td><td>' + (godzOff >= 1 ? godzOff.toLocaleString('pl-PL') + ' h' : Math.round(sekOff / 60) + ' min') + '</td></tr>' +
    '<tr><td>Grafik przewinął się o</td><td>' + Math.floor(tygodnie).toLocaleString('pl-PL') + ' tyg.</td></tr>' +
    '<tr><td><b>Wpłynęło (zastępstwo: 50% stawki)</b></td><td><b style="color:var(--kasa)">+' + fmt(zysk) + '</b></td></tr>' +
    '</table>' +
    '<p class="mala">Odespałeś (energia 100%). W poczekalni czeka pełna kolejka.</p>',
    'Do roboty');
  log('Powrót po ' + Math.floor(tygodnie) + ' tyg. System pracował za ciebie: +' + fmt(zysk), true);
}

/* ── start ── */
wczytaj();
budujSklepy();
renderPlansza();
renderGablote();
if (S.kliki > 0 || S.bloki.length > 0) {
  S.odslony = S.odslony || {};
  if (S.odslony.sklep || S.lifetime >= 100) $('sklepy').style.display = 'block';
  if (S.odslony.praca || S.lifetime >= 250) $('tabPraca').classList.remove('hide');
  if (S.tier >= 1) { renderKariere(); $('tabSystem').classList.remove('hide'); $('energiaStan').classList.add('on'); $('tydzienStan').classList.add('on'); }
  if (S.tier >= 2) $('negocjujBtn').classList.remove('hide');
  if (S.systemOtwarty) { const t = $('tabSystem'); t.disabled = false; t.innerHTML = iko('system') + ' System'; }
  if (S.odslony.majatek) $('tabMajatek').classList.remove('hide');
  if (S.bilokacja >= 1) $('dobaStan').classList.add('on');
  if (S.negocjacje > 0) $('negChip').classList.remove('hide');
  if (S.b2b) $('okoBtn').classList.remove('hide');
  if (S.rejestrDziala) { okoEl.classList.add('rejestr'); $('okoEtyk').textContent = 'rejestr — widzą wszyscy:'; }
  log('Wróciłeś. Grafik pracował za ciebie.');
  rozliczOffline();
} else {
  log('Dzień pierwszy. Masz dyplom, pieczątkę i pusty grafik.');
  $('dziennikBox').style.display = 'none';
}
render();

window.__gra = { S, T, TYPY, DECYZJE, ACHV, znajdzSloty, dodajBloki, hFizyczne, hRozliczane, renderPlansza, render, postep, decyzja, toast, achievement, rozliczOffline, finalRejestru, kosztBlokady };
</script>
</div>

</BaseLayout>
