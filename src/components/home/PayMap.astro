---
/**
 * Strona główna: mapa zarobków z monitoringu Watchdog — sama warstwa „Zarobki”, bez przełącznika.
 * Prowadzi do przeglądarki monitoringu, gdzie jest też tryb „Jawność” i tabela.
 */
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import PolandMap from '@/components/mapa/PolandMap.astro';
---
<Section id="mapa" space="bottom" aria-labelledby="mapa-title">
  <SectionHead eyebrow="Mapa · monitoring Watchdog" title="Ile płacą szpitale, które ujawniły listy płac" id="mapa-title" layout="row">
    <LinkArrow slot="action" href="/dane/monitoring-watchdog/#mapa">Przeglądarka monitoringu</LinkArrow>
  </SectionHead>
  <PolandMap set="monitoring" layers={['zarobki']} />
</Section>
