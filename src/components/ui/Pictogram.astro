---
/**
 * Piktogram z pól siatki (styl A): rysunek z lib/siatka/piktogramy.ts na środku ramki z wygaszonych plusów.
 * Kolory jak w ui/DotGrid (--dg-on, --dg-mid, --dg-off).
 */
import DotGrid from './DotGrid.astro';
import { PICTOGRAMS, type PictogramName } from '@/lib/siatka/piktogramy';

interface Props {
  name: PictogramName;
  /** ramka w polach; domyślnie 17×14 — wszystkie piktogramy w jednej skali */
  frame?: [cols: number, rows: number];
  label?: string;
  class?: string;
}

const { name, frame = [17, 14], label, class: className } = Astro.props;
---
<DotGrid mask={PICTOGRAMS[name]} frame={frame} label={label} class={className} />
