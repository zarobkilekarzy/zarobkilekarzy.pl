---
/**
 * Zwinięty fragment artykułu: materiał, do którego się sięga, a nie czyta — pełna tabela głosowań,
 * szczegóły przepisu poza głównym wywodem. Tytuł mówi, co jest w środku; `note` to krótka zapowiedź
 * (np. „7 głosowań”). Link do kotwicy w środku rozwija blok przed przewinięciem (scripts/open-target).
 * Główny wywód zostaje poza blokiem: czytelnik nie może potrzebować kliknięcia, żeby zrozumieć tekst.
 * `compact` — mały wariant w podpisie ilustracji (blocks/Figure zwija w nim długą listę źródeł).
 */
import type { HTMLAttributes } from 'astro/types';
import { typo } from '@/lib/format';

interface Props extends HTMLAttributes<'details'> {
  title: string;
  note?: string;
  /** mały wariant: bez odstępów i grubej linii, tytuł krojem linii źródła */
  compact?: boolean;
}

const { title, note, compact = false, class: className, ...rest } = Astro.props;
---
<details class:list={['fold', { 'fold--compact': compact }, className]} {...rest}>
  <summary class="fold__head">
    <span class="fold__title">{typo(title)}</span>
    {note && <span class="fold__note">{typo(note)}</span>}
  </summary>
  <div class="fold__body"><slot /></div>
</details>

<style>
  .fold { margin-block: 32px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line-2); }

  /* kilka bloków pod rząd (np. lista głosowań) układa się w jedną listę ze wspólnymi liniami */
  .fold + .fold { margin-top: -32px; border-top: 0; }

  .fold__head {
    display: flex; align-items: baseline; gap: 16px;
    padding: 14px 0; cursor: pointer; list-style: none;
  }
  .fold__head::-webkit-details-marker { display: none; }
  .fold__head::after { content: "+" / ""; margin-left: auto; font: 400 1.125rem/1 var(--f-mono); color: var(--blue); }
  .fold[open] .fold__head::after { content: "–" / ""; }

  .fold__title { font: 500 1rem/1.4 var(--f-display); letter-spacing: -0.01em; color: var(--ink); transition: color .2s; }
  .fold__head:hover .fold__title { color: var(--blue); }
  .fold__note { flex: none; font: 400 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }

  .fold__body { padding-bottom: 24px; }
  .fold__body > :global(:first-child) { margin-top: 8px; }
  .fold__body > :global(:last-child) { margin-bottom: 0; }

  /* wariant w podpisie ilustracji: wygląda jak linia źródła, z plusem po prawej */
  .fold--compact { margin-block: 0; border-top: 1px solid var(--line); border-bottom: 0; }
  .fold--compact .fold__head { gap: 10px; padding: 8px 0 2px; }
  .fold--compact .fold__head::after { font-size: 0.875rem; }
  .fold--compact .fold__title { font: 400 0.75rem/1.55 var(--f-mono); color: var(--muted); }
  .fold--compact .fold__note { letter-spacing: 0; text-transform: none; }
  .fold--compact .fold__body { display: grid; gap: 6px; padding-bottom: 0; }

  @media (max-width: 600px) {
    .fold:not(.fold--compact) .fold__note { display: none; }
  }
</style>
