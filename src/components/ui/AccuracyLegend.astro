---
/** Legenda etykiet dokładności: co znaczy „Dokładna” i „Szacunek” (napisy z src/i18n/ui.ts). */
import Flag from './Flag.astro';
import { uiOf } from '@/i18n/ui';

const t = uiOf(Astro.url).blocks.legend;
---
<ul class="legend" aria-label={t.label}>
  <li><Flag accuracy="exact" /> {t.exact}</li>
  <li><Flag accuracy="est" /> {t.est}</li>
</ul>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 24px; font-size: 0.84375rem; color: var(--text); }
  li { display: flex; align-items: center; gap: 8px; }
</style>
