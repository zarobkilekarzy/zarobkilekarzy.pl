---
/**
 * Nagłówek artykułu: okruszki, kategoria, tytuł, lead, metadane (data — z linkiem do historii zmian, podpis
 * „Redakcja” z linkiem do opisu pracy — rolę AI opisuje nota pod treścią, nie podpis obok przypisów —, czas czytania,
 * przypisy) i ramka „W skrócie”.
 * Z `aside` slot „aside” zajmuje miejsce ramki — dla materiałów, których hakiem jest narzędzie
 * (np. licznik długu w /dane/zadluzenie-szpitali/); obie kolumny są wtedy równe. Flaga zamiast
 * Astro.slots.has(): slot przekazany warunkowo kompilator rejestruje zawsze.
 */
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Num from '@/components/ui/Num.astro';
import { formatDateIn, isoDate, typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';
import { uiOf } from '@/i18n/ui';
import type { Crumb } from '@/lib/seo';

interface Props {
  title: string;
  summary: string;
  section: { label: string; href?: string };
  /** okruszki — te same trafiają do danych strukturalnych (ArticleLayout → seo.breadcrumbs) */
  crumbs: Crumb[];
  /** data najnowszego wpisu historii zmian (content.config → `updated`) */
  updated?: Date;
  published?: Date;
  /** artykuł ma „Historię zmian” — data aktualizacji prowadzi do niej */
  changelog?: boolean;
  minutes: number;
  /** liczba przypisów — lista „Przypisy” (#przypisy) na końcu treści */
  notesCount?: number;
  keyPoints?: string[];
  /** treść slotu „aside” zamiast ramki „W skrócie” */
  aside?: boolean;
}

const { title, summary, section, crumbs, updated, published, changelog = false, minutes, notesCount = 0, keyPoints = [], aside = false } = Astro.props;
const date = updated ?? published;
const t = uiOf(Astro.url).article;
const locale = localeOf(Astro.url.pathname);
---
<header class="ahead">
  <Breadcrumbs items={crumbs} />

  <div class:list={['ahead__grid', { 'ahead__grid--single': !keyPoints.length && !aside, 'ahead__grid--aside': aside }]}>
    <div>
      <Eyebrow>{section.label}</Eyebrow>
      <Heading as="h1" size="display" class="ahead__title">{typo(title)}</Heading>
      <p class="lead ahead__lead">{typo(summary)}</p>

      <dl class="ahead__meta">
        {date && (
          <div>
            <dt>{updated ? t.updated : t.published}</dt>
            <dd>
              {updated && changelog
                ? <a href={`#${t.changelogId}`}><time datetime={isoDate(date)}>{formatDateIn(date, locale)}</time></a>
                : <time datetime={isoDate(date)}>{formatDateIn(date, locale)}</time>}
            </dd>
          </div>
        )}
        <div><dt>{t.byline}</dt><dd><a href={t.bylineHref}>{t.bylineText}</a></dd></div>
        <div><dt>{t.readingTime}</dt><dd>{minutes} min</dd></div>
        {notesCount > 0 && <div><dt>{t.notes}</dt><dd><a href={`#${t.notesId}`}>{t.notesWithSources(notesCount)}</a></dd></div>}
      </dl>
    </div>

    {aside ? <slot name="aside" /> : keyPoints.length > 0 && (
      <aside class="ahead__points" aria-labelledby="w-skrocie">
        <p class="ahead__points-title" id="w-skrocie">{t.keyPoints}</p>
        <ol>
          {keyPoints.map((point, i) => (
            <li><Num n={i + 1} size="sm" /><p>{typo(point)}</p></li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</header>

<style>
  .ahead__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px clamp(40px, 6vw, 96px); align-items: end; margin-top: 40px; }
  .ahead__grid--single { grid-template-columns: minmax(0, 1fr); }
  .ahead__grid--aside { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px clamp(32px, 4vw, 64px); align-items: start; }
  /* Szerokość tytułu w em, nie w ch: „ch” (szerokość cyfry 0) jest inny w foncie docelowym i zastępczym, więc przy
     podmianie fontu tytuł zmieniał liczbę linii i spychał treść (CLS). 1ch w Inter Tight = 0.578em → 16ch = 9.25em. */
  .ahead__title { font-size: clamp(2.5rem, 4.8vw, 4.25rem); margin-bottom: 24px; max-width: 9.25em; }
  .ahead__lead { font-size: 1.1875rem; max-width: 40em; }

  .ahead__meta { display: flex; flex-wrap: wrap; gap: 0; margin-top: 32px; border-top: 1px solid var(--line); }
  .ahead__meta > div { padding: 14px 28px 0 0; }
  .ahead__meta > div + div { padding-left: 28px; border-left: 1px solid var(--line); }
  dt { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  dd { font: 400 1.0625rem/1.2 var(--f-display); letter-spacing: -0.01em; color: var(--ink); }
  dd a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }

  .ahead__points { position: relative; padding: 28px; background: var(--blue-fill); color: #fff; --num-color: #fff; --num-dot: rgba(255, 255, 255, .6); }
  .ahead__points::before { content: ""; position: absolute; top: -4px; left: -4px; width: 7px; height: 7px; background: var(--ink); }
  .ahead__points-title { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: rgba(255, 255, 255, .75); padding-bottom: 14px; border-bottom: 1px solid rgba(255, 255, 255, .3); }
  .ahead__points li { display: grid; grid-template-columns: 44px 1fr; gap: 8px; padding: 16px 0; border-bottom: 1px solid rgba(255, 255, 255, .2); }
  .ahead__points li:last-child { border-bottom: 0; padding-bottom: 0; }
  .ahead__points p { font-size: 0.9375rem; line-height: 1.55; color: rgba(255, 255, 255, .92); }

  @media (max-width: 1024px) {
    .ahead__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .ahead__lead { font-size: 1.0625rem; }
    /* Cztery pozycje nie mieszczą się w rzędzie — siatka 2×2 bez pionowych separatorów */
    .ahead__meta { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
    .ahead__meta > div, .ahead__meta > div + div { padding: 14px 0 0; border-left: 0; }
    .ahead__points { padding: 22px 20px; }
  }
</style>
