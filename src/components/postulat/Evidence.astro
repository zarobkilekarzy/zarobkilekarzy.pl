---
/** /postulat/ — dowody: cztery liczby ze źródłami; reszta w działach Dane i Analizy. */
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import StatRow from '@/components/blocks/StatRow.astro';
import { evidence } from '@/data/postulat';
---
<Section id="dowody" aria-labelledby="dowody-title">
  <SectionHead eyebrow="Dowody" title="Dlaczego to konieczne" id="dowody-title" layout="row">
    <LinkArrow slot="action" href="/dane/">Wszystkie dane</LinkArrow>
  </SectionHead>
  <StatRow items={evidence} label="Liczby uzasadniające postulat" />
</Section>
