---
/**
 * Droga publicznej złotówki w czterech przystankach z oceną jawności na każdym (statycznie, bez JS).
 * Cztery kolumny w szerokim kontenerze, lista pionowa w wąskim (container queries).
 * Skala 0–3 to ocena redakcji, a nie pomiar — mówi o tym podpis ramki.
 * Na stronach /en/ przystanki z src/data/en/sladem-zlotowki.ts i angielskie podpisy z T.
 */
import Figure from '@/components/blocks/Figure.astro';
import { STOPS as STOPS_PL } from '@/data/sladem-zlotowki';
import { typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';

const MAX = 3;
const en = localeOf(Astro.url.pathname) === 'en';
// moduł EN tylko na stronach /en/ — jego strażniki (brak tłumaczenia = błąd) nie mogą zatrzymać polskiego buildu
const { STOPS: STOPS_EN } = (localeOf(Astro.url.pathname) === 'en' ? await import('@/data/en/sladem-zlotowki') : {}) as typeof import('@/data/en/sladem-zlotowki');
const STOPS = en ? STOPS_EN : STOPS_PL;

const T = {
  pl: {
    title: 'Im dalej od składki, tym mniej widać: sumy są jawne na każdym przystanku, kwota dla jednej osoby — na żadnym.',
    note: 'Skala jawności to ocena redakcji: co da się sprawdzić w publicznych źródłach na danym etapie. Liczby i ich źródła podajemy w tekście przystanków.',
    label: 'Cztery przystanki publicznej złotówki',
    stop: 'Przystanek',
    level: (level: number) => `Jawność ${level} na ${MAX}`,
    visible: 'Widać',
    hidden: 'Nie widać',
  },
  en: {
    title: 'The further from the contribution, the less you can see: totals are public at every stop, the amount for one person — at none.',
    note: 'The transparency scale is the editors’ assessment: what can be checked in public sources at a given stage. Figures and their sources are given in the text on each stop.',
    label: 'Four stops of the public zloty',
    stop: 'Stop',
    level: (level: number) => `Transparency ${level} out of ${MAX}`,
    visible: 'Visible',
    hidden: 'Not visible',
  },
}[en ? 'en' : 'pl'];
---
<Figure
  title={T.title}
  note={T.note}
>
  <ol class="route" aria-label={T.label}>
    {STOPS.map((stop, i) => (
      <li class="route__stop" data-level={stop.level}>
        <p class="route__idx">{`${T.stop} ${i + 1}`}</p>
        <p class="route__name">{typo(stop.name)}</p>
        <p class="route__meter">
          <span class="route__dots" aria-hidden="true">
            {Array.from({ length: MAX }, (_, d) => <span class:list={['route__dot', { 'is-on': d < stop.level }]}></span>)}
          </span>
          <span class="route__level">
            <span class="sr-only">{T.level(stop.level)}: </span>{typo(stop.levelLabel)}
          </span>
        </p>
        <p class="route__what">{typo(stop.what)}</p>
        <dl class="route__facts">
          <dt>{T.visible}</dt>
          <dd>{typo(stop.visible)}</dd>
          <dt>{T.hidden}</dt>
          <dd>{typo(stop.hidden)}</dd>
        </dl>
      </li>
    ))}
  </ol>
</Figure>

<style>
  .route { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 24px; }
  .route__stop { position: relative; padding-top: 16px; border-top: 3px solid var(--blue); }
  .route__stop[data-level="1"] { border-top-color: var(--chart); }
  .route__stop[data-level="0"] { border-top: 3px dashed var(--line-2); }

  .route__idx { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .route__name { margin-top: 6px; font: 500 1.125rem/1.25 var(--f-display); letter-spacing: -0.015em; color: var(--ink); }

  .route__meter { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .route__dots { display: inline-flex; gap: 4px; }
  .route__dot { width: 10px; height: 10px; border: 1.5px solid var(--line-2); }
  .route__dot.is-on { background: var(--blue); border-color: var(--blue); }
  .route__level { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--blue); }
  .route__stop[data-level="1"] .route__level,
  .route__stop[data-level="0"] .route__level { color: var(--muted); }

  .route__what { margin-top: 12px; font-size: 0.9375rem; line-height: 1.55; color: var(--text-strong); }
  .route__facts { margin-top: 12px; display: grid; gap: 2px; font-size: 0.875rem; line-height: 1.5; color: var(--text); }
  .route__facts dt { margin-top: 8px; font: 500 0.65625rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .route__facts dt:first-child { margin-top: 0; }

  /* Wąski kontener (Figure ma container-type): przystanki jeden pod drugim, pasek jawności z lewej */
  @container (max-width: 820px) {
    .route { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .route__stop { padding: 0 0 0 18px; border-top: 0; border-left: 3px solid var(--blue); }
    .route__stop[data-level="1"] { border-left-color: var(--chart); }
    .route__stop[data-level="0"] { border-top: 0; border-left: 3px dashed var(--line-2); }
  }
</style>
