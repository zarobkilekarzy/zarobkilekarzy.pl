---
/**
 * Liczba z animacją odliczania (scripts/reveal.ts → data-count).
 * W HTML zawsze jest wartość końcowa — animacja to tylko ulepszenie.
 */
import { formatPL } from '@/lib/format';

interface Props {
  value: number;
  decimals?: number;
}
const { value, decimals = 0 } = Astro.props;
---
<span data-count={value} data-decimals={decimals || undefined}>{formatPL(value, decimals)}</span>
