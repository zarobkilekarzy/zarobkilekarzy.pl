---
/**
 * Strona 503 — noindex, bez grafu danych strukturalnych i bez wpisu w sitemapie.
 * Statyczna strona pod /503/ do podpięcia jako strona błędu 5xx po stronie Cloudflare; sama z siebie
 * nie zastępuje komunikatów brzegu (Worker obsługuje tylko /api/* i odpowiada JSON-em).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import ServerDownMonitor from '@/components/site/ServerDownMonitor.astro';
import type { SeoInput } from '@/lib/seo';

const seo: SeoInput = {
  title: 'Serwer chwilowo nie odpowiada',
  description: 'Strona chwilowo nie odpowiada. Odśwież ją za kilka minut.',
  index: false,
};
---
<BaseLayout seo={seo}>
  <Section class="err">
    <div class="err__grid">
      <div>
        <Eyebrow>Błąd 503 · Brak odczytu</Eyebrow>
        <Heading as="h1" size="display">Serwer nie daje oznak życia</Heading>
        <p class="lead err__lead">Monitor pokazuje płaską linię. Wygląda na to, że ktoś <strong>wyciągnął wtyczkę</strong>.</p>
        <p class="err__note">Strona chwilowo nie odpowiada. Odśwież ją za kilka minut.</p>
        <p class="err__links">
          <LinkArrow href="/">Strona główna</LinkArrow>
          <LinkArrow href="https://x.com/ZarobkiLekarzy">Nasz profil na X</LinkArrow>
        </p>
      </div>
      <ServerDownMonitor />
    </div>
  </Section>
</BaseLayout>

<style>
  .err__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 48px; align-items: center; }
  .err__lead { margin-top: 1.5rem; }
  .err__note { margin-top: 1rem; max-width: 42ch; color: var(--muted); }
  .err__links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; }
  @media (max-width: 720px) {
    .err__grid { grid-template-columns: 1fr; gap: 32px; }
    .err__grid > :global(svg) { order: -1; }
  }
</style>
