---
/**
 * „Na każde 100 zł w planie NFZ”: sto kropek i trzy źródła pieniędzy z opisami, wszystko widoczne od razu.
 * Najechanie na źródło albo dotknięcie go tylko wygasza pozostałe kropki. Bez JS wygląda tak samo.
 */
import { localeOf } from '@/i18n/locales';
import { linkAttrs } from '@/lib/links';
import { typo } from '@/lib/format';

const en = localeOf(Astro.url.pathname) === 'en';
const { planSplit, sources } = en ? await import('@/data/en/ile-placimy') : await import('@/data/ile-placimy');
const T = en
  ? { head: 'Per PLN 100 in the draft NFZ plan for 2026', share: (n: number) => `PLN ${n}`, sources: 'Sources:' }
  : { head: 'Na każde 100 zł w projekcie planu NFZ na 2026 r.', share: (n: number) => `${n} zł`, sources: 'Źródła:' };

const dots = planSplit.flatMap((p, g) => Array.from({ length: p.share }, () => g));
---
<zl-plan-split class="split">
  <p class="mono-label tool-head">{T.head}</p>
  <div class="split__dots" aria-hidden="true">
    {dots.map((g) => <span class="split__dot" data-g={g}></span>)}
  </div>
  <ul class="split__rows">
    {planSplit.map((p, i) => (
      <li class="split__row" data-pick={i}>
        <p class="split__head">
          <span class="split__key" data-g={i} aria-hidden="true"></span>
          <strong class="split__name">{p.label}</strong>
          <span class="split__share">{T.share(p.share)}</span>
        </p>
        <p class="split__text"><span class="split__amount">{p.amount}.</span> {typo(p.text)}</p>
      </li>
    ))}
  </ul>
  <p class="split__src">{T.sources} <a {...linkAttrs(sources.draft.href)}>{sources.draft.label}</a>, <a {...linkAttrs(sources.mz.href)}>{sources.mz.label}</a>, <a {...linkAttrs(sources.nik.href)}>{sources.nik.label}</a>.</p>
</zl-plan-split>

<script>
  class PlanSplit extends HTMLElement {
    connectedCallback() {
      const dots = this.querySelector<HTMLElement>('.split__dots')!;
      this.querySelectorAll<HTMLElement>('[data-pick]').forEach((row) => {
        row.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') dots.dataset.at = row.dataset.pick; });
        row.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') delete dots.dataset.at; });
        // dotyk: drugie dotknięcie tego samego źródła zdejmuje wyróżnienie
        row.addEventListener('click', () => {
          if (dots.dataset.at === row.dataset.pick && !matchMedia('(hover: hover)').matches) delete dots.dataset.at;
          else dots.dataset.at = row.dataset.pick;
        });
      });
    }
  }

  if (!customElements.get('zl-plan-split')) customElements.define('zl-plan-split', PlanSplit);
</script>

<style>
  .split { display: block; }

  .split__dots { display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: clamp(3px, .7vw, 8px); margin-top: 20px; }
  .split__dot { aspect-ratio: 1; border-radius: 50%; transition: opacity .2s; }
  .split__key[data-g="0"], .split__dot[data-g="0"] { background: var(--blue); }
  .split__key[data-g="1"], .split__dot[data-g="1"] { background: var(--chart); }
  .split__key[data-g="2"], .split__dot[data-g="2"] { background: var(--chart-soft); box-shadow: inset 0 0 0 1px var(--chart); }
  .split__dots[data-at="0"] .split__dot:not([data-g="0"]),
  .split__dots[data-at="1"] .split__dot:not([data-g="1"]),
  .split__dots[data-at="2"] .split__dot:not([data-g="2"]) { opacity: .28; }

  .split__rows { display: grid; margin-top: 20px; border-top: 1px solid var(--line-2); }
  .split__row { padding-block: 12px; border-bottom: 1px solid var(--line); }
  .split__head { display: flex; align-items: baseline; gap: 8px; }
  .split__key { flex: none; align-self: center; width: 10px; height: 10px; border-radius: 50%; }
  .split__name { font-weight: 600; color: var(--ink); transition: color .15s; }
  .split__row:hover .split__name { color: var(--blue-700); }
  .split__share { margin-left: auto; font: 400 1.375rem/1 var(--f-display); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }
  .split__text { margin-top: 4px; font-size: 0.9375rem; line-height: 1.55; color: var(--text); }
  .split__amount { color: var(--ink); font-weight: 500; }
  .split__src { margin-top: 10px; font-size: 0.8125rem; line-height: 1.5; color: var(--muted); }
  .split__src a { color: var(--blue-700); text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) { .split__dot { transition: none; } }
</style>
