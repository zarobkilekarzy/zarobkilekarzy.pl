---
/**
 * Spis treści z nagłówków h2 artykułu. Na szerokim ekranie przyklejony z boku,
 * podświetla bieżącą sekcję, a linia po lewej wypełnia się płynnie za przewijaniem;
 * na wąskim — rozwijany (<details>) nad treścią.
 */
import type { MarkdownHeading } from 'astro';
import { uiOf } from '@/i18n/ui';

interface Props {
  headings: MarkdownHeading[];
  title?: string;
}

const { headings, title = uiOf(Astro.url).article.toc } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---
{items.length > 0 && (
  <zl-toc class="toc">
    <details open>
      <summary class="toc__title">{title}</summary>
      <ol>
        {items.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
  </zl-toc>
)}

<script>
  // Podświetla w spisie sekcję, której nagłówek ostatnio minął górę ekranu,
  // i wypełnia linię postępu: wewnątrz pozycji spisu tak, jak przewinięta jest jej sekcja
  class ZlToc extends HTMLElement {
    connectedCallback() {
      const links = [...this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
      const targets = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((el): el is HTMLElement => Boolean(el));
      if (!targets.length) return;
      const list = this.querySelector('ol')!;
      const content = targets[targets.length - 1].parentElement!;

      const update = () => {
        const offset = window.innerHeight * 0.25;
        const tops = targets.map((el) => el.getBoundingClientRect().top);
        let current = 0;
        tops.forEach((top, i) => {
          if (top <= offset) current = i;
        });
        links.forEach((a, i) => a.toggleAttribute('aria-current', i === current));

        // Ostatnia sekcja kończy się z treścią, a gdy strona jest za krótka, by treść doszła do progu — z końcem strony
        const scrollLeft = document.documentElement.scrollHeight - window.innerHeight - window.scrollY;
        const end = tops[current + 1] ?? Math.min(content.getBoundingClientRect().bottom, offset + scrollLeft);
        const progress = Math.min(Math.max((offset - tops[current]) / (end - tops[current]), 0), 1);
        const from = links[current].offsetTop;
        const to = links[current + 1]?.offsetTop ?? list.offsetHeight;
        list.style.setProperty('--toc-fill', String((from + progress * (to - from)) / (list.offsetHeight || 1)));
      };

      let ticking = false;
      const schedule = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      update();

      // Na wąskim ekranie nagłówek zwija i rozwija spis (domyślnie zwinięty); na szerokim spis jest zawsze otwarty
      const details = this.querySelector('details')!;
      const summary = details.querySelector('summary')!;
      const narrow = window.matchMedia('(max-width: 1024px)');
      const syncLayout = () => {
        details.open = !narrow.matches;
        summary.tabIndex = narrow.matches ? 0 : -1;
      };
      summary.addEventListener('click', (event) => {
        if (!narrow.matches) event.preventDefault();
      });
      narrow.addEventListener('change', syncLayout);
      syncLayout();
    }
  }

  if (!customElements.get('zl-toc')) customElements.define('zl-toc', ZlToc);
</script>

<style>
  zl-toc { display: block; }
  .toc__title {
    list-style: none; cursor: default;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
    padding-bottom: 14px; border-bottom: 1px solid var(--ink);
  }
  .toc__title::-webkit-details-marker { display: none; }
  ol { position: relative; counter-reset: toc; }
  /* Linia postępu: szyna przez cały spis i wypełnienie skalowane z przewijania, bez transition — ma iść 1:1 ze scrollem */
  ol::before, ol::after { content: ""; position: absolute; left: -16px; top: 0; bottom: 0; width: 2px; background: var(--line); }
  ol::after { background: var(--blue); transform: scaleY(var(--toc-fill, 0)); transform-origin: top; }
  li { counter-increment: toc; border-bottom: 1px solid var(--line); }
  a {
    display: grid; grid-template-columns: 28px 1fr; gap: 4px;
    padding: 12px 0; font-size: 0.875rem; line-height: 1.4; color: var(--text);
    transition: color .2s;
  }
  a::before { content: counter(toc, decimal-leading-zero); font: 400 0.6875rem/1.9 var(--f-mono); color: var(--muted); }
  a:hover { color: var(--blue); }
  a[aria-current] { color: var(--ink); font-weight: 500; }
  a[aria-current]::before { color: var(--blue); }

  @media (max-width: 1024px) {
    .toc { border: 1px solid var(--line-2); padding: 14px 18px; }
    .toc__title { cursor: pointer; padding-bottom: 0; border-bottom: 0; display: flex; justify-content: space-between; }
    .toc__title::after { content: "+"; font-size: 1rem; color: var(--blue); }
    details[open] .toc__title::after { content: "–"; }
    details[open] .toc__title { padding-bottom: 12px; border-bottom: 1px solid var(--ink); }
    ol::before, ol::after { display: none; }
  }
</style>
