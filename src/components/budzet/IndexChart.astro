---
/**
 * Wykres liniowy indeksów (rok bazowy = 100) dla kilku serii o różnych jednostkach.
 * Linie rysuje SVG rozciągnięte na obszar wykresu (preserveAspectRatio="none" + non-scaling-stroke),
 * a wszystko, co jest tekstem albo kropką — siatka, lata, znaczniki pomiarów, podpisy na końcach linii —
 * to HTML, więc nie skaluje się razem z rysunkiem i zostaje czytelne na telefonie.
 *
 * Ton serii (README → Wykresy): `accent` — to, o czym jest teza (kobalt), `data` — dane bez
 * wyróżnienia (--chart), `ref` — linia odniesienia (przerywana, --muted). Punkt z `gapBefore`
 * łączy się z poprzednim kreską przerywaną (brak pomiaru pomiędzy).
 * Podpisy stoją na końcach linii zamiast legendy; `labelShift` -1 / 1 przesuwa podpis nad / pod
 * punkt, gdy dwie linie kończą się blisko siebie.
 * Bez `base` to zwykły wykres liniowy wartości (np. mld zł): linia 100 nie jest wtedy wyróżniona,
 * a `unit` stoi przy najwyższej wartości siatki (README → Wykresy).
 * `animate` — po przewinięciu do wykresu linie rysują się od lewej do prawej (odsłanianie obszaru
 * wykresu), a podpisy na końcach pojawiają się na końcu. Bez JS i przy prefers-reduced-motion
 * wykres jest od razu pełny.
 * Kropki pomiarów (`markers`) mają dymek z wartością: po najechaniu myszą albo po dotknięciu.
 * Dymek pokazuje okres (`label`, domyślnie rok), wartość (`tip`, domyślnie liczba z jednostką
 * albo indeks) i opis (`note`, domyślnie nazwa serii). To dodatek dla oka — czytnik ekranu
 * dostaje `caption`, dlatego kropki nie łapią fokusu.
 */
import type { HTMLAttributes } from 'astro/types';
import { formatPL, typo } from '@/lib/format';

interface Point {
  /** położenie na osi czasu: rok + ułamek */
  x: number;
  /** wartość: indeks albo kwota w jednostce wykresu */
  v: number;
  gapBefore?: boolean;
  /** okres w dymku, np. „IX/X 2025”; domyślnie rok */
  label?: string;
  /** wartość w dymku, np. „4,2 mies.”; domyślnie `v` z jednostką wykresu albo indeks */
  tip?: string;
  /** opis pod wartością w dymku; domyślnie nazwa serii */
  note?: string;
}

interface Series {
  id: string;
  label: string;
  tone: 'accent' | 'data' | 'ref';
  /** podpis wartości na końcu linii, np. „×3,1” */
  end: string;
  labelShift?: number;
  markers?: boolean;
  points: Point[];
}

interface Props extends HTMLAttributes<'div'> {
  xMin: number;
  xMax: number;
  yMin: number;
  yMax: number;
  ticks: number[];
  /** lata podpisane pod osią (podpis na środku roku) */
  years: number[];
  series: Series[];
  /** rok bazowy — podpis przy linii 100; bez niego wykres wartości bezwzględnych */
  base?: number;
  /** jednostka przy najwyższej wartości siatki, np. „mld zł” */
  unit?: string;
  /** pełny opis danych dla czytników ekranu */
  caption: string;
  /** rysowanie linii po przewinięciu do wykresu */
  animate?: boolean;
}

const { xMin, xMax, yMin, yMax, ticks, years, series, base, unit, caption, animate = false, class: className, ...rest } = Astro.props;

const top = Math.max(...ticks);
const isBase = (t: number) => base !== undefined && t === 100;
const tickLabel = (t: number) => (isBase(t) ? `100 = ${base}` : unit && t === top ? `${t} ${unit}` : String(t));

const X = (x: number) => ((x - xMin) / (xMax - xMin)) * 1000;
const Y = (v: number) => 1000 - ((v - yMin) / (yMax - yMin)) * 1000;
const pct = (x: number, lo: number, hi: number) => (((x - lo) / (hi - lo)) * 100).toFixed(3);

/** Dymek kropki: przy lewym brzegu wyrównany do kropki zamiast wyśrodkowany, przy górnym — pod kropką */
const tipValue = (p: Point) => p.tip ?? (base !== undefined ? `indeks ${formatPL(p.v)} (${base} = 100)` : `${formatPL(p.v, 1)}${unit ? `\u00A0${unit}` : ''}`);
const tipPlace = (p: Point) => ({
  'is-start': (p.x - xMin) / (xMax - xMin) < 0.2,
  'is-below': (p.v - yMin) / (yMax - yMin) > 0.75,
});

/** Ciągłe odcinki serii (przerwa przy `gapBefore`) i odcinki przerywane między nimi */
function paths(points: Point[]) {
  const runs: Point[][] = [];
  const gaps: [Point, Point][] = [];
  points.forEach((p, i) => {
    if (i > 0 && p.gapBefore) {
      gaps.push([points[i - 1], p]);
      runs.push([p]);
    } else if (runs.length) runs.at(-1)!.push(p);
    else runs.push([p]);
  });
  return {
    runs: runs.filter((r) => r.length > 1).map((r) => r.map((p) => `${X(p.x).toFixed(1)},${Y(p.v).toFixed(1)}`).join(' ')),
    gaps,
  };
}
---
<div class:list={['ix', className]} data-animate={animate || undefined} {...rest}>
  <div class="ix__plot" aria-hidden="true">
    {ticks.map((t) => (
      <span class:list={['ix__tick', { 'is-base': isBase(t) }]} style={`--t: ${pct(t, yMin, yMax)}%`}>
        <span>{tickLabel(t)}</span>
      </span>
    ))}
    <div class="ix__area">
      <svg class="ix__svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" focusable="false">
        {series.map((s) => {
          const { runs, gaps } = paths(s.points);
          return (
            <g class={`ix__line ix__line--${s.tone}`}>
              {runs.map((pts) => <polyline points={pts} vector-effect="non-scaling-stroke" />)}
              {gaps.map(([a, b]) => (
                <line class="ix__gap" x1={X(a.x)} y1={Y(a.v)} x2={X(b.x)} y2={Y(b.v)} vector-effect="non-scaling-stroke" />
              ))}
            </g>
          );
        })}
      </svg>
      {series.filter((s) => s.markers).map((s) =>
        s.points.map((p) => (
          <span class:list={['ix__dot', `ix__dot--${s.tone}`, tipPlace(p)]} style={`left: ${pct(p.x, xMin, xMax)}%; bottom: ${pct(p.v, yMin, yMax)}%`}>
            <span class="ix__tip">
              <span class="ix__tip-when">{p.label ?? Math.floor(p.x)}</span>
              <span class="ix__tip-val">{typo(tipValue(p))}</span>
              <span class="ix__tip-note">{typo(p.note ?? s.label)}</span>
            </span>
          </span>
        )),
      )}
      {series.map((s) => {
        const last = s.points.at(-1)!;
        return (
          <p class={`ix__end ix__end--${s.tone}`} style={`bottom: ${pct(last.v, yMin, yMax)}%; --shift: ${s.labelShift ?? 0}`}>
            <span class="ix__name">{typo(s.label)}</span>
            <span class="ix__val">{typo(s.end)}</span>
          </p>
        );
      })}
    </div>
  </div>
  <div class="ix__years" aria-hidden="true">
    {years.map((y) => <span style={`left: ${pct(y, xMin, xMax)}%; width: ${(100 / (xMax - xMin)).toFixed(3)}%`}>{y}</span>)}
  </div>
  <p class="sr-only">{caption}</p>
</div>

<script>
  // Wykres z `animate`: schowany dopiero, gdy skrypt działa (is-armed), rysowany po wejściu w widok
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.filter((e) => e.isIntersecting).forEach((e) => {
        e.target.classList.add('is-drawn');
        // po odsłonięciu obszar bez przycięcia — dymki kropek wychodzą poza wykres. Tylko przejście clip-path
        // samego obszaru (zdarzenia dymków bąbelkują w górę); przerwane przejście też kończy odsłanianie.
        const area = e.target.querySelector('.ix__area');
        const done = (ev: Event) => {
          if (ev.target === area && (ev as TransitionEvent).propertyName === 'clip-path') e.target.classList.add('is-done');
        };
        area?.addEventListener('transitionend', done);
        area?.addEventListener('transitioncancel', done);
        observer.unobserve(e.target);
      });
    }, { threshold: 0.5 });
    document.querySelectorAll<HTMLElement>('.ix[data-animate]').forEach((el) => {
      el.classList.add('is-armed');
      observer.observe(el);
    });
  }

  /** Dymek nie wychodzi poza wykres (wąski ekran): przesunięcie w poziomie przed pokazaniem */
  function fit(dot: Element) {
    const tip = dot.querySelector<HTMLElement>('.ix__tip');
    const box = dot.closest('.ix')?.getBoundingClientRect();
    if (!tip || !box) return;
    tip.style.removeProperty('--dx');
    const r = tip.getBoundingClientRect();
    const dx = Math.max(box.left - r.left, 0) + Math.min(box.right - r.right, 0);
    if (dx) tip.style.setProperty('--dx', `${Math.round(dx)}px`);
  }

  // Mysz: dymek pokazuje :hover w CSS. Dotyk: stuknięcie otwiera (i zamyka inne), stuknięcie obok zamyka.
  document.addEventListener('pointerover', (e) => {
    const dot = (e.target as Element).closest?.('.ix__dot');
    if (dot) fit(dot);
  });
  document.addEventListener('click', (e) => {
    const dot = (e.target as Element).closest?.('.ix__dot');
    document.querySelectorAll('.ix__dot.is-open').forEach((d) => d !== dot && d.classList.remove('is-open'));
    if (dot) fit(dot);
    dot?.classList.toggle('is-open');
  });
</script>

<style>
  .ix { --reserve: 128px; --h: clamp(240px, 52cqi, 360px); }
  .ix__plot { position: relative; height: var(--h); margin-top: 24px; }

  /* Siatka: linia przez obszar wykresu, podpis nad nią przy lewej krawędzi */
  .ix__tick { position: absolute; left: 0; right: var(--reserve); bottom: var(--t); border-top: 1px solid var(--line); }
  .ix__tick.is-base { border-top-color: var(--line-2); }
  /* podpis bazy po prawej: na lewym brzegu linie startują właśnie ze 100 */
  .ix__tick.is-base span { left: auto; right: 0; }
  .ix__tick span { position: absolute; left: 0; bottom: 4px; font: 400 0.65625rem/1 var(--f-mono); color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }

  .ix__area { position: absolute; inset: 0 var(--reserve) 0 0; }
  .ix__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ix__line polyline, .ix__line line { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .ix__line--data :is(polyline, line) { stroke: var(--chart); stroke-width: 2.5px; }
  .ix__line--ref :is(polyline, line) { stroke: var(--muted); stroke-width: 1.5px; stroke-dasharray: 5 4; }
  .ix__line--accent :is(polyline, line) { stroke: var(--blue); stroke-width: 2.5px; }
  .ix__line .ix__gap { stroke-width: 1.5px; stroke-dasharray: 2 5; }

  /* Pomiar — kropka z wycięciem w kolorze tła */
  .ix__dot { position: absolute; width: 9px; height: 9px; translate: -50% 50%; border-radius: 50%; border: 2px solid var(--under); }
  .ix__dot--accent { background: var(--blue); }
  .ix__dot--data { background: var(--chart); }
  .ix__dot--ref { background: var(--muted); }
  /* Większe pole trafienia niż sama kropka (palec, mysz) */
  .ix__dot::before { content: ""; position: absolute; inset: -9px; border-radius: 50%; }
  .ix__dot:is(:hover, .is-open) { z-index: 2; width: 12px; height: 12px; }

  /* Dymek z wartością: nad kropką, wyśrodkowany; is-start — od kropki w prawo, is-below — pod kropką;
     --dx — przesunięcie ze skryptu, gdy dymek wychodziłby poza wykres */
  .ix__tip {
    position: absolute; left: 50%; bottom: calc(100% + 8px); translate: calc(-50% + var(--dx, 0px)) 0;
    display: grid; gap: 3px; padding: 7px 10px 8px;
    /* jak dymek mapy i ui/Popover: w dzień jasny z ramką i cieniem, w nocy granat uniesiony nad tło */
    background: light-dark(var(--surface), var(--inverse-2));
    box-shadow:
      inset 0 0 0 1px light-dark(var(--line-2), transparent),
      0 20px 40px -16px light-dark(rgba(4, 11, 27, .18), rgba(4, 11, 27, .5)),
      0 2px 6px light-dark(rgba(4, 11, 27, .06), transparent);
    white-space: nowrap;
    opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .15s, visibility .15s;
  }
  .ix__dot.is-start .ix__tip { left: -6px; translate: var(--dx, 0px) 0; }
  .ix__dot.is-below .ix__tip { bottom: auto; top: calc(100% + 8px); }
  .ix__dot:is(:hover, .is-open) .ix__tip { opacity: 1; visibility: visible; }
  .ix__tip-when { font: 500 0.625rem/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .ix__tip-val { font: 400 1.0625rem/1.1 var(--f-display); letter-spacing: -0.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .ix__tip-note { font: 400 0.75rem/1.25 var(--f-body); color: var(--text); }

  /* Podpis na końcu linii, w marginesie po prawej: kreska w kolorze serii, nazwa, wartość */
  .ix__end {
    position: absolute; left: calc(100% + 12px); width: calc(var(--reserve) - 12px);
    translate: 0 calc(50% + var(--shift) * 50%);
    display: grid; gap: 2px; padding-left: 20px;
  }
  .ix__end::before { content: ""; position: absolute; left: 0; top: 0.5rem; width: 14px; border-top: 2.5px solid var(--chart); }
  .ix__end--accent::before { border-top-color: var(--blue); }
  .ix__end--ref::before { border-top: 1.5px dashed var(--muted); }
  .ix__name { font: 400 0.78125rem/1.25 var(--f-body); color: var(--text); }
  .ix__val { font: 400 1.125rem/1.1 var(--f-display); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; }

  /* Lata: podpis na środku roku, kreska na granicy */
  .ix__years { position: relative; height: 24px; margin-right: var(--reserve); }
  .ix__years span {
    position: absolute; top: 0; height: 100%; display: flex; justify-content: center; align-items: flex-end;
    font: 400 0.6875rem/1 var(--f-mono); color: var(--muted);
  }
  .ix__years span::before { content: ""; position: absolute; top: 0; left: 0; width: 1px; height: 6px; background: var(--line-2); }

  /* Rysowanie: obszar wykresu odsłania się od lewej (linie, kropki), margines z podpisami na końcu.
     Ujemne wcięcia, żeby kropki i grube linie na brzegach nie były przycięte. */
  .ix.is-armed .ix__area { clip-path: inset(-12px 100% -12px -12px); }
  .ix.is-armed .ix__end { opacity: 0; }
  .ix.is-drawn .ix__area { clip-path: inset(-12px calc(-1 * var(--reserve)) -12px -12px); transition: clip-path 1.8s cubic-bezier(0.45, 0, 0.55, 1); }
  .ix.is-drawn .ix__end { opacity: 1; transition: opacity 0.4s 1.5s; }
  .ix.is-done .ix__area { clip-path: none; }

  @container (max-width: 560px) {
    .ix { --reserve: 104px; }
    .ix__name { font-size: 0.71875rem; }
    .ix__val { font-size: 1rem; }
    .ix__years span { font-size: 0.625rem; }
    /* co drugi rok bez podpisu (kreska granicy zostaje) */
    .ix__years span:nth-child(even) { color: transparent; }
  }
</style>
