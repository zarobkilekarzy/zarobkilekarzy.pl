---
/**
 * Wartość punktu NHI: wzór (budżet ÷ zgłoszone punkty) i przykładowe wartości na jednej skali.
 * Kropka to pojedyncza wartość, odcinek — przedział (np. średnie roczne z kilku lat).
 * Na stronach /en/ podpisy z src/data/en/tajwan.ts, liczby w zapisie angielskim.
 */
import Figure from '@/components/blocks/Figure.astro';
import { LINKS, POINT_VALUES, type PointValue } from '@/data/tajwan';
import { formatNumber, typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';

const locale = localeOf(Astro.url.pathname);
// moduł EN tylko na stronach /en/ — jego strażniki (brak tłumaczenia = błąd) nie mogą zatrzymać polskiego buildu
const { POINT_VALUES: POINT_VALUES_EN } = (localeOf(Astro.url.pathname) === 'en' ? await import('@/data/en/tajwan') : {}) as typeof import('@/data/en/tajwan');
const rows: PointValue[] = locale === 'en' ? POINT_VALUES_EN : POINT_VALUES;
const T = {
  pl: {
    title: 'Punkt z cennika nie ma stałej ceny. Ile jest wart, wychodzi dopiero po rozliczeniu kwartału.',
    note: 'Wartości pływających punktów usług ogólnych. Punkty o stałej wartości (leki, zabiegi operacyjne, część świadczeń ratunkowych) płaci się 1:1.',
    source: 'MOHW/NHIA, zestawienia wartości punktu 2019–2025',
    formula: 'Wartość punktu równa się budżet sektora w regionie podzielony przez sumę punktów zgłoszonych przez wszystkie placówki',
    result: 'wartość punktu',
    budget: 'budżet sektora w regionie',
    points: 'punkty zgłoszone przez wszystkie placówki',
  },
  en: {
    title: 'A point in the fee schedule has no fixed price. What it is worth becomes clear only after the quarter is settled.',
    note: 'Values of floating points for general services. Points with a fixed value (medicines, surgical procedures, some emergency services) are paid 1:1.',
    source: 'MOHW/NHIA, point value tables 2019–2025',
    formula: 'Point value equals the sector budget in the region divided by the sum of points claimed by all facilities',
    result: 'point value',
    budget: 'sector budget in the region',
    points: 'points claimed by all facilities',
  },
}[locale];

// Skala od 0,6 do 1 TWD — tu mieszczą się wszystkie opisane wartości
const MIN = 0.6;
const MAX = 1;
const TICKS = [0.6, 0.7, 0.8, 0.9, 1];
const pos = (v: number) => `${((v - MIN) / (MAX - MIN)) * 100}%`;
// Przedział — jak w tekście (0,95–0,98), pojedyncza wartość — jak w rozliczeniu (0,813)
const fmt = (v: number, decimals: number) => formatNumber(v, v === 1 ? 2 : decimals, locale);
---
<Figure
  title={T.title}
  note={T.note}
  source={{ label: T.source, href: LINKS.pointValues }}
>
  <p class="pv__formula" aria-label={T.formula}>
    <span class="pv__term pv__term--result">{T.result}</span>
    <span class="pv__op" aria-hidden="true">=</span>
    <span class="pv__term">{T.budget}</span>
    <span class="pv__op" aria-hidden="true">÷</span>
    <span class="pv__term">{T.points}</span>
  </p>

  <ul class="pv__rows">
    {rows.map((p) => {
      const [from, to] = Array.isArray(p.value) ? p.value : [p.value, p.value];
      const range = from !== to;
      return (
        <li class:list={['pv__row', { 'pv__row--nominal': from === 1 }]}>
          <span class="pv__label">{typo(p.label)}<em>{typo(p.detail)}</em></span>
          <span class="pv__track" aria-hidden="true">
            <span class="pv__mark" style={`--from: ${pos(from)}; --to: ${pos(to)}`}></span>
          </span>
          <span class="pv__value">{range ? `${fmt(from, 2)}–${fmt(to, 2)}` : fmt(from, 3)}<small> TWD</small></span>
        </li>
      );
    })}
  </ul>
  <div class="pv__axis" aria-hidden="true">
    {TICKS.map((t) => <span style={`--at: ${pos(t)}`}>{formatNumber(t, 1, locale)}</span>)}
  </div>
</Figure>

<style>
  .pv__formula {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px;
    padding: 16px 18px; margin-bottom: 8px; background: var(--bg-soft);
    font: 400 0.875rem/1.35 var(--f-body); color: var(--ink);
  }
  .pv__term { padding: 6px 10px; background: var(--surface); border: 1px solid var(--line-2); }
  .pv__term--result { background: var(--blue-fill); border-color: var(--blue-fill); color: #fff; }
  .pv__op { font-size: 1.125rem; color: var(--muted); }

  /* kolumna wartości w rem — rośnie z „Większym tekstem” razem z liczbą */
  .pv__rows, .pv__axis { --label-w: 220px; --value-w: 6rem; --gap: 16px; }
  .pv__row {
    display: grid; grid-template-columns: var(--label-w) 1fr var(--value-w); align-items: center; gap: var(--gap);
    padding: 12px 0; border-bottom: 1px solid var(--line);
  }
  .pv__label { font-size: 0.90625rem; line-height: 1.3; color: var(--ink); }
  .pv__label em { display: block; margin-top: 2px; font: 400 0.71875rem/1.3 var(--f-mono); font-style: normal; color: var(--muted); }

  /* Tor ze skalą w tle: pionowe kreski co 0,1 TWD */
  .pv__track {
    position: relative; height: 24px;
    background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 25%) 0 0 / calc(100% + 1px) 100%;
  }
  .pv__mark {
    position: absolute; top: 50%; left: var(--from); width: calc(var(--to) - var(--from) + 12px);
    height: 12px; transform: translate(-6px, -50%);
    background: var(--blue); border-radius: 6px;
  }
  .pv__row--nominal .pv__mark { background: var(--surface); box-shadow: inset 0 0 0 2px var(--ink); }

  .pv__value { font: 400 1.25rem/1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pv__value small { font: 400 0.75rem/1 var(--f-body); letter-spacing: 0; color: var(--muted); }

  .pv__axis { position: relative; height: 22px; margin-inline: calc(var(--label-w) + var(--gap)) calc(var(--value-w) + var(--gap)); }
  .pv__axis span { position: absolute; top: 8px; left: var(--at); transform: translateX(-50%); font: 400 0.6875rem/1 var(--f-mono); color: var(--muted); }
  /* skrajne wartości nie wychodzą poza kolumnę */
  .pv__axis span:first-child { transform: none; }
  .pv__axis span:last-child { transform: translateX(-100%); }

  @container (max-width: 560px) {
    .pv__rows, .pv__axis { --label-w: 1fr; --value-w: auto; }
    .pv__row { grid-template-columns: 1fr auto; gap: 8px 12px; }
    .pv__track { grid-column: 1 / -1; grid-row: 2; }
    .pv__axis { margin-inline: 0; }
    .pv__value { font-size: 1.0625rem; }
  }
</style>
