---
/**
 * /prawa-pacjenta/ — prawa pacjenta ułożone według sytuacji, w jakiej jest czytelnik:
 * „jestem u lekarza”, „potrzebuję dokumentacji”, „coś poszło nie tak”, „szkoda w szpitalu”.
 * Treść: src/data/prawa-pacjenta.ts (wspólna z kartą do druku i PDF). Komponenty: components/pacjent.
 * Treść w rem — rośnie z przełącznikiem „Większy tekst” i z ustawieniem czcionki w przeglądarce.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Aside from '@/components/blocks/Aside.astro';
import SourceList from '@/components/article/SourceList.astro';
import Changelog from '@/components/article/Changelog.astro';
import ShareLinks from '@/components/article/ShareLinks.astro';
import Icon from '@/components/ui/Icon.astro';
import HelpCard from '@/components/pacjent/HelpCard.astro';
import EntryCards from '@/components/pacjent/EntryCards.astro';
import TextSize from '@/components/pacjent/TextSize.astro';
import Intro from '@/components/pacjent/Intro.astro';
import RightsGroup from '@/components/pacjent/RightsGroup.astro';
import FirstSteps from '@/components/pacjent/FirstSteps.astro';
import RouteFinder from '@/components/pacjent/RouteFinder.astro';
import Deadlines from '@/components/pacjent/Deadlines.astro';
import FundCompare from '@/components/pacjent/FundCompare.astro';
import PrintPromo from '@/components/pacjent/PrintPromo.astro';
import CallBar from '@/components/pacjent/CallBar.astro';
import SorLive from '@/components/sor/SorLive.astro';
import {
  ACT, courtMyth, deadlines, editorial, emergency, entries, firstSteps, fund, helpline, legalBasis,
  page, rightsGroups, routes, routesNote, sources,
} from '@/data/prawa-pacjenta';
import type { Crumb, SeoInput } from '@/lib/seo';
import { articleHref, getAllArticles, getArticle } from '@/lib/content';
import { formatDate, isoDate, typo } from '@/lib/format';
import { inline, plain, type Resolve } from '@/lib/inline';
import { PDF_FILES, pdfMeta } from '@/lib/pacjent/downloads';

// Linki „ref:<id>” w treści prowadzą tam, gdzie wskazuje articleHref (zapowiedź = sam tekst)
const hrefs = new Map((await getAllArticles()).map((a) => [a.id, articleHref(a)]));
const resolve: Resolve = (href) => {
  if (!href.startsWith('ref:')) return href;
  const id = href.slice(4);
  if (!hrefs.has(id)) throw new Error(`prawa-pacjenta: brak artykułu „${id}” (link ref:${id})`);
  return hrefs.get(id);
};

const act = { name: ACT.name, url: ACT.url };
const [rightsNow, rightsDocs] = rightsGroups;
const url = new URL(Astro.url.pathname, Astro.site).href;

const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: page.title }];
// Pytania i odpowiedzi jako strona FAQ (schema.org/FAQPage) — graf buduje lib/seo
const entry = await getArticle('prawa-pacjenta');
const seo: SeoInput = {
  title: page.seoTitle,
  social: { title: page.docTitle },
  description: page.description,
  breadcrumbs: crumbs,
  // aktualizacja = najnowszy wpis historii zmian (prawa-pacjenta.md); „Sprawdzone ze źródłami” = lastReviewed
  dates: { modified: entry.data.updated, reviewed: page.checked },
  page: {
    type: 'FAQPage',
    questions: rightsGroups.flatMap((g) => g.items).map((item) => ({
      question: item.q,
      answer: plain([`${item.verdict}. ${item.short}`, ...item.more, `Podstawa: ${item.basis} ustawy o prawach pacjenta.`].join(' ')),
    })),
  },
};
---
<BaseLayout seo={seo}>
  <div class="pp">
    <Section space="bottom" class="pp-top">
      <PageHeader title={page.title} lead={page.lead} eyebrow="Dla pacjenta" crumbs={crumbs}>
        <div class="pp-tools">
          <TextSize />
          <a class="pp-tool" href="#druk"><Icon name="print" size={20} /><span>Karta do druku</span></a>
          <p class="pp-checked">Sprawdzone ze źródłami <time datetime={isoDate(page.checked)}>{formatDate(page.checked)}</time></p>
        </div>
        <HelpCard slot="aside" helpline={helpline} emergency={emergency} />
      </PageHeader>

      <EntryCards class="pp-entries" title="W jakiej jesteś sytuacji?" items={entries} />
      <SorLive variant="pas" class="pp-sor" />
    </Section>

    <Section id="teraz" aria-labelledby="teraz-title" class="pp-sec">
      <RightsGroup group={rightsNow} act={act} resolve={resolve} />
    </Section>

    <Section id="dokumenty" tone="soft" aria-labelledby="dokumenty-title" class="pp-sec">
      <RightsGroup group={rightsDocs} act={act} resolve={resolve} />
    </Section>

    <Section id="co-sie-stalo" aria-labelledby="co-sie-stalo-title" class="pp-sec">
      <Intro
        eyebrow="Gdy coś poszło nie tak"
        title="Co się stało?"
        punct=""
        id="co-sie-stalo-title"
        lead="Wybierz sytuację, która pasuje — zobaczysz, dokąd z nią iść, jak to zrobić, ile masz czasu i czy to coś kosztuje. Instytucje nie przekazują sobie spraw, więc właściwy adres to połowa sukcesu."
      />
      <FirstSteps class="pp-steps" title="Zanim cokolwiek zgłosisz" steps={firstSteps} resolve={resolve} />
      <div class="pp-routes">
        <RouteFinder routes={routes} resolve={resolve} />
        <p class="pp-routes__note"><Icon name="info" size={20} /><span>{typo(routesNote)}</span></p>
      </div>
    </Section>

    <Section id="terminy" tone="soft" aria-labelledby="terminy-title" class="pp-sec">
      <div class="pp-split">
        <Intro
          eyebrow="Pilnuj terminów"
          title="Ile masz czasu"
          id="terminy-title"
          lead="Najczęściej sprawa przepada nie dlatego, że pacjent nie miał racji, tylko dlatego, że minął termin. Tu są wszystkie na jednej liście — od najkrótszego."
        />
        <div>
          <Deadlines items={deadlines} />
          <Aside variant="info" title="Mit: „po 10 latach i tak się przedawniło”" class="pp-myth">
            <p>{typo(courtMyth)}</p>
          </Aside>
        </div>
      </div>
    </Section>

    <Section id="fundusz" aria-labelledby="fundusz-title" class="pp-sec">
      <Intro eyebrow="Szkoda w szpitalu" title="Fundusz czy sąd?" punct="" id="fundusz-title" lead={fund.lead} class="pp-fund-intro" />
      <FundCompare
        compare={fund.compare}
        heads={['Fundusz Kompensacyjny', 'Sąd cywilny']}
        catchBox={fund.catch}
        conditions={fund.conditions}
        how={fund.how}
        notes={fund.notes}
        amountsNote={fund.amountsNote}
      />
    </Section>

    <Section id="druk" tone="soft" aria-labelledby="druk-title" class="pp-sec">
      <PrintPromo
        title="Karta kieszonkowa"
        text="Najważniejsze prawa, terminy i numery na jednej karcie — do torebki, do teczki z dokumentacją albo dla rodzica. Drukujesz na zwykłej kartce A4, przecinasz i składasz. Można ją rozdawać bez pytania o zgodę."
        phone={helpline.phone.display}
        actions={[
          { label: 'Pobierz kartę', meta: `${await pdfMeta('card')} · 2 karty na A4`, href: PDF_FILES.card.href, download: PDF_FILES.card.download, icon: 'doc' },
          { label: 'Duży druk', meta: `${await pdfMeta('large')} · 2 strony, tekst 14 pt`, href: PDF_FILES.large.href, download: PDF_FILES.large.download, icon: 'text-size' },
          { label: 'Jak wydrukować i złożyć', meta: 'instrukcja i podgląd karty', href: '/prawa-pacjenta/druk/', icon: 'print' },
        ]}
      />
    </Section>

    <Section aria-labelledby="zrodla-title" class="pp-sec">
      <div class="pp-end">
        <div class="pp-basis">
          <h2 class="pp-basis__title" id="zrodla-title">Skąd to wiemy</h2>
          <p class="pp-disclaimer"><strong>To nie jest porada prawna.</strong> {typo(page.disclaimer.replace(/^To nie jest porada prawna\.\s*/, ''))}</p>
          <ul class="pp-basis__list">
            {legalBasis.map((p) => <li set:html={inline(p, resolve)} />)}
          </ul>
          <SourceList sources={sources} />
          {entry.data.changelog && <Changelog entries={entry.data.changelog} class="page-log" />}
        </div>
        <Aside variant="editorial" title="Dlaczego serwis o jawności pisze o prawach pacjenta">
          {editorial.map((p) => <p set:html={inline(p, resolve)} />)}
        </Aside>
      </div>
      <div class="pp-share">
        <ShareLinks url={url} title={page.docTitle} label="Ktoś, kogo znasz, może tego potrzebować" />
      </div>
    </Section>
  </div>

  <CallBar phone={helpline.phone} label="Infolinia" />
</BaseLayout>

<script>
  // Kotwica do odpowiedzi lub sytuacji otwiera ją (także przy wejściu z linku od kogoś)
  const openTarget = (hash: string) => {
    if (!hash || hash.length < 2) return;
    const el = document.getElementById(decodeURIComponent(hash.slice(1)));
    if (!el) return;
    const details = el instanceof HTMLDetailsElement ? el : el.querySelector('details');
    if (details) details.open = true;
  };
  openTarget(location.hash);
  window.addEventListener('hashchange', () => openTarget(location.hash));
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (link && !link.hasAttribute('data-share')) openTarget(link.hash);
  });

  // „Wyślij tę odpowiedź”: arkusz udostępniania na telefonie, w innym razie kopia linku
  document.addEventListener('click', async (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-share]');
    if (!link) return;
    e.preventDefault();
    const href = new URL(link.hash, location.href).href;
    history.replaceState(null, '', link.hash);
    const label = link.querySelector('[data-share-label]');
    const original = label?.textContent;
    const flash = (text: string) => {
      if (!label) return;
      label.textContent = text;
      setTimeout(() => { label.textContent = original ?? ''; }, 2200);
    };
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try { await navigator.share({ title: link.dataset.share, url: href }); } catch { /* anulowane */ }
      return;
    }
    try {
      await navigator.clipboard.writeText(href);
      flash('Link skopiowany — wklej go w wiadomości');
    } catch {
      flash('Skopiuj adres z paska przeglądarki');
    }
  });

  // Wydruk strony: wszystkie odpowiedzi rozwinięte, po wydruku stan jak przed nim
  let opened: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    opened = [...document.querySelectorAll<HTMLDetailsElement>('.pp details:not([open])')];
    opened.forEach((d) => { d.open = true; });
  });
  window.addEventListener('afterprint', () => {
    opened.forEach((d) => { d.open = false; });
    opened = [];
  });
</script>

<style>
  /* historia zmian pod źródłami (wpisy: frontmatter prawa-pacjenta.md) */
  :global(.page-log) { margin-top: 40px; }
  .pp-top { padding-top: clamp(32px, 4vw, 56px); }
  .pp :global(.pp-sec) { scroll-margin-top: var(--header-h); }

  .pp-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem 0.75rem; margin-top: 1.75rem; }
  .pp-tool {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 1rem;
    border: 1px solid var(--line-2); background: var(--surface);
    font: 500 0.9375rem/1 var(--f-body); color: var(--ink);
    transition: border-color .2s;
  }
  .pp-tool:hover { border-color: var(--ink); }
  .pp-checked { font: 400 0.8125rem/1.4 var(--f-mono); color: var(--text); margin-left: 0.25rem; }

  .pp :global(.pp-entries) { margin-top: clamp(48px, 6vw, 80px); }
  .pp :global(.pp-sor) { margin-top: clamp(32px, 4vw, 48px); }

  .pp :global(.pp-steps) { margin-top: clamp(2rem, 4vw, 3rem); }
  .pp-routes { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .pp-routes__note {
    display: flex; gap: 0.75rem; margin-top: 1.5rem; max-width: 52em;
    font-size: 0.9375rem; line-height: 1.6; color: var(--ink-2);
  }
  .pp-routes__note :global(svg) { color: var(--blue); flex: none; margin-top: 0.125rem; }

  .pp-split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: 2rem clamp(40px, 6vw, 96px); align-items: start; }
  .pp :global(.pp-myth) { margin-top: 2rem; }
  .pp :global(.pp-fund-intro) { margin-bottom: clamp(2rem, 4vw, 3rem); }

  .pp-end { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2.5rem clamp(40px, 6vw, 96px); align-items: start; }
  /* minmax(0, …): jednowierszowy podgląd źródeł nie może rozpychać kolumny */
  .pp-basis { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .pp-basis__title { font: 400 clamp(1.75rem, 2.6vw, 2.25rem)/1.1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); }
  .pp-disclaimer { padding: 1rem 1.25rem; background: var(--bg-soft); border-left: 2px solid var(--ink); font-size: 1rem; line-height: 1.6; color: var(--ink-2); }
  .pp-disclaimer strong { color: var(--ink); }
  .pp-basis__list { display: grid; gap: 0.75rem; }
  .pp-basis__list li { position: relative; padding-left: 1.125rem; font-size: 0.9375rem; line-height: 1.6; color: var(--text); }
  .pp-basis__list li::before { content: "§"; position: absolute; left: 0; color: var(--blue); }
  .pp-basis__list :global(a) { color: var(--blue-700); text-decoration: underline; text-underline-offset: 3px; }
  .pp-share { margin-top: clamp(40px, 5vw, 64px); padding-top: 1.5rem; border-top: 1px solid var(--line-2); }

  @media (max-width: 1024px) {
    .pp-split, .pp-end { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .pp-checked { flex-basis: 100%; margin-left: 0; }
    .pp-tools > :global(*:not(.pp-checked)) { flex: 1 1 0; justify-content: center; }
    /* miejsce na przycisk infolinii przy dolnej krawędzi */
    .pp { padding-bottom: 4rem; }
  }

  /* Wydruk całej strony: sama treść, bez nawigacji i elementów interaktywnych */
  @media print {
    :global(.topbar), :global(header.header), :global(footer.footer), :global(.skip-link),
    .pp-tools, .pp :global(.pp-entries), .pp :global(.pp-sor), .pp-share, .pp :global(.qa__share),
    .pp :global(#druk), .pp :global(.route__toggle), .pp :global(.qa__toggle) { display: none !important; }
    .pp :global(.section) { padding-block: 16px !important; background: none !important; border: 0 !important; }
    .pp :global(.rights__intro) { position: static !important; }
    .pp :global(.qa), .pp :global(.route), .pp :global(.dl) { break-inside: avoid; }
    .pp :global(a[href^="http"])::after { content: " (" attr(href) ")"; font-size: 0.75em; color: var(--text); word-break: break-all; }
  }
</style>
