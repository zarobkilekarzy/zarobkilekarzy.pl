---
/**
 * Rachunek „od miejsca na studiach do prawa wykonywania zawodu” krok po kroku — jak w księdze:
 * liczba startowa, kroki ze znakiem (wcięte), sumy pośrednie pod kreską, wynik w kobalcie.
 * Zostaje tabelą także na wąskim ekranie (dwie kolumny mieszczą się w 320 px).
 * Statycznie, bez JS. Dane i arytmetyka: data/odsiew-na-medycynie.ts (LEDGER).
 * Dwujęzyczny: na stronach /en/ napisy z T.en i kroki z data/en/odsiew-na-medycynie.ts (LEDGER_EN);
 * wyjście polskie bez zmian.
 */
import Figure from '@/components/blocks/Figure.astro';
import { LEDGER, LEDGER_TOTALS, LINKS } from '@/data/odsiew-na-medycynie';
import { formatNumber, typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';

const locale = localeOf(Astro.url.pathname);
// moduł EN tylko na stronach /en/ — jego strażniki (brak tłumaczenia = błąd) nie mogą zatrzymać polskiego buildu
const { LEDGER_EN } = (localeOf(Astro.url.pathname) === 'en' ? await import('@/data/en/odsiew-na-medycynie') : {}) as typeof import('@/data/en/odsiew-na-medycynie');
const ledger = locale === 'en' ? LEDGER_EN : LEDGER;
const isTotal = (kind?: string) => kind === 'subtotal' || kind === 'result';
// border-collapse rysuje jedną linię między wierszami — kreskę nad sumą daje dolna krawędź wiersza nad nią
const rows = ledger.map((row, i) => ({ ...row, beforeTotal: isTotal(ledger[i + 1]?.kind) }));
const { limit, pwz, reached } = LEDGER_TOTALS;

const T = {
  pl: {
    title: (() => {
      const thousands = (n: number) => `${formatNumber(n / 1000, 1, 'pl')} tys.`;
      return `Z ${thousands(limit)} miejsc na studiach do prawa wykonywania zawodu dochodzi ${thousands(pwz)} lekarzy — ok. ${formatNumber(reached, 0, 'pl')}%`;
    })(),
    note: 'Przyjęci w latach 2015–2019 to w przybliżeniu lekarze, którzy w 2026 r. mają 26–30 lat (izba liczy wiek rocznikami, start studiów w wieku 19 lat). To dopasowanie roczników, a nie śledzenie tych samych osób. Limity: suma pięciu rozporządzeń MZ; Polacy na I semestrze i absolwenci: POL-on; lekarze z PWZ: zestawienie NIL według wieku, stan na 30.06.2026.',
    source: 'MZ BASiW (POL-on), rozporządzenia MZ o limitach przyjęć, NIL; obliczenia własne',
    step: 'Krok rachunku',
    number: 'Liczba',
  },
  en: {
    title: (() => {
      const thousands = (n: number) => `${formatNumber(n / 1000, 1, 'en')} thousand`;
      return `Of ${thousands(limit)} places at medical school, ${thousands(pwz)} doctors reach a licence to practise — about ${formatNumber(reached, 0, 'en')}%`;
    })(),
    note: 'Those admitted in 2015–2019 are roughly the doctors aged 26–30 in 2026 (the chamber counts age by year of birth; studies start at 19). This matches cohorts; it does not follow the same people. Limits: sum of five regulations of the Minister of Health; Poles in the first semester and graduates: POL-on; doctors with a licence to practise: NIL breakdown by age, as of 30.06.2026.',
    source: 'Ministry of Health BASiW (POL-on), Ministry of Health regulations on admission limits, NIL; our calculations',
    step: 'Step of the calculation',
    number: 'Number',
  },
}[locale];
---
<Figure
  title={T.title}
  note={T.note}
  source={{ label: T.source, href: LINKS.mz }}
>
  <table class="ledger">
    <thead>
      <tr><th scope="col">{T.step}</th><th scope="col">{T.number}</th></tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class:list={[`ledger__${row.kind}`, { 'ledger__before-total': row.beforeTotal }]}>
          <th scope="row">{typo(row.label)}{row.note && <span>{typo(row.note)}</span>}</th>
          <td>{row.value}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Figure>

<style>
  .ledger { width: 100%; border-collapse: collapse; }
  /* .ledger przed selektorem — tabela stoi w Prose, która stylizuje th/td potomków */
  .ledger thead th {
    padding: 0 0 10px; text-align: left; vertical-align: bottom;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
    border-bottom: 1px solid var(--ink);
  }
  .ledger thead th:last-child { text-align: right; }

  .ledger tbody th, .ledger tbody td {
    padding: 12px 0; vertical-align: baseline; border-bottom: 1px solid var(--line); color: var(--text-strong);
  }
  .ledger tbody th {
    padding-right: 16px; text-align: left; text-transform: none; letter-spacing: 0;
    font: 400 0.9375rem/1.45 var(--f-body);
  }
  .ledger tbody th span { display: block; margin-top: 2px; font: 400 0.8125rem/1.4 var(--f-body); color: var(--muted); }
  .ledger tbody td {
    text-align: right; white-space: nowrap;
    font: 400 1.125rem/1.2 var(--f-display); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  }

  /* Kroki wcięte — czyta się je jako ruch od sumy nad nimi */
  .ledger tbody .ledger__step th { padding-left: 20px; }

  /* Start, sumy pośrednie i wynik pełnym atramentem; nad sumą kreska */
  .ledger tbody .ledger__start th, .ledger tbody .ledger__start td,
  .ledger tbody .ledger__subtotal th, .ledger tbody .ledger__subtotal td,
  .ledger tbody .ledger__result th, .ledger tbody .ledger__result td { color: var(--ink); }
  .ledger tbody .ledger__start th, .ledger tbody .ledger__subtotal th, .ledger tbody .ledger__result th { font-weight: 500; }
  .ledger tbody .ledger__before-total th, .ledger tbody .ledger__before-total td,
  .ledger tbody .ledger__result th, .ledger tbody .ledger__result td { border-bottom-color: var(--ink); }
  .ledger tbody .ledger__result td { color: var(--blue); font-size: 1.375rem; }
</style>
