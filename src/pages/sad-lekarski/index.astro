---
/**
 * /sad-lekarski/ — gra „Czy orzekasz jak sąd lekarski” (do 21.10.2026 prototyp pod /prototypy/sad-lekarski/).
 * Katalog wszystkich rozstrzygnięć ma osobną stronę: /sad-lekarski/orzeczenia/.
 * Gracz czyta stan faktyczny z prawomocnego orzeczenia, wybiera rozstrzygnięcie ze skali art. 83
 * ustawy o izbach lekarskich i widzi, co orzekł sąd. Dane: src/data/sad-lekarski.ts.
 * Układ na jeden ekran: sprawa po lewej, skala po prawej; po wyborze skala zwija się do linijki
 * z oznaczeniami „Ty” i „Sąd”, a w jej miejscu pojawia się wyrok.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Icon from '@/components/ui/Icon.astro';
import MonitorPhoto from '@/components/ui/MonitorPhoto.astro';
import DotGrid from '@/components/ui/DotGrid.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import ToolCard from '@/components/blocks/ToolCard.astro';
import { articleHref, getArticle } from '@/lib/content';
import aktaImg from '@/assets/img/monitoring-teczki.jpg';
import kartotekaImg from '@/assets/img/rozklad-kartoteka.jpg';
import {
  CASES, CATALOG_HREF, NIL_PRAWOMOCNE_URL, PORTAL_URL, REGULAMIN_URL, ROUND_MIX, ROUND_SIZE, SCALE, USTAWA_URL, sadPage,
} from '@/data/sad-lekarski';
import {
  FIRST_YEAR, LAST_YEAR, PENALTIES_MILD, PENALTIES_TOTAL, PENALTY_WINDOW, PL_ZERO_YEARS, YEARS_COUNT, penalty, total,
} from '@/data/odpowiedzialnosc-zawodowa-lekarzy';
import { infographicSets } from '@/lib/infografiki/zestawy';
import { FORMATS, THEMES, infographicUrl, type FormatKey, type ThemeKey } from '@/lib/infografiki/render';
import type { Crumb, SeoInput } from '@/lib/seo';
import { typo } from '@/lib/format';
import { linkAttrs } from '@/lib/links';

const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: 'Czy orzekasz jak sąd lekarski?' }];
const seo: SeoInput = {
  title: 'Czy orzekasz jak sąd lekarski? Gra na orzeczeniach',
  description:
    'Dziesięć prawdziwych spraw z prawomocnych orzeczeń sądów lekarskich. Wybierz karę ze skali, którą daje ustawa, i porównaj z tym, co orzekł sąd.',
  breadcrumbs: crumbs,
};

const typoCase = (c: (typeof CASES)[number]) => ({
  ...c,
  facts: c.facts.map(typo),
  charge: typo(c.charge),
  verdict: { ...c.verdict, text: typo(c.verdict.text) },
  reasoning: c.reasoning ? typo(c.reasoning) : undefined,
});
// gra: bez spraw oznaczonych inGame: false (katalog na /sad-lekarski/orzeczenia/ ma wszystkie)
const cases = CASES.filter((c) => c.inGame !== false).map(typoCase);
const files = new Set(CASES.map((c) => c.file)).size;
const scale = SCALE.map((s) => ({ level: s.level, label: s.label }));
const round = Math.min(ROUND_SIZE, cases.length);

// Zakończenie: jak rzadko sądy lekarskie odbierają prawo do zawodu — liczby z modułu danych analizy
const revoked = total('pl');
const ordered = penalty('Pozbawienie prawa wykonywania zawodu');
const orderedPct = Math.round((ordered / PENALTIES_TOTAL) * 100);
const mildPct = Math.round((PENALTIES_MILD / PENALTIES_TOTAL) * 100);
const igSet = infographicSets['odpowiedzialnosc-zawodowa-lekarzy'];
const igItem = igSet.items.find((it) => it.id === 'porownanie-krajow')!;
// warianty infografiki do przełącznika: format × motyw → adres, wymiary i nazwa pliku do pobrania
const igVariants = Object.fromEntries((Object.keys(FORMATS) as FormatKey[]).flatMap((f) =>
  (Object.keys(THEMES) as ThemeKey[]).map((t) => {
    const src = infographicUrl(igSet, igItem.id, f, t);
    return [`${f}-${t}`, { src, width: FORMATS[f].width, height: FORMATS[f].height, file: `${igSet.filePrefix}-${src.split('/').pop()}` }];
  })));
const ig0 = igVariants['poziom-jasny'];
const analiza = await getArticle('odpowiedzialnosc-zawodowa-lekarzy');
// Kropka = jeden prawomocnie pozbawiony lekarz; równa siatka po 10 w rzędzie (bez rozkładu na lata)
const unitCols = 10;
const unitCells = Array.from({ length: Math.ceil(revoked / unitCols) * unitCols }, (_, i): 'on' | 'off' => (i < revoked ? 'on' : 'off'));
---
<BaseLayout seo={seo}>
  <Section space="bottom" class="top" aria-label="Gra">
    <Breadcrumbs items={crumbs} />
    <header class="intro">
      <div>
        <Eyebrow class="intro__eyebrow">Gra · odpowiedzialność zawodowa</Eyebrow>
        <Heading as="h1" size="h2" punct="?" class="intro__title">{sadPage.title}</Heading>
      </div>
      <p class="intro__lead">{typo(sadPage.lead)}</p>
    </header>

    <p class="more"><LinkArrow href={CATALOG_HREF}>{typo(`Katalog orzeczeń: wszystkie ${CASES.length} spraw z opisami i karą`)}</LinkArrow></p>

    <div class="game" id="gra" data-game data-case-base={CATALOG_HREF}>
      <script type="application/json" data-cases set:html={JSON.stringify({ cases, scale, mix: ROUND_MIX })} />

      <div class="play" data-play>
        <div class="bar">
          <p class="bar__step"><b data-step>1</b> / <span data-total>{round}</span></p>
          <div class="bar__track" aria-hidden="true"><span data-bar></span></div>
          <p class="bar__label" data-label></p>
        </div>

        <div class="stage">
          <article class="case" aria-live="polite">
            <div class="case__facts" data-facts></div>
            <p class="case__charge"><span class="mono-label">Zarzut</span><span data-charge></span></p>
          </article>

          <div class="side">
            <fieldset class="scale" data-scale>
              <legend class="mono-label">Twoje orzeczenie <span class="scale__hint">klawisze 0–7</span></legend>
              <ol>
                {SCALE.map((s) => (
                  <li>
                    <button type="button" class="opt" data-level={s.level}>
                      <span class="opt__step" aria-hidden="true">{s.level}</span>
                      <span class="opt__label">{s.label}</span>
                      <span class="opt__note">{s.note}</span>
                    </button>
                    <button type="button" class="law-btn" aria-expanded="false" aria-controls={`law-${s.level}`} aria-label={`Przepis: ${s.label}`} title="Jak tę karę opisuje ustawa" data-law-btn>§</button>
                    <div class="law" id={`law-${s.level}`} hidden>
                      {s.law.map((p) => <p><span class="law__ref">{p.ref}</span>{typo(p.text)}</p>)}
                    </div>
                  </li>
                ))}
              </ol>
              <p class="scale__src">§ — przepis przy każdej karze, z <a {...linkAttrs(USTAWA_URL)}>ustawy o izbach lekarskich (t.j. Dz.U. 2021 poz. 1342)<Icon name="arrow-ne" size={12} /></a></p>
            </fieldset>

            <div class="verdict" data-reveal hidden>
              <span class="burst" data-burst aria-hidden="true"></span>
              <p class="verdict__head" data-reveal-head></p>
              <div class="ruler" aria-hidden="true">
                <ol class="ruler__cells">
                  {SCALE.map((s) => <li data-cell={s.level}><span class="ruler__you">Ty</span><span class="ruler__court">Sąd</span></li>)}
                </ol>
                <p class="ruler__ends"><span>Bez kary</span><span>Pozbawienie prawa do zawodu</span></p>
              </div>
              <p class="verdict__pair" data-pair></p>
              <p class="verdict__text"><span class="mono-label">Sąd orzekł</span><strong data-verdict></strong></p>
              <p class="verdict__why" data-reasoning hidden></p>
              <p class="verdict__src">
                Źródło: portal prawomocnych orzeczeń NIL, plik <code data-file></code>
                <br /><a {...linkAttrs(PORTAL_URL)}>nil.org.pl/orzeczenia<Icon name="arrow-ne" size={14} /></a>
              </p>
              <p class="verdict__link"><a data-case-link href={CATALOG_HREF}>Osobna strona tej sprawy — link do udostępnienia<Icon name="arrow" size={14} /></a></p>
              <button type="button" class="next" data-next><span data-next-label>Następna sprawa</span><Icon name="arrow" size={18} /></button>
            </div>
          </div>
        </div>
      </div>

      <div class="result" data-result hidden tabindex="-1">
        <div class="result__main">
          <p class="mono-label">Twój wynik</p>
          <p class="result__title" data-result-title></p>
          <p class="result__lead" data-result-lead></p>
          <dl class="result__stats">
            <div><dt>Trafione</dt><dd data-hits></dd></div>
            <div><dt>Surowiej niż sąd</dt><dd data-harsher></dd></div>
            <div><dt>Łagodniej niż sąd</dt><dd data-milder></dd></div>
          </dl>
          <button type="button" class="next" data-restart><span>Zagraj jeszcze raz</span><Icon name="arrow" size={18} /></button>
        </div>
        <div class="result__side">
          <details class="result__all">
            <summary>Wszystkie sprawy: Ty i sąd</summary>
            <table class="result__table">
              <thead><tr><th scope="col">Sprawa</th><th scope="col">Ty</th><th scope="col">Sąd</th></tr></thead>
              <tbody data-rows></tbody>
            </table>
          </details>
          <p class="result__note">{typo(sadPage.sample.replace('{files}', String(files)))}</p>
        </div>

        <section class="pwz" aria-labelledby="pwz-title">
          <div class="pwz__text">
            <p class="mono-label">Najwyższa kara</p>
            <h2 class="pwz__title" id="pwz-title">Prawo do zawodu sądy lekarskie odbierają prawie nigdy</h2>
            <div class="pwz__big">
              <p class="pwz__n">{revoked}</p>
              <figure class="pwz__units">
                <DotGrid cells={unitCells} cols={unitCols} label={`${revoked} kropek — ${revoked} lekarzy`} class="pwz__dots" />
                <figcaption>1 kropka = 1 lekarz</figcaption>
              </figure>
            </div>
            <p class="pwz__cap">{typo('lekarzy prawomocnie pozbawionych prawa wykonywania zawodu')} <strong>{typo(`w ciągu ${YEARS_COUNT} lat (${FIRST_YEAR}–${LAST_YEAR})`)}</strong></p>
            <p>{typo(`To nieco ponad jeden lekarz rocznie, a w ${PL_ZERO_YEARS} z tych ${YEARS_COUNT} lat — nikt. W pierwszej instancji w latach ${PENALTY_WINDOW.from}–${PENALTY_WINDOW.to} pozbawienie prawa do zawodu to ${ordered} z ${PENALTIES_TOTAL} kar (ok. ${orderedPct}%), a upomnienie, nagana i kara pieniężna — ${mildPct}%.`)}</p>
            <p class="pwz__note">{typo('Na grafice: porównanie z Norwegią, Szwecją i Wielką Brytanią. Systemy różnią się zakresem spraw, a przestępstwa lekarzy w Polsce osądzają osobno sądy karne.')}</p>
          </div>
          <figure class="pwz__fig" data-ig={JSON.stringify(igVariants)}>
            <div class="igsw">
              <div class="igsw__group" role="group" aria-label="Format">
                {(Object.keys(FORMATS) as FormatKey[]).map((f) => (
                  <button type="button" data-ig-format={f} aria-pressed={f === 'poziom' ? 'true' : 'false'}>{FORMATS[f].label}</button>
                ))}
              </div>
              <div class="igsw__group" role="group" aria-label="Motyw">
                {(Object.keys(THEMES) as ThemeKey[]).map((t) => (
                  <button type="button" data-ig-theme={t} aria-pressed={t === 'jasny' ? 'true' : 'false'}>{THEMES[t].label}</button>
                ))}
              </div>
              <a class="igsw__dl" data-ig-dl href={ig0.src} download={ig0.file}><Icon name="arrow" size={14} />Pobierz PNG</a>
            </div>
            <a class="pwz__ig" data-ig-frame href={ig0.src} target="_blank" rel="noopener">
              <img data-ig-img src={ig0.src} width={ig0.width} height={ig0.height} alt={igItem.alt} loading="lazy" decoding="async" />
            </a>
          </figure>
          <div class="pwz__banner">
            <ToolCard
              layout="banner"
              cta="Czytaj analizę"
              image={analiza.data.cover && { src: analiza.data.cover, alt: analiza.data.coverAlt ?? '' }}
              tool={{
                icon: 'chart',
                label: 'Analiza · samorząd',
                title: analiza.data.title,
                desc: 'Kary sądów lekarskich rok po roku, prawomocne odebrania prawa do zawodu i porównanie z Norwegią, Szwecją i Wielką Brytanią.',
                href: articleHref(analiza),
              }}
            />
          </div>
        </section>
      </div>
    </div>

    <div class="cat-banner">
      <ToolCard
        layout="banner"
        cta="Otwórz katalog"
        image={{ src: kartotekaImg, alt: '' }}
        tool={{
          icon: 'chart',
          label: 'Katalog orzeczeń',
          title: 'Za co i jak karzą sądy lekarskie',
          desc: typo(`Wszystkie ${CASES.length} spraw ze streszczeniem, zarzutem i karą, z filtrem według kary. Uwaga — katalog zdradza wyniki gry.`),
          href: CATALOG_HREF,
        }}
      />
    </div>
  </Section>

  <Section tone="soft" aria-labelledby="skad">
    <div class="about">
      <div class="about__main">
      <p class="mono-label">Skąd te sprawy</p>
      <Heading as="h2" size="h2" id="skad" class="about__title">Prawdziwe orzeczenia, nasze opisy</Heading>
      <div class="prose">
        <p>{typo('Od 2024 r. Naczelna Rada Lekarska publikuje zanonimizowane prawomocne orzeczenia sądów lekarskich: Naczelnego Sądu Lekarskiego doręczone po 1 stycznia 2024 r. i okręgowych sądów doręczone po 1 lipca 2024 r. Portal zaczernia sygnatury, daty, nazwę sądu, nazwiska i kwoty.')}</p>
        <p>{typo('Regulamin portalu pozwala wykorzystywać orzeczenia w celach naukowych, dydaktycznych i informacyjnych (§ 5 ust. 3). Opisy spraw piszemy sami i ogólniej niż orzeczenie: bez miejscowości i dat. Każde rozstrzygnięcie ma nazwę pliku, pod którą można je znaleźć na portalu.')}</p>
        <p>{typo('Skala w grze to kary z art. 83 ust. 1 ustawy o izbach lekarskich, w kolejności, w jakiej wymienia je ustawa. „Bez kary” obejmuje uniewinnienie i umorzenie postępowania. Gdy sąd orzekł za jeden czyn dwie kary, liczy się surowsza.')}</p>
      </div>
      <ul class="sources">
        <li><a {...linkAttrs(PORTAL_URL)}>Portal prawomocnych orzeczeń sądów lekarskich (NIL)<Icon name="arrow-ne" size={14} /></a></li>
        <li><a {...linkAttrs(REGULAMIN_URL)}>Regulamin portalu (uchwała NRL nr 10/24/IX)<Icon name="arrow-ne" size={14} /></a></li>
        <li><a {...linkAttrs(NIL_PRAWOMOCNE_URL)}>NIL: liczba prawomocnych orzeczeń według rodzaju, 2023–2025 (proporcje w grze)<Icon name="arrow-ne" size={14} /></a></li>
        <li><a {...linkAttrs(USTAWA_URL)}>Ustawa o izbach lekarskich, t.j. Dz.U. 2021 poz. 1342 (art. 82–83)<Icon name="arrow-ne" size={14} /></a></li>
      </ul>
      </div>
      <MonitorPhoto
        effect="scan"
        src={aktaImg}
        alt="Rzędy spiętych sznurkiem plików dokumentów rozłożone na stole, widok z góry"
        ratio="4/3"
        sizes="(min-width: 1025px) 520px, 100vw"
        widths={[480, 720, 1040]}
        frame
        class="about__photo"
      />
    </div>
  </Section>
</BaseLayout>

<script>
  interface GameCase {
    id: string; title: string; label: string; court: string; facts: string[]; charge: string;
    verdict: { level: number; text: string }; reasoning?: string; file: string;
  }
  interface GameData { cases: GameCase[]; scale: { level: number; label: string }[]; mix: number[] }

  /** Tasowanie Fishera–Yatesa. */
  function shuffle<T>(list: T[]): T[] {
    for (let k = list.length - 1; k > 0; k--) {
      const j = Math.floor(Math.random() * (k + 1));
      [list[k], list[j]] = [list[j], list[k]];
    }
    return list;
  }

  const root = document.querySelector<HTMLElement>('[data-game]');
  const dataEl = root?.querySelector<HTMLScriptElement>('[data-cases]');
  if (root && dataEl) {
    const { cases: all, scale, mix } = JSON.parse(dataEl.textContent ?? '{}') as GameData;
    const ROUND = Number(root.querySelector('[data-total]')?.textContent) || all.length;
    const caseBase = root.dataset.caseBase ?? '';

    /** Koszyk kary: 0 bez kary, 1 upomnienie, 2 nagana, 3 kara pieniężna, 4 surowsze (poziomy 4–7). */
    const bucket = (c: GameCase) => Math.min(c.verdict.level, 4);

    /**
     * Rozgrywka: orzeczenia w losowej kolejności, aż do ROUND rozstrzygnięć, z luźnym rozkładem kar (ROUND_MIX).
     * Cel każdego koszyka = udział × ROUND, przesunięty losowo o −1…+1; pierwsze przejście bierze orzeczenia,
     * które mieszczą się w celach, drugie dopełnia rundę czymkolwiek. Sprawy z jednego orzeczenia (kilka zarzutów,
     * kilku obwinionych) idą razem i w swojej kolejności — opisy się do siebie odwołują.
     */
    function deal(): GameCase[] {
      const groups = new Map<string, GameCase[]>();
      for (const c of all) groups.set(c.file, [...(groups.get(c.file) ?? []), c]);
      const target = mix.map((share) => Math.max(0, Math.round(share * ROUND + (Math.random() * 2 - 1))));
      const have = mix.map(() => 0);
      const out: GameCase[] = [];
      const rest: GameCase[][] = [];
      const take = (g: GameCase[]) => { out.push(...g); for (const c of g) have[bucket(c)] += 1; };
      for (const g of shuffle([...groups.values()])) {
        const need = mix.map(() => 0);
        for (const c of g) need[bucket(c)] += 1;
        const fits = out.length + g.length <= ROUND && need.every((n, b) => have[b] + n <= target[b] + (n > 1 ? 1 : 0));
        if (fits) take(g); else rest.push(g);
      }
      for (const g of rest) if (out.length + g.length <= ROUND) take(g);
      // kolejność w rundzie: grupy przemieszane, w grupie — kolejność z orzeczenia
      const dealt = new Map<string, GameCase[]>();
      for (const c of out) dealt.set(c.file, [...(dealt.get(c.file) ?? []), c]);
      return shuffle([...dealt.values()]).flat();
    }
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const play = $('[data-play]');
    const result = $('[data-result]');
    const scaleBox = $('[data-scale]');
    const reveal = $('[data-reveal]');
    const opts = [...root.querySelectorAll<HTMLButtonElement>('.opt')];
    const cells = [...root.querySelectorAll<HTMLElement>('[data-cell]')];
    const burstBox = $('[data-burst]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const labelOf = (level: number) => scale.find((s) => s.level === level)?.label ?? '';
    const steps = (n: number) => (n === 1 ? 'stopień' : n < 5 ? 'stopnie' : 'stopni');

    let cases = deal();
    let i = 0;
    let answers: number[] = [];

    /** Przewija do elementu tylko wtedy, gdy nie mieści się w oknie. */
    function scrollIfHidden(el: HTMLElement) {
      const r = el.getBoundingClientRect();
      if (r.top < 72 || r.bottom > window.innerHeight) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    /**
     * Trafienie: z pola linijki rozchodzi się po karcie wyroku podwójna fala kropek (jak `pulse`
     * w ui/MonitorPhoto) — siatka co 16 px, każda kropka zapala się z opóźnieniem zależnym od odległości.
     */
    function burst(from: HTMLElement) {
      burstBox.replaceChildren();
      if (still) return;
      const S = 16;
      const W = reveal.clientWidth, H = reveal.clientHeight;
      const cols = Math.floor(W / S), rows = Math.floor(H / S);
      const ox = (W - cols * S) / 2 + S / 2, oy = (H - rows * S) / 2 + S / 2;
      const box = reveal.getBoundingClientRect(), at = from.getBoundingClientRect();
      const cx = at.left + at.width / 2 - box.left, cy = at.top + at.height / 2 - box.top;
      let dots = '';
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        const x = ox + c * S, y = oy + r * S;
        dots += `<circle cx="${x}" cy="${y}" r="${S * .26}" style="--d:${(Math.hypot(x - cx, y - cy) / 700).toFixed(3)}s"/>`;
      }
      burstBox.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">${dots}</svg>`;
    }

    function show() {
      burstBox.replaceChildren();
      const c = cases[i];
      $('[data-step]').textContent = String(i + 1);
      $('[data-bar]').style.setProperty('--p', String(i / cases.length));
      $('[data-total]').textContent = String(cases.length);
      $('[data-label]').textContent = c.label ? `${c.court} · ${c.label}` : c.court;
      $('[data-facts]').replaceChildren(...c.facts.map((t) => Object.assign(document.createElement('p'), { textContent: t })));
      $('[data-charge]').textContent = c.charge;
      for (const o of opts) o.disabled = false;
      scaleBox.hidden = false;
      reveal.hidden = true;
    }

    function answer(level: number) {
      if (!reveal.hidden) return;
      const c = cases[i];
      answers[i] = level;
      const court = c.verdict.level;
      for (const cell of cells) {
        const l = Number(cell.dataset.cell);
        cell.classList.toggle('is-you', l === level);
        cell.classList.toggle('is-court', l === court);
        cell.classList.toggle('is-between', l > Math.min(level, court) && l < Math.max(level, court));
      }
      const d = level - court;
      const head = $('[data-reveal-head]');
      head.className = `verdict__head ${d === 0 ? 'is-hit' : 'is-miss'}`;
      head.textContent = d === 0 ? 'Orzekasz jak sąd.'
        : `${d > 0 ? 'Surowiej' : 'Łagodniej'} niż sąd o ${Math.abs(d)} ${steps(Math.abs(d))}.`;
      $('[data-pair]').textContent = d === 0 ? `Oboje: ${labelOf(level)}` : `Ty: ${labelOf(level)} · Sąd: ${labelOf(court)}`;
      $('[data-verdict]').textContent = c.verdict.text;
      const why = $('[data-reasoning]');
      why.hidden = !c.reasoning;
      why.textContent = c.reasoning ?? '';
      $('[data-file]').textContent = c.file;
      $<HTMLAnchorElement>('[data-case-link]').href = `${caseBase}${c.id}/`;
      $('[data-next-label]').textContent = i === cases.length - 1 ? 'Zobacz wynik' : 'Następna sprawa';
      scaleBox.hidden = true;
      reveal.hidden = false;
      reveal.classList.toggle('is-hit', d === 0);
      if (d === 0) burst(cells[court]);
      $<HTMLButtonElement>('[data-next]').focus({ preventScroll: true });
      scrollIfHidden(reveal);
    }

    function finish() {
      const diffs = cases.map((c, k) => answers[k] - c.verdict.level);
      const hits = diffs.filter((d) => d === 0).length;
      const harsher = diffs.filter((d) => d > 0).length;
      const milder = diffs.filter((d) => d < 0).length;
      const n = cases.length;
      let title: string; let lead: string;
      if (hits >= Math.ceil(n * 0.8)) {
        title = 'Orzekasz jak sąd lekarski.';
        lead = `Trafiasz ${hits} z ${n} rozstrzygnięć — skala kar jest dla Ciebie taka sama jak dla sędziów samorządu.`;
      } else if (harsher > milder) {
        title = 'Orzekasz surowiej niż sąd lekarski.';
        lead = `W ${harsher} z ${n} spraw wybierasz cięższą karę niż sąd.`;
      } else if (milder > harsher) {
        title = 'Orzekasz łagodniej niż sąd lekarski.';
        lead = `W ${milder} z ${n} spraw wybierasz lżejsze rozstrzygnięcie niż sąd.`;
      } else {
        title = 'Ważysz sprawy inaczej niż sąd lekarski.';
        lead = 'Raz surowiej, raz łagodniej — bez stałego kierunku.';
      }
      $('[data-result-title]').textContent = title;
      $('[data-result-lead]').textContent = lead;
      $('[data-hits]').textContent = `${hits} z ${n}`;
      $('[data-harsher]').textContent = String(harsher);
      $('[data-milder]').textContent = String(milder);
      $('[data-rows]').replaceChildren(...cases.map((c, k) => {
        const tr = document.createElement('tr');
        tr.className = diffs[k] === 0 ? 'is-hit' : '';
        for (const t of [c.title, labelOf(answers[k]), labelOf(c.verdict.level)]) tr.append(Object.assign(document.createElement('td'), { textContent: t }));
        return tr;
      }));
      play.hidden = true;
      result.hidden = false;
      result.focus({ preventScroll: true });
      scrollIfHidden(result);
    }

    function next() {
      if (i === cases.length - 1) { finish(); return; }
      i += 1;
      show();
      scrollIfHidden(play);
    }

    for (const o of opts) o.addEventListener('click', () => answer(Number(o.dataset.level)));
    // „§” przy karze: rozwija dosłowny przepis pod pozycją skali (można czytać przed wyborem)
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-law-btn]')) {
      b.addEventListener('click', () => {
        const box = document.getElementById(b.getAttribute('aria-controls')!)!;
        box.hidden = !box.hidden;
        b.setAttribute('aria-expanded', String(!box.hidden));
      });
    }
    $('[data-next]').addEventListener('click', next);
    $('[data-restart]').addEventListener('click', () => {
      cases = deal(); i = 0; answers = [];
      result.hidden = true; play.hidden = false;
      show();
      scrollIfHidden(play);
    });
    document.addEventListener('keydown', (e) => {
      if (play.hidden || e.altKey || e.ctrlKey || e.metaKey) return;
      if ((e.target as HTMLElement).closest('input, textarea, select')) return;
      if (/^[0-7]$/.test(e.key) && reveal.hidden) answer(Number(e.key));
    });
    show();
  }

  // Przełącznik infografiki (pion/poziom × jasna/ciemna): podmienia obraz, link do pełnej wersji i pobieranie
  const fig = document.querySelector<HTMLElement>('[data-ig]');
  if (fig) {
    const variants = JSON.parse(fig.dataset.ig ?? '{}') as Record<string, { src: string; width: number; height: number; file: string }>;
    const img = fig.querySelector<HTMLImageElement>('[data-ig-img]')!;
    const frame = fig.querySelector<HTMLAnchorElement>('[data-ig-frame]')!;
    const dl = fig.querySelector<HTMLAnchorElement>('[data-ig-dl]')!;
    const formats = [...fig.querySelectorAll<HTMLButtonElement>('[data-ig-format]')];
    const themes = [...fig.querySelectorAll<HTMLButtonElement>('[data-ig-theme]')];
    let format = 'poziom';
    let theme = 'jasny';
    const apply = () => {
      const v = variants[`${format}-${theme}`];
      if (!v) return;
      img.src = v.src; img.width = v.width; img.height = v.height;
      frame.href = v.src; dl.href = v.src; dl.download = v.file;
      fig.classList.toggle('is-pion', format === 'pion');
      for (const b of formats) b.setAttribute('aria-pressed', String(b.dataset.igFormat === format));
      for (const b of themes) b.setAttribute('aria-pressed', String(b.dataset.igTheme === theme));
    };
    for (const b of formats) b.addEventListener('click', () => { format = b.dataset.igFormat!; apply(); });
    for (const b of themes) b.addEventListener('click', () => { theme = b.dataset.igTheme!; apply(); });
  }

</script>

