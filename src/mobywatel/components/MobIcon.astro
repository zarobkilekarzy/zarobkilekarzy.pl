---
/** Ikona prototypu (rejestr mobywatel/icons.ts), rysowana w miejscu. Kolor z `currentColor`. */
import type { HTMLAttributes } from 'astro/types';
import { mobIcons, type MobIconName } from '@/mobywatel/icons';

interface Props extends HTMLAttributes<'svg'> {
  name: MobIconName;
  size?: number;
}

const { name, size = 20, class: className, ...rest } = Astro.props;
---
<svg class:list={['mob-icon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={mobIcons[name]} {...rest} />

<style>
  .mob-icon { flex: none; }
</style>
