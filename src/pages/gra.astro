function achievement(id) {
  if (S.achv[id]) return;
  const a = ACHV.find(x => x.id === id);
  if (!a) return;
  S.achv[id] = true;
  toast({ html: iko('trofeum') + ' <b>' + a.n + '</b><br>' + a.o + (a.link ? ' <a href="' + LINK(a.link) + '" target="_blank" rel="noopener">to działa naprawdę →</a>' : ''), ttl: 12000 });
  renderGablote();
}
function renderGablote() {
  const ile = ACHV.filter(a => S.achv[a.id]).length;
  if (ile > 0) $('gablotaBox').classList.remove('hide');
  $('gablotaLicznik').textContent = ile + '/' + ACHV.length;
  const ul = $('gablotaLista');
  ul.innerHTML = '';
  for (const a of ACHV) {
    const li = document.createElement('li');
    const jest = !!S.achv[a.id];
    li.className = jest ? 'zdobyte' : '';
    li.innerHTML = jest
      ? '<span class="n">' + iko('trofeum') + ' ' + a.n + '</span>' + a.o + (a.link ? ' <a href="' + LINK(a.link) + '" target="_blank" rel="noopener">→</a>' : '')
      : '<span class="n">' + a.n + '</span>???';
    ul.appendChild(li);
  }
}

/* ── plansza: sloty, godziny (2 plansze) ── */
const kluczKom = (c, r) => c + ',' + r;
function komorkiFizyczne(bloki) {
  const s = new Set();
  for (const b of (bloki || S.bloki)) if (b.lane === 0) s.add(kluczKom(b.c, b.r));
  return s;
}
function hFizyczne() { return komorkiFizyczne().size * 4; }
function hRozliczane() { return S.bloki.length * 4; }
function dobaRozliczana() { return hRozliczane() / 7; }
function naUrlopie() { return Date.now() < S.urlopDo; }

/* tor 0: tylko komórki wolne GLOBALNIE (jedno ciało — bez nakładek między
   placówkami); tory 1..2 nad własnym torem 0 tej samej planszy (bilokacja) */
function znajdzSloty(n, preferRows, blokiStan, p) {
  p = p || 0;
  const bloki = blokiStan || S.bloki;
  const rzedy = preferRows || [0, 1, 5, 4, 2, 3];
  const zajete = new Set(bloki.map(b => (b.p || 0) + '|' + b.c + ',' + b.r + ',' + b.lane));
  const fizGlobal = komorkiFizyczne(bloki);
  const tor0Tu = new Set(bloki.filter(b => b.lane === 0 && (b.p || 0) === p).map(b => kluczKom(b.c, b.r)));
  const L = 1 + S.bilokacja;
  const wynik = [];
  for (let lane = 0; lane < L && wynik.length < n; lane++) {
    for (const r of rzedy) {
      for (let c = 0; c < T.KOL && wynik.length < n; c++) {
        const klucz = p + '|' + c + ',' + r + ',' + lane;
        if (zajete.has(klucz)) continue;
        const kom = kluczKom(c, r);
        if (lane === 0) {
          if (fizGlobal.has(kom)) continue;
          if ((fizGlobal.size + 1) * 4 > S.hCap) continue;
          fizGlobal.add(kom); tor0Tu.add(kom);
        } else if (!tor0Tu.has(kom)) continue;
        zajete.add(klucz);
        wynik.push({ c, r, lane, p });
      }
    }
  }
  return wynik.length === n ? wynik : null;
}
function dodajBloki(n, typ, kreska, preferRows, p) {
  const sloty = znajdzSloty(n, preferRows, null, p || 0);
  if (!sloty) return false;
  for (const s of sloty) S.bloki.push({ c: s.c, r: s.r, lane: s.lane, typ, kreska: !!kreska, p: s.p });
  renderPlansza();
  return true;
}

const plansza = $('plansza');
function renderPlansza() {
  for (const el of plansza.querySelectorAll('.blok')) el.remove();
  const tu = S.bloki.filter(b => (b.p || 0) === S.aktywnaPlansza);
  $('planszaHint').style.display = S.bloki.length ? 'none' : 'grid';
  const L = 1 + S.bilokacja;
  const w = 100 / T.KOL, h = 100 / T.RZED;
  for (const b of tu) {
    const el = document.createElement('div');
    el.className = 'blok t-' + b.typ + (b.kreska && !S.rejestrDziala ? ' kreska' : '');
    el.textContent = TYPY[b.typ].et;
    const szer = (w - 0.9) / L;
    el.style.left = 'calc(' + (b.c * w + 0.45 + b.lane * szer) + '% + 1px)';
    el.style.width = 'calc(' + szer + '% - 2px)';
    el.style.top = 'calc(' + (b.r * h) + '% + 2px)';
    el.style.height = 'calc(' + h + '% - 5px)';
    plansza.appendChild(el);
  }
  if (S.plansze === 2) {
    $('pTaby').classList.remove('hide');
    for (const b of $('pTaby').querySelectorAll('button')) b.classList.toggle('on', +b.dataset.p === S.aktywnaPlansza);
  }
}
$('pTaby').addEventListener('click', e => {
  const b = e.target.closest('button');
  if (!b) return;
  S.aktywnaPlansza = +b.dataset.p;
  renderPlansza();
});
function pFloat(tekst, xPct, yPct, klasa) {
  if (redMotion) return;
  const f = document.createElement('span');
  f.className = 'p-float' + (klasa ? ' ' + klasa : '');
  f.textContent = tekst;
  f.style.left = Math.min(88, xPct) + '%'; f.style.top = yPct + '%';
  plansza.appendChild(f);
  setTimeout(() => f.remove(), 820);
}

/* ── dochód ── */
function mnoznikNeg() { return Math.pow(1.1, S.negocjacje); }
function mnoznikEnergii() { return 0.35 + 0.65 * S.energia / 100; }
function bonusSzkolen() { let b = 0; for (let i = 0; i < S.szkolenia; i++) b += SZKOLENIA[i].b; return b; }
function stawkaBloku(b) {
  const t = TYPY[b.typ];
  const obok = b.typ === 'obok' ? S.mnoznikObok : 1;
  return t.st() * (t.rynek ? S.indeks : 1) * obok * mnoznikNeg() * (b.lane === 0 ? mnoznikEnergii() : 1);
}
function stawkaBazowa(b) { // bez mnożnika energii — do offline i sum tygodniowych
  const t = TYPY[b.typ];
  const obok = b.typ === 'obok' ? S.mnoznikObok : 1;
  return t.st() * (t.rynek ? S.indeks : 1) * obok * mnoznikNeg();
}
function aktualnaKomorka() {
  const h = S.gh % 168;
  return { c: Math.floor(h / 24), r: Math.floor((h % 24) / 4), poz: h / 168 };
}
function blokiW(c, r) { return S.bloki.filter(b => b.c === c && b.r === r); }
function jawneTygodniowo() {
  let s = 0;
  for (const b of S.bloki) if (!b.kreska) s += stawkaBazowa(b) * 4;
  return s;
}
function kreskoweTygodniowo() {
  let s = 0;
  for (const b of S.bloki) if (b.kreska) s += stawkaBazowa(b) * 4;
  return s;
}
function klinUoP() { return jawneTygodniowo() * 52 > T.PROG_ROCZNY ? T.NETTO_UOP_WYSOKI : T.NETTO_UOP_NISKI; }
function nettoB2B() { return T.NETTO_B2B + (S.panamerka ? 0.03 : 0); }
function czynszNaGodzine() { return (S.mieszkania * 900 + S.apartamenty * 2600) / 168; }

/* ── klik + kolejka pacjentów ── */
function naDyzurze() {
  const { c, r } = aktualnaKomorka();
  return blokiW(c, r).some(b => b.lane === 0);
}
function wartoscKlikuBrutto() {
  const baza = T.KLIK_BAZA + bonusSzkolen();
  return baza * T.TIER_MNOZNIK[Math.min(S.tier, 3)] * S.indeks * mnoznikNeg()
    * mnoznikEnergii() * (naDyzurze() ? 2 : 1) * (S.kolejka > 0 ? 1.5 : 1);
}
function klik() {
  const brutto = wartoscKlikuBrutto();
  const klin = S.b2b ? nettoB2B() : klinUoP();
  S.portfel += brutto * klin;
  S.lifetime += brutto; S.realCum += brutto;
  if (!S.b2b || S.rejestrDziala) S.jawneCum += brutto;
  S.kliki++; S.pacjenci++;
  if (S.kolejka > 0) {
    S.kolejka--; S.zKolejki++;
    if (S.zKolejki >= 50) achievement('kolejka50');
  }
  S.energia = Math.max(0, S.energia - T.KLIK_ENERGIA);
  if (S.energia === 0) achievement('zombie');
  const { poz } = aktualnaKomorka();
  if (!redMotion) {
    const b = document.createElement('span');
    b.className = 'p-blip';
    b.style.left = 'calc(' + (poz * 100) + '% - 3px)';
    b.style.top = (12 + Math.random() * 76) + '%';
    plansza.appendChild(b);
    setTimeout(() => b.remove(), 2500);
  }
  pFloat('+' + Math.floor(brutto * klin).toLocaleString('pl-PL') + ' zł', poz * 100 + 1, 14 + Math.random() * 30);
  postep();
}
const przyjmijBtn = $('przyjmij');
przyjmijBtn.addEventListener('pointerdown', e => {
  if (e.button === 0 || e.pointerType !== 'mouse') {
    e.preventDefault();
    przyjmijBtn.classList.add('wcisniety');
    klik();
  }
});
addEventListener('pointerup', () => przyjmijBtn.classList.remove('wcisniety'));
przyjmijBtn.addEventListener('click', e => { if (e.detail === 0) klik(); });
plansza.addEventListener('pointerdown', () => klik());

