---
/**
 * /analizy/ — spis analiz (układ „Katalog”, jak /dane/): działy z analizami w wierszach.
 * Katalog, a nie pasy ze zdjęciami: analiz jest kilkadziesiąt i przybywa ich z czasem.
 * Analizy to wpisy kolekcji `articles` z polem `topic`; opisy działów — src/data/analizy.ts.
 */
import IndexLayout from '@/layouts/IndexLayout.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import TopicCatalog from '@/components/blocks/TopicCatalog.astro';
import ToolTiles from '@/components/blocks/ToolTiles.astro';
import { toolTiles } from '@/data/narzedzia';
import { analizyPage, analysisTopics } from '@/data/analizy';
import { site } from '@/data/navigation';
import { countArticles, getTopicGroups } from '@/lib/content';
import { ANALYSIS_TOPICS } from '@/types';

const groups = await getTopicGroups(ANALYSIS_TOPICS, analysisTopics);
---
<IndexLayout
  title={analizyPage.title}
  docTitle="Analizy o płacach i kształceniu lekarzy"
  lead={analizyPage.lead}
  description={analizyPage.description}
  eyebrow={analizyPage.eyebrow}
  meta={[
    { label: 'Analizy', value: countArticles(groups) },
    { label: 'Działy', value: groups.length },
    { label: 'Aktualizacja', value: site.updated },
  ]}
  jump={{ title: 'Działy', items: groups.map((g) => ({ label: g.info.label, href: `#${g.topic}`, count: g.articles.length })) }}
  articles={groups.flatMap((g) => g.articles)}
>
  <Section space="bottom" class="catalog">
    <TopicCatalog groups={groups} noun={['analiza', 'analizy', 'analiz']} format={false} />
  </Section>

  <Section space="bottom" aria-labelledby="narzedzia-title">
    <SectionHead eyebrow="Narzędzia" title="Sprawdź sam" id="narzedzia-title" aside="Symulatory i przeglądarki, na których analizy się opierają. Zmień założenia i policz sam." />
    <ToolTiles items={toolTiles} />
  </Section>
</IndexLayout>

<style>
  .catalog { padding-top: 48px; }
</style>
