---
/**
 * Tłumaczenie wpisu aktualności, np. /en/news/site-in-english/ — układ jak src/pages/aktualnosci/[id].astro.
 * Data, zdjęcie i szkic z polskiego wpisu; nota o tłumaczeniu nad treścią (article/TranslationNote).
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import Prose from '@/components/article/Prose.astro';
import ProseLink from '@/components/article/ProseLink.astro';
import ShareLinks from '@/components/article/ShareLinks.astro';
import TranslationNote from '@/components/article/TranslationNote.astro';
import Aside from '@/components/blocks/Aside.astro';
import Screenshot from '@/components/blocks/Screenshot.astro';
import { formatDateIn, isoDate, typo } from '@/lib/format';
import { newsHref } from '@/lib/news';
import { getNewsTranslations, newsEnHref, newsFreshnessOf, newsPageEn } from '@/i18n/news';
import type { Crumb, SeoInput } from '@/lib/seo';
import InfographicsSection from '@/components/blocks/InfographicsSection.astro';
import { infographicSetsEn } from '@/lib/infografiki/zestawy-en';

export const getStaticPaths = (async () => {
  const news = await getNewsTranslations();
  return news.map((pair) => ({ params: { slug: pair.entry.id }, props: { pair } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { pair } = Astro.props;
const { entry, source } = pair;
const { title, summary, links = [], x, coverAlt, coverCaption } = entry.data;
const { date, draft, cover } = source.data;
const { Content } = await render(entry);
const freshness = newsFreshnessOf(pair);
const original = newsHref(source);
// infografiki do pobrania: zestaw o kluczu = id polskiego wpisu (lib/infografiki/zestawy-en.ts)
const graphics = infographicSetsEn[source.id]?.items.length ?? 0;

const url = new URL(newsEnHref(pair), Astro.site).href;
const crumbs: Crumb[] = [{ label: 'Home', href: '/en/' }, { label: newsPageEn.title, href: newsPageEn.href }, { label: title }];
const seo: SeoInput = {
  title,
  description: summary,
  type: 'article',
  index: !draft && !entry.data.noindex,
  dates: { published: date, modified: entry.data.translation.date },
  section: newsPageEn.title,
  breadcrumbs: crumbs,
  entities: [{ kind: 'article' }],
  translations: [{ locale: 'pl', path: original, indexable: !draft }],
};
---
<BaseLayout seo={seo}>
  <Section space="bottom" class="entry">
    <header class="entry__head">
      <Breadcrumbs items={crumbs} />
      <div class="entry__intro">
        <Eyebrow>{newsPageEn.title}</Eyebrow>
        <Heading as="h1" size="display" class="entry__title">{typo(title)}</Heading>
        <p class="lead entry__lead">{typo(summary)}</p>
        <p class="entry__date"><time datetime={isoDate(date)}>{formatDateIn(date, 'en')}</time></p>
      </div>
    </header>

    {draft && (
      <Aside variant="warn" label="Work in progress" title="Draft" class="entry__draft">
        <p>Local preview. This entry will not go live while the Polish entry has <code>draft: true</code> in its frontmatter.</p>
      </Aside>
    )}

    {cover && <Screenshot src={cover} alt={coverAlt ?? source.data.coverAlt!} caption={coverCaption} class="entry__cover" sizes="(min-width: 1025px) 1000px, calc(100vw - 32px)" />}

    <div class="entry__body">
      <div class="entry__note">
        <TranslationNote original={original} translated={entry.data.translation.date} stale={freshness.stale} changed={freshness.changed} />
      </div>
      <Prose><Content components={{ a: ProseLink }} /></Prose>

      {graphics > 0 && <InfographicsSection set={source.id} class="entry__ig" />}

      {(links.length > 0 || x) && (
        <ul class="entry__links">
          {links.map((link) => <li><LinkArrow href={link.href}>{link.label}</LinkArrow></li>)}
          {x && <li><LinkArrow href={x}>This entry on X</LinkArrow></li>}
        </ul>
      )}

      <footer class="entry__foot">
        <ShareLinks url={url} title={title} />
        <LinkArrow href={newsPageEn.href}>All news</LinkArrow>
      </footer>
    </div>
  </Section>
</BaseLayout>

<style>
  /* style jak w src/pages/aktualnosci/[id].astro — przy zmianie układu poprawić obie strony */
  .entry { padding-top: clamp(32px, 4vw, 56px); }
  .entry__intro { margin-top: 40px; }
  .entry__title { font-size: clamp(2.25rem, 4.2vw, 3.75rem); margin-bottom: 24px; max-width: 20ch; }
  .entry__lead { font-size: 1.1875rem; max-width: 40em; }
  .entry__date { margin-top: 20px; font: 400 0.8125rem/1.2 var(--f-mono); letter-spacing: .02em; color: var(--muted); }

  .entry__draft { margin-top: 40px; max-width: 780px; }
  .entry :global(.entry__cover) { margin-top: clamp(32px, 4vw, 48px); max-width: 1000px; }
  .entry__body { margin-top: clamp(40px, 5vw, 64px); padding-top: 40px; border-top: 1px solid var(--line); }
  .entry__body :global(.entry__ig) { margin-top: 56px; }
  .entry__note { max-width: 780px; }
  .entry__links { display: grid; gap: 12px; margin-top: 48px; max-width: 780px; }
  .entry__foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px;
    margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); max-width: 780px;
  }

  @media (max-width: 720px) {
    .entry__lead { font-size: 1.0625rem; }
  }
</style>
