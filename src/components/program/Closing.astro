---
/** /program/ — zakończenie: dla kogo jest program, i powrót do jedynego postulatu (blok „Stanowisko redakcji”). */
import Section from '@/components/layout/Section.astro';
import Heading from '@/components/ui/Heading.astro';
import PostulatCta from '@/components/site/PostulatCta.astro';
import { closing } from '@/data/program';
import { typo } from '@/lib/format';
---
<Section id="zakonczenie" tone="soft" aria-labelledby="zakonczenie-title">
  <div class="close">
    <Heading id="zakonczenie-title" class="close__title">{typo(closing.title)}</Heading>
    <p class="close__text">{typo(closing.text)}</p>
  </div>
  <PostulatCta />
</Section>

<style>
  .close { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px clamp(40px, 6vw, 96px); align-items: start; margin-bottom: clamp(48px, 6vw, 80px); }
  .close__title { max-width: 14ch; }
  .close__text { padding-top: 8px; font-size: 1.125rem; line-height: 1.7; max-width: 54ch; color: var(--ink-2); }

  @media (max-width: 1024px) {
    .close { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .close__text { font-size: 1.03125rem; }
  }
</style>
