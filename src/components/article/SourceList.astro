---
/**
 * Numerowana lista źródeł strony bez odwołań w tekście (np. /prawa-pacjenta/ — ustawy i strony urzędów).
 * Artykuły i strony, które powołują się na źródło przy zdaniu, mają przypisy (lib/notes, GFM w MDX).
 * Domyślnie zwinięta; w nagłówku widać wydawców. Link prowadzący do listy lub do
 * jej pozycji (`#zrodla`, `#zrodla-2`) rozwija ją przed przewinięciem (scripts/open-target).
 */
import type { Source } from '@/types';
import { uiOf } from '@/i18n/ui';

interface Props {
  sources: Source[];
  id?: string;
}

const { sources, id = 'zrodla' } = Astro.props;
const publishers = [...new Set(sources.map((s) => s.publisher))];
const t = uiOf(Astro.url).sources;
---
{sources.length > 0 && (
  <details class="sources" id={id}>
    <summary class="sources__head">
      <h2 class="sources__title">{t.title} <span>{sources.length}</span></h2>
      <span class="sources__preview">{publishers.join(' · ')}</span>
    </summary>
    <ol>
      {sources.map((s, i) => (
        <li id={`${id}-${i + 1}`}>
          <p class="sources__meta">{s.publisher}{s.date && <span> · {s.date}</span>}</p>
          <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
        </li>
      ))}
    </ol>
    <p class="sources__note">{t.note}</p>
  </details>
)}

<style>
  .sources, li { scroll-margin-top: 8px; }

  .sources__head {
    display: flex; align-items: center; gap: 16px;
    padding-bottom: 14px; border-bottom: 1px solid var(--ink);
    cursor: pointer; list-style: none;
  }
  .sources__head::-webkit-details-marker { display: none; }
  .sources__head::after { content: "+"; margin-left: auto; font: 400 1.125rem/1 var(--f-mono); color: var(--blue); }
  .sources[open] .sources__head::after { content: "–"; }
  .sources__head:hover .sources__title { color: var(--ink); }

  .sources__title {
    display: flex; flex: none; align-items: center; gap: 10px;
    font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
    transition: color .2s;
  }
  .sources__title span { padding: 2px 6px; background: var(--blue-50); color: var(--blue); }
  .sources__preview { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font: 400 0.75rem/1.3 var(--f-mono); color: var(--muted); }
  .sources[open] .sources__preview { visibility: hidden; }

  ol { counter-reset: src; }
  li {
    counter-increment: src;
    position: relative; padding: 14px 0 14px 40px; border-bottom: 1px solid var(--line);
    transition: background-color 1.2s;
  }
  /* pozycja, do której prowadził link — krótkie wyróżnienie */
  li:target { background: var(--blue-50); transition: none; }
  li::before { content: counter(src, decimal-leading-zero); position: absolute; left: 0; top: 16px; font: 400 0.75rem/1 var(--f-mono); color: var(--blue); }
  .sources__meta { font: 400 0.75rem/1.4 var(--f-mono); color: var(--muted); margin-bottom: 4px; }
  a { font-size: 0.96875rem; line-height: 1.5; color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  a:hover { color: var(--blue); text-decoration-color: currentColor; }
  .sources__note { margin-top: 14px; font: 400 0.75rem/1.5 var(--f-mono); color: var(--muted); }
</style>
