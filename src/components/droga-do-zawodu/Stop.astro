---
/**
 * Przystanek drogi; wszystkie stoją jeden pod drugim, a lata przy nazwie przelicza Planner. Po lewej biegnie linia, którą
 * `Road` wypełnia (`--p`) do miejsca czytania. Na ostatnim przystanku kończy ją pełny kwadrat z rokiem tytułu specjalisty.
 * W środku dwie kolumny: pytanie i objaśnienie ze źródłami, obok narzędzie (slot domyślny).
 * Pod nimi na całą szerokość: „czego nie wiadomo” i teksty przystanku (slot `texts`).
 */
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import type { RoadStop } from '@/data/droga-do-zawodu';
import { localeOf } from '@/i18n/locales';
import { linkAttrs } from '@/lib/links';
import { typo } from '@/lib/format';

interface Props {
  stop: RoadStop;
  n: number;
  total: number;
}

const { stop, n, total } = Astro.props;
const last = n === total;
const en = localeOf(Astro.url.pathname) === 'en';
const { startLabels } = en ? await import('@/data/en/droga-do-zawodu') : await import('@/data/droga-do-zawodu');
const T = en
  ? { stop: 'Stop', of: 'of', change: 'Change the year of your matura', sources: 'Sources:', unknown: 'What is not known', finish: 'Specialist title: at the earliest' }
  : { stop: 'Przystanek', of: 'z', change: 'Zmień rok matury', sources: 'Źródła:', unknown: 'Czego nie wiadomo', finish: 'Tytuł specjalisty: najwcześniej' };
---
<section class:list={['stop', { 'stop--last': last }]} id={stop.id} data-stop>
  <span class="stop__fill" aria-hidden="true"></span>
  <span class="stop__mark" aria-hidden="true"></span>
  <div class="stop__grid">
    <div class="stop__side">
      <Eyebrow>{`${T.stop} ${n} ${T.of} ${total} · `}{typo(stop.name)}</Eyebrow>
      <Heading punct="?" class="stop__title">{typo(stop.question)}</Heading>
      <p class="stop__when">
        <span data-road={stop.span}>{startLabels[stop.span]}</span>
        {stop.length && <> · <span data-road={stop.length.key}>{stop.length.label}</span></>}
        <a class="stop__change" href="#twoja-droga" data-road-controls hidden>{T.change}</a>
      </p>
      <p class="stop__lead">{typo(stop.lead)}</p>
      <div class="stop__body">
        {stop.body.map((p) => <p set:html={typo(p)} />)}
      </div>
      <p class="stop__src">{T.sources} {stop.sources.map((s, i) => <>{i > 0 && ', '}<a {...linkAttrs(s.href)}>{s.label}</a></>)}.</p>
    </div>
    <div class="stop__main"><slot /></div>
    <dl class="stop__seen">
      <dt>{T.unknown}</dt>
      <dd>{typo(stop.unknown)}</dd>
    </dl>
    <div class="stop__texts"><slot name="texts" /></div>
  </div>
  {last && (
    <p class="stop__finish">
      <span class="stop__finish-mark" aria-hidden="true"></span>
      {T.finish} <strong data-road="end">{startLabels.end}</strong>
    </p>
  )}
</section>

<style>
  .stop { position: relative; padding: 0 0 clamp(72px, 9vw, 112px) 48px; }

  /* linia ścieżki: szara, kobalt do miejsca czytania; kwadrat to przystanek */
  .stop::before { content: ""; position: absolute; top: 0; bottom: 0; left: 6px; border-left: 3px solid var(--line-2); }
  .stop__fill { position: absolute; top: 0; left: 6px; height: calc(var(--p, 0) * 100%); border-left: 3px solid var(--blue); }
  .stop__mark { position: absolute; top: 0; left: 0; width: 15px; height: 15px; background: var(--line-2); transition: background .2s; }
  .stop.is-reached .stop__mark { background: var(--blue); }

  /* ostatni przystanek: linia dochodzi do kwadratu z rokiem tytułu specjalisty i tam się kończy */
  .stop--last { padding-bottom: 0; }
  .stop--last::before { bottom: 12px; }
  .stop--last .stop__fill { max-height: calc(100% - 12px); }
  .stop__finish { position: relative; margin-top: 64px; font: 400 clamp(1.25rem, 2vw, 1.5rem)/1.2 var(--f-display); letter-spacing: -0.02em; color: var(--ink); }
  .stop__finish strong { font-weight: 500; }
  .stop__finish-mark { position: absolute; bottom: 4px; left: -48px; width: 15px; height: 15px; background: var(--line-2); transition: background .2s; }
  .stop.is-done .stop__finish-mark { background: var(--blue); }

  .stop__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px clamp(40px, 5vw, 72px); align-items: start; }

  .stop :global(.stop__title) { font-size: clamp(1.875rem, 3vw, 2.625rem); line-height: 1.1; max-width: 14em; }
  .stop__when { margin-top: 14px; font: 500 0.875rem/1.5 var(--f-mono); color: var(--ink); }
  .stop__change { display: block; font: 500 0.8125rem/1.5 var(--f-body); color: var(--blue-700); text-underline-offset: 3px; }
  .stop__lead { margin-top: 16px; font-size: 1.125rem; line-height: 1.6; color: var(--text-strong); }
  .stop__body { display: grid; gap: 14px; margin-top: 14px; font-size: 1.0625rem; line-height: 1.65; color: var(--text); }
  .stop__body :global(strong) { color: var(--ink); font-weight: 600; }
  .stop__src { margin-top: 12px; font-size: 0.8125rem; line-height: 1.5; color: var(--muted); }
  .stop__src a { color: var(--blue-700); text-underline-offset: 3px; }

  /* na całą szerokość, żeby zamykało cały przystanek: objaśnienie i narzędzie */
  .stop__seen { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4px clamp(40px, 5vw, 72px); margin: 0; padding-top: 20px; border-top: 1px solid var(--line-2); }
  .stop__seen dt { font: 500 0.6875rem/1.6 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .stop__seen dd { margin: 0; font-size: 1rem; line-height: 1.55; color: var(--text-strong); }

  .stop__main { display: grid; gap: 36px; min-width: 0; }
  /* etykieta narzędzia: jak nagłówek listy tekstów */
  .stop__main :global(.tool-head) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px; padding-bottom: 12px; border-bottom: 1px solid var(--ink); }

  .stop__texts { grid-column: 1 / -1; display: grid; gap: 48px; min-width: 0; }

  @media (max-width: 1024px) {
    /* jedna kolumna: pytanie z objaśnieniem, narzędzie, teksty przystanku */
    .stop__grid { grid-template-columns: minmax(0, 1fr); row-gap: 40px; }
  }

  /* telefon: bez linii z boku, szerokość zostaje dla treści */
  @media (max-width: 720px) {
    .stop__seen { grid-template-columns: minmax(0, 1fr); }
    .stop { padding-left: 0; padding-bottom: 72px; }
    .stop--last { padding-bottom: 0; }
    .stop::before, .stop__fill, .stop__mark, .stop__finish-mark { display: none; }
    .stop__finish { margin-top: 48px; }
  }
</style>
