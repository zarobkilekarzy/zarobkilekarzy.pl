---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareRow from '../components/ShareRow.astro';
import HubSekcje from '../components/HubSekcje.astro';
import { stronyDzialu, strona } from '../lib/pages';

const stats = [
  { n: '300 tys.', u: 'zł / dzień', cap: 'Rekordowy dzień neurochirurga (zarzut — sprawa w toku).', href: '/dane/rekordy/', hot: true },
  { n: '316 079', u: 'zł / mies.', cap: 'Najwyższy kontrakt — w regionie, którego szpitale mają 1,4 mld zł długu.', href: '/dane/rekordy/', hot: true },
  { n: '0', u: 'rejestrów', cap: 'Publicznych rejestrów sumujących wypłaty jednego lekarza. To sedno problemu.', href: '/postulat/', core: true },
  { n: '~73%', u: 'na kontrakcie', cap: 'Specjalistów rozlicza się na B2B — a kwot tych kontraktów nikt nie publikuje.', href: '/dane/rozklad-wynagrodzen/' },
  { n: '4,2', u: 'miesiąca', cap: 'Kolejka do specjalisty — mimo budżetu NFZ realnie ×2 od 2015 r.', href: '/dane/kolejki/' },
  { n: '34', u: 'mld zł', cap: 'Dług szpitali — idzie głównie na pensje wypłacane „na kredyt”.', href: '/dane/zadluzenie-szpitali/' },
  { n: '4,9', u: 'mln zł / rok', cap: 'Najwyższy roczny dochód lekarza ujawniony w jawnych oświadczeniach majątkowych (analiza 160 lekarzy-radnych).', href: '/dane/rekordy/' },
  { n: '5,9', u: 'piel. / 1000', cap: 'Pielęgniarek na 1000 mieszkańców — vs 9,2 średniej OECD. Najliczniejszy, najstarszy i najbardziej przetrzebiony zawód OZ.', href: '/dane/personel-medyczny/' },
];

const podstrony = [
  ...stronyDzialu('dane'),
  // Gość z działu analiz — liczby porównawcze pasują do huba danych.
  strona('/analizy/zarobki-lekarzy-polska-sasiedzi'),
];
---

<BaseLayout
  title="Dane — zarobkilekarzy.pl"
  description="Dane o wydatkach publicznych, wynagrodzeniach i dostępności świadczeń — każda liczba z podaniem źródła."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Liczby</p>
      <h1>Dane</h1>
      <p class="lead">
        Zestawiamy wydatki publiczne, wynagrodzenia i dostępność świadczeń dla pacjenta.
        Zasada jest jedna: <strong>żadnej liczby bez źródła</strong>. Każdą oznaczamy jako
        <em>dokładną</em> albo <em>szacunek</em> i nie mieszamy tych kategorii.
      </p>

      <HubSekcje strony={podstrony} poziom={3} zwarta />

      <p class="eyebrow" style="margin-top: 2.5rem">Na start</p>
      <h2 style="margin-top: 0.1rem">Osiem liczb, które pokazują skalę</h2>
      <p class="muted" style="max-width: 62ch; margin: 0.35rem 0 0.25rem">
        Najmocniejsze dane z całego serwisu w jednym miejscu. Kliknij dowolną, by wejść
        głębiej — z pełnym rozbiciem i źródłami.
      </p>
      <div class="stats-grid">
        {stats.map((s) => (
          <a class={`dstat${s.hot ? ' is-hot' : ''}${s.core ? ' is-core' : ''}`} href={s.href}>
            <span class="dstat-num">{s.n}<span class="dstat-unit">{s.u}</span></span>
            <span class="dstat-cap">{s.cap}</span>
            <span class="dstat-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <p class="source-note" style="margin-top: 2rem">
        Nie publikujemy liczb „z pamięci”. Dopóki pole nie ma źródła, pozostaje oznaczone jako „—”.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ShareRow heading="Pomóż nagłośnić sprawę:" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Osiem liczb jako rząd tablicy: liczby rozdzielone liniami, bez kafli.
     Sztywne cztery kolumny trzymają 4 + 4 (2 × 4 na tablecie), więc blok
     czyta się jako komplet. Czerwień tylko przy „0 rejestrów” — to brakująca
     suma, jak „?” w równaniu na stronie głównej. */
  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 1.5rem 0 2rem; border-top: 2px solid var(--rule); border-bottom: 1px solid var(--line); }
  .dstat { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem 1.5rem 1.25rem; text-decoration: none; color: inherit; border-left: 1px solid var(--line); }
  .dstat:nth-child(4n + 1) { border-left: 0; padding-left: 0; }
  .dstat:nth-child(n + 5) { border-top: 1px solid var(--line); }
  .dstat-num { font-size: var(--fs-h1); font-weight: 800; font-stretch: 104%; line-height: 0.95; letter-spacing: -0.025em; color: var(--ink); white-space: nowrap; }
  .dstat.is-core .dstat-num { color: var(--signal); }
  .dstat-unit { display: block; margin-top: 0.45rem; font-size: var(--fs-label); font-weight: 600; font-stretch: 85%; letter-spacing: 0; color: var(--ink-faint); }
  .dstat-cap { font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.5; text-wrap: pretty; }
  .dstat-go { margin-top: auto; font-weight: 700; color: var(--ink-faint); }
  .dstat:hover .dstat-cap { color: var(--ink); }
  .dstat:hover .dstat-go { color: var(--brand-link); }
  .dstat:focus-visible { outline-offset: -2px; }
  @media (max-width: 900px) {
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dstat, .dstat:nth-child(4n + 1) { border-left: 1px solid var(--line); padding-left: 1.5rem; }
    .dstat:nth-child(2n + 1) { border-left: 0; padding-left: 0; }
    .dstat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: 1fr; }
    .dstat, .dstat:nth-child(4n + 1), .dstat:nth-child(2n + 1) { border-left: 0; padding: 1.25rem 0; }
    .dstat:nth-child(n + 2) { border-top: 1px solid var(--line); }
  }
</style>
