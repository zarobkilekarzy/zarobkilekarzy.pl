---
/** Etykieta dokładności danych: „Dokładna” / „Szacunek”. */
import type { Accuracy } from '@/types';
import { uiOf } from '@/i18n/ui';

interface Props {
  accuracy: Accuracy;
}

const t = uiOf(Astro.url);
const LABEL: Record<Accuracy, string> = { exact: t.blocks.exact, est: t.blocks.estimate };
const { accuracy } = Astro.props;
---
<span class:list={['flag', `flag--${accuracy}`]}>{LABEL[accuracy]}</span>

<style>
  .flag {
    display: inline-block; padding: 3px 6px;
    font: 500 0.65625rem/1.2 var(--f-mono); letter-spacing: .06em; text-transform: uppercase;
  }
  .flag--exact { background: var(--blue-50); color: var(--blue-700); }
  .flag--est { background: var(--amber-bg); color: var(--amber); }
</style>
