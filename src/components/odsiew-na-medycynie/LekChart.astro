---
/**
 * Wynik LEK uczelni względem średniej sesji — słupki od zera w obie strony (BarChart rysuje
 * tylko wartości dodatnie). Kobalt = uczelnie „nowe”, łupek = „stare”; ciągła włoskowa linia
 * zera biegnie od podpisu „średnia sesji” przez wszystkie wiersze (jak średnia w BarChart).
 * Wartość stoi za końcem słupka: przy dodatnich po prawej, przy ujemnych po lewej.
 * Szeroko: nazwa uczelni w kolumnie obok słupka; wąsko (Figure < 560 px): nad słupkiem.
 * Statycznie, bez JS. Dane: data/odsiew-na-medycynie.ts (LEK).
 * Dwujęzyczny: na stronach /en/ napisy z T.en, nazwy uczelni i wartości z data/en/odsiew-na-medycynie.ts;
 * wyjście polskie bez zmian.
 */
import Figure from '@/components/blocks/Figure.astro';
import { LEK, LEK_SCALE, LINKS, lekDisplay } from '@/data/odsiew-na-medycynie';
import { formatNumber } from '@/lib/format';
import { localeOf } from '@/i18n/locales';

const { min, max } = LEK_SCALE;
const range = max - min;
/** położenie zera na skali (0–1) */
const zero = -min / range;
const rows = LEK.map((r) => ({
  ...r,
  start: (Math.min(r.diff, 0) - min) / range,
  width: Math.abs(r.diff) / range,
  negative: r.diff < 0,
}));
const locale = localeOf(Astro.url.pathname);
// moduł EN tylko na stronach /en/ — jego strażniki (brak tłumaczenia = błąd) nie mogą zatrzymać polskiego buildu
const { schoolEN, lekDisplayEN } = (localeOf(Astro.url.pathname) === 'en' ? await import('@/data/en/odsiew-na-medycynie') : {}) as typeof import('@/data/en/odsiew-na-medycynie');
const en = locale === 'en';
const school = (name: string) => (en ? schoolEN(name) : name);
const display = en ? lekDisplayEN : lekDisplay;

const T = {
  pl: {
    title: 'Egzamin końcowy: uczelnie „stare” i „nowe” są wymieszane, wyraźnie odstają dwie nowe',
    note: 'Średni wynik zdających po raz pierwszy (egzamin po polsku) minus średnia sesji, w punktach na 200; sześć sesji od wiosny 2024 do jesieni 2026, ważone liczbą zdających. Kobaltem — uczelnie „nowe” (podział jak w ankiecie NIL). Uczelnia Medyczna im. M. Skłodowskiej-Curie: 56 zdających w trzech sesjach od jesieni 2025. Średnio: „stare” +0,3 pkt i 97,2% zdało, „nowe” −1,4 pkt i 95,3%.',
    source: 'CEM, statystyka LEK — zdający po raz pierwszy; obliczenia własne',
    zero: 'średnia sesji',
    newTag: ' · nowa',
    sr: (passed: number) => ` pkt względem średniej sesji; zdało ${formatNumber(passed, 1, 'pl')}%`,
  },
  en: {
    title: 'Final examination: “old” and “new” universities are mixed together, two new ones clearly stand out',
    note: 'Average score of first-time candidates (examination in Polish) minus the session average, in points out of 200; six sessions from spring 2024 to autumn 2026, weighted by the number of candidates. In cobalt — “new” universities (as classified in the NIL survey). Maria Skłodowska-Curie Medical College: 56 candidates in three sessions since autumn 2025. On average: “old” +0.3 points and 97.2% passed, “new” −1.4 points and 95.3%.',
    source: 'CEM, LEK statistics — first-time candidates; our calculations',
    zero: 'session average',
    newTag: ' · new',
    sr: (passed: number) => ` points relative to the session average; ${formatNumber(passed, 1, 'en')}% passed`,
  },
}[locale];
---
<Figure
  title={T.title}
  note={T.note}
  source={{ label: T.source, href: LINKS.cem }}
>
  <div class="dev" style={`--z: ${zero}`}>
    <p class="dev__zero" aria-hidden="true"><span>{T.zero}</span></p>
    <ol class="dev__rows">
      {rows.map((r) => (
        <li class:list={['dev__row', { 'dev__row--hi': r.type === 'nowa' }]} style={`--s: ${r.start}; --w: ${r.width}`}>
          <span class="dev__label">{school(r.school)}{r.type === 'nowa' && <em>{T.newTag}</em>}</span>
          <span class="dev__track">
            <span class="dev__bar" aria-hidden="true"></span>
            <span class:list={['dev__value', { 'dev__value--neg': r.negative }]}>
              {display(r.diff)}<span class="sr-only">{T.sr(r.passed)}</span>
            </span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</Figure>

<style>
  /* Zapytania o szerokość idą do kontenera Figure (.fig ma container-type) */
  .dev {
    /* --pad: miejsce na wartość po obu stronach skali; --lab: kolumna nazw (wąsko 0) */
    --pad: 3rem; --lab: 0px; --gap: 12px; --bar: 12px;
    /* x zera w wierszu: kolumna nazw + margines + część skali */
    --zero-x: calc(var(--lab) + var(--pad) + (100% - var(--lab) - 2 * var(--pad)) * var(--z));
  }
  .dev__rows { display: grid; gap: var(--gap); margin: 0; padding: 0; list-style: none; }
  .dev__row { position: relative; display: grid; gap: 6px; }

  /* Nazwa nad linią zera — tło wycina linię (jak etykiety przy średniej w BarChart) */
  .dev__label {
    position: relative; z-index: 1; justify-self: start; padding-right: 6px; background: var(--under);
    font: 400 0.875rem/1.3 var(--f-body); color: var(--ink);
  }
  .dev__label em { font-style: normal; color: var(--muted); }

  .dev__track { position: relative; display: block; height: var(--bar); margin-inline: var(--pad); }
  .dev__bar {
    position: absolute; top: 0; bottom: 0;
    left: calc(var(--s) * 100%); width: max(2px, var(--w) * 100%);
    background: var(--chart);
  }
  .dev__row--hi .dev__bar { background: var(--blue); }

  .dev__value {
    position: absolute; top: 50%; transform: translateY(-50%);
    left: calc((var(--s) + var(--w)) * 100% + 8px);
    font: 400 1rem/1 var(--f-display); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
    color: var(--ink); white-space: nowrap;
  }
  .dev__value--neg { left: auto; right: calc((1 - var(--s)) * 100% + 8px); }

  /* Linia zera: każdy wiersz rysuje odcinek od przerwy nad sobą do dołu słupka,
     odcinki się zazębiają; pierwszy dochodzi do kreski podpisu nad wykresem */
  .dev__row::after {
    content: ""; position: absolute; top: calc(-1 * var(--gap)); bottom: 0; left: var(--zero-x);
    width: 1px; background: var(--ink);
  }
  .dev__row:first-child::after { top: -10px; }

  .dev__zero { position: relative; height: 26px; margin: 0 0 10px; }
  .dev__zero span {
    position: absolute; bottom: 0; left: var(--zero-x);
    padding-left: 8px; border-left: 1px solid var(--ink);
    font: 500 0.65625rem/1.6 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink); white-space: nowrap;
  }

  /* Szeroko: nazwa w kolumnie po lewej, słupek obok */
  @container (min-width: 560px) {
    .dev { --lab: calc(15rem + 16px); --gap: 8px; }
    .dev__row { grid-template-columns: 15rem minmax(0, 1fr); column-gap: 16px; align-items: center; }
    .dev__label { justify-self: end; padding: 0; text-align: right; background: none; }
  }
</style>
