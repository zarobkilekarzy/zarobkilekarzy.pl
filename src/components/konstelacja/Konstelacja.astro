---
/**
 * „Konstelacja ochrony zdrowia” — graf powiązań (<zl-konstelacja>, kod klienta: ./client.ts, logika: lib/konstelacja).
 * Na komputerze graf + panel boczny (fakty, źródła, analiza), na telefonie graf nad panelem.
 * Panel i podpisy rysuje skrypt, więc style są globalne, ale wszystkie pod `.kst`.
 * Logotypy partii: oryginały z src/assets/partie/ (te same co w barometrze i półkolu), zawsze na białej plakietce.
 */
import { getImage } from 'astro:assets';
import centrumLogo from '@/assets/partie/centrum.png';
import koLogo from '@/assets/partie/ko.svg';
import lewicaLogo from '@/assets/partie/lewica.png';
import pisLogo from '@/assets/partie/pis.svg';
import polska2050Logo from '@/assets/partie/polska2050.png';
import pslLogo from '@/assets/partie/psl.svg';
import rozwojLogo from '@/assets/partie/rozwoj.png';

// nazwa partii w graf.json → logo (wysokość 48 px wystarcza na plakietkę 16 px przy gęstości 3×)
const LOGOS = {
  KO: koLogo, PiS: pisLogo, PSL: pslLogo, Lewica: lewicaLogo,
  'Rozwój Plus': rozwojLogo, 'Polska 2050': polska2050Logo, Centrum: centrumLogo,
};
const logos = Object.fromEntries(await Promise.all(Object.entries(LOGOS).map(async ([name, src]) =>
  [name, (await getImage({ src, height: 48 })).src])));
---
<zl-konstelacja class="kst">
  <script type="application/json" class="kst-config" set:html={JSON.stringify({ logos })} />

  <div class="kst-bar" role="toolbar" aria-label="Filtry grafu">
    <div class="kst-row">
      <div class="group hist" role="group" aria-label="Historia">
        <button class="btn" id="kst-hist-back" type="button" aria-label="Wstecz" title="Wstecz (Alt+←)" disabled>←</button>
        <button class="btn" id="kst-hist-fwd" type="button" aria-label="Dalej" title="Dalej (Alt+→)" disabled>→</button>
      </div>
      <input type="search" id="kst-search" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="kst-suggest" aria-expanded="false" placeholder="Szukaj osoby, instytucji albo faktu" aria-label="Szukaj osoby lub instytucji; Enter szuka też w treści faktów i w źródłach" title="Nazwa z listy otwiera węzeł. Enter przy innym tekście: wyniki w osobach, treści faktów i źródłach." />
      <div class="picks">
        <details class="pick" data-pick="mode">
          <summary><span id="kst-mode-label">Rdzeń</span> <em id="kst-mode-n"></em></summary>
          <div class="pop" role="group" aria-label="Kogo pokazać">
            <button class="opt is-on" data-mode="core" type="button" aria-pressed="true"><b>Rdzeń</b><span>Osoby z funkcjami w co najmniej dwóch sektorach (np. rząd i szpital) albo powiązane z inną osobą. Reszta kryje się pod licznikami „+N”, a drobne miejsca z jedną osobą zbiera węzeł sektora.</span></button>
            <button class="opt" data-mode="all" type="button" aria-pressed="false"><b>Wszyscy</b><span>Wszystkie osoby z grafu. Nazwiska mają osoby z rdzenia, reszta po najechaniu albo przybliżeniu.</span></button>
            <p class="pop-h">Najwięcej powiązań</p>
            <div class="names" id="kst-hubs"></div>
          </div>
        </details>
        <details class="pick" data-pick="sectors">
          <summary id="kst-sectors-label">Wszystkie sektory</summary>
          <div class="pop" role="group" aria-label="Sektory">
            <p class="pop-note">Pokaż tylko osoby z funkcją w wybranych sektorach. Liczba to osoby w całym grafie.</p>
            <div class="optlist" id="kst-sectors"></div>
            <button class="linkish" type="button" data-clear>Wszystkie sektory</button>
          </div>
        </details>
        <details class="pick" data-pick="period">
          <summary id="kst-period-label">Cały okres</summary>
          <div class="pop period" role="group" aria-label="Okres">
            <button class="opt" data-period="now" type="button" aria-pressed="false"><b>Teraz</b><span>Trwające funkcje i fakty z ostatnich 2 lat</span></button>
            <button class="opt is-on" data-period="all" type="button" aria-pressed="true"><b>Cały okres</b><span>Wszystkie fakty, od 2005 r.</span></button>
            <p class="pop-h">Wybrane lata <span id="kst-period-range"></span></p>
            <span class="years">
              <input type="range" id="kst-y0" min="2005" max="2027" step="1" value="2005" aria-label="Początek okresu (rok)" />
              <input type="range" id="kst-y1" min="2005" max="2027" step="1" value="2027" aria-label="Koniec okresu (rok)" />
            </span>
            <span class="years-axis" aria-hidden="true"><span>2005</span><span>2015</span><span>2026</span></span>
            <button class="btn" id="kst-play" type="button" aria-pressed="false">Rok po roku</button>
          </div>
        </details>
        <details class="pick" data-pick="lines">
          <summary>Linie i pewność</summary>
          <div class="pop pop--wide"><div class="legend-body" id="kst-legend-body"></div><div id="kst-defs"></div></div>
        </details>
      </div>
    </div>
    <div class="asks" role="group" aria-label="Pytania do grafu">
      <button class="ask" type="button" data-ask="path" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="3.5" cy="4" r="2"/><circle cx="14.5" cy="14" r="2"/><path d="M5.5 4h4a3 3 0 0 1 0 6h-2a2 2 0 0 0 0 4h5"/></svg><b>Jak są połączeni?</b><span>Najkrótsza ścieżka między dwiema osobami albo instytucjami</span></button>
      <button class="ask" type="button" data-ask="cmp" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="6" cy="9" r="4.5"/><circle cx="12" cy="9" r="4.5"/></svg><b>Co ich łączy?</b><span>Porównanie dwóch osób: wspólne instytucje i lata</span></button>
      <button class="ask" type="button" data-ask="bridges" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M1.5 13c3-6 12-6 15 0M5 9.6V13M9 8.5V13M13 9.6V13M1.5 13h15"/></svg><b>Kto łączy sektory?</b><span>Osoby i powiązania, które spinają odległe części grafu</span></button>
      <button class="ask" type="button" data-ask="srcs" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 2h7l3 3v11H4z"/><path d="M7 8h5M7 11h5M7 14h3"/></svg><b>Na czym to stoi?</b><span>Ile faktów stoi na każdym źródle i wydawcy</span></button>
    </div>
    <div class="theses" id="kst-theses" role="group" aria-label="Widoki: jedna teza, kilkanaście węzłów"></div>
  </div>

  <div class="kst-layout">
    <section class="kst-stage" aria-label="Graf powiązań">
      <div class="viewbar" id="kst-viewbar" aria-live="polite"><span class="mono-label">Widok</span><b id="kst-viewbar-title"></b><button type="button" id="kst-viewbar-close">Zamknij</button></div>
      <svg class="kst-graph" aria-describedby="kst-hint"></svg>
      <p class="mono-label hint" id="kst-hint">Przeciągaj węzły · dwuklik przybliża, Shift+dwuklik oddala · „+N” rozwija ukryte osoby · Shift+klik drugiej osoby — porównanie</p>
      <div class="zoomctl" role="group" aria-label="Przybliżenie grafu">
        <button class="btn" id="kst-zoom-in" type="button" aria-label="Przybliż" title="Przybliż (albo dwuklik)">+</button>
        <input type="range" id="kst-zoom-range" aria-label="Przybliżenie" title="Przybliżenie" />
        <button class="btn" id="kst-zoom-out" type="button" aria-label="Oddal" title="Oddal (albo Shift+dwuklik)">−</button>
        <button class="btn" id="kst-zoom-fit" type="button" aria-label="Dopasuj widok" title="Dopasuj widok"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 5V1h4M9 1h4v4M13 9v4H9M5 13H1V9" /></svg></button>
        <button class="btn" id="kst-full" type="button" aria-pressed="false" aria-label="Pełny ekran" title="Pełny ekran"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path class="ico-open" d="M8 1h5v5M13 1 8.5 5.5M6 13H1V8M1 13l4.5-4.5" /><path class="ico-close" d="M1 1l12 12M13 1L1 13" /></svg></button>
        <button class="btn" id="kst-help" type="button" aria-label="Jak obsługiwać graf" title="Jak obsługiwać graf">?</button>
      </div>
      <p class="gesture-toast" id="kst-toast" role="status" aria-live="polite" hidden></p>
      <div class="intro" id="kst-intro" role="dialog" aria-labelledby="kst-intro-title" hidden>
        <p class="mono-label" id="kst-intro-title">Jak obsługiwać graf</p>
        <ul id="kst-intro-list"></ul>
        <button class="btn btn-primary" id="kst-intro-ok" type="button">Rozumiem</button>
      </div>
      <noscript><p class="kst-noscript">Graf działa z włączonym JavaScriptem. Metoda i granice danych są opisane niżej.</p></noscript>
    </section>
    <aside class="kst-panel" id="kst-panel" aria-label="Szczegóły">
      <button class="card-x" id="kst-card-close" type="button" aria-label="Zamknij szczegóły" title="Zamknij"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" /></svg></button>
      <div class="detail" id="kst-detail" aria-live="polite"></div>
    </aside>
  </div>
</zl-konstelacja>

<script>
  import data from '@/data/konstelacja/graf.json';
  import type { GraphData } from '@/lib/konstelacja/types';
  import { defineKonstelacja } from './client';

  defineKonstelacja(data as GraphData);
</script>

<style is:global>
  zl-konstelacja { display: block; }
  .kst { --kst-h: clamp(520px, calc(100svh - var(--header-h, 72px) - 120px), 860px); color: var(--text); font: 400 0.9375rem/1.55 var(--f-body); }
  .kst a { color: var(--blue); text-underline-offset: 2px; }
  .kst button, .kst input, .kst select { font: inherit; color: inherit; }
  .kst .btn, .kst .chip {
    background: var(--surface); border: 1px solid var(--line-2); padding: 5px 10px; cursor: pointer; border-radius: 0;
    font: 500 0.8125rem/1.3 var(--f-body); color: var(--text-strong);
  }
  .kst .btn:hover, .kst .chip:hover { border-color: var(--ink); color: var(--ink); }
  .kst .chip.is-on { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
  .kst .btn:disabled, .kst .btn:disabled:hover { color: var(--muted); border-color: var(--line); cursor: default; opacity: .6; }
  .kst .btn:focus-visible, .kst .chip:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .kst .hist .btn { font-size: 0.875rem; line-height: 1; padding: 5px 9px; }

  /* Podpowiedzi w polach wyszukiwania (lista pod polem, pozycja liczona w skrypcie) */
  .kst .kst-suggest {
    position: fixed; z-index: 60; margin: 0; padding: 4px 0; list-style: none; max-height: 340px; overflow-y: auto;
    background: var(--bg); border: 1px solid var(--line-2); border-top: 2px solid var(--blue);
  }
  .kst .kst-suggest li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 7px 12px; cursor: pointer;
    font-size: 0.875rem; line-height: 1.35; color: var(--text-strong);
  }
  .kst .kst-suggest li[aria-selected="true"], .kst .kst-suggest li:hover { background: var(--blue-fill); color: var(--ink); }
  .kst .kst-suggest mark { background: none; color: var(--blue); font-weight: 600; }
  .kst .kst-suggest .tp { flex: none; font: 500 0.6875rem/1.3 var(--f-body); color: var(--muted); }

  /* Pasek nad grafem: wyszukiwarka i pigułki (kogo, sektory, okres, linie), pytania do grafu, pas tez */
  .kst-bar { display: grid; gap: 12px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line-2); border-bottom: 0; }
  .kst-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .kst-bar input[type="search"] {
    flex: 1 1 280px; min-width: 0; height: 40px; padding: 0 12px; border: 1px solid var(--line-2); background: var(--bg); border-radius: 0;
    font-size: 0.9375rem;
  }
  .kst-bar input[type="search"]:focus { outline: 2px solid var(--blue); outline-offset: -1px; }
  .kst .hist .btn { height: 40px; width: 36px; padding: 0; }
  .kst .picks { display: flex; flex-wrap: wrap; gap: 8px; }
  .kst .pick { position: relative; }
  .kst .pick > summary {
    display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 12px; list-style: none; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--line-2); background: var(--surface); font: 500 0.9375rem/1 var(--f-body); color: var(--ink);
  }
  .kst .pick > summary::-webkit-details-marker { display: none; }
  .kst .pick > summary::after {
    content: ''; width: 7px; height: 7px; margin-left: 2px; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted);
    transform: translateY(-2px) rotate(45deg);
  }
  .kst .pick[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
  .kst .pick > summary:hover, .kst .pick[open] > summary { border-color: var(--ink); }
  .kst .pick > summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .kst .pick > summary em { font-style: normal; font-weight: 400; color: var(--muted); }
  .kst .pick.is-set > summary { background: var(--blue-50); border-color: var(--blue); }
  .kst .pop {
    position: absolute; z-index: 20; top: calc(100% + 6px); left: 0; width: 340px; max-width: calc(100vw - 32px);
    display: grid; gap: 4px; padding: 12px; background: var(--surface); border: 1px solid var(--ink);
    box-shadow: 0 20px 40px -16px rgb(4 11 27 / .45);
  }
  .kst .picks .pick:nth-last-child(-n+2) .pop { left: auto; right: 0; }
  .kst .pop--wide { width: 460px; max-height: min(70vh, 560px); overflow: auto; }
  .kst .opt {
    display: grid; gap: 2px; text-align: left; padding: 8px 10px; background: none; border: 0; border-left: 2px solid transparent; cursor: pointer;
  }
  .kst .opt b { font: 600 0.9375rem/1.3 var(--f-body); color: var(--ink); }
  .kst .opt span { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); }
  .kst .opt:hover { background: var(--bg-soft); }
  .kst .opt.is-on { background: var(--blue-50); border-left-color: var(--blue); }
  .kst .opt:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; }
  .kst .optlist { display: grid; }
  .kst .optlist .opt { grid-template-columns: 16px 1fr auto; align-items: center; gap: 10px; padding: 7px 8px; }
  .kst .optlist .opt::before { content: ''; width: 12px; height: 12px; border: 1.5px solid var(--line-2); background: var(--surface); }
  .kst .optlist .opt.is-on::before { background: var(--blue-fill); border-color: var(--blue-fill); box-shadow: inset 0 0 0 2px var(--surface); }
  .kst .optlist .opt b { font-weight: 500; }
  .kst .optlist .opt span { font-variant-numeric: tabular-nums; }
  .kst .pop-h { margin: 10px 0 4px; font: 600 0.8125rem/1.3 var(--f-body); color: var(--ink); }
  .kst .pop-h span { font-weight: 400; color: var(--muted); margin-left: 6px; }
  .kst .pop-note { margin: 0 0 6px; font-size: 0.8125rem; line-height: 1.4; color: var(--muted); }
  .kst .pop .linkish { justify-self: start; margin-top: 6px; font-size: 0.875rem; }
  .kst .pop .names { margin: 0; }
  .kst .years-axis { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .kst .pop #kst-play { justify-self: start; margin-top: 8px; }
  .kst .pop .legend-body { display: grid; gap: 12px; }
  #kst-defs .defs-wrap { margin-top: 14px; border-top: 1px solid var(--line); padding-top: 10px; }
  #kst-defs summary { cursor: pointer; }
  #kst-defs h3 { margin: 14px 0 8px; }

  /* Pytania do grafu: zamiast jednego przełącznika „Analiza” — cztery nazwane narzędzia */
  .kst .asks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .kst .ask {
    display: grid; grid-template-columns: 20px 1fr; gap: 2px 10px; align-content: start; text-align: left; padding: 10px 12px;
    background: var(--surface); border: 1px solid var(--line-2); cursor: pointer;
  }
  .kst .ask svg { grid-row: span 2; margin-top: 1px; fill: none; stroke: var(--blue); stroke-width: 1.6; }
  .kst .ask b { font: 600 0.9375rem/1.3 var(--f-body); color: var(--ink); }
  .kst .ask span { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); }
  .kst .ask:hover { border-color: var(--ink); }
  .kst .ask.is-on { background: var(--ink); border-color: var(--ink); }
  .kst .ask.is-on b, .kst .ask.is-on span { color: var(--on-ink); }
  .kst .ask.is-on svg { stroke: var(--on-ink); }
  .kst .ask:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }

  /* Tezy (widoki): poziomy pas kart */
  .kst .theses { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: thin; padding-bottom: 2px; }
  .kst .thesis {
    flex: 0 0 248px; display: grid; gap: 2px; align-content: start; text-align: left; padding: 9px 12px; cursor: pointer;
    background: var(--bg-soft); border: 1px solid var(--line);
  }
  .kst .thesis span { font-size: 0.8125rem; color: var(--muted); }
  .kst .thesis b { font: 600 0.875rem/1.35 var(--f-display); color: var(--ink); }
  .kst .thesis:hover { border-color: var(--ink); }
  .kst .thesis.is-on { background: var(--blue-50); border-color: var(--blue); }
  .kst .thesis:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .kst .group { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
  .kst .group .mono-label { margin: 0 2px 0 0; }
  .kst .chk { display: flex; gap: 6px; align-items: center; font-size: 0.8125rem; color: var(--text-strong); cursor: pointer; }
  .kst .chk input { margin: 0; accent-color: var(--blue-fill); }
  /* Okres: dwa suwaki lat na jednej osi (uchwyty klikalne, tor nie) */
  .kst .period .years { position: relative; display: block; width: 100%; height: 22px; }
  .kst .period .years input { position: absolute; inset: 0; width: 100%; margin: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; }
  .kst .period .years input::-webkit-slider-runnable-track { height: 2px; background: var(--line-2); }
  .kst .period .years input::-webkit-slider-thumb { pointer-events: auto; -webkit-appearance: none; width: 10px; height: 18px; margin-top: -8px; background: var(--ink); border: 2px solid var(--surface); cursor: ew-resize; }
  .kst .period .years input::-moz-range-track { height: 2px; background: var(--line-2); }
  .kst .period .years input::-moz-range-thumb { pointer-events: auto; width: 8px; height: 16px; background: var(--ink); border: 2px solid var(--surface); border-radius: 0; cursor: ew-resize; }
  .kst .period .years input:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .kst .mono-label { font: 500 0.8125rem/1.35 var(--f-body); letter-spacing: 0; text-transform: none; color: var(--muted); margin: 0; }
  .kst h3.mono-label { font-weight: 600; color: var(--ink); }

  .kst-layout { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); height: var(--kst-h); border: 1px solid var(--line-2); }
  .kst-stage {
    position: relative; min-height: 0; overflow: hidden;
    background-color: var(--bg-soft);
    background-image: radial-gradient(var(--line-2) 1px, transparent 1.2px);
    background-size: 24px 24px;
  }
  /* Jeden palec przewija stronę (pan-y), graf przesuwa się i przybliża dwoma palcami; na pełnym ekranie — każdym gestem. */
  .kst-graph { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; display: block; }
  .kst.is-full .kst-graph { touch-action: none; }
  .kst-graph:active { cursor: grabbing; }
  .kst .hint { position: absolute; left: 16px; right: 64px; bottom: 12px; pointer-events: none; }
  .kst.has-card .hint { right: calc(min(420px, 42%) + 28px); }
  .kst .gesture-toast {
    position: absolute; left: 50%; top: 50%; z-index: 3; transform: translate(-50%, -50%); max-width: calc(100% - 48px);
    margin: 0; padding: 10px 16px; background: var(--ink); color: var(--on-ink); text-align: center; pointer-events: none;
    font: 500 0.875rem/1.4 var(--f-body);
  }
  .kst .intro {
    position: absolute; left: 50%; top: 50%; z-index: 4; transform: translate(-50%, -50%); width: min(380px, calc(100% - 32px));
    padding: 18px 20px 16px; background: var(--surface); border: 1px solid var(--line-2); border-top: 2px solid var(--blue);
  }
  .kst .intro ul { margin: 10px 0 14px; padding: 0; list-style: none; display: grid; gap: 8px; }
  .kst .intro li { padding-left: 14px; border-left: 2px solid var(--line-2); font-size: 0.9375rem; line-height: 1.45; color: var(--text-strong); }
  .kst .intro li b { color: var(--ink); font-weight: 600; }
  .kst .intro .btn-primary { background: var(--ink); color: var(--on-ink); border-color: var(--ink); padding: 7px 14px; }
  .kst .zoomctl .ico-close { display: none; }
