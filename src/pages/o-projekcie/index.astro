---
/**
 * /o-projekcie/ — cel serwisu, zasady pracy, sprostowania. Bez informacji, kto prowadzi serwis
 * (decyzja redakcji z 15.10.2026). Dane: src/data/o-serwisie.ts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageMeta from '@/components/layout/PageMeta.astro';
import Prose from '@/components/article/Prose.astro';
import NumberedList from '@/components/blocks/NumberedList.astro';
import Figure from '@/components/blocks/Figure.astro';
import MiniStats from '@/components/blocks/MiniStats.astro';
import ActivityCalendar from '@/components/blocks/ActivityCalendar.astro';
import { contact, editorialRules, legalPages } from '@/data/o-serwisie';
import { commitHistory } from '@/lib/historia';
import { articleHref, getPublishedArticles } from '@/lib/content';
import { getNews, newsHref } from '@/lib/news';
import { formatDate, formatPL, plural } from '@/lib/format';
import type { Crumb, SeoInput } from '@/lib/seo';

const page = legalPages.oProjekcie;
const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: page.title }];
const seo: SeoInput = { title: page.docTitle, description: page.description, breadcrumbs: crumbs };
const mail = `mailto:${contact.email}`;

// Historia zmian z gita, liczona przy każdym buildzie (bez historii — np. płytki klon — sekcji nie ma)
// Zmienione pliki → opublikowane artykuły i aktualności po `filePath`; reszta (kod, dane, szkice) pomijana
async function changedTexts(files: Record<string, string[]>) {
  const texts = new Map<string, { label: string; href: string }>();
  for (const a of await getPublishedArticles()) if (a.filePath && !a.data.noindex) texts.set(a.filePath, { label: a.data.title, href: articleHref(a) });
  for (const n of await getNews()) if (n.filePath) texts.set(n.filePath, { label: n.data.title, href: newsHref(n) });
  return Object.fromEntries(Object.entries(files).map(([day, paths]) => [day, paths.flatMap((p) => texts.get(p) ?? [])]));
}
const history = commitHistory();
const historyStats = history && await (async () => {
  const active = Object.keys(history.days).length;
  const [peakDay, peak] = Object.entries(history.days).reduce((a, b) => (b[1] > a[1] ? b : a));
  const day = (s: string) => formatDate(new Date(`${s}T00:00:00Z`));
  return {
    title: `Strona zmienia się na bieżąco: ${formatPL(history.total)} ${plural(history.total, ['zmiana', 'zmiany', 'zmian'])} w ${active} ${active === 1 ? 'dniu' : 'dniach'}`,
    items: [
      { label: 'Zmiany (commity)', value: formatPL(history.total) },
      { label: 'Dni pracy', value: String(active) },
      { label: 'Najwięcej w dniu', value: `${peak} · ${day(peakDay).slice(0, 5)}` },
      { label: 'Ostatnia zmiana', value: day(history.last) },
    ],
    links: await changedTexts(history.files),
    label: `Kalendarz zmian w kodzie strony od ${day(history.first)} do ${day(history.today)}: ${history.total} zmian w ${active} dniach, najwięcej ${peak} dnia ${day(peakDay)}.`,
  };
})();
---
<BaseLayout seo={seo}>
  <Section space="bottom" class="about-top">
    <PageHeader title={page.title} lead={page.lead} eyebrow="O serwisie" crumbs={crumbs}>
      <PageMeta items={[{ label: 'Aktualizacja', value: page.updated }, { label: 'Kontakt', value: contact.email }]} />
    </PageHeader>
  </Section>

  <Section space="bottom">
    <Prose>
      <p>Wynagrodzenia z publicznych pieniędzy w ochronie zdrowia są w Polsce jawne tylko częściowo. Znamy ustawowe minima płac i pojedyncze umowy, ale nikt nie zestawia, ile łącznie trafia do jednej osoby z kilku miejsc pracy.</p>

      <h2 id="po-co">Po co ten serwis</h2>
      <p>Zbieramy to, co da się ustalić z ogólnodostępnych źródeł — dane, raporty kontrolne, wyroki, odpowiedzi na wnioski o informację publiczną — i pokazujemy, czego ustalić się nie da. Opisujemy, jak działa system: skąd biorą się pieniądze, jak trafiają do szpitali i lekarzy, dlaczego brakuje kadr i czego nie widać w statystykach.</p>
      <p>Nie jesteśmy przeciwko lekarzom. Jesteśmy za tym, żeby publiczny pieniądz był widoczny. Dlatego postulujemy <a href="/postulat/">jawne łączne wypłaty dla każdej osoby, pod stałym identyfikatorem i bez nazwisk</a>.</p>

      <h2 id="zasady">Zasady pracy</h2>
      <NumberedList items={editorialRules} />

      <h2 id="kto">Kto prowadzi serwis</h2>
      <p>Serwis jest prowadzony anonimowo. Nie stoi za nim żadna fundacja, firma ani organizacja. Oceniaj nas po źródłach: każda liczba ma przypis z linkiem do dokumentu, który możesz sprawdzić sam.</p>

      {history && historyStats && (
        <>
          <h2 id="historia-zmian">Historia zmian</h2>
          <p>Kod i treść serwisu są publiczne. Każda poprawka — nowy tekst, zaktualizowana liczba, sprostowanie — zostaje w historii repozytorium z datą.</p>
          <Figure
            data-i18n-skip
            title={historyStats.title}
            note="Kropka to dzień, w którym zmieniono kod albo treść strony — im mocniejsza, tym więcej zmian. Plus to dzień bez zmian. Grafika odświeża się przy każdym wydaniu strony."
            source={{ label: 'historia repozytorium zarobkilekarzy.pl (GitHub)', href: 'https://github.com/zarobkilekarzy/zarobkilekarzy.pl/commits/main/' }}
          >
            <MiniStats items={historyStats.items} />
            <div class="about-calendar">
              <ActivityCalendar days={history.days} links={historyStats.links} from={history.first} to={history.today} label={historyStats.label} />
            </div>
          </Figure>
        </>
      )}

      <h2 id="sprostowania">Sprostowania i kontakt</h2>
      <p>Widzisz błąd, nieaktualną liczbę albo źródło, które przestało działać? Napisz na <a href={mail}>{contact.email}</a>. Sprawdzamy każde zgłoszenie, a poprawiony tekst dostaje nową datę aktualizacji.</p>
      <p>Serwis ma charakter informacyjny i nie udziela porad medycznych ani prawnych. Jak traktujemy dane, opisuje <a href="/prywatnosc/">polityka prywatności</a>, a na najczęstsze zarzuty odpowiadamy w <a href="/faq/">osobnym tekście</a>.</p>
    </Prose>
  </Section>
</BaseLayout>

<style>
  .about-top { padding-top: clamp(32px, 4vw, 56px); }
  .about-calendar { margin-top: 28px; }
</style>
