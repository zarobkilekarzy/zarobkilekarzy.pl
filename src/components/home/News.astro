---
/**
 * Strona główna: trzy ostatnie aktualności — data, tytuł i lead; całość pod /aktualnosci/.
 * Na /en/ — trzy ostatnie przetłumaczone wpisy (src/i18n/news.ts), całość pod /en/news/.
 */
import { Image } from 'astro:assets';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import { formatDateIn, isoDate, typo } from '@/lib/format';
import { getNews, newsHref, newsPage, newsImage, newsThumbWhole } from '@/lib/news';
import { getPublishedNewsTranslations, newsEnHref, newsPageEn } from '@/i18n/news';
import { localeOf } from '@/i18n/locales';

const locale = localeOf(Astro.url.pathname);
const en = locale === 'en';
const text = en
  ? { id: 'news', eyebrow: 'News', title: 'What’s new in the project', all: 'All news', href: newsPageEn.href }
  : { id: 'aktualnosci', eyebrow: 'Aktualności', title: 'Co słychać w projekcie', all: 'Wszystkie aktualności', href: newsPage.href };

// Wpis na liście: polski wpis (data, zdjęcie) i tekst w języku strony
const news = (
  en
    ? (await getPublishedNewsTranslations()).map((t) => ({ href: newsEnHref(t), source: t.source, title: t.entry.data.title, summary: t.entry.data.summary }))
    : (await getNews()).map((n) => ({ href: newsHref(n), source: n, title: n.data.title, summary: n.data.summary }))
).slice(0, 3);
---
{news.length > 0 && (
  <Section id={text.id} space="bottom" aria-labelledby={`${text.id}-title`}>
    <SectionHead eyebrow={text.eyebrow} title={text.title} id={`${text.id}-title`} layout="row">
      <LinkArrow slot="action" href={text.href}>{text.all}</LinkArrow>
    </SectionHead>

    <ol class="hnews">
      {news.map((n) => (
        <li>
          <a href={n.href}>
            <Image src={newsImage(n.source).src} alt="" widths={[360, 720]} sizes="(min-width: 1025px) 400px, (min-width: 721px) 240px, calc(100vw - 32px)" class:list={['hnews__img', { 'is-whole': newsThumbWhole(n.source, 16 / 9) }]} />
            <time datetime={isoDate(n.source.data.date)}>{formatDateIn(n.source.data.date, locale)}</time>
            <h3 class="hnews__title">{typo(n.title)}</h3>
            <p class="hnews__desc">{typo(n.summary)}</p>
          </a>
        </li>
      ))}
    </ol>
  </Section>
)}

<style>
  .hnews { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 clamp(24px, 3vw, 48px); border-top: 1px solid var(--ink); }
  .hnews a { display: block; padding: 24px 0 22px; }
  .hnews :global(.hnews__img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: 0 0; margin-bottom: 16px; border: 1px solid var(--line); }
  .hnews :global(.hnews__img.is-whole) { object-fit: contain; object-position: 50% 50%; background: var(--bg-soft); }
  .hnews time { font: 400 0.75rem/1.2 var(--f-mono); letter-spacing: .02em; color: var(--muted); }
  .hnews__title { margin: 10px 0 8px; font: 500 1.125rem/1.25 var(--f-display); letter-spacing: -0.02em; color: var(--ink); transition: color .2s; }
  .hnews__desc {
    font-size: 0.90625rem; line-height: 1.55;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  }
  .hnews a:hover .hnews__title { color: var(--blue); }

  @media (max-width: 1024px) {
    .hnews { grid-template-columns: minmax(0, 1fr); }
    .hnews li + li { border-top: 1px solid var(--line); }
    .hnews a { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 0 24px; align-content: start; }
    .hnews :global(.hnews__img) { grid-row: span 3; margin-bottom: 0; }
  }
  @media (max-width: 720px) {
    .hnews a { display: block; }
    .hnews :global(.hnews__img) { margin-bottom: 16px; }
  }
</style>
