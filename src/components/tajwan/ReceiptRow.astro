---
/**
 * Wiersz rachunku (tajwan/Receipt): podpis chiński + polski, kwota i numer objaśnienia.
 * Na szerokim rachunku numer otwiera dymek (ui/Popover), na wąskim jest zwykłym znakiem
 * odsyłającym do listy pod rachunkiem. Próg: kontener figury (.fig), jak w Receipt.
 */
import type { HTMLAttributes } from 'astro/types';
import Popover from '@/components/ui/Popover.astro';
import type { ReceiptLine } from '@/data/tajwan';
import { zl } from '@/data/tajwan';
import { formatPL, typo } from '@/lib/format';

interface Props extends HTMLAttributes<'li'> {
  line: ReceiptLine;
  /** numer objaśnienia (gdy wiersz je ma) */
  n?: number;
  /** wiersz kwoty do zapłaty: duża kwota w TWD i przeliczenie na złote */
  due?: boolean;
}

const { line, n, due = false, class: className, ...rest } = Astro.props;
const heading = line.pl.charAt(0).toUpperCase() + line.pl.slice(1);
---
<li class:list={['row', { 'row--due': due }, className]} {...rest}>
  <span class="row__label"><span lang="zh-Hant">{line.zh}</span> {line.pl}</span>
  <span class="row__amount">
    {formatPL(line.amount)}{due && <> <small>TWD</small></>}
  </span>
  {line.note && n ? (
    <span class="row__note">
      <span class="row__live">
        <Popover label={`Objaśnienie ${n}: ${line.pl}`} heading={heading}>
          <Fragment slot="trigger">{n}</Fragment>
          {typo(line.note)}
        </Popover>
      </span>
      <span class="row__n" aria-hidden="true">{n}</span>
    </span>
  ) : <span></span>}
  {due && <span class="row__zl">{zl(line.amount)}</span>}
</li>

<style>
  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto 18px; align-items: baseline; gap: 10px; padding: 4px 0; }
  .row__label { min-width: 0; color: var(--text); }
  .row__label [lang] { margin-right: 4px; color: var(--ink); }
  .row__amount { font-variant-numeric: tabular-nums; text-align: right; color: var(--ink); white-space: nowrap; }
  .row__note { display: inline-flex; align-self: center; }

  /* Numer bez dymka (wąski rachunek) — ten sam znak co na liście objaśnień */
  .row__n {
    display: inline-grid; place-items: center; width: 18px; height: 18px;
    font: 500 0.65625rem/1 var(--f-mono); color: var(--blue); box-shadow: inset 0 0 0 1px var(--blue);
  }
  .row__live { display: none; }
  @container (min-width: 640px) {
    .row__live { display: inline-flex; }
    .row__n { display: none; }
  }

  /* Kwota do zapłaty */
  .row--due { align-items: center; row-gap: 2px; }
  .row--due .row__label { font-weight: 500; color: var(--ink); }
  .row--due .row__amount { font: 400 1.625rem/1 var(--f-display); letter-spacing: -0.03em; }
  .row--due small { font: 400 0.75rem/1 var(--f-body); letter-spacing: 0; color: var(--muted); }
  .row__zl { grid-column: 2; text-align: right; font-size: 0.78125rem; color: var(--muted); }
</style>
