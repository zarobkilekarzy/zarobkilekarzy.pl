// Cloudflare Workers ze statycznymi plikami (dawniej Cloudflare Pages).
// Domena zarobkilekarzy.pl jest przypięta do Workera po stronie konfiguracji strefy, nie tutaj.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zarobkilekarzy",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  // tylko domena serwisu: bez adresów *.workers.dev i adresów podglądu wersji (zdublowana treść)
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Kod tylko dla API; resztę obsługują pliki, _redirects i _headers bez wywołania Workera.
    "run_worker_first": ["/api/*"],
    // adres bez pliku i bez przekierowania → dist/404.html ze statusem 404
    "not_found_handling": "404-page"
  },
  "vars": {
    // publiczny klucz niewidocznego widżetu Turnstile modułu egzaminu (ten sam w src/lib/egzamin/stats.ts);
    // sekret TURNSTILE_EGZAMIN_SECRET_KEY to sekret Workera (wrangler secret put), nie zmienna
    "TURNSTILE_EGZAMIN_SITE_KEY": "0x4AAAAAAFRvAWnOihYqV1jZ"
  },
  // Anonimowe wyniki modułu /egzamin — jeden wiersz na ukończony test, bez IP i identyfikatorów.
  // Tabele tworzy Worker leniwie; bez bindingu /api/egzamin degraduje się łagodnie.
  "d1_databases": [
    {
      "binding": "EGZAMIN_DB",
      "database_name": "zarobki-egzamin",
      "database_id": "dd44d49b-26e8-42fa-aab0-d008e8559b30"
    }
  ]
}
