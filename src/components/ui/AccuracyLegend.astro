---
/** Legenda etykiet dokładności: co znaczy „Dokładna” i „Szacunek”. */
import Flag from './Flag.astro';
---
<ul class="legend" aria-label="Oznaczenia liczb">
  <li><Flag accuracy="exact" /> liczba z dokumentu źródłowego</li>
  <li><Flag accuracy="est" /> przybliżenie lub wyliczenie z danych</li>
</ul>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 24px; font-size: 0.84375rem; color: var(--text); }
  li { display: flex; align-items: center; gap: 8px; }
</style>
