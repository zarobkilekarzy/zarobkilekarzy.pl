---
/**
 * Strona 404 — na razie sam mechanizm: noindex, bez grafu danych strukturalnych i bez wpisu w sitemapie.
 * Cloudflare Pages serwuje dist/404.html ze statusem 404 dla każdego adresu bez pliku i bez przekierowania.
 * Treść (wyszukiwarka, popularne miejsca) dojdzie później; stare adresy obsługuje src/data/seo/redirects.ts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import type { SeoInput } from '@/lib/seo';

const seo: SeoInput = {
  title: 'Nie ma takiej strony',
  description: 'Pod tym adresem nie ma strony. Wróć na stronę główną albo użyj wyszukiwarki.',
  index: false,
};
---
<BaseLayout seo={seo}>
  <Section class="nf">
    <Eyebrow>Błąd 404</Eyebrow>
    <Heading as="h1" size="display">Nie ma takiej strony</Heading>
    <p class="lead nf__lead">Adres mógł się zmienić albo zawierać literówkę.</p>
    <p class="nf__links">
      <LinkArrow href="/">Strona główna</LinkArrow>
      <LinkArrow href="/szukaj/">Szukaj w serwisie</LinkArrow>
    </p>
  </Section>
</BaseLayout>

<style>
  .nf__lead { margin-top: 1.5rem; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; }
</style>
