---
/** Link w treści MDX (mapowany na `<a>`) — zewnętrzne otwierają się w nowej karcie, jak w reszcie serwisu. */
import type { HTMLAttributes } from 'astro/types';
import { linkAttrs } from '@/lib/links';

type Props = HTMLAttributes<'a'>;
const { href, ...rest } = Astro.props;
---
<a {...rest} {...linkAttrs(String(href ?? ''))}><slot /></a>
