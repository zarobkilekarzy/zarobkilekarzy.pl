---
/**
 * Terminy pacjenta na jednej liście, od najkrótszego. Krótkie terminy (dni) są oznaczone
 * słowem, nie tylko kolorem. Przechowywanie dokumentacji to punkt odniesienia, nie termin.
 */
import type { HTMLAttributes } from 'astro/types';
import type { Deadline } from '@/lib/pacjent/types';
import { typo } from '@/lib/format';

interface Props extends HTMLAttributes<'ol'> {
  items: Deadline[];
}

const { items, class: className, ...rest } = Astro.props;
---
<ol class:list={['deadlines', className]} {...rest}>
  {items.map((d) => (
    <li class:list={['dl', { 'dl--urgent': d.urgent, 'dl--info': d.info }]}>
      <p class="dl__value"><span class="dl__n">{d.value}</span> <span class="dl__u">{d.unit}</span></p>
      <div class="dl__text">
        <p class="dl__what">{typo(d.what)}</p>
        <p class="dl__from">{typo(d.from)} · {typo(d.basis)}</p>
      </div>
      {d.urgent && <p class="dl__tag">Krótki termin</p>}
      {d.info && <p class="dl__tag dl__tag--info">Dla porównania</p>}
    </li>
  ))}
</ol>

<style>
  .deadlines { border-top: 1px solid var(--ink); }
  .dl {
    display: grid; grid-template-columns: 8.5rem minmax(0, 1fr) 8rem; gap: 0.5rem 1.5rem; align-items: baseline;
    padding: 1.125rem 0; border-bottom: 1px solid var(--line-2);
  }
  .dl__value { display: flex; align-items: baseline; gap: 0.375rem; white-space: nowrap; }
  .dl__n { font: 400 2.5rem/1 var(--f-display); letter-spacing: -0.04em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .dl__u { font: 500 1rem/1 var(--f-display); color: var(--ink); }
  .dl__what { font: 500 1.0625rem/1.4 var(--f-body); color: var(--ink); }
  .dl__from { margin-top: 0.25rem; font-size: 0.9375rem; line-height: 1.5; color: var(--text); }

  .dl__tag {
    justify-self: end; align-self: center;
    padding: 0.375rem 0.5rem; background: var(--amber-bg); color: var(--amber);
    font: 500 0.6875rem/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap;
  }
  .dl--urgent .dl__n { color: var(--amber); }
  .dl__tag--info { background: var(--bg-soft); color: var(--text); }
  .dl--info .dl__n, .dl--info .dl__u, .dl--info .dl__what { color: var(--text); }

  @media (max-width: 720px) {
    .dl { grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0.375rem 1rem; padding: 1rem 0; }
    .dl__n { font-size: 2rem; }
    .dl__u { font-size: 0.875rem; }
    .dl__tag { grid-column: 2; justify-self: start; order: -1; }
    .dl__value { grid-row: 1 / span 2; }
  }
</style>
