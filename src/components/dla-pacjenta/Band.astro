---
/**
 * Sekcja ścieżki w układzie `blocks/QuestionBands` (/mechanizmy/): zdjęcie z liczbą i efektem monitora, obok pytanie,
 * krótka odpowiedź, narzędzie ze slotu i teksty. Zdjęcie jest przyklejone, bo narzędzie zmienia wysokość tekstu.
 */
import MonitorPhoto from '@/components/ui/MonitorPhoto.astro';
import Badge from '@/components/ui/Badge.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Icon from '@/components/ui/Icon.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import Tag from '@/components/ui/Tag.astro';
import type { Stop } from '@/data/dla-pacjenta';
import { localeOf } from '@/i18n/locales';
import { pad2, typo } from '@/lib/format';

export interface ResolvedLink {
  href: string;
  title: string;
  minutes?: number;
  /** język strony docelowej, gdy inny niż strony ze spisem */
  hreflang?: string;
}

interface Props {
  stop: Stop;
  n: number;
  main: ResolvedLink;
  more: ResolvedLink[];
  /** odsyłacz na końcu sekcji: następny krok ścieżki */
  next?: { href: string; label: string };
  flip?: boolean;
}

const { stop, n, main, more, next, flip = false } = Astro.props;
const titleId = `${stop.id}-title`;
const T = { pl: { more: 'Czytaj dalej', start: 'Zacznij tu' }, en: { more: 'Read more', start: 'Start here' } }[localeOf(Astro.url.pathname)];
---
<section class:list={['band', { 'band--flip': flip }]} id={stop.id} aria-labelledby={titleId}>
  <div class="band__media" data-reveal>
    <MonitorPhoto effect={stop.effect} src={stop.image} alt="" ratio="5/6" position={stop.position} widths={[640, 960, 1280]} sizes="(min-width: 1025px) 860px, min(150vw, 840px)" frame>
      <Badge variant="stat" value={stop.badge.value} label={stop.badge.label} note={stop.badge.note} />
    </MonitorPhoto>
  </div>
  <div class="band__body">
    <Eyebrow>{pad2(n)} · {stop.short}</Eyebrow>
    <Heading id={titleId} punct="?" class="band__question">{typo(stop.question)}</Heading>
    <p class="band__answer">{typo(stop.lead)}</p>

    <div class="band__tool"><slot /></div>

    <p class="mono-label band__label">{T.more}</p>
    <ul class="band__list" data-i18n-skip>
      <li>
        <a href={main.href}>
          <span class="band__title">{typo(main.title)}</span>
          <Tag>{T.start}</Tag>
          <Icon name="arrow" size={16} class="band__arrow" />
        </a>
      </li>
      {more.map((m) => (
        <li>
          <a href={m.href} hreflang={m.hreflang}>
            <span class="band__title">{typo(m.title)}</span>
            {m.minutes ? <span class="band__min">{m.minutes} min</span> : <span></span>}
            <Icon name="arrow" size={16} class="band__arrow" />
          </a>
        </li>
      ))}
    </ul>

    {next && <LinkArrow href={next.href} class="band__next">{typo(next.label)}</LinkArrow>}
  </div>
</section>

<style>
  .band { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 40px clamp(48px, 7vw, 112px); align-items: start; }
  .band--flip .band__media { order: 2; }
  .band__media { position: sticky; top: calc(var(--header-h) + 24px); }
  .band :global(.band__question) { margin: 18px 0 20px; max-width: 18ch; }
  .band__answer { max-width: 52ch; font-size: 1.125rem; line-height: 1.7; color: var(--ink-2); }

  .band__tool { margin-top: 36px; }
  /* etykieta narzędzia wygląda jak nagłówek listy pod spodem: mono i linia w kolorze tekstu */
  .band__tool :global(.tool-head) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px; padding-bottom: 12px; border-bottom: 1px solid var(--ink); }

  .band__label { margin: 40px 0 0; padding-bottom: 12px; border-bottom: 1px solid var(--ink); }
  .band__list a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto 16px; align-items: center; gap: 16px;
    padding: 15px 0; border-bottom: 1px solid var(--line);
  }
  .band__title { font: 500 1.0625rem/1.3 var(--f-display); letter-spacing: -0.015em; color: var(--ink); transition: color .2s; }
  .band__min { font: 400 0.75rem/1 var(--f-mono); color: var(--muted); }
  .band__list :global(.band__arrow) { color: var(--line-2); transition: color .2s, transform .3s var(--ease); }
  .band__list a:hover .band__title { color: var(--blue); }
  .band__list a:hover :global(.band__arrow) { color: var(--blue); transform: translateX(3px); }
  .band :global(.band__next) { margin-top: 24px; }

  @media (max-width: 1024px) {
    .band { grid-template-columns: minmax(0, 1fr); }
    .band--flip .band__media { order: 0; }
    /* w jednej kolumnie niższy kadr: pięć pionowych zdjęć wydłużałoby ścieżkę o kilka ekranów */
    .band__media { position: static; }
    .band__media :global(.media) { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 720px) {
    .band__answer { font-size: 1.0625rem; }
    .band__media :global(.media) { aspect-ratio: 4 / 3; }
  }
</style>
