---
/**
 * /prawa-pacjenta/sor/ — kolejki na SOR na żywo (dział „Dla pacjenta”). Najpierw dane: mapa z wykresem doby,
 * wykresy z pomiarów, tabela wszystkich SOR; potem objaśnienia (jak działa kolejka, czego dane nie mówią) —
 * zwinięte, widać same tytuły. Treść: src/data/kolejki-sor.ts. Mapa: zestaw `sor` (lib/sor/map) z warstwą na
 * żywo — migawkę sor/teraz.json co 2 minuty uzupełnia Worker workers/sor. Wykresy i tabela: historia kolejek
 * z buildu (lib/sor/history); bez niej te sekcje znikają.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Aside from '@/components/blocks/Aside.astro';
import BarChart from '@/components/blocks/BarChart.astro';
import Figure from '@/components/blocks/Figure.astro';
import SourceList from '@/components/article/SourceList.astro';
import Changelog from '@/components/article/Changelog.astro';
import PolandMap from '@/components/mapa/PolandMap.astro';
import SorDayChart from '@/components/sor/SorDayChart.astro';
import SorGrid from '@/components/sor/SorGrid.astro';
import { dayChartText, editorial, gaps, historyCharts, historyLabels, page, sources, steps } from '@/data/kolejki-sor';
import { sorHistory } from '@/lib/sor/history';
import { normText, STAGES } from '@/lib/sor/measure';
import { formatDate, isoDate, typo } from '@/lib/format';
import { getArticle } from '@/lib/content';
import type { Crumb, SeoInput } from '@/lib/seo';

const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: 'Prawa pacjenta', href: '/prawa-pacjenta/' }, { label: page.title }];
// daty: publikacja i aktualizacja (najnowszy wpis historii zmian) z wpisu kolekcji; sprawdzenie przepisów = lastReviewed
const entry = await getArticle('kolejki-sor');
const seo: SeoInput = {
  title: page.seoTitle,
  description: page.description,
  breadcrumbs: crumbs,
  dates: { published: entry.data.date, modified: entry.data.updated, reviewed: page.checked },
};
const norms = STAGES.filter((s) => s.norm != null);
const capitalize = (s: string) => s[0].toLocaleUpperCase('pl') + s.slice(1);
const history = await sorHistory();
const charts = history ? historyCharts(history) : null;
---
<BaseLayout seo={seo}>
  <Section space="bottom" class="sor-top">
    <PageHeader title={page.title} lead={page.lead} eyebrow="Dla pacjenta · na żywo" crumbs={crumbs}>
      <div class="sor-112">
        <a class="sor-112__num" href="tel:112">112</a>
        <p><strong>{typo(page.emergency.title)}</strong> <span>{typo(page.emergency.text)}</span></p>
      </div>
    </PageHeader>
  </Section>

  <Section aria-labelledby="mapa" space="bottom">
    <PolandMap set="sor" heading={{ eyebrow: 'Mapa', title: 'Kolejki na SOR teraz', id: 'mapa' }} />
    {history && history.facts.usual.length > 0 && <SorDayChart values={history.facts.usual} days={history.window.days} text={dayChartText} locale="pl" />}
  </Section>

  {history && charts && (charts.byRegion || charts.capped) && (
    <Section tone="soft" aria-labelledby={historyLabels.facts.id}>
      <SectionHead eyebrow={historyLabels.facts.eyebrow} title={historyLabels.facts.title(history.window.days)} id={historyLabels.facts.id} />
      <div class="sor-charts">
        {charts.byRegion && (
          <Figure title={charts.byRegion.title} note={charts.byRegion.note} source={charts.source}>
            <BarChart rows={charts.byRegion.rows} max={charts.byRegion.max} unit="%" average={charts.byRegion.average} averageLabel={charts.byRegion.averageLabel} caption={charts.byRegion.caption} />
          </Figure>
        )}
        <div>
          {charts.capped && (
            <Figure title={charts.capped.title} note={charts.capped.note} source={charts.source}>
              <BarChart rows={charts.capped.rows} max={charts.capped.max} unit="%" caption={charts.capped.caption} />
            </Figure>
          )}
          {charts.gap && <p class="sor-gap"><strong>{historyLabels.gap}</strong> {typo(charts.gap)}</p>}
        </div>
      </div>
    </Section>
  )}

  {history && (
    <Section aria-labelledby={historyLabels.table.id}>
      <SectionHead eyebrow={historyLabels.table.eyebrow} title={historyLabels.table.title} id={historyLabels.table.id} />
      <p class="sor-lead">{typo(historyLabels.table.lead(history))}</p>
      {/* tylko po polsku: strona EN ma w tym miejscu odnośnik do tej tabeli (integrations/i18n/qa.ts) */}
      <SorGrid history={history} src="/prawa-pacjenta/sor/dane.json" data-i18n-skip />
    </Section>
  )}

  <Section tone="soft" aria-labelledby="jak-dziala">
    <SectionHead eyebrow="Jak to działa" title="Kolejka na SOR to nie kolejka do okienka" id="jak-dziala" />
    <ol class="sor-steps">
      {steps.map((s) => (
        <li>
          <details>
            <summary><h3>{typo(s.title)}</h3></summary>
            <p>{typo(s.text)}</p>
            {s.norms && (
              <table class="sor-norms">
                <caption class="sr-only">Najdłuższy dopuszczalny czas do pierwszego kontaktu z lekarzem</caption>
                <tbody>
                  {norms.map((n) => <tr><th scope="row">{capitalize(n.color!)}</th><td class="sor-norms__api">priorytet {n.label.toLowerCase()}</td><td>{normText(n.norm!)}</td></tr>)}
                </tbody>
              </table>
            )}
            {s.link && <p><a class="sor-link" href={s.link.href}>{s.link.label} →</a></p>}
            {s.basis && <p class="sor-basis">{s.basis}</p>}
          </details>
        </li>
      ))}
    </ol>
  </Section>

  <Section aria-labelledby="ograniczenia">
    <SectionHead eyebrow="Ograniczenia danych" title="Czego te dane nie mówią" id="ograniczenia" />
    <div class="sor-gaps">
      {gaps.map((g) => (
        <details>
          <summary><h3>{typo(g.title)}</h3></summary>
          <p>{typo(g.text)}</p>
          {g.basis && <p class="sor-basis">{g.basis}</p>}
        </details>
      ))}
    </div>
    <Aside variant="editorial" title={editorial.title} class="sor-editorial">
      <p>{typo(editorial.text)}</p>
    </Aside>
    <p class="sor-checked">Przepisy i dokumenty sprawdzone <time datetime={isoDate(page.checked)}>{formatDate(page.checked)}</time>.</p>
    <SourceList sources={sources} />
    {entry.data.changelog && <Changelog entries={entry.data.changelog} class="page-log" />}
  </Section>
</BaseLayout>

<style>
  /* historia zmian pod źródłami (wpisy: frontmatter kolejki-sor.md) */
  :global(.page-log) { margin-top: 40px; }
  /* jedyny alarmowy blok strony — ten sam czerwony co „112” w karcie pomocy (components/pacjent/HelpCard) */
  .sor-112 { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 24px); max-width: 40em; margin-top: 32px; padding: clamp(16px, 2.5vw, 22px) clamp(16px, 2.5vw, 26px); border-left: 4px solid var(--bad); background: var(--bad-bg); }
  .sor-112__num { flex: none; display: grid; place-items: center; min-width: 4.75rem; height: 3.75rem; padding: 0 12px; background: var(--bad); color: var(--on-ink); font: 600 1.875rem/1 var(--f-display); letter-spacing: -0.02em; text-decoration: none; transition: background .2s; }
  .sor-112__num:hover { background: light-dark(#8f1c13, #FFB3AA); }
  .sor-112__num:focus-visible { outline: 2px solid var(--bad); outline-offset: 3px; }
  .sor-112 p { display: grid; gap: 2px; }
  .sor-112 strong { font: 600 clamp(1.25rem, 2.2vw, 1.5rem)/1.2 var(--f-display); letter-spacing: -0.015em; color: var(--bad); }
  .sor-112 span { font-size: 1rem; line-height: 1.4; color: var(--text-strong); }

  /* objaśnienia zwinięte: widać tytuły, tekst po kliknięciu */
  .sor-steps { display: grid; max-width: 46em; counter-reset: krok; border-bottom: 1px solid var(--line); }
  .sor-steps li { position: relative; padding-left: 52px; counter-increment: krok; border-top: 1px solid var(--line); }
  .sor-steps li::before { content: counter(krok, decimal-leading-zero); position: absolute; left: 0; top: 18px; font: 500 0.8125rem/1 var(--f-mono); color: var(--blue); }
  .sor-steps summary, .sor-gaps summary { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; list-style: none; cursor: pointer; }
  .sor-steps summary::-webkit-details-marker, .sor-gaps summary::-webkit-details-marker { display: none; }
  .sor-steps summary::after, .sor-gaps summary::after { content: '+'; flex: none; font: 400 1.25rem/1 var(--f-mono); color: var(--muted); }
  .sor-steps details[open] summary::after, .sor-gaps details[open] summary::after { content: '−'; }
  .sor-steps details > :not(summary), .sor-gaps details > :not(summary) { margin-bottom: 14px; }
  .sor-steps h3, .sor-gaps h3 { font: 600 1.0625rem/1.35 var(--f-display); color: var(--ink); }
  .sor-steps p, .sor-gaps p { color: var(--text); }
  .sor-charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px clamp(32px, 4vw, 56px); align-items: start; }
  .sor-gap { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line-2); font-size: 0.9375rem; color: var(--text); }
  .sor-gap strong { color: var(--ink); }
  .sor-link { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .sor-lead { max-width: 46em; margin-bottom: 24px; color: var(--text); }
  .sor-basis { margin-top: 6px; font: 400 0.75rem/1.45 var(--f-mono); color: var(--muted) !important; }

  .sor-norms { width: 100%; max-width: 30em; margin-top: 12px; border-collapse: collapse; font-size: 0.9375rem; }
  .sor-norms th, .sor-norms td { padding: 6px 0; border-top: 1px solid var(--line); text-align: left; font-weight: 400; color: var(--text-strong); }
  .sor-norms td:last-child { text-align: right; font-family: var(--f-mono); color: var(--ink); }
  .sor-norms__api { color: var(--muted) !important; font-size: 0.875rem; }

  .sor-gaps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(32px, 4vw, 56px); }
  .sor-gaps > details { border-top: 1px solid var(--line); }
  .sor-gaps p { font-size: 1rem; }
  .sor-editorial { margin-top: 48px; max-width: 46em; }
  .sor-checked { margin: 32px 0 12px; font-size: 0.875rem; color: var(--muted); }

  @media (max-width: 860px) {
    .sor-gaps, .sor-charts { grid-template-columns: 1fr; }
    .sor-steps li { padding-left: 40px; }
  }
</style>
