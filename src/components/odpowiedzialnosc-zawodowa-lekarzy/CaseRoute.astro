---
/**
 * Droga sprawy przed sądem lekarskim (artykuł „Jak działają sądy lekarskie”): lewa kolumna — samorząd
 * (rzecznik → okręgowy sąd lekarski → Naczelny Sąd Lekarski), pod granicą samorządu kasacja do Sądu Najwyższego;
 * prawa kolumna — sądy powszechne, osobno (sąd karny, odszkodowanie po kasacji lub wznowieniu).
 * Linie ciągłe = droga sprawy w samorządzie, przerywane = sprawy przed sądami spoza samorządu.
 * Na wąskim ekranie prawa kolumna wchodzi pod krok, do którego się odnosi.
 * Podstawa każdego elementu: ustawa o izbach lekarskich, t.j. Dz.U. 2021 poz. 1342.
 * Dwujęzyczny: na stronie /en/ napisy z obiektu TEXT.en (przykład prowadzi do polskiej strony sprawy); wyjście polskie bez zmian.
 */
import Figure from '@/components/blocks/Figure.astro';
import { caseHref } from '@/data/sad-lekarski';
import { localeOf } from '@/i18n/locales';
import { typo } from '@/lib/format';

const USTAWA = 'https://api.sejm.gov.pl/eli/acts/DU/2021/1342/text.pdf';

const TEXT = {
  pl: {
    title: 'Sprawa lekarza przechodzi przez dwie instancje samorządu. Poza samorząd wychodzi tylko z kasacją do Sądu Najwyższego, a gdy czyn jest też przestępstwem, osobno toczy się sprawa karna.',
    source: 'Ustawa o izbach lekarskich, art. 54, 68, 80, 90, 92, 94–97, 106 i 113a',
    lane: 'Samorząd lekarski',
    laneSide: 'Sądy powszechne — osobno',
    prosecutorK: 'Oskarża',
    prosecutorH: 'Rzecznik odpowiedzialności zawodowej',
    prosecutorD: 'Sprawdza zgłoszenie, zbiera dowody, stawia zarzuty. Odmowę wszczęcia i umorzenie pokrzywdzony może zaskarżyć.',
    request: 'wniosek o ukaranie',
    firstK: 'I instancja',
    firstH: 'Okręgowy sąd lekarski',
    firstD: 'Skład 3 osób. Może zawiesić sprawę do końca procesu karnego, a po karze karnej umorzyć ją jako niecelową.',
    criminalK: 'Gdy czyn jest przestępstwem',
    criminalH: 'Sąd karny',
    criminalD: 'Proces toczy się niezależnie od sprawy w samorządzie. Sąd może orzec m.in. zakaz wykonywania zawodu.',
    example: 'Przykład: ',
    exampleLink: 'fikcyjne ciąże i zwolnienia',
    exampleAfter: '',
    appeal: 'odwołanie · 14 dni',
    secondK: 'II instancja',
    secondH: 'Naczelny Sąd Lekarski',
    secondD: 'Skład 5 osób. Utrzymuje, zmienia albo uchyla orzeczenie; jego orzeczenie jest prawomocne z chwilą ogłoszenia.',
    border: 'Poza samorządem',
    cassation: 'kasacja · 2 miesiące — strony, minister zdrowia, Prezes NRL',
    supremeK: 'Kasacja',
    supremeH: 'Sąd Najwyższy',
    supremeD: 'Tylko rażące naruszenie prawa albo niewspółmierność kary. W katalogu dwie sprawy wróciły po wyroku SN do NSL.',
    damagesK: 'Po uniewinnieniu w kasacji lub wznowieniu',
    damagesH: 'Sąd powszechny — odszkodowanie',
    damagesD: 'Lekarz może żądać od izby odszkodowania i zadośćuczynienia za wykonaną karę.',
    legendSolid: 'droga sprawy w samorządzie',
    legendDashed: 'sprawy przed sądami spoza samorządu',
  },
  en: {
    title: 'A doctor’s case passes through two instances of the self-government. It leaves the self-government only with a cassation appeal to the Supreme Court, and if the act is also a crime, criminal proceedings run separately.',
    source: 'Act on medical chambers, Articles 54, 68, 80, 90, 92, 94–97, 106 and 113a',
    lane: 'Medical self-government',
    laneSide: 'Common courts — separately',
    prosecutorK: 'Brings the charges',
    prosecutorH: 'Disciplinary prosecutor',
    prosecutorD: 'Checks the complaint, gathers evidence, brings charges. The injured party may challenge a refusal to open proceedings and a discontinuation.',
    request: 'request for a penalty',
    firstK: 'First instance',
    firstH: 'Regional medical court',
    firstD: 'Panel of 3. May stay the case until the criminal trial ends and, after a criminal penalty, discontinue it as pointless.',
    criminalK: 'If the act is a crime',
    criminalH: 'Criminal court',
    criminalD: 'The trial runs independently of the case in the self-government. The court may impose, among other things, a ban on practising the profession.',
    example: 'Example: ',
    exampleLink: 'fictitious pregnancies and sick notes',
    exampleAfter: ' (in Polish)',
    appeal: 'appeal · 14 days',
    secondK: 'Second instance',
    secondH: 'Supreme Medical Court',
    secondD: 'Panel of 5. Upholds, amends or sets aside the decision; its decision is final once announced.',
    border: 'Outside the self-government',
    cassation: 'cassation appeal · 2 months — the parties, the minister of health, the President of the Supreme Medical Council',
    supremeK: 'Cassation appeal',
    supremeH: 'Supreme Court',
    supremeD: 'Only a flagrant breach of the law or a disproportionate penalty. In the catalogue, two cases went back to the Supreme Medical Court after a Supreme Court judgment.',
    damagesK: 'After acquittal on cassation or reopening',
    damagesH: 'Common court — compensation',
    damagesD: 'The doctor may claim damages and compensation for harm from the chamber for a penalty already served.',
    legendSolid: 'path of the case in the self-government',
    legendDashed: 'cases before courts outside the self-government',
  },
};
const t = TEXT[localeOf(Astro.url.pathname) === 'en' ? 'en' : 'pl'];
---
<Figure
  title={t.title}
  source={{ label: t.source, href: USTAWA }}
>
  <div class="rt">
    <p class="rt__lane">{t.lane}</p>
    <p class="rt__lane rt__lane--side">{t.laneSide}</p>

    <div class="rt__node">
      <p class="rt__k">{t.prosecutorK}</p>
      <p class="rt__h">{t.prosecutorH}</p>
      <p class="rt__d">{typo(t.prosecutorD)}</p>
    </div>

    <p class="rt__arrow">{t.request}</p>

    <div class="rt__node rt__node--court">
      <p class="rt__k">{t.firstK}</p>
      <p class="rt__h">{t.firstH}</p>
      <p class="rt__d">{typo(t.firstD)}</p>
    </div>
    <span class="rt__link" aria-hidden="true"></span>
    <div class="rt__side">
      <p class="rt__k">{t.criminalK}</p>
      <p class="rt__h">{t.criminalH}</p>
      <p class="rt__d">{typo(t.criminalD)}</p>
      <p class="rt__ex">{t.example}<a href={caseHref('ciaza-fikcyjna')}>{t.exampleLink}</a>{t.exampleAfter}</p>
    </div>

    <p class="rt__arrow">{t.appeal}</p>

    <div class="rt__node rt__node--court">
      <p class="rt__k">{t.secondK}</p>
      <p class="rt__h">{t.secondH}</p>
      <p class="rt__d">{typo(t.secondD)}</p>
    </div>

    <p class="rt__border">{t.border}</p>

    <p class="rt__arrow">{t.cassation}</p>

    <div class="rt__node">
      <p class="rt__k">{t.supremeK}</p>
      <p class="rt__h">{t.supremeH}</p>
      <p class="rt__d">{typo(t.supremeD)}</p>
    </div>
    <span class="rt__link" aria-hidden="true"></span>
    <div class="rt__side">
      <p class="rt__k">{t.damagesK}</p>
      <p class="rt__h">{t.damagesH}</p>
      <p class="rt__d">{typo(t.damagesD)}</p>
    </div>
  </div>
  <p class="rt__legend" aria-hidden="true"><span>{t.legendSolid}</span><span>{t.legendDashed}</span></p>
</Figure>

<style>
  /* siatka: [samorząd] [łącznik] [sądy powszechne]; wiersze w kolejności znaczników */
  .rt { display: grid; grid-template-columns: minmax(0, 1.25fr) 48px minmax(0, 1fr); align-items: stretch; }
  .rt__lane { grid-column: 1; margin: 0; padding-bottom: 10px; font: 500 0.6875rem/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .rt__lane--side { grid-column: 3; }
  .rt__node { grid-column: 1; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line-2); }
  .rt__node--court { border-color: var(--blue); }
  .rt__k { margin: 0; font: 500 0.6875rem/1.2 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--blue); }
  .rt__h { margin: 4px 0 0; font: 500 1rem/1.3 var(--f-display); color: var(--ink); }
  .rt__d { margin: 4px 0 0; font-size: 0.8125rem; line-height: 1.5; color: var(--text-strong); }
  /* strzałka w dół: linia + grot z obramowania */
  .rt__arrow { grid-column: 1; position: relative; margin: 0; min-height: 44px; padding: 10px 0 10px 28px; font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .04em; color: var(--text); }
  .rt__arrow::before { content: ""; position: absolute; left: 14px; top: 0; bottom: 6px; width: 1px; background: var(--ink); }
  .rt__arrow::after { content: ""; position: absolute; left: 10px; bottom: 0; border: 4.5px solid transparent; border-top: 7px solid var(--ink); }
  .rt__border { grid-column: 1 / -1; margin: 6px 0; padding-top: 6px; border-top: 1px dashed var(--muted); font: 500 0.6875rem/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .rt__link { grid-column: 2; align-self: center; border-top: 1px dashed var(--muted); }
  .rt__side { grid-column: 3; padding: 12px 14px; border: 1px dashed var(--muted); }
  .rt__side .rt__k { color: var(--muted); }
  .rt__ex { margin: 6px 0 0; font-size: 0.75rem; color: var(--muted); }
  .rt__ex a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; }
  .rt__ex a:hover { color: var(--blue); }
  .rt__legend { display: flex; flex-wrap: wrap; gap: 6px 24px; margin: 16px 0 0; font-size: 0.75rem; color: var(--muted); }
  .rt__legend span::before { content: ""; display: inline-block; width: 24px; margin-right: 8px; vertical-align: middle; border-top: 1px solid var(--ink); }
  .rt__legend span + span::before { border-top-style: dashed; border-color: var(--muted); }

  @media (max-width: 640px) {
    .rt { grid-template-columns: minmax(0, 1fr); }
    .rt__lane--side, .rt__link { display: none; }
    .rt__side { grid-column: 1; margin: 8px 0 0 28px; }
  }
</style>
