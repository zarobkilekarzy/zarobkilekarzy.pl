---
/** Grupa praw: wstęp sekcji (na szerokim ekranie przyklejony z lewej) i lista pytań. */
import Intro from './Intro.astro';
import RightItem from './RightItem.astro';
import type { RightsGroup } from '@/lib/pacjent/types';
import { inline, type Resolve } from '@/lib/inline';
import { plural } from '@/lib/format';

interface Props {
  group: RightsGroup;
  act: { name: string; url: string };
  resolve?: Resolve;
}

const { group, act, resolve } = Astro.props;
---
<div class="rights">
  <Intro class="rights__intro" eyebrow={group.eyebrow} title={group.title} id={`${group.id}-title`} lead={group.lead}>
    <p class="rights__count">{group.items.length} {plural(group.items.length, ['pytanie', 'pytania', 'pytań'])} · odpowiedź od razu, szczegóły po rozwinięciu</p>
  </Intro>
  <div class="rights__list">
    {group.items.map((item) => <RightItem item={item} act={act} resolve={resolve} />)}
    {group.also && (
      <section class="rights__also" aria-labelledby={`${group.id}-also`}>
        <h3 class="rights__also-title" id={`${group.id}-also`}>{group.also.title}</h3>
        <ul>
          {group.also.items.map((a) => (
            <li><span set:html={inline(a.text, resolve)} /> <span class="rights__also-basis">{a.basis}</span></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</div>

<style>
  .rights { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: 2rem clamp(40px, 6vw, 96px); align-items: start; }
  .rights :global(.rights__intro) { position: sticky; top: calc(var(--header-h) + 32px); }
  .rights__count { margin-top: 1.5rem; padding-top: 0.875rem; border-top: 1px solid var(--line-2); font: 400 0.8125rem/1.5 var(--f-mono); color: var(--text); }
  .rights__list { border-bottom: 1px solid var(--line-2); }
  .rights__also { padding: 1.75rem 0 1.5rem; border-top: 1px solid var(--line-2); }
  .rights__also-title { font: 500 1.3125rem/1.3 var(--f-display); letter-spacing: -0.015em; color: var(--ink); }
  .rights__also ul { display: grid; gap: 0.75rem; max-width: 40em; margin-top: 1rem; }
  .rights__also li { position: relative; padding-left: 1.125rem; font-size: 1rem; line-height: 1.6; color: var(--ink-2); }
  .rights__also li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 0.375rem; height: 0.375rem; background: var(--blue); }
  .rights__also :global(a) { color: var(--blue-700); text-decoration: underline; text-underline-offset: 3px; }
  .rights__also-basis { font: 500 0.8125rem/1 var(--f-mono); color: var(--text); white-space: nowrap; }

  @media (max-width: 1024px) {
    .rights { grid-template-columns: minmax(0, 1fr); }
    .rights :global(.rights__intro) { position: static; }
    .rights__count { display: none; }
  }
</style>
