---
/**
 * Poziomy wykres słupkowy w wierszach: nazwa nad słupkiem, wartość tuż za jego końcem
 * (wspólna skala od zera; --reserve to miejsce na wartość przy najdłuższym słupku).
 * Każdy wiersz ma podpisaną wartość, więc wykres nie ma osi.
 * Średnia to jedna ciągła linia od podpisu nad wykresem przez wszystkie słupki; kończy się
 * na ostatnim zwykłym wierszu — słupek porównawczy (secondary, np. „prywatnie”) nie należy do średniej.
 * Słupki „rosną” przy przewijaniu (data-reveal="grow" → .is-armed → .is-in).
 */
import type { BarRow } from '@/types';
import { formatNumber, typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';
import { uiOf } from '@/i18n/ui';

interface Props {
  rows: BarRow[];
  /** wartość odpowiadająca pełnej szerokości słupka */
  max: number;
  unit: string;
  average?: number;
  /** podpis linii zamiast „średnio X”, gdy to inna wartość odniesienia (np. „zgadywanie 20%”) */
  averageLabel?: string;
  /** dopisek pod wykresem */
  note?: string;
  /** pełny opis danych dla czytników ekranu */
  caption: string;
  /** `lg` — grube słupki i duże wartości, dla jednego mocnego porównania;
   *  `sm` — zwarty ranking: nazwa z lewej, słupek i wartość w tym samym wierszu (długie listy krajów).
   *  Bez `size` wykres od COMPACT_FROM wierszy jest zwarty sam (decyzja usera 25.11.2026: długie rankingi za wysokie). */
  size?: 'lg' | 'sm';
  /** liczba prowadząca nad wykresem (np. „2,3×”) z dopiskiem */
  lead?: { value: string; text: string };
}

const { rows, max, unit, average, averageLabel, note, caption, size, lead } = Astro.props;
// miejsce na wartość za najdłuższym słupkiem: co najmniej 96px, a dla długich etykiet („243,8 mld zł”)
// ok. 0,7rem na znak w foncie wartości + odstęp — w rem, więc rośnie razem z „Większym tekstem”
const longest = Math.max(...rows.map((row) => row.display.length));
/** od tylu wierszy wykres bez `size` przechodzi w zwarty ranking */
const COMPACT_FROM = 11;
const compact = size === 'sm' || (size === undefined && rows.length >= COMPACT_FROM);
// szerokość kolumny nazw w zwartym rankingu: według najdłuższej nazwy (z dopiskiem), dłuższe się zawijają
const labelChars = Math.max(...rows.map((row) => row.label.length + (row.note ? row.note.length + 1 : 0)));
/** nazwy dłuższe niż tyle znaków na telefonie nie mieszczą się obok słupka — tam nazwa wraca nad słupek */
const LONG_LABEL = 26;
---
<figure class:list={['bars', { 'bars--lg': size === 'lg', 'bars--sm': compact, 'bars--long': compact && labelChars > LONG_LABEL }]} data-reveal="grow" style={`--max: ${max}; --chars: ${longest}; --lchars: ${labelChars}${average !== undefined ? `; --avg: ${average}` : ''}`}>
  {lead && <p class="bars__lead" aria-hidden="true"><span class="bars__lead-value">{lead.value}</span> <span>{typo(lead.text)}</span></p>}
  {average !== undefined && (
    <p class="bars__avg" aria-hidden="true"><span>{typo(averageLabel ?? uiOf(Astro.url).blocks.average(formatNumber(average, 1, localeOf(Astro.url.pathname)), unit))}</span></p>
  )}
  <ol class:list={['bars__rows', { 'has-avg': average !== undefined }]} aria-hidden="true">
    {rows.map((row, i) => (
      <>
      {row.group && <li class="bars__group">{typo(row.group)}</li>}
      <li class:list={['bars__row', { 'bars__row--hi': row.highlight, 'bars__row--secondary': row.secondary }]} style={`--v: ${row.value}; --i: ${i}`}>
        <span class="bars__label">{typo(row.label)}{row.note && <em> {typo(row.note)}</em>}</span>
        <span class="bars__track"><span class="bars__bar"></span><span class="bars__value">{typo(row.display)}</span></span>
      </li>
      </>
    ))}
  </ol>
  {note && <p class="bars__note">{typo(note)}</p>}
  <figcaption class="sr-only">{caption}</figcaption>
</figure>

<style>
  .bars {
    flex: 1; display: flex; flex-direction: column; justify-content: center;
    --bar: 14px; --reserve: max(96px, calc(var(--chars) * 0.7rem + 12px));
    /* pozycja wartości v na skali (w szerokości wykresu) */
    --scale: calc(100% - var(--reserve));
  }
  /* Wariant duży: grube słupki, wartość w foncie nagłówków; liczba prowadząca w kobalcie */
  .bars--lg { --bar: 36px; --reserve: max(120px, calc(var(--chars) * 1.25rem + 16px)); }
  .bars--lg .bars__rows { --gap: 24px; }
  .bars--lg .bars__value { font-size: 2.25rem; font-weight: 300; }
  .bars--lg .bars__row:not(.bars__row--hi) .bars__value { color: var(--text-strong); }
  .bars__lead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin: 0 0 28px; font-size: 0.9375rem; line-height: 1.4; color: var(--text-strong); }
  .bars__lead-value { font: 300 clamp(3rem, 9cqi, 4.5rem)/1 var(--f-display); letter-spacing: -0.03em; color: var(--blue); }
  /* dwa wykresy w jednej ramce (różne miary, każda z własną skalą) */
  .bars + .bars { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); }
  .bars__rows { --gap: 20px; display: grid; gap: var(--gap); }
  .bars__row { position: relative; display: grid; gap: 8px; }
  .bars__label { font-size: 0.90625rem; line-height: 1.3; color: var(--ink); }
  .bars__label em { font-style: normal; color: var(--muted); }
  /* Nagłówek grupy: mono wersalikami, odstęp od poprzedniej grupy */
  .bars__group { margin-bottom: -8px; font: 500 0.6875rem/1.4 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .bars__group:not(:first-child) { margin-top: 12px; }

  .bars__track { position: relative; display: flex; align-items: center; gap: 12px; }
  .bars__bar {
    flex: none; height: var(--bar);
    width: max(2px, var(--v) / var(--max) * var(--scale));
    background: var(--chart);
    transform-origin: left; transition: transform 1.1s var(--ease) calc(var(--i) * 80ms);
  }
  .bars__row--hi .bars__bar { background: var(--blue); }
  .bars__value { font: 400 1.25rem/1 var(--f-display); letter-spacing: -0.03em; color: var(--ink); white-space: nowrap; transition: opacity .4s calc(var(--i) * 80ms + .7s); }

  /* Słupek do porównania (np. „prywatnie”) — cieńszy, wartość drobniej */
  .bars__row--secondary .bars__bar { height: 4px; background: var(--blue); }
  .bars__row--secondary .bars__value { font: 400 0.875rem/1.2 var(--f-body); letter-spacing: 0; color: var(--text-strong); }

  /* Średnia: podpis nad wykresem + ciągła linia. Każdy wiersz rysuje odcinek od połowy przerwy
     nad sobą do 5 px pod słupkiem, odcinki się zazębiają; pierwszy dochodzi do kreski podpisu.
     Podpis stoi na prawo od linii; gdy się tam nie mieści (wąski ekran), zawija się w górę zamiast wychodzić poza stronę. */
  .bars__avg { display: flex; align-items: flex-end; min-height: 26px; margin-bottom: 10px; }
  .bars__avg span {
    margin-left: calc(var(--avg) / var(--max) * var(--scale));
    padding-left: 8px; border-left: 1px solid var(--ink);
    font: 500 0.65625rem/1.6 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink);
  }
  .has-avg .bars__row:not(.bars__row--secondary)::after {
    content: ""; position: absolute; top: calc(-1 * var(--gap)); bottom: -5px;
    left: calc(var(--avg) / var(--max) * var(--scale)); width: 1px; background: var(--ink);
  }
  .has-avg .bars__row:first-child::after { top: -10px; }
  /* Nazwa nad linią — na wąskim ekranie średnia wypada w jej końcówce, tło wycina linię */
  .has-avg .bars__label { position: relative; z-index: 1; justify-self: start; padding-right: 6px; background: var(--under); }

  /* Wariant zwarty: kolumna nazw (--lw) i słupek w jednym wierszu; skala liczona od końca kolumny nazw,
     więc linia średniej i jej podpis przesuwają się o --lw + odstęp */
  .bars--sm { --bar: 10px; --lw: clamp(6rem, calc(var(--lchars) * 0.5rem + 8px), 42%); --col: 12px; --reserve: max(56px, calc(var(--chars) * 0.6rem + 10px)); --off: calc(var(--lw) + var(--col)); }
  .bars--sm .bars__rows { --gap: 7px; }
  .bars--sm .bars__row { grid-template-columns: var(--lw) 1fr; align-items: center; column-gap: var(--col); }
  .bars--sm .bars__label { font-size: 0.84375rem; line-height: 1.25; }
  .bars--sm .bars__row--hi .bars__label { font-weight: 600; }
  .bars--sm .bars__track { gap: 8px; }
  .bars--sm .bars__value { font: 400 0.8125rem/1 var(--f-mono); letter-spacing: 0; color: var(--text); }
  .bars--sm .bars__row--hi .bars__value { font-weight: 600; color: var(--ink); }
  .bars--sm .bars__avg span { margin-left: calc(var(--off) + var(--avg) / var(--max) * (100% - var(--off) - var(--reserve))); }
  .bars--sm .has-avg .bars__row:not(.bars__row--secondary)::after { left: calc(var(--off) + var(--avg) / var(--max) * (100% - var(--off) - var(--reserve))); bottom: calc(-0.5 * var(--gap)); }
  .bars--sm .has-avg .bars__row:first-child::after { top: -10px; }
  .bars--sm .has-avg .bars__label { background: none; padding-right: 0; }

  .bars__note { margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 0.875rem; line-height: 1.55; color: var(--text); }

  /* Animacja wzrostu */
  .bars.is-armed .bars__bar { transform: scaleX(0); }
  .bars.is-armed .bars__value { opacity: 0; }
  .bars.is-armed.is-in .bars__bar { transform: scaleX(1); }
  .bars.is-armed.is-in .bars__value { opacity: 1; }

  @media (max-width: 720px) {
    .bars { --bar: 12px; --reserve: max(80px, calc(var(--chars) * 0.7rem + 12px)); }
    .bars__rows { --gap: 16px; }
    .bars__label { font-size: 0.875rem; }
    .bars__value { font-size: 1.125rem; }
    .bars--lg { --bar: 26px; --reserve: max(96px, calc(var(--chars) * 1rem + 12px)); }
    .bars--lg .bars__value { font-size: 1.75rem; }
    .bars--sm { --bar: 9px; --lw: clamp(5.5rem, calc(var(--lchars) * 0.47rem + 6px), 45%); --col: 10px; }
    .bars--sm .bars__rows { --gap: 6px; }
    .bars--sm .bars__label { font-size: 0.8125rem; }
    .bars--sm .bars__value { font-size: 0.75rem; }
    /* długie nazwy (uczelnie z dopiskiem): na telefonie nazwa nad słupkiem, słupek na całą szerokość */
    .bars--sm.bars--long { --off: 0px; }
    .bars--sm.bars--long .bars__rows { --gap: 12px; }
    .bars--sm.bars--long .bars__row { grid-template-columns: 1fr; row-gap: 5px; }
  }
</style>
