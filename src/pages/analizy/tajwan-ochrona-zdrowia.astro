---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareRow from '../../components/ShareRow.astro';
import Aktualizacja from '../../components/Aktualizacja.astro';
import WykresyInline from '../../components/WykresyInline.astro';
import RachunekTajwan from '../../components/RachunekTajwan.astro';
import KartaNHI from '../../components/KartaNHI.astro';
import DoplatyTajwan from '../../components/DoplatyTajwan.astro';
import { compiledContent } from './_tajwan-ochrona-zdrowia.md';

// Markdown nie przyjmuje komponentów, a rozbicie treści na kilka plików rozbiłoby numerację
// przypisów — więc dzielimy skompilowany HTML w miejscach znaczników <div data-slot="…"></div>
// i wstawiamy tam komponenty. Każdy znacznik musi wystąpić dokładnie raz.
const SLOTY = ['karta', 'rachunek', 'doplaty'] as const;
type Slot = (typeof SLOTY)[number];
const czesci = (await compiledContent()).split(/<div data-slot="([a-z]+)"><\/div>/);
const znalezione = czesci.filter((_, i) => i % 2 === 1);
for (const slot of SLOTY) {
  const ile = znalezione.filter((z) => z === slot).length;
  if (ile !== 1) throw new Error(`Znacznik „${slot}” w treści: ${ile} (oczekiwano 1)`);
}
if (znalezione.length !== SLOTY.length) throw new Error(`Nieznane znaczniki w treści: ${znalezione.join(', ')}`);

// Analiza: jak działa tajwańska ochrona zdrowia i co w niej jest jawne. Treść w
// _tajwan-ochrona-zdrowia.md (Markdown z przypisami); źródła pierwotne: ustawy z law.moj.gov.tw,
// NHIA, MOHW, MOE, MOL, DGBAS. Ton objaśniający (opis mechanizmów, nie polemika z tezami).
// Oś: Tajwan jest jawny wobec pacjenta i na poziomie szpitala, ale nie per lekarz.
// Autor wpisów, które zainspirowały tekst (Rafał, @rafaltwn), wymieniony w podziękowaniu na końcu
// treści i jako źródło relacji pacjenta; poza tym bez nazwisk.
// Opublikowana 5.10.2026 (wcześniej podgląd pod /preview/ — przekierowanie 301 w public/_redirects).
// Rejestry: pages.ts (hub), ogPages.ts (karta OG), pageDates.mjs (data).
---

<BaseLayout
  title="Jak działa tajwańska ochrona zdrowia — i co w niej jest jawne — zarobkilekarzy.pl"
  description="Jeden płatnik, budżet globalny z punktową wyceną, rachunek z kwotą dla ubezpieczyciela po każdej wizycie i rejestr miejsc pracy lekarzy. Opisujemy tajwański system na podstawie ustaw i danych rządowych — także to, czego Tajwan nie ujawnia."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow"><a href="/analizy/">Analizy</a> · Świat</p>
      <h1>Jak działa tajwańska ochrona zdrowia — i co w niej jest jawne</h1>
      <Aktualizacja />
      <p class="lead">Tajwan coraz częściej pojawia się w polskich rozmowach o ochronie zdrowia jako przykład systemu z jednym płatnikiem, w którym do specjalisty można pójść bez skierowania, dopłata w okienku jest stała i znana z góry, a każda wizyta zostawia elektroniczny ślad. Opisujemy, jak ten system działa — na podstawie tajwańskich ustaw i danych rządowych — ze szczególnym uwzględnieniem jawności pieniędzy publicznych. Tajwańczyk dostaje z każdej wizyty rachunek z kwotą zgłoszoną do ubezpieczyciela, sprawozdania finansowe szpitali są publikowane, a państwo wie, gdzie pracuje każdy lekarz. <strong>Zarobków poszczególnych lekarzy</strong> Tajwan natomiast nie ujawnia.</p>
      <div class="prose">
        {czesci.map((czesc, i) =>
          i % 2 === 0 ? <Fragment set:html={czesc} />
          : (czesc as Slot) === 'karta' ? <KartaNHI />
          : (czesc as Slot) === 'doplaty' ? <DoplatyTajwan />
          : <RachunekTajwan />
        )}
      </div>
      <p class="pager"><a href="/analizy/">← Wszystkie analizy</a> · <a href="/postulat/">Postulat →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ShareRow
        heading="Pomóż nagłośnić sprawę:"
        url="https://zarobkilekarzy.pl/analizy/tajwan-ochrona-zdrowia/"
        text="Jak działa tajwańska ochrona zdrowia — i co w niej jest jawne — zarobkilekarzy.pl"
      />
    </div>
  </section>
  <WykresyInline />
</BaseLayout>

<style>
  /* Podziękowanie na końcu treści, nad przypisami (HTML w _tajwan-ochrona-zdrowia.md): cichy, neutralny box (nie callout — to nie teza),
     na tokenach, więc działa w obu motywach. */
  .prose :global(.podziekowanie) {
    margin: 2.5rem 0 1.5rem;
    padding: 1.1rem 1.35rem 1.2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .prose :global(.podziekowanie-label) {
    margin: 0 0 0.4rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--ink-faint);
    font-stretch: 85%;
  }
  .prose :global(.podziekowanie p:last-child) {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .prose :global(.podziekowanie a) { color: var(--brand-link); }

  /* Tabela dopłat: wszystkie kolumny z kwotami wyrównane do prawej, nie tylko ostatnia. */
  .prose :global(td:not(:first-child)),
  .prose :global(th:not(:first-child)) {
    text-align: right;
    white-space: normal;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 640px) {
    .prose :global(td:not(:first-child)) { white-space: nowrap; }
    /* Nagłówki mogą się zawijać — inaczej długi nagłówek ściska pierwszą kolumnę. */
    .prose :global(th:not(:first-child)) { white-space: normal; }
  }
  @media (max-width: 639px) {
    .prose :global(table) { font-size: var(--fs-label); }
    .prose :global(th),
    .prose :global(td) { padding: 0.45rem 0.3rem; }
  }
</style>
