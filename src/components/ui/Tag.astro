---
/** Etykieta rodzaju materiału (np. forma zestawienia: „Wykresy”, „Tabela”). */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  tone?: 'line' | 'blue' | 'light';
}

const { tone = 'line', class: className, ...rest } = Astro.props;
---
<span class:list={['tag', `tag--${tone}`, className]} {...rest}><slot /></span>

<style>
  .tag {
    display: inline-flex; align-items: center; padding: 4px 7px;
    font: 500 0.65625rem/1 var(--f-mono); letter-spacing: .07em; text-transform: uppercase; white-space: nowrap;
  }
  .tag--line { border: 1px solid var(--line-2); color: var(--text); }
  .tag--blue { background: var(--blue-50); color: var(--blue); }
  .tag--light { border: 1px solid rgba(255, 255, 255, .35); color: #fff; } /* kolor-stały: wariant tylko na tło zawsze ciemne lub kobaltowe */
</style>
