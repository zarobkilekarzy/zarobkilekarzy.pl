---
/**
 * Liczba z animacją odliczania (scripts/reveal.ts → data-count).
 * W HTML zawsze jest wartość końcowa — animacja to tylko ulepszenie.
 */
import { formatNumber } from '@/lib/format';
import { localeOf } from '@/i18n/locales';

interface Props {
  value: number;
  decimals?: number;
}
const { value, decimals = 0 } = Astro.props;
---
<span data-count={value} data-decimals={decimals || undefined}>{formatNumber(value, decimals, localeOf(Astro.url.pathname))}</span>
