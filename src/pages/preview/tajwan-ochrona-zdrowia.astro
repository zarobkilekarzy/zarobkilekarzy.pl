---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareRow from '../../components/ShareRow.astro';
import Aktualizacja from '../../components/Aktualizacja.astro';
import WykresyInline from '../../components/WykresyInline.astro';
import { Content } from './_tajwan-ochrona-zdrowia.md';

// Analiza: jak działa tajwańska ochrona zdrowia i co w niej jest jawne. Treść w
// _tajwan-ochrona-zdrowia.md (Markdown z przypisami); źródła pierwotne: ustawy z law.moj.gov.tw,
// NHIA, MOHW, MOE, MOL, DGBAS. Ton objaśniający (opis mechanizmów, nie polemika z tezami).
// Oś: Tajwan jest jawny wobec pacjenta i na poziomie szpitala, ale nie per lekarz.
// Autor wpisów, które zainspirowały tekst, nienazwany. Bez nazwisk.
// PODGLĄD przed publikacją: /preview/ = noindex, poza sitemapą, hubami i wyszukiwarką.
// Przy publikacji: przenieść do /analizy/, zdjąć noindex, dodać wpisy w pages.ts,
// ogPages.ts i pageDates.mjs.
---

<BaseLayout
  title="Jak działa tajwańska ochrona zdrowia — i co w niej jest jawne — zarobkilekarzy.pl"
  noindex={true}
  description="Jeden płatnik, budżet globalny z punktową wyceną, rachunek z kwotą dla ubezpieczyciela po każdej wizycie i rejestr miejsc pracy lekarzy. Opisujemy tajwański system na podstawie ustaw i danych rządowych — także to, czego Tajwan nie ujawnia."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow"><a href="/analizy/">Analizy</a> · Świat</p>
      <h1>Jak działa tajwańska ochrona zdrowia — i co w niej jest jawne</h1>
      <Aktualizacja data="2026-10-05" />
      <p class="lead">Tajwan coraz częściej pojawia się w polskich rozmowach o ochronie zdrowia jako przykład systemu z jednym płatnikiem, w którym do specjalisty można pójść bez skierowania, dopłata w okienku jest niewielka, a każda wizyta zostawia elektroniczny ślad. Opisujemy, jak ten system działa — na podstawie tajwańskich ustaw i danych rządowych — ze szczególnym uwzględnieniem jawności pieniędzy publicznych. Tajwańczyk dostaje z każdej wizyty rachunek z kwotą zgłoszoną do ubezpieczyciela, sprawozdania finansowe szpitali są publikowane, a państwo wie, gdzie pracuje każdy lekarz. <strong>Zarobków poszczególnych lekarzy</strong> Tajwan natomiast nie ujawnia.</p>
      <div class="prose">
        <Content />
      </div>
      <p class="pager"><a href="/analizy/">← Wszystkie analizy</a> · <a href="/postulat/">Postulat →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ShareRow
        heading="Pomóż nagłośnić sprawę:"
        url="https://zarobkilekarzy.pl/analizy/tajwan-ochrona-zdrowia/"
        text="Jak działa tajwańska ochrona zdrowia — i co w niej jest jawne — zarobkilekarzy.pl"
      />
    </div>
  </section>
  <WykresyInline />
</BaseLayout>

<style>
  /* Tabela dopłat: wszystkie kolumny z kwotami wyrównane do prawej, nie tylko ostatnia. */
  .prose :global(td:not(:first-child)),
  .prose :global(th:not(:first-child)) {
    text-align: right;
    white-space: normal;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 640px) {
    .prose :global(td:not(:first-child)),
    .prose :global(th:not(:first-child)) {
      white-space: nowrap;
    }
  }
  @media (max-width: 639px) {
    .prose :global(table) { font-size: 0.8rem; }
    .prose :global(th),
    .prose :global(td) { padding: 0.45rem 0.3rem; }
  }
</style>
