---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Aktualizacja from '../../components/Aktualizacja.astro';
import dataset from '../../data/watchdog-placowki.json';
import InfoTip from '../../components/InfoTip.astro';

// WERSJA ROBOCZA (niepublikowana). Przeglądarka obywatelskiego monitoringu
// „Ile zarabiają lekarze?" (Watchdog Polska): wszystkie 1358 placówek —
// kto odpowiedział, kto odmówił, kto milczy — a dla placówek z pełnymi
// rocznymi listami płac: agregaty (fundusz, mediana, max, koncentracja).
// Zasady rdzenia:
//  • agregaty per placówka, nie listy nazwisko+kwota;
//  • agregat tylko z czystych list rocznych (≥10 wierszy, mediana ≥60 tys.);
//  • ujawnienie = dobra praktyka (zielone), odmowa/cisza = problem systemowy;
//  • kredyt + link do Watchdog Polska; każdy wiersz linkuje do sprawy u źródła.
// Dane: src/data/watchdog-placowki.json, generowane LOKALNIE skryptem
// research/watchdog/08-export.mjs (research/ poza gitem — CI nie ma bazy).

const { placowki, sync, ludnoscRok } = dataset;
const SYNC_HR = new Intl.DateTimeFormat('pl-PL', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date(sync));

const fmt = (n) => new Intl.NumberFormat('pl-PL').format(n);
// Kwoty skracamy do „x,x mln" / „xxx tys." — tabela ma być czytelna, nie księgowa.
const short = (n) =>
  n >= 1e6 ? `${(n / 1e6).toFixed(2).replace('.', ',')} mln` : `${Math.round(n / 1e3)} tys.`;

// Wielkość miejscowości (GUS BDL, ludność wg faktycznego miejsca zamieszkania).
// Skala: „1,9 mln" dla metropolii, „673 tys." dla dużych miast, „19,7 tys." dla
// małych — poniżej 100 tys. z jednym miejscem po przecinku, żeby zaokrąglenie nie
// przerzucało miasta przez próg filtra („do 20 tys." pokazujące „20 tys.").
const pop = (n) =>
  n >= 1e6
    ? `${(n / 1e6).toFixed(1).replace('.', ',')} mln`
    : n >= 1e5
      ? `${Math.round(n / 1e3)} tys.`
      : `${(n / 1e3).toFixed(1).replace('.', ',')} tys.`;
// Trzy progi zamiast surowej liczby — po to, by dało się porównać koncentrację
// płac w małych i dużych ośrodkach, a nie licytować pojedyncze miasta.
const bucket = (n) => (!n ? '' : n < 20000 ? 'S' : n < 100000 ? 'M' : 'L');

// Koszyki histogramu — te same progi co HIST_PROGI w research/watchdog/08-export.mjs.
// Zmiana w jednym miejscu bez drugiego rozjedzie opis z danymi.
const HIST_ETY = [
  'do 100 tys.', '100–200 tys.', '200–300 tys.', '300–500 tys.',
  '500–750 tys.', '750 tys.–1 mln', 'ponad 1 mln',
];

const KAT = {
  A: { label: 'dane', cls: 'ok', desc: 'odpowiedź z danymi' },
  B: { label: 'odmowa', cls: 'alert', desc: 'wprost odmówiła' },
  C: { label: 'inna odpowiedź', cls: 'mid', desc: 'np. przedłużenie terminu' },
  E: { label: 'inna instytucja', cls: 'mid', desc: 'odpowiedź z innej instytucji' },
  G: { label: 'nieustalona', cls: 'mid', desc: 'charakter odpowiedzi nieustalony' },
  receipt: { label: 'tylko potwierdzenie', cls: 'mute', desc: 'samo potwierdzenie doręczenia' },
  none: { label: 'cisza', cls: 'mute', desc: 'żadnej odpowiedzi' },
};

const woje = [...new Set(placowki.map((p) => p.woj).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'pl'),
);

// Domyślny porządek: najpierw placówki z listami (fundusz malejąco), potem reszta alfabetycznie.
const rows = [...placowki].sort((a, b) =>
  (b.fundusz ?? -1) - (a.fundusz ?? -1) || a.nazwa.localeCompare(b.nazwa, 'pl'),
);

const N = placowki.length;
const N_DANE = placowki.filter((p) => p.kat === 'A').length;
const N_ODMOWA = placowki.filter((p) => p.kat === 'B').length;
const N_CISZA = placowki.filter((p) => p.kat === 'none').length;
const N_LISTY = placowki.filter((p) => p.n).length;
const N_PSZ = placowki.filter((p) => p.psz).length;

const MONITORING = 'https://fedrowanie.siecobywatelska.pl/monitoringi/ile-zarabiaja-lekarze';
---

<BaseLayout
  title="Przeglądarka monitoringu „Ile zarabiają lekarze?” — zarobkilekarzy.pl"
  description={`Wszystkie ${fmt(N)} placówek z obywatelskiego monitoringu płac lekarzy: kto ujawnił dane, kto odmówił, kto milczy — z agregatami płac dla placówek, które podały pełne listy. Wyszukiwarka, filtry, sortowanie. Źródło: Watchdog Polska.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow"><a href="/dane/">Dane</a> · Przeglądarka monitoringu</p>
      <h1>Przeglądarka monitoringu „Ile zarabiają lekarze?”</h1>
      <Aktualizacja zrodla=" · obywatelski monitoring „Ile zarabiają lekarze?” (Sieć Obywatelska Watchdog Polska); ludność miejscowości — GUS, Bank Danych Lokalnych." />
      <p class="lead">
        <a href={MONITORING} target="_blank" rel="noopener noreferrer">Watchdog Polska zapytał</a>
        <strong> {fmt(N)} publicznych placówek</strong> o roczne brutto lekarzy za 2025 r.
        Tu możesz przejrzeć <strong>każdą z nich</strong>: kto ujawnił dane, kto odmówił, kto
        milczy — a dla {N_LISTY} placówek z pełnymi rocznymi listami płac także
        <strong> ile lekarzy, jaki fundusz i jak bardzo skoncentrowany</strong>. Każdy wiersz
        prowadzi do sprawy u źródła. Stan na {SYNC_HR}.
      </p>

      <div class="wm-chips" role="group" aria-label="Podsumowanie monitoringu">
        <span class="wm-chip"><strong>{fmt(N)}</strong> wniosków</span>
        <span class="wm-chip is-ok"><strong>{N_DANE}</strong> ujawniło dane</span>
        <span class="wm-chip is-alert"><strong>{N_ODMOWA}</strong> odmówiło</span>
        <span class="wm-chip is-mute"><strong>{N_CISZA}</strong> milczy</span>
        <span class="wm-chip"><strong>{N_LISTY}</strong> pełnych rocznych list płac</span>
      </div>

      <!-- ————————————————— KONTROLKI ————————————————— -->
      <form class="wm-controls" id="wm-controls" aria-label="Filtry tabeli">
        <label class="wm-field wm-grow">
          <span>Szukaj placówki</span>
          <input type="search" id="wm-q" placeholder="np. Sławno, szpital powiatowy…" autocomplete="off" />
        </label>
        <label class="wm-field">
          <span>Województwo</span>
          <select id="wm-woj">
            <option value="">wszystkie</option>
            {woje.map((w) => <option value={w}>{w}</option>)}
          </select>
        </label>
        <label class="wm-field">
          <span>Odpowiedź</span>
          <select id="wm-kat">
            <option value="">wszystkie</option>
            <option value="A">ujawniła dane</option>
            <option value="B">odmówiła</option>
            <option value="C">inna odpowiedź</option>
            <option value="receipt">tylko potwierdzenie</option>
            <option value="none">cisza</option>
            <option value="E">inna instytucja</option>
            <option value="G">nieustalona</option>
          </select>
        </label>
        <label class="wm-field">
          <span>Wielkość miejscowości</span>
          <select id="wm-lud">
            <option value="">wszystkie</option>
            <option value="S">do 20 tys.</option>
            <option value="M">20–100 tys.</option>
            <option value="L">ponad 100 tys.</option>
          </select>
        </label>
        <label class="wm-field">
          <span>Na stronę</span>
          <select id="wm-pp">
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="0">wszystkie</option>
          </select>
        </label>
        <label class="wm-check">
          <input type="checkbox" id="wm-tylko-listy" />
          <span>tylko z listami płac ({N_LISTY})</span>
        </label>
        <label class="wm-check">
          <input type="checkbox" id="wm-tylko-psz" />
          <span>tylko sieć szpitali ({N_PSZ})</span>
        </label>
      </form>
      <p class="wm-count" id="wm-count" aria-live="polite">Placówek: {fmt(N)}</p>

      <!-- ————————————————— TABELA ————————————————— -->
      <div class="wm-scroll" tabindex="0" role="region" aria-label="Tabela placówek monitoringu">
        <table class="wm-table" id="wm-table">
          <thead>
            <tr>
              <th scope="col"><button type="button" data-sort="nazwa" data-type="text">Placówka</button></th>
              <th scope="col"><button type="button" data-sort="woj" data-type="text">Woj.</button></th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="ludnosc" data-type="num">Mieszkańcy</button>
                  <InfoTip termin="Mieszkańcy">
                    Ludność miejscowości, w której zarejestrowana jest placówka (GUS, Bank Danych
                    Lokalnych, koniec {ludnoscRok} r.). Dla gmin wiejskich — ludność
                    <strong> całej gminy</strong>. Kolumna <strong>nie mówi o wielkości szpitala</strong>,
                    tylko o skali ośrodka.
                  </InfoTip>
                </div>
              </th>
              <th scope="col">
                <div class="wm-th">
                  <button type="button" data-sort="kat" data-type="text">Odpowiedź</button>
                  <InfoTip termin="Odpowiedź">
                    Jak placówka zareagowała na wniosek o informację publiczną: ujawniła dane,
                    odmówiła, odpisała inaczej albo milczy. Kategorię nadaje
                    <strong> automat</strong> platformy fedrowanie po treści maila — bywa omylny.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="n" data-type="num">Lekarzy</button>
                  <InfoTip termin="Lekarzy">
                    Liczba osób na ujawnionej rocznej liście płac tej placówki — nie cała kadra
                    szpitala, tylko tylu lekarzy obejmuje udostępniony wykaz.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="fundusz" data-type="num">Fundusz płac</button>
                  <InfoTip termin="Fundusz płac">
                    Suma wszystkich ujawnionych rocznych kwot brutto wypłaconych lekarzom przez tę
                    placówkę. <strong>Nie</strong> jest to budżet szpitala ani koszt całego personelu.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="mediana" data-type="num">Mediana</button>
                  <InfoTip termin="Mediana">
                    Wartość <strong>środkowa</strong>: połowa lekarzy z listy zarobiła mniej, połowa
                    więcej. Inaczej niż średnia, nie jest windowana przez kilka rekordowych kwot —
                    dlatego lepiej pokazuje „typową” wypłatę.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="max" data-type="num">Najwyższa</button>
                  <InfoTip termin="Najwyższa">
                    Największa roczna kwota brutto na liście tej placówki — zapłata
                    <strong> jednej osobie przez jeden szpital</strong>. Ile ta osoba zarobiła
                    łącznie, ze wszystkich miejsc pracy, nie wie nikt.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="n500k" data-type="num">&gt;500 tys.</button>
                  <InfoTip termin="Ponad 500 tys.">
                    Ilu lekarzy z listy tej placówki dostało od niej ponad 500 tys. zł brutto
                    w ciągu roku.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="n1m" data-type="num">&gt;1 mln</button>
                  <InfoTip termin="Ponad 1 mln">
                    Ilu lekarzy z listy tej placówki dostało od niej ponad milion złotych brutto
                    w ciągu roku.
                  </InfoTip>
                </div>
              </th>
              <th scope="col" class="num">
                <div class="wm-th">
                  <button type="button" data-sort="top10" data-type="num">Top&nbsp;10 = %&nbsp;funduszu</button>
                  <InfoTip termin="Top 10 = % funduszu">
                    Jaki procent funduszu płac trafia do dziesięciu najlepiej opłacanych lekarzy —
                    miara <strong>koncentracji</strong>. W małej placówce dziesięć osób to z natury
                    większa część zespołu, więc wartości porównuj w obrębie podobnej wielkości.
                  </InfoTip>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((p) => {
              const k = KAT[p.kat] ?? KAT.none;
              const histMax = p.hist ? Math.max(...p.hist) : 0;
              return (
                <Fragment>
                <tr
                  data-nazwa={`${p.nazwa} ${p.miasto}`.toLowerCase()}
                  data-woj={p.woj}
                  data-kat={p.kat}
                  data-psz={p.psz ? '1' : '0'}
                  data-ludnosc={p.ludnosc ?? -1}
                  data-lud={bucket(p.ludnosc)}
                  data-n={p.n ?? -1}
                  data-fundusz={p.fundusz ?? -1}
                  data-mediana={p.mediana ?? -1}
                  data-max={p.max ?? -1}
                  data-n500k={p.n ? p.n500k : -1}
                  data-n1m={p.n ? p.n1m : -1}
                  data-top10={p.top10 ?? -1}
                >
                  <td class="wm-name">
                    {(p.hist || p.komentarz) && (
                      <button
                        type="button"
                        class="wm-toggle"
                        data-detail={`d-${p.nr}`}
                        aria-expanded="false"
                        aria-controls={`d-${p.nr}`}
                      ><span class="wm-toggle-ico" aria-hidden="true"></span>
                        <span class="sr-only">
                          Pokaż {p.hist ? 'rozkład wynagrodzeń' : 'uwagę o danych'} — {p.nazwa}
                        </span>
                      </button>
                    )}
                    <a href={`https://fedrowanie.siecobywatelska.pl/sprawy/${p.slug}`} target="_blank" rel="noopener noreferrer">{p.nazwa}</a>
                    {p.miasto && <span class="wm-city">{p.miasto}</span>}
                    {p.psz && <span class="wm-psz" title={`Sieć szpitali (PSZ)${p.pszPoziom ? ' — ' + p.pszPoziom : ''}`}>sieć</span>}
                  </td>
                  <td class="wm-woj">{p.woj}</td>
                  <td class="num wm-pop">
                    {p.ludnosc ? (
                      <span title={`${fmt(p.ludnosc)} mieszkańców — ${p.ludnoscTyp === 'gmina' ? 'cała gmina' : 'miasto'} (GUS, ${ludnoscRok})`}>
                        {pop(p.ludnosc)}
                        {p.ludnoscTyp === 'gmina' && <span class="wm-pop-typ">gmina</span>}
                      </span>
                    ) : ''}
                  </td>
                  <td><span class={`wm-badge is-${k.cls}`} title={k.desc}>{k.label}</span></td>
                  <td class="num">{p.n ?? ''}</td>
                  <td class="num">{p.fundusz ? short(p.fundusz) : ''}</td>
                  <td class="num">{p.mediana ? short(p.mediana) : ''}</td>
                  <td class="num">{p.max ? short(p.max) : ''}</td>
                  <td class="num">{p.n ? p.n500k : ''}</td>
                  <td class="num">{p.n ? p.n1m : ''}</td>
                  <td class="num">{p.top10 != null ? `${p.top10}%` : ''}</td>
                </tr>
                {(p.hist || p.komentarz) && (
                  <tr class="wm-detail" id={`d-${p.nr}`} hidden>
                    <td colspan="11">
                      <div class="wm-dist">
                        {p.komentarz && (
                          <p class="wm-uwaga">
                            <strong>Skąd bierze się problem z tymi danymi:</strong> {p.komentarz}
                            {' '}Sprawdź w sprawie u źródła (link w nazwie placówki).
                          </p>
                        )}
                        {p.hist && (
                        <p class="wm-dist-head">
                          <strong>Rozkład {fmt(p.n)} ujawnionych kwot</strong> — roczne brutto
                          wypłacone przez tę placówkę
                        </p>
                        <div class="wm-bars" role="img" aria-label={`Rozkład wynagrodzeń: ${p.hist.map((v, i) => `${HIST_ETY[i]} — ${v}`).join('; ')}.`}>
                          {p.hist.map((v, i) => (
                            <div class="wm-bar-row">
                              <span class="wm-bar-lab">{HIST_ETY[i]}</span>
                              <span class="wm-bar-track">
                                <span
                                  class={`wm-bar${i >= 4 ? ' is-hi' : i < 2 ? ' is-lo' : ''}`}
                                  style={`width:${histMax ? Math.round((v / histMax) * 100) : 0}%`}
                                ></span>
                              </span>
                              <span class="wm-bar-val">{v}</span>
                            </div>
                          ))}
                        </div>
                        )}
                        {p.hist && (
                        <p class="wm-dist-foot">
                          Środkowa połowa zespołu mieści się między <strong>{short(p.p25)}</strong>
                          a <strong>{short(p.p75)}</strong> zł; mediana <strong>{short(p.mediana)}</strong> zł.
                          Koszyki są takie same dla wszystkich placówek, więc rozkłady da się
                          porównywać. Pokazujemy wyłącznie <strong>liczebności</strong> —
                          pojedynczych kwot nie publikujemy.
                        </p>
                        )}
                      </div>
                    </td>
                  </tr>
                )}
                </Fragment>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="wm-empty" id="wm-empty" hidden>
        <strong>Żadna placówka nie spełnia tych kryteriów.</strong>
        Poluzuj filtry albo <button type="button" id="wm-reset">wyczyść wszystkie</button>.
      </p>

      <nav class="wm-pager" aria-label="Stronicowanie tabeli">
        <button type="button" id="wm-prev">‹ poprzednia</button>
        <span id="wm-page" aria-live="polite"></span>
        <button type="button" id="wm-next">następna ›</button>
      </nav>

      <div class="callout" style="border-left-color: var(--amber); background: var(--amber-50)">
        <p>
          <strong>Ostrzeżenie: dane zbierane maszynowo.</strong> Kwoty i klasyfikacje odpowiedzi
          zostały wyłuskane automatycznie z jawnej korespondencji (w tym z OCR skanów) — tabela
          <strong> może zawierać błędy</strong>: źle sklejone kwoty, sumy policzone z niepełnych
          list, mylną kategorię odpowiedzi. Zanim zacytujesz konkretną liczbę,
          <strong> sprawdź ją w sprawie u źródła</strong> (link w każdym wierszu).
        </p>
        <p>
          <strong>Widzisz błąd w wierszu swojej placówki?</strong> Napisz na
          <a href="mailto:sprostowania@zarobkilekarzy.pl">sprostowania@zarobkilekarzy.pl</a> —
          poprawiamy niezwłocznie po sprawdzeniu w źródle.
        </p>
      </div>

      <!-- ————————————————— JAK CZYTAĆ ————————————————— -->
      <section aria-labelledby="jak-czytac">
        <h2 id="jak-czytac">Jak czytać tę tabelę</h2>
        <ul>
          <li>
            <strong>Kolumny płacowe wypełniamy tylko dla {N_LISTY} placówek</strong>, które ujawniły
            pełne, wierszowe listy <em>rocznego</em> brutto per lekarz (co najmniej 10 wierszy,
            mediana ≥ 60 tys. zł — to odsiewa listy miesięczne i cząstkowe). Pozostałe odpowiedzi
            „z danymi" to np. widełki, sumy oddziałów albo skany, których nie da się rzetelnie
            zliczyć.
          </li>
          <li>
            <strong>Fundusz płac</strong> = suma ujawnionych rocznych kwot dla lekarzy tej placówki
            (nie cały budżet szpitala). <strong>Top&nbsp;10</strong> = jaki procent tego funduszu
            trafia do dziesięciu najlepiej opłacanych lekarzy — miara koncentracji.
          </li>
          <li>
            <strong>Trójkącik przy nazwie rozwija rozkład</strong> — histogram pokazuje, ilu
            lekarzy zmieściło się w każdym przedziale rocznego brutto, oraz gdzie leży środkowa
            połowa zespołu (kwartyle). Przedziały są <strong>identyczne dla wszystkich placówek</strong>,
            więc rozkłady da się między sobą porównywać. Publikujemy wyłącznie liczebności
            przedziałów — nigdy pojedynczych kwot.
          </li>
          <li>
            <strong>Każda kwota to zapłata jednej placówki.</strong> Lekarz pracujący w kilku
            miejscach ma tu tylko fragment przychodu — sum per osoba nikt w Polsce nie zna,
            bo nie ma jawnego rejestru per&nbsp;PWZ. To dolne granice.
          </li>
          <li>
            <strong>Mieszkańcy</strong> to ludność miejscowości, w której zarejestrowana jest
            placówka — dane GUS (Bank Danych Lokalnych, stan na koniec {ludnoscRok} r.),
            złączone po kodzie gminy <strong>TERYT</strong>. Dla placówek w gminach wiejskich
            i na obszarach wiejskich podajemy ludność <strong>całej gminy</strong> (podpis
            „gmina”), dla dzielnic dużych miast — ludność całego miasta. Kolumna nic nie mówi
            o wielkości samego szpitala; pozwala zestawić koncentrację płac
            (<strong>Top&nbsp;10</strong>) w małych i dużych ośrodkach — z zastrzeżeniem, że
            w mniejszej placówce dziesięciu lekarzy to z natury większa część zespołu.
          </li>
          <li>
            Znacznik <strong>„sieć”</strong> oznacza szpital zakwalifikowany do
            <strong> PSZ</strong> (podstawowego szpitalnego zabezpieczenia, czyli „sieci szpitali”) —
            ma z mocy ustawy gwarantowaną umowę z NFZ finansowaną ryczałtem. To najtwardszy
            przypadek obowiązku jawności: publiczny pieniądz płynie tam z automatu.
            Dopasowaliśmy {N_PSZ} placówek do wykazów 16 oddziałów NFZ po kodzie gminy i nazwie;
            gdzie dopasowanie było niepewne, <strong>celowo nie stawiamy znacznika</strong> —
            jego brak nie dowodzi więc, że szpitala nie ma w sieci.
          </li>
          <li>
            <strong>Kolumnę „Odpowiedź” klasyfikuje automat</strong> platformy fedrowanie
            (po treści maila) — bywa omylny, np. mail „w załączeniu skan odpowiedzi” z pełną
            tabelą płac w załączniku potrafi oznaczyć jako odmowę. Placówkom, których listę
            płac pokazujemy, przypisujemy „dane” niezależnie od tej klasyfikacji.
          </li>
          <li>
            Kwoty wyłuskaliśmy automatycznie z jawnej korespondencji — przed cytowaniem
            konkretnej liczby sprawdź ją w sprawie u źródła (link w każdym wierszu).
            Ujawnienie danych to <strong>dobra praktyka</strong>, nie zarzut wobec placówki.
          </li>
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .wm-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.1rem 0 1.6rem; }
  .wm-chip {
    font-size: 0.85rem; color: var(--ink-soft); background: var(--surface);
    border: 1px solid var(--line-2); border-radius: 999px; padding: 0.3rem 0.75rem;
  }
  .wm-chip strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  .wm-chip.is-ok { border-color: var(--ok); }
  .wm-chip.is-ok strong { color: var(--ok); }
  .wm-chip.is-alert { border-color: var(--alert); }
  .wm-chip.is-alert strong { color: var(--alert); }
  .wm-chip.is-mute { border-style: dashed; }

  /* — kontrolki — */
  .wm-controls {
    display: flex; flex-wrap: wrap; gap: 0.9rem; align-items: end;
