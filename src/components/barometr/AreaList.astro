---
/**
 * /barometr-polityczny/ — sześć obszarów (zarazem pytania do partii) w układzie wierszy NumberedList,
 * pod obszarem z częściami (kadry) — lista części oznaczonych 2a–2c (jak w mailu), na które partia odpowiada osobno,
 * a przy obszarze albo części — pytania pomocnicze (podpowiedź, nie obowiązek).
 */
import Num from '@/components/ui/Num.astro';
import HintList from '@/components/barometr/HintList.astro';
import { answerLimitLabel, barometrAreas } from '@/data/barometr-polityczny';
import { typo } from '@/lib/format';
---
<p class="areas__note">Pytania pomocnicze (ze znakiem „?”) to tylko sugestia. Nie zamykają tematu: można odpowiedzieć szerzej albo po swojemu i nie trzeba odpowiadać na każde. Limit {answerLimitLabel} dotyczy każdego obszaru osobno, a w kadrach — każdej z trzech części, nie całej odpowiedzi.</p>
<ol class="areas">
  {barometrAreas.map((area, i) => (
    <li data-reveal>
      <Num n={i + 1} size="sm" />
      <div>
        <p><strong>{typo(area.title)}</strong> {typo(area.text)}</p>
        {area.hints && <HintList hints={area.hints} label={`Pytania pomocnicze: ${area.title.replace(/\.$/, '')}`} />}
        {area.parts && (
          <ol class="areas__parts">
            {area.parts.map((part, j) => (
              <li>
                <span class="areas__part-no" aria-hidden="true">{i + 1}{'abcdefgh'[j]}</span>
                <div>
                  <p class="areas__part-text"><strong>{part.title}:</strong> {typo(part.text)}</p>
                  {part.hints && <HintList hints={part.hints} label={`Pytania pomocnicze: ${part.title}`} />}
                </div>
              </li>
            ))}
          </ol>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .areas { border-top: 1px solid var(--line-2); }
  .areas > li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding: 24px 0; border-bottom: 1px solid var(--line-2); }
  .areas p { font-size: 1rem; line-height: 1.65; }
  .areas strong { color: var(--ink); font-weight: 600; }

  /* części obszaru: oznaczenie 2a–2c w wąskiej kolumnie (jak w mailu) — bez pionowej linii, która wyglądała jak cytat */
  .areas__parts { display: grid; gap: 16px; margin-top: 14px; }
  .areas__parts > li { display: grid; grid-template-columns: 32px 1fr; gap: 8px; }
  .areas__part-no { padding-top: 3px; font: 500 0.8125rem/1.4 var(--f-mono); color: var(--blue); }
  .areas .areas__part-text { font-size: 0.9375rem; line-height: 1.55; color: var(--ink-2); }

  .areas__note { margin-bottom: 20px; max-width: 72ch; font-size: 0.9375rem; line-height: 1.55; color: var(--ink-2); }
</style>
