---
/**
 * Numeracja „01.” — cyfry w kolorze akcentu, kropka w kolorze tekstu.
 * Kolory można nadpisać z rodzica: --num-color, --num-dot.
 */
import { pad2 } from '@/lib/format';

interface Props {
  n: number;
  size?: 'md' | 'sm';
}
const { n, size = 'md' } = Astro.props;
---
<span class:list={['num', `num--${size}`]}>{pad2(n)}<span>.</span></span>

<style>
  .num {
    font-family: var(--f-display);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--num-color, var(--blue));
    transition: color .45s var(--ease);
  }
  .num > span { color: var(--num-dot, var(--ink)); transition: color .45s var(--ease); }
  .num--md { font-size: 2.75rem; }
  .num--sm { font-size: 1.75rem; }
</style>
