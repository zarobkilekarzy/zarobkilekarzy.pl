---
/**
 * Numer przypisu w tekście strony spoza MDX — odpowiednik `[^id]` (lib/notes). Stawiaj go bez spacji
 * po słowie albo znaku interpunkcyjnym, którego dotyczy: `…zawód<NoteRef notes={notes} id="nil" />.`
 */
import { noteRef, type Notes } from '@/lib/notes';

interface Props {
  notes: Notes;
  id: string;
}

const { notes, id } = Astro.props;
---
<Fragment set:html={noteRef(notes, id)} />
