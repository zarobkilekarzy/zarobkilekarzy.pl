---
/**
 * Strona 404 — noindex, bez grafu danych strukturalnych i bez wpisu w sitemapie.
 * Cloudflare (Workers Static Assets, not_found_handling: 404-page) serwuje dist/404.html ze statusem 404 dla każdego adresu bez pliku i bez przekierowania.
 * Stare adresy obsługuje src/data/seo/redirects.ts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import NotFoundDoctor from '@/components/site/NotFoundDoctor.astro';
import type { SeoInput } from '@/lib/seo';

const seo: SeoInput = {
  title: 'Nie ma takiej strony',
  description: 'Pod tym adresem nie ma strony. Wróć na stronę główną albo użyj wyszukiwarki.',
  index: false,
};

/** Jedno uderzenie serca na linii y = 60 od punktu x (piksele) */
const beat = (x: number) => `L${x} 60l8 -10l6 10l10 0l6 -40l8 72l7 -38l7 6l12 0l10 -10l8 10`;
---
<BaseLayout seo={seo}>
  <Section class="nf">
    <div class="nf__grid">
      <div>
        <Eyebrow>Błąd 404</Eyebrow>
        <Heading as="h1" size="display">Strony nie zastaliśmy</Heading>
        <p class="lead nf__lead">Być może ta strona <strong>dyżuruje teraz w&nbsp;innym szpitalu</strong>. I&nbsp;nie mamy tego <strong>w&nbsp;nosie</strong>.</p>
        <p class="nf__note">Adres mógł się zmienić albo zawierać literówkę. Zacznij od strony głównej albo poszukaj tego, czego potrzebujesz.</p>
        <p class="nf__links">
          <LinkArrow href="/">Strona główna</LinkArrow>
          <LinkArrow href="/szukaj/">Szukaj w serwisie</LinkArrow>
        </p>
      </div>
      <NotFoundDoctor />
    </div>
    <!-- zapis EKG przez całą szerokość okna: uderzenia pod tekstem, za lekarzem linia płaska — lekarz na niej stoi -->
    <svg class="nf__ekg" aria-hidden="true" height="120">
      <path class="nf__ekg-wide" d={`M0 60${[60, 200, 340].map(beat).join('')}L4000 60`} />
      <path class="nf__ekg-narrow" d={`M0 60${beat(24)}L4000 60`} />
    </svg>
  </Section>
</BaseLayout>

<style>
  /* tekst i lekarz do dołu: lekarz stoi na linii EKG, tekst ma pod sobą miejsce na uderzenia */
  .nf__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; align-items: end; }
  .nf__grid > div { padding-bottom: 84px; }
  .nf__grid > :global(svg) { margin-bottom: -2px; }
  .nf__lead { margin-top: 1.5rem; }
  .nf__note { margin-top: 1rem; max-width: 42ch; color: var(--muted); }
  .nf__links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; }

  /* od lewej do prawej krawędzi okna; środek linii (y = 60) na dole ilustracji */
  .nf__ekg { display: block; width: 100vw; max-width: none; margin: -60px 0 0 calc(50% - 50vw); overflow: hidden; }
  .nf__ekg path { fill: none; stroke: var(--blue); stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; }
  .nf__ekg-narrow { display: none; }

  /* telefon: tekst, pod nim lekarz na linii; jedno uderzenie przy lewej krawędzi, przed postacią */
  @media (max-width: 720px) {
    .nf__grid { grid-template-columns: 1fr; gap: 32px; }
    .nf__grid > div { padding-bottom: 0; }
    .nf__ekg-wide { display: none; }
    .nf__ekg-narrow { display: inline; }
  }
</style>
