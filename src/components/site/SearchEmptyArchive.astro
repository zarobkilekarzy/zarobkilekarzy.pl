---
/**
 * Ilustracja pustej wyszukiwarki: szafa kartoteki z wysuniętą pustą szufladą „Wyniki”, pajęczyna, ćma i lupa.
 * Kolory z palety ilustracji (light-dark), więc tryb nocny przygasza scenę sam; animacje tylko bez „ogranicz ruch”.
 * Identyfikatory (clipPath, gradient, title) mają losowy przedrostek — komponent może wystąpić na stronie dwa razy.
 */
import { uiOf } from '@/i18n/ui';

const uid = `il${Math.random().toString(36).slice(2, 8)}`;
const t = uiOf(Astro.url).search.archive;
---
<svg class="il" viewBox="0 0 800 480" role="img" aria-labelledby={`${uid}-t`}>
  <title id={`${uid}-t`}>{t.title}</title>
  <defs>
    <clipPath id={`${uid}-opensz`}><path d="M284 179 H414 L480 140 H350 Z"/></clipPath>
    <linearGradient id={`${uid}-dropsz`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B1430" stop-opacity=".28"/><stop offset="1" stop-color="#0B1430" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <g>
    <rect class="c-wall" width="800" height="480"/>
    <rect class="c-floor" y="380" width="800" height="100"/>
    <rect class="c-base" y="372" width="800" height="8"/>

    <!-- tabliczka -->
    <rect class="c-shadow" x="604" y="96" width="132" height="40" rx="4"/>
    <rect class="c-navy" x="600" y="92" width="132" height="40" rx="4"/>
    <text class="tx-plate" x="666" y="117" text-anchor="middle">{t.plate}</text>

    <!-- cień szafy na podłodze -->
    <path class="c-shadow" d="M330 434 L500 434 L572 410 L548 398 L384 398 Z"/>

    <!-- bryła: bok, góra, front -->
    <path class="c-steel2" d="M490 130 L534 104 V404 L490 430 Z"/>
    <path class="c-steel3" d="M340 130 L384 104 H534 L490 130 Z"/>
    <rect class="c-steel" x="340" y="130" width="150" height="300"/>
    <rect class="c-steel2" x="340" y="422" width="150" height="8"/>
    <path class="c-plastic3" d="M490 422 L534 396 V404 L490 430 Z" style="opacity:.6"/>

    <!-- dolne szuflady -->
    <rect class="c-steel3" x="350" y="236" width="130" height="86" rx="2"/>
    <rect class="c-steel3" x="350" y="332" width="130" height="86" rx="2"/>
    <g>
      <rect class="c-metal" x="420" y="272" width="36" height="16" rx="2"/><rect class="c-paper" x="423" y="275" width="30" height="10" rx="1"/>
      <text class="tx-label" x="438" y="283" text-anchor="middle">{t.top}</text>
      <rect class="c-metal2" x="413" y="298" width="50" height="9" rx="4.5"/>
      <rect class="c-metal" x="397" y="352" width="36" height="16" rx="2"/><rect class="c-paper" x="400" y="355" width="30" height="10" rx="1"/>
      <text class="tx-label" x="415" y="363" text-anchor="middle">{t.bottom}</text>
      <rect class="c-metal2" x="390" y="390" width="50" height="9" rx="4.5"/>
    </g>
    <!-- otwór po górnej szufladzie i cień wysuniętej szuflady -->
    <rect class="c-hole" x="350" y="140" width="130" height="86"/>
    <rect fill={`url(#${uid}-dropsz)`} x="340" y="226" width="150" height="46"/>

    <!-- wysunięta szuflada: wnętrze -->
    <path class="c-hole" d="M284 179 H414 L480 140 H350 Z"/>
    <g clip-path={`url(#${uid}-opensz)`}>
      <rect class="c-hole2" x="350" y="143" width="130" height="30"/>
      <path class="c-steel2" d="M284 179 H414 L420 175.5 H290 Z"/>
      <path class="c-hole2" d="M286 179 L352 143 V179 Z" style="opacity:.7"/>
      <!-- pajęczyna w kącie -->
      <g class="k-web" style="opacity:.9;stroke-width:1.2">
        <path d="M352 143 L352 178 M352 143 L396 143 M352 143 L322 166 M352 143 L382 166 M352 143 L366 178"/>
        <path d="M352 154 Q358 152 361 145 M340 152 Q348 156 352 154 M346 158 Q356 161 362 155 M362 155 Q368 150 368 143"/>
        <path d="M352 166 Q364 167 372 160 M333 160 Q344 166 352 166 M372 160 Q380 152 381 143"/>
      </g>
    </g>
    <path d="M284 179 L350 140 H480" style="fill:none;stroke:var(--il-steel3);stroke-width:3;stroke-linejoin:round"/>
    <!-- bok i front szuflady -->
    <path class="c-steel2" d="M414 179 L480 140 V226 L414 265 Z"/>
    <rect class="c-steel3" x="284" y="179" width="130" height="86" rx="2"/>
    <rect class="c-steel2" x="284" y="259" width="130" height="6"/>
    <rect class="c-metal" x="331" y="194" width="36" height="16" rx="2"/><rect class="c-paper" x="334" y="197" width="30" height="10" rx="1"/>
    <text class="tx-label" x="349" y="205" text-anchor="middle">{t.drawer}</text>
    <rect class="c-metal2" x="324" y="232" width="50" height="9" rx="4.5"/>
    <rect class="c-steel3" x="328" y="232" width="42" height="3" rx="1.5"/>

    <!-- ćma -->
    <g class="moth">
      <ellipse class="c-metal2" cx="402" cy="76" rx="3" ry="8" transform="rotate(30 402 76)"/>
      <path class="c-metal wing" d="M402 74 C390 58 376 62 380 74 C384 82 396 80 402 76 Z"/>
      <path class="c-metal wing" d="M403 76 C414 64 428 70 422 82 C418 88 408 84 403 78 Z"/>
      <path d="M405 68 L409 60 M407 69 L413 63" style="stroke:var(--il-metal2);stroke-width:1.2;stroke-linecap:round"/>
    </g>
    <path d="M384 124 C390 112 386 102 394 92" style="fill:none;stroke:var(--il-metal);stroke-width:1.5;stroke-dasharray:2 5;stroke-linecap:round"/>

    <!-- lupa -->
    <g class="lens">
      <path d="M170 182 L132 220" style="stroke:var(--il-navy);stroke-width:16;stroke-linecap:round"/>
      <path d="M176 176 L166 186" style="stroke:var(--il-metal);stroke-width:12"/>
      <circle cx="204" cy="148" r="40" style="fill:var(--blue);fill-opacity:.12"/>
      <path d="M180 132 A30 30 0 0 1 214 116" style="fill:none;stroke:var(--il-white);stroke-width:5;stroke-linecap:round;opacity:.7"/>
      <circle cx="204" cy="148" r="40" style="fill:none;stroke:var(--il-navy);stroke-width:10"/>
    </g>

    <!-- karty na podłodze -->
    <path class="c-shadow" d="M582 444 L650 444 L668 432 L600 432 Z"/>
    <path class="c-paper" d="M578 440 L646 440 L664 428 L596 428 Z"/>
    <path d="M594 436 H636 M600 432 H650" style="stroke:var(--il-white2);stroke-width:1.5"/>
    <path class="c-paper" d="M626 458 L686 448 L694 436 L636 444 Z" style="opacity:.92"/>
    <path d="M640 450 L676 444" style="stroke:var(--il-white2);stroke-width:1.5"/>
  </g>
</svg>

<style>
  .il { display: block; width: 100%; height: auto; }
  .il {
    --il-wall: light-dark(#EEF2FA, #111A30);
    --il-floor: light-dark(#DFE6F2, #18223A);
    --il-base: light-dark(#CCD6E6, #222D47);
    --il-shadow: light-dark(rgba(23, 43, 94, .13), rgba(0, 0, 0, .38));
    --il-white: light-dark(#FFFFFF, #DDE3EE);
    --il-white2: light-dark(#DCE3EE, #AEB9CC);
    --il-paper: light-dark(#FFFFFF, #D3DAE6);
    --il-navy: light-dark(#1E2740, #3A4766);
    --il-metal: light-dark(#A9B4C6, #7C88A0);
    --il-metal2: light-dark(#8592A8, #59647D);
    --il-plastic3: light-dark(#B3BDCD, #475373);
    --il-steel: light-dark(#D7DEE9, #34405C);
    --il-steel2: light-dark(#BFC9D8, #29334C);
    --il-steel3: light-dark(#EEF2F8, #3E4B6B);
    --il-hole: light-dark(#5F6B86, #070B16);
    --il-hole2: light-dark(#7C88A1, #141C30);
  }
  .il text { font-family: "IBM Plex Mono", monospace; }
  .c-wall { fill: var(--il-wall); }
  .c-floor { fill: var(--il-floor); }
  .c-base { fill: var(--il-base); }
  .c-shadow { fill: var(--il-shadow); }
  .c-paper { fill: var(--il-paper); }
  .c-navy { fill: var(--il-navy); }
  .c-metal { fill: var(--il-metal); }
  .c-metal2 { fill: var(--il-metal2); }
  .c-plastic3 { fill: var(--il-plastic3); }
  .c-steel { fill: var(--il-steel); }
  .c-steel2 { fill: var(--il-steel2); }
  .c-steel3 { fill: var(--il-steel3); }
  .c-hole { fill: var(--il-hole); }
  .c-hole2 { fill: var(--il-hole2); }
  .k-web { fill: none; stroke: var(--il-white); stroke-width: 1; opacity: .75; }
  .tx-plate { font: 600 13px "IBM Plex Mono", monospace; letter-spacing: .16em; fill: #FFFFFF; } /* kolor-stały: napis na stałym tle */
  .tx-label { font: 600 6.5px "IBM Plex Mono", monospace; letter-spacing: .04em; fill: #283041; } /* kolor-stały: napis na stałym tle */
  @media (prefers-reduced-motion: no-preference) {
    .lens { animation: il-look 5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .moth { animation: il-moth 6s ease-in-out infinite; }
    .wing { animation: il-flap .18s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: center; }
    @keyframes il-look { 50% { transform: translate(26px, 10px) rotate(-4deg); } }
    @keyframes il-moth { 0%, 100% { transform: translate(-18px, 46px); } 50% { transform: translate(6px, -6px); } }
    @keyframes il-flap { to { transform: scaleY(.55); } }
  }
</style>
