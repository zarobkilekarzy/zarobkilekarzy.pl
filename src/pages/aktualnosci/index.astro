---
/**
 * /aktualnosci/ — komunikaty o projekcie, od najnowszego. Wpisy: src/content/aktualnosci/*.md,
 * pomocnicze funkcje i teksty strony: src/lib/news.ts. Szkice (`draft`) nie trafiają na listę.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageMeta from '@/components/layout/PageMeta.astro';
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { formatDate, isoDate, typo } from '@/lib/format';
import { getNews, newsHref, newsIllustration, newsImage, newsPage, newsThumbWhole } from '@/lib/news';
import type { Crumb, SeoInput } from '@/lib/seo';

const news = await getNews();
const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: newsPage.title }];
const seo: SeoInput = {
  title: newsPage.title,
  description: newsPage.description,
  breadcrumbs: crumbs,
  page: { type: 'CollectionPage', items: news.map((n) => ({ name: n.data.title, url: newsHref(n) })) },
};
---
<BaseLayout seo={seo}>
  <Section space="bottom" class="news-top">
    <PageHeader title={newsPage.title} lead={newsPage.lead} eyebrow="O serwisie" crumbs={crumbs}>
      <PageMeta
        items={[
          { label: 'Wpisy', value: news.length },
          ...(news[0] ? [{ label: 'Ostatni wpis', value: news[0].data.date }] : []),
        ]}
      />
      <Image slot="aside" src={newsIllustration.src} alt={newsIllustration.alt} widths={[480, 720, 960]} sizes="(min-width: 1025px) 480px, calc(100vw - 32px)" class="news-top__img" loading="eager" />
    </PageHeader>
  </Section>

  <Section space="bottom">
    <ol class="news">
      {news.map((n) => (
        <li class="news__item">
          <a href={newsHref(n)}>
            <Image src={newsImage(n).src} alt="" widths={[240, 480]} sizes="(min-width: 721px) 240px, calc(100vw - 32px)" class:list={['news__img', { 'is-whole': newsThumbWhole(n, 16 / 10) }]} />
            <span class="news__body">
              <time class="news__date" datetime={isoDate(n.data.date)}>{formatDate(n.data.date)}</time>
              <h2 class="news__title">{typo(n.data.title)}</h2>
              <p class="news__desc">{typo(n.data.summary)}</p>
            </span>
            <Icon name="arrow-ne" class="news__arrow" />
          </a>
        </li>
      ))}
    </ol>
    <p class="news__rss">Nowe wpisy trafiają też do <a href="/rss.xml">kanału RSS</a> razem z nowymi materiałami serwisu.</p>
  </Section>
</BaseLayout>

<style>
  .news-top { padding-top: clamp(32px, 4vw, 56px); }

  .news { border-top: 1px solid var(--ink); }
  .news__item a {
    position: relative; display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 16px 32px; align-items: start;
    padding: 26px 48px 28px 0; border-bottom: 1px solid var(--line);
  }
  .news-top :global(.news-top__img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .news :global(.news__img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: 0 0; border: 1px solid var(--line); }
  .news :global(.news__img.is-whole) { object-fit: contain; object-position: 50% 50%; background: var(--bg-soft); }
  .news__date { display: block; margin-bottom: 10px; font: 400 0.8125rem/1.2 var(--f-mono); letter-spacing: .02em; color: var(--muted); }
  .news__title { font: 500 1.5rem/1.2 var(--f-display); letter-spacing: -0.02em; color: var(--ink); margin: 0 0 10px; transition: color .2s; }
  .news__desc { max-width: 60ch; font-size: 1rem; line-height: 1.6; }
  .news__arrow { position: absolute; top: 30px; right: 0; color: var(--line-2); transition: color .2s, transform .3s var(--ease); }
  .news__item a:hover .news__title { color: var(--blue); }
  .news__item a:hover .news__arrow { color: var(--blue); transform: translate(2px, -2px); }
  .news__rss { margin-top: 32px; font-size: 0.9375rem; color: var(--muted); }

  @media (max-width: 1024px) {
    .news__item a { grid-template-columns: 200px minmax(0, 1fr); gap: 16px 24px; }
  }
  @media (max-width: 720px) {
    .news__item a { grid-template-columns: minmax(0, 1fr); padding-right: 36px; }
    .news__title { font-size: 1.25rem; }
  }
</style>
