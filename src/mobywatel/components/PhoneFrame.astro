---
/**
 * Prototyp na stronie serwisu: <iframe> do /mobywatel/<slug>/ (wyjątek od frame-ancestors
 * w integrations/seo/headers.ts). Telefon z obręczą rysuje sam prototyp (wspolne/challenge.js, tryb ramki):
 * 390×844 + obręcz, w skali ramki — tu tylko ramka o tych proporcjach, bez własnego telefonu.
 */
interface Props {
  src: string;
  /** nazwa dla czytnika ekranu, np. „Prototyp: Moje zdrowie” */
  title: string;
}

const { src, title } = Astro.props;
---
<iframe class="phone-frame" src={src} title={title} loading="lazy"></iframe>

<style>
  /* cały telefon na ekranie: wysokość do okna pod nagłówkiem strony (laptop), szerokość z proporcji 414×868;
     na wąskim ekranie ogranicza go szerokość kolumny */
  .phone-frame {
    display: block;
    height: max(480px, min(868px, calc(100dvh - var(--header-h) - 48px), calc((100vw - 2 * var(--gutter)) * 868 / 414)));
    width: auto;
    aspect-ratio: 414 / 868;
    border: 0;
    /* ten sam schemat co dokument w ramce — przy różnych przeglądarka maluje pod ramką nieprzezroczyste tło */
    color-scheme: light;
  }
</style>
