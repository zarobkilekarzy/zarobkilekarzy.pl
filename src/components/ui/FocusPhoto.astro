---
/**
 * <Photo> z głębią ostrości sterowaną kursorem — jak zdjęcie z jasnego obiektywu.
 *
 * Warstwy: dwie rozmyte kopie zdjęcia (mocno i lekko) pod ostrym oryginałem z <Photo>;
 * oryginał i lekko rozmyta kopia są maskowane gradientem wokół punktu ostrości.
 * Kopie mają ten sam srcset co oryginał, więc przeglądarka pobiera plik raz.
 *
 * Efekty (`focus`):
 * - tilt:  pas ostrości przez kursor, przechylany zależnie od jego pozycji w poziomie (±30°)
 * - plane: poziomy pas ostrości na wysokości kursora (płaszczyzna ostrzenia)
 * - point: ostre koło wokół kursora
 *
 * `rest` — punkt ostrości w spoczynku, w % kadru [x, y]. Ruch śledzi tylko mysz/rysik;
 * dotyk i prefers-reduced-motion dostają statyczny stan spoczynku. Bez JS zdjęcie jest
 * w całości ostre (maska bez zmiennych z JS jest nieprawidłowa, więc się nie stosuje).
 */
import type { ComponentProps } from 'astro/types';
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { variantWidths } from '@/lib/images';

type Props = ComponentProps<typeof Photo> & {
  focus?: 'tilt' | 'plane' | 'point';
  rest?: [number, number];
};

const { focus = 'tilt', rest = [50, 60], class: className, ...photo } = Astro.props;
const { src, sizes, widths = [480, 720, 960, 1280, 1600], position = '50% 50%', priority = false } = photo;

// Te same parametry co <Image> w <Photo> → identyczne adresy wariantów
const copy = await getImage({ src, widths: variantWidths(src, widths), sizes, format: 'webp', quality: 72 });
const layer = {
  src: copy.src,
  srcset: copy.srcSet.attribute,
  sizes,
  alt: '',
  loading: priority ? 'eager' : 'lazy',
  decoding: 'async',
  style: `object-position: ${position}`,
} as const;
---
<Photo {...photo} class:list={['fp', `fp--${focus}`, className]} data-focus={focus} data-rest={rest.join(' ')}>
  <span class="fp__layers" aria-hidden="true">
    <img class="fp__far" {...layer} />
    <img class="fp__mid" {...layer} />
  </span>
  <span class={focus === 'point' ? 'fp__af' : 'fp__ticks'} aria-hidden="true"></span>
  <slot />
</Photo>

<style>
  /* Zmienne ustawia skrypt: --k (0 spoczynek … 1 kursor nad zdjęciem), --x/--y (%),
     tilt/plane: --p (pozycja pasa na linii gradientu, px), --th (kąt), --yl/--yr (znaczniki);
     point: --r (promień ostrego koła, px). --d = połowa głębi ostrości w % linii gradientu. */
  :global(.fp) { --d: calc(18 - var(--k, 0) * 6); }

  .fp__layers { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .fp__layers img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    user-select: none; pointer-events: none;
  }
  .fp__far { filter: var(--img-filter, grayscale(1) contrast(1.05)) blur(8px) var(--photo-filter); transform: scale(1.05); }
  .fp__mid { filter: var(--img-filter, grayscale(1) contrast(1.05)) blur(3px) var(--photo-filter); transform: scale(1.015); }

  /* tilt i plane: pas ostrości (plane = tilt z kątem 0) */
  :global(.fp--tilt) .fp__mid, :global(.fp--plane) .fp__mid {
    -webkit-mask-image: linear-gradient(calc(180deg + var(--th)), transparent calc(var(--p) - var(--d) * 2.6%), #000 calc(var(--p) - var(--d) * 1.2%), #000 calc(var(--p) + var(--d) * 1.2%), transparent calc(var(--p) + var(--d) * 2.6%));
            mask-image: linear-gradient(calc(180deg + var(--th)), transparent calc(var(--p) - var(--d) * 2.6%), #000 calc(var(--p) - var(--d) * 1.2%), #000 calc(var(--p) + var(--d) * 1.2%), transparent calc(var(--p) + var(--d) * 2.6%));
  }
  :global(.fp--tilt .media__img), :global(.fp--plane .media__img) {
    -webkit-mask-image: linear-gradient(calc(180deg + var(--th)), transparent calc(var(--p) - var(--d) * 1%), #000 calc(var(--p) - var(--d) * .35%), #000 calc(var(--p) + var(--d) * .35%), transparent calc(var(--p) + var(--d) * 1%));
            mask-image: linear-gradient(calc(180deg + var(--th)), transparent calc(var(--p) - var(--d) * 1%), #000 calc(var(--p) - var(--d) * .35%), #000 calc(var(--p) + var(--d) * .35%), transparent calc(var(--p) + var(--d) * 1%));
  }

  /* point: ostre koło wokół kursora */
  :global(.fp--point) .fp__mid {
    -webkit-mask-image: radial-gradient(circle calc(var(--r) * 1.9) at var(--x) var(--y), #000 30%, transparent 100%);
            mask-image: radial-gradient(circle calc(var(--r) * 1.9) at var(--x) var(--y), #000 30%, transparent 100%);
  }
  :global(.fp--point .media__img) {
    -webkit-mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 45%, transparent 100%);
            mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 45%, transparent 100%);
  }

  /* Znaczniki płaszczyzny ostrości na krawędziach kadru — tylko przy kursorze */
  .fp__ticks { position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; opacity: calc(var(--k, 0) * .95); }
  .fp__ticks::before, .fp__ticks::after {
    content: ""; position: absolute; width: 14px; height: 2px; margin-top: -1px;
    background: var(--blue-fill); rotate: var(--th, 0deg);
  }
  .fp__ticks::before { left: 0; top: var(--yl, -10px); transform-origin: 0 50%; }
  .fp__ticks::after { right: 0; top: var(--yr, -10px); transform-origin: 100% 50%; }

  /* Punkt AF — narożniki jak „uchwyty” ramki */
  .fp__af {
    position: absolute; z-index: 2; left: var(--x, 50%); top: var(--y, 50%); width: 54px; height: 54px;
    translate: -50% -50%; pointer-events: none; opacity: calc(var(--k, 0) * .9);
    --c: linear-gradient(var(--blue-fill), var(--blue-fill));
    background:
      var(--c) 0 0 / 10px 2px no-repeat, var(--c) 0 0 / 2px 10px no-repeat,
      var(--c) 100% 0 / 10px 2px no-repeat, var(--c) 100% 0 / 2px 10px no-repeat,
      var(--c) 0 100% / 10px 2px no-repeat, var(--c) 0 100% / 2px 10px no-repeat,
      var(--c) 100% 100% / 10px 2px no-repeat, var(--c) 100% 100% / 2px 10px no-repeat;
  }
</style>

<script>
  type Focus = 'tilt' | 'plane' | 'point';
  interface State { el: HTMLElement; focus: Focus; rx: number; ry: number; x: number; y: number; k: number; tx: number; ty: number; tk: number; raf: number }

  const TILT = 30 * Math.PI / 180; // maks. przechył pasa przy krawędzi kadru

  function apply(s: State) {
    const st = s.el.style;
    const W = s.el.clientWidth, H = s.el.clientHeight;
    const px = s.x / 100 * W, py = s.y / 100 * H;
    st.setProperty('--x', `${s.x.toFixed(2)}%`);
    st.setProperty('--y', `${s.y.toFixed(2)}%`);
    st.setProperty('--k', s.k.toFixed(4));
    if (s.focus === 'point') {
      st.setProperty('--r', `${(W * (0.38 - s.k * 0.08)).toFixed(1)}px`);
      return;
    }
    // Gradient liniowy nie „przechodzi przez punkt” — rzutujemy (px, py) na linię gradientu
    const th = s.focus === 'tilt' ? (s.x - 50) / 50 * TILT : 0;
    const sin = Math.sin(th), cos = Math.cos(th), tan = Math.tan(th);
    const L = W * Math.abs(sin) + H * Math.abs(cos);
    st.setProperty('--th', `${(th * 180 / Math.PI).toFixed(3)}deg`);
    st.setProperty('--p', `${(L / 2 - (px - W / 2) * sin + (py - H / 2) * cos).toFixed(1)}px`);
    st.setProperty('--yl', `${(py - px * tan).toFixed(1)}px`);
    st.setProperty('--yr', `${(py + (W - px) * tan).toFixed(1)}px`);
  }

  function tick(s: State) {
    s.raf = 0;
    const f = 0.12; // wygładzanie ruchu
    s.x += (s.tx - s.x) * f;
    s.y += (s.ty - s.y) * f;
    s.k += (s.tk - s.k) * f;
    apply(s);
    if (Math.abs(s.tx - s.x) + Math.abs(s.ty - s.y) + Math.abs(s.tk - s.k) * 100 > 0.05) {
      s.raf = requestAnimationFrame(() => tick(s));
    }
  }
  const kick = (s: State) => { if (!s.raf) s.raf = requestAnimationFrame(() => tick(s)); };

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const states = new Map<Element, State>();
  // --p, --r i znaczniki są w px — przeliczamy po każdej zmianie rozmiaru kadru
  const resize = new ResizeObserver((entries) => entries.forEach((e) => {
    const s = states.get(e.target);
    if (s) apply(s);
  }));

  document.querySelectorAll<HTMLElement>('[data-focus]').forEach((el) => {
    const [rx, ry] = (el.dataset.rest ?? '50 60').split(' ').map(Number);
    const s: State = { el, focus: el.dataset.focus as Focus, rx, ry, x: rx, y: ry, k: 0, tx: rx, ty: ry, tk: 0, raf: 0 };
    states.set(el, s);
    resize.observe(el); // pierwsze wywołanie od razu — ustawia stan spoczynku
    if (still) return;

    el.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const r = el.getBoundingClientRect();
      s.tx = Math.min(100, Math.max(0, (e.clientX - r.left) / r.width * 100));
      s.ty = Math.min(100, Math.max(0, (e.clientY - r.top) / r.height * 100));
      s.tk = 1;
      kick(s);
    });
    el.addEventListener('pointerleave', () => { s.tx = s.rx; s.ty = s.ry; s.tk = 0; kick(s); });
  });
</script>
