---
/**
 * Rząd dużych liczb z opisem, etykietą dokładności i źródłem.
 * Liczba kolumn zależy od szerokości KONTENERA (container queries), więc ten sam
 * blok działa na całą szerokość strony i w wąskiej kolumnie artykułu.
 * Źródło z `href` jest linkiem do publikacji.
 */
import type { HTMLAttributes } from 'astro/types';
import Counter from '@/components/ui/Counter.astro';
import Flag from '@/components/ui/Flag.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Stat } from '@/types';
import { typo } from '@/lib/format';
import { linkAttrs } from '@/lib/links';

interface Props extends HTMLAttributes<'div'> {
  items: Stat[];
  label?: string;
}

const { items, label, class: className, ...rest } = Astro.props;
---
<div class:list={['stats-wrap', className]} {...rest}>
  <div class="stats" style={`--n: ${items.length}`} aria-label={label}>
    {items.map((s) => (
      <div class="stat">
        <p class="stat__value">
          {s.prefix && <span class="stat__prefix">{s.prefix}</span>}
          <Counter value={s.value} decimals={s.decimals} />
          <small>{typo(s.unit)}</small>
        </p>
        <p class="stat__desc">{typo(s.desc)}</p>
        <p class="stat__src">
          <Flag accuracy={s.accuracy} />
          {s.href
            ? <a {...linkAttrs(s.href)}>{typo(s.source)}<Icon name="arrow-ne" size={10} /></a>
            : typo(s.source)}
        </p>
      </div>
    ))}
  </div>
</div>

<style>
  .stats-wrap { container-type: inline-size; }
  .stats { display: grid; grid-template-columns: repeat(var(--n), 1fr); border-top: 1px solid var(--line); }
  .stat { padding: 32px 28px 8px; border-left: 1px solid var(--line); }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .stat__value {
    display: flex; align-items: baseline; gap: 6px;
    font: 300 clamp(2.5rem, 4vw, 3.5rem)/1 var(--f-display);
    letter-spacing: -0.045em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .stat__prefix { color: var(--muted); margin-right: -4px; }
  .stat__value small { font: 400 1rem/1 var(--f-body); letter-spacing: 0; color: var(--text); }
  .stat__desc { margin-top: 16px; font-size: 0.90625rem; line-height: 1.55; max-width: 28ch; }
  .stat__src { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 18px; font: 400 0.71875rem/1.3 var(--f-mono); color: var(--muted); }
  .stat__src a { display: inline-flex; align-items: center; gap: 4px; color: var(--text); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  .stat__src a:hover { color: var(--blue); text-decoration-color: currentColor; }

  @container (max-width: 980px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(odd) { border-left: 0; padding-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid var(--line); }
  }

  @container (max-width: 520px) {
    .stats { grid-template-columns: 1fr; }
    .stat, .stat:nth-child(n) { border-left: 0; padding: 26px 0 6px; }
    .stat + .stat { border-top: 1px solid var(--line); }
  }
</style>
