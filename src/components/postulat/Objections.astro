---
/**
 * /postulat/ — najczęstsze zarzuty (RODO, rozpoznawalność, „atak na lekarzy”), odsyłacz do szerszego
 * programu (jedno zdanie — program jest osobno) i pomoc w nagłośnieniu.
 * Dwujęzyczny: na /en/demand/ teksty z src/data/en/postulat.ts; projekt ustawy i program są tylko
 * po polsku — linki z „(in Polish)”. Wyjście polskie bez zmian.
 */
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import Faq from '@/components/blocks/Faq.astro';
import ShareLinks from '@/components/article/ShareLinks.astro';
import * as pl from '@/data/postulat';
import * as en from '@/data/en/postulat';
import { programPage } from '@/data/program';
import { projekt } from '@/data/projekt-ustawy';
import { localeOf } from '@/i18n/locales';
import { typo } from '@/lib/format';

const locale = localeOf(Astro.url.pathname);
const { objections, postulatPage, programNote } = locale === 'en' ? en : pl;
const T = {
  pl: {
    id: 'zarzuty',
    path: '/postulat/',
    eyebrow: 'Zarzuty',
    title: 'A co z RODO',
    intro: 'RODO nie zakazuje przetwarzania danych — określa, kiedy i na jakiej podstawie wolno je przetwarzać. Odpowiadamy też na pytania, na które sami nie znamy jeszcze odpowiedzi.',
    questions: 'Otwarte pytania prawne',
    program: programPage.title,
    share: 'Pomóż nagłośnić postulat',
    hreflang: undefined,
  },
  en: {
    id: en.sectionIds.zarzuty,
    path: '/en/demand/',
    eyebrow: 'Objections',
    title: 'What about the GDPR',
    intro: 'The GDPR does not prohibit the processing of data — it sets out when and on what basis data may be processed. We also answer questions to which we do not yet know the answer ourselves.',
    questions: 'Open legal questions (in Polish)',
    program: 'Broader programme (in Polish)',
    share: 'Help spread the word about our demand',
    hreflang: 'pl',
  },
}[locale];

const url = new URL(T.path, Astro.site).href;
---
<Section id={T.id} tone="soft" aria-labelledby={`${T.id}-title`}>
  <div class="obj">
    <div class="obj__intro">
      <Eyebrow>{T.eyebrow}</Eyebrow>
      <Heading id={`${T.id}-title`} punct="?">{T.title}</Heading>
      <p>{T.intro}</p>
      <LinkArrow href={`${projekt.href}#zalacznik-b`} hreflang={T.hreflang}>{T.questions}</LinkArrow>
    </div>
    <Faq items={objections} openFirst />
  </div>

  <p class="obj__program">
    <span>{typo(programNote)}</span>
    <LinkArrow href={programPage.href} hreflang={T.hreflang}>{T.program}</LinkArrow>
  </p>

  <div class="obj__share">
    <ShareLinks url={url} title={postulatPage.title} label={T.share} />
  </div>
</Section>

<style>
  .obj { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 40px clamp(40px, 6vw, 96px); align-items: start; }
  .obj__intro p { margin: 24px 0 24px; font-size: 1.03125rem; line-height: 1.7; max-width: 40ch; color: var(--ink-2); }
  .obj__program {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px;
    margin-top: clamp(48px, 6vw, 72px); padding-top: 24px; border-top: 1px solid var(--line-2);
    font-size: 1.03125rem; line-height: 1.6; color: var(--ink-2);
  }
  .obj__program span { max-width: 64ch; }
  .obj__share { margin-top: clamp(56px, 7vw, 88px); }

  @media (max-width: 1024px) {
    .obj { grid-template-columns: minmax(0, 1fr); }
  }
</style>
