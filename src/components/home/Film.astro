---
/**
 * Strona główna: film „Brak odczytu” (40 s) — wejście w temat tuż przed „Temat w 30 sekund”.
 * Pobieranie i zasady wykorzystania są na /media/#film.
 */
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import Film from '@/components/blocks/Film.astro';
---
<Section id="film" space="bottom" aria-labelledby="film-title">
  <SectionHead eyebrow="Film · 40 sekund" title="Suma, której nikt nie liczy" id="film-title" layout="row">
    <LinkArrow slot="action" href="/media/#film">Pobierz film</LinkArrow>
  </SectionHead>
  <Film id="film-glowna" />
</Section>
