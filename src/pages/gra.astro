<script is:inline>
'use strict';
/* ── DRUGI LICZNIK v6 ──
   Nowe: offline progress, łuk rejestru (blokowanie drożeje), energia z zębami
   (klik i praca kosztują, sen tylko w wolne noce), druga placówka jako zakładka,
   8 decyzji, kolejka pacjentów, gablota osiągnięć, migracje zapisu.            */

const T = {
  H_NA_SEK: 6,
  KLIK_BAZA: 10,
  TIER_MNOZNIK: [1, 2, 4, 8],
  NETTO_UOP_NISKI: 0.72, NETTO_UOP_WYSOKI: 0.55, PROG_ROCZNY: 120000,
  NETTO_B2B: 0.84,
  CEGIELKA_TYG: 0.02,
  KLIK_ENERGIA: 0.5,
  KAWA_CENA0: 300, KAWA_R: 1.6, KAWA_PLUS: 15,
  URLOP_MS: 20000, URLOP_PLUS: 40, URLOP_CD_MS: 60000,
  NEG_CD_MS: 45000,
  REJESTR_OD: 120000, REJESTR_KOSZT0: 40000, REJESTR_R: 3,
  OFFLINE_MIN_S: 45, OFFLINE_CAP_S: 8 * 3600, OFFLINE_TEMPO: 0.5,
  KOL: 7, RZED: 6,
  WERSJA: 6,
};
const TIERY = ['Stażysta', 'Rezydent', 'Specjalista', 'Kontraktowiec', 'Walizkowiec'];
const LINK = p => 'https://zarobkilekarzy.pl' + p;
const iko = n => '<svg class="i"><use href="#i-' + n + '"/></svg>';

const SZKOLENIA = [
  { n: 'Kurs USG', k: 100, b: 2, f: 'Weekend w hotelu konferencyjnym, certyfikat na ścianę.' },
  { n: 'Kurs echo serca', k: 450, b: 3, f: 'Serce pacjenta na ekranie. Twoje: 140/min, bo kredyt.' },
  { n: 'Kurs endoskopii', k: 1800, b: 4, f: 'Zaglądasz ludziom w głąb. NFZ zagląda w twoje punkty.' },
  { n: 'Studia podyplomowe', k: 7000, b: 6, f: 'Dwa lata weekendów. Dyplom uprawnia do kolejnych studiów.' },
  { n: 'Doktorat', k: 28000, b: 8, f: 'Litery przed nazwiskiem. Do rozliczenia z NFZ nie wchodzą.' },
];
const BILOKACJA = [
  { k: 150000, ef: 'komórki grafiku dzielą się na 2 tory — te same godziny, druga wypłata', f: 'Szkolenie weekendowe: jak być w dwóch miejscach naraz. Nikt nie porównuje grafików.' },
  { k: 1200000, ef: 'trzy tory w komórce — te same godziny, trzy wypłaty', f: 'Trzy oddziały, jedno ciało. Rekordzista z życia rozliczał doby po 72 godziny.' },
];
/* energia: praca kosztuje (tor 0), sen oddaje tylko w WOLNE noce */
const TYPY = {
  etat:     { et: 'ETAT',   st: () => S.tier >= 2 ? 87 : 50, dren: 0.35, rynek: false },
  dyzur:    { et: 'DYŻUR',  st: () => 110, dren: 1.6,  rynek: true },
  poradnia: { et: 'PORAD',  st: () => 130, dren: 0.5,  rynek: true },
  kontrakt: { et: 'FIRMA',  st: () => 170, dren: 0.6,  rynek: true },
  obok:     { et: 'OBOK',   st: () => 220, dren: 0.7,  rynek: true },
  cito:     { et: 'CITO×3', st: () => 500, dren: 1.8,  rynek: true },
};

let S = {
  wersja: T.WERSJA,
  portfel: 0, lifetime: 0, jawneCum: 0, realCum: 0,
  kliki: 0, pacjenci: 0, zKolejki: 0, kolejka: 2,
  szkolenia: 0, tier: 0, etat: false, b2b: false,
  gen: { dyzur: 0, poradnia: 0, obok: 0 },
  bloki: [],                       // {c,r,lane,typ,kreska,cito,p}
  plansze: 1, aktywnaPlansza: 0,
  mieszkania: 0, apartamenty: 0, panamerka: false,
  hCap: 48, optout: false, grafik: false, cennik: false,
  cegielki: 0, indeks: 1, negocjacje: 0, mnoznikObok: 1,
  energia: 100, urlopDo: 0, kawyTydzien: 0,
  bilokacja: 0,
  ryzyko: 0, kontrole: 0, kawyRazem: 0,
  blokadyRejestru: 0,
  gh: 8, tydzienNr: 1, tydzienSuma: 0,
  odslony: {}, achv: {},
  systemOtwarty: false, fin: false, rejestrDziala: false,
  ostatnioOnline: 0,
};

const $ = id => document.getElementById(id);
const fmt = n => Math.floor(n).toLocaleString('pl-PL') + ' zł';
const fmtX = n => '×' + n.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const DNI = ['pon', 'wt', 'śr', 'czw', 'pt', 'sob', 'nd'];
const zegar = () => {
  const d = Math.floor(S.gh / 24) % 7, h = Math.floor(S.gh % 24), m = Math.floor((S.gh % 1) * 60);
  return DNI[d] + ' ' + String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
};
const czytnik = t => { $('czytnik').textContent = t; };
const redMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

function log(txt, wazne) {
  const li = document.createElement('li');
  li.innerHTML = '<span class="czas">' + zegar() + '</span> ' + (wazne ? '<b>' + txt + '</b>' : txt);
  const ol = $('dziennik');
  ol.prepend(li);
  while (ol.children.length > 40) ol.lastChild.remove();
  $('dziennikBox').style.display = 'block';
}

