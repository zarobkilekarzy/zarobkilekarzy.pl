---
/**
 * Zrzut ekranu w treści (np. pod krokiem instrukcji). W odróżnieniu od <Photo> nie kadruje
 * i nie filtruje obrazu — interfejs ma być czytelny w całości. Wyższa jakość WebP niż
 * przy zdjęciach, bo drobny tekst na zrzutach źle znosi artefakty kompresji.
 */
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { variantWidths } from '@/lib/images';
import { typo } from '@/lib/format';

interface Props extends HTMLAttributes<'figure'> {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** szerokość, w jakiej zrzut jest rysowany — domyślnie kolumna artykułu */
  sizes?: string;
}

const { src, alt, caption, sizes = '(max-width: 720px) 100vw, 780px', class: className, ...rest } = Astro.props;
---
<figure class:list={['shot', className]} {...rest}>
  <Image src={src} alt={alt} widths={variantWidths(src, [480, 720, 960])} sizes={sizes} format="webp" quality={80} />
  {caption && <figcaption>{typo(caption)}</figcaption>}
</figure>

<style>
  .shot :global(img) { display: block; width: 100%; height: auto; filter: var(--photo-filter); }
  figcaption { margin-top: 8px; font: 400 0.84375rem/1.5 var(--f-body); color: var(--text); }
</style>
