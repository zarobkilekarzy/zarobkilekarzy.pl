---
/**
 * /faq/ — najczęstsze zarzuty wobec serwisu i odpowiedzi (FAQPage w grafie lib/seo).
 * Treść: src/data/faq.ts. Zarzuty prawne wobec postulatu są na /postulat/#zarzuty.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageMeta from '@/components/layout/PageMeta.astro';
import Actions from '@/components/layout/Actions.astro';
import Button from '@/components/ui/Button.astro';
import Faq from '@/components/blocks/Faq.astro';
import NoteList from '@/components/article/NoteList.astro';
import { faqItems, faqNotes, faqPage } from '@/data/faq';
import { plain } from '@/lib/inline';
import type { Crumb, SeoInput } from '@/lib/seo';

const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: faqPage.title }];
const seo: SeoInput = {
  title: faqPage.docTitle,
  description: faqPage.description,
  breadcrumbs: crumbs,
  page: {
    type: 'FAQPage',
    questions: faqItems.map((item) => ({ question: item.question, answer: plain(item.answer.join(' ')) })),
  },
};
---
<BaseLayout seo={seo}>
  <Section space="bottom" class="faq-top">
    <PageHeader title={faqPage.title} lead={faqPage.lead} eyebrow="Pytania i zarzuty" crumbs={crumbs}>
      <PageMeta
        items={[
          { label: 'Pytania', value: faqItems.length },
          { label: 'Aktualizacja', value: faqPage.updated },
        ]}
      />
    </PageHeader>
  </Section>

  <Section space="bottom">
    <Faq items={faqItems} notes={faqNotes} openFirst />
    <NoteList notes={faqNotes} class="faq-notes" />
    <Actions class="faq-actions">
      <Button href="/postulat/">Poznaj postulat</Button>
      <Button href="/mechanizmy/" variant="ghost">Zobacz mechanizmy</Button>
    </Actions>
  </Section>
</BaseLayout>

<style>
  .faq-top { padding-top: clamp(32px, 4vw, 56px); }
  .faq-notes { margin-top: 40px; }
  .faq-actions { margin-top: 40px; }
</style>
