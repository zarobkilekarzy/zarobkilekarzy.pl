---
/**
 * /analizy/symulator-podazy-lekarzy/ — ustaw nabór na medycynę, zobacz, ilu lekarzy będzie.
 * Widok: components/podaz (ustawienia | przyklejony wynik). Rachunek: lib/podaz/model.
 * Wpis kolekcji `symulator-podazy-lekarzy` zostaje bez treści i linkuje tutaj (href).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Prose from '@/components/article/Prose.astro';
import NoteRef from '@/components/article/NoteRef.astro';
import NoteList from '@/components/article/NoteList.astro';
import SupplySimulator from '@/components/podaz/SupplySimulator.astro';
import {
  DEFAULTS, GUS_WITH_PATIENTS, LIMIT_TODAY, LIMIT_TODAY_LABEL, MEASURED, seats, NIL_BASE, OVER_70, REGISTER_DATE, REGISTER_TOTAL,
  SPEC_YEARS, STUDY_YEARS, YEAR_END,
} from '@/lib/podaz/model';
import { thousands } from '@/lib/podaz/charts';
import { articleHref, getArticle, isPublished } from '@/lib/content';
import { mainNav } from '@/data/navigation';
import type { Crumb, SeoInput } from '@/lib/seo';
import { formatPL, typo } from '@/lib/format';
import { defineNotes } from '@/lib/notes';

const title = 'Symulator podaży lekarzy';
const lead = `Limit miejsc na medycynie działa z opóźnieniem: ${STUDY_YEARS} lat do dyplomu, ${STUDY_YEARS + SPEC_YEARS} do specjalisty. Zmień nabór i od razu zobacz, ilu lekarzy będzie w 2040 i 2050 r.`;
const description = `Ustaw limit przyjęć na medycynę i zobacz, ilu lekarzy będzie do ${YEAR_END} r. Start: rejestr NIL (${formatPL(REGISTER_TOTAL)} lekarzy wykonujących zawód) i limity z rozporządzeń.`;
const analysesHref = mainNav.find((link) => link.match === '/analizy/')?.href ?? '/analizy/';
const crumbs: Crumb[] = [{ label: 'Start', href: '/' }, { label: 'Analizy', href: analysesHref }, { label: title }];
// Narzędzie z opisem modelu i źródłami — w danych strukturalnych to artykuł działu Analizy.
// Daty z wpisu kolekcji (src/content/articles/symulator-podazy-lekarzy.md: date / updated).
const entry = await getArticle('symulator-podazy-lekarzy');
const seo: SeoInput = {
  title: `${title} w Polsce`,
  description,
  type: 'article',
  section: 'Analizy',
  dates: { published: entry?.data.date, modified: entry?.data.updated ?? entry?.data.date },
  breadcrumbs: crumbs,
  entities: [{ kind: 'article' }],
};

// Powiązane analizy — link tylko do opublikowanych (zapowiedź nie ma jeszcze strony)
const related = async (id: string) => {
  const article = await getArticle(id);
  return isPublished(article) ? articleHref(article) : undefined;
};
const odsiew = await related('odsiew-na-medycynie');
const ciecie = await related('ciecie-limitow-na-medycyne');
const specjalizacje = await related('wedlug-specjalizacji');

// Źródła opisu modelu — przypisy (lib/notes) w kolejności, w jakiej stoją w tekście
const notes = defineNotes({
  nil: `NIL, [Centralny Rejestr Lekarzy — informacje statystyczne](https://nil.org.pl/rejestry/centralny-rejestr-lekarzy/informacje-statystyczne): lekarze wykonujący zawód według grup wieku, stan na ${REGISTER_DATE}.`,
  mz: 'Ministerstwo Zdrowia, BASiW, [„Studenci i absolwenci kierunków medycznych”](https://basiw.mz.gov.pl/mapy-informacje/mapa-2022-2026/analizy/kadry-medyczne/studenci-i-absolwenci-kierunkow-medycznych/) (POL-on, ZUS): odsiew w trakcie studiów i absolwenci bez pracy w Polsce.',
  cem: 'Centrum Egzaminów Medycznych, [statystyki LEK](https://www.cem.edu.pl/lep_s.php): lekarze z dyplomem zagranicznym zdający egzamin.',
  gus: 'GUS, [Zasoby kadrowe w wybranych zawodach medycznych na podstawie źródeł administracyjnych w 2024 r.](https://stat.gov.pl/files/gfx/portalinformacyjny/pl/defaultaktualnosci/5513/28/4/1/zasoby_kadrowe_w_wybranych_zawodach_medycznych_na_podstawie_zrodel_administracyjnych_w_2024_r..pdf), dane za 2024 r.',
  ccomptes: 'Cour des comptes, [L’accès aux études de santé](https://www.ccomptes.fr/sites/default/files/2024-12/20241211-Lacces-aux-%C3%A9tudes-de-sante.pdf), grudzień 2024.',
});

const meta = [
  { label: 'Start modelu', value: `${formatPL(REGISTER_TOTAL)} lekarzy` },
  { label: 'Rejestr NIL', value: '16.01.2026' },
  { label: `Limit ${LIMIT_TODAY_LABEL}`, value: seats(LIMIT_TODAY) },
  { label: 'Horyzont', value: `${YEAR_END} r.` },
];
---
<BaseLayout seo={seo}>
  <Section space="none" class="sim-page">
    <header class="sim-page__head">
      <Breadcrumbs items={crumbs} />
      <div class="sim-page__intro">
        <div>
          <Eyebrow>Narzędzie · dostęp do zawodu</Eyebrow>
          <Heading as="h1" size="display" class="sim-page__title">{title}</Heading>
          <p class="lead sim-page__lead">{typo(lead)}</p>
        </div>
        <dl class="sim-page__meta">
          {meta.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </header>

    <SupplySimulator />
  </Section>

  <Section tone="soft" aria-labelledby="model">
    <div class="about">
      <div>
        <p class="mono-label">Jak czytać wynik</p>
        <Heading as="h2" size="h2" id="model" class="about__title">Różnice, nie poziomy</Heading>
        <p class="about__lead">
          {typo(`Bez ruszania suwaków symulator odtwarza rzeczywistość: rok 2026 to co do osoby rejestr izby lekarskiej, a historia naboru — limity z rozporządzeń MZ. Wszystko, co zmienisz, model liczy jako odchylenie od tego stanu, więc wiarygodne są przede wszystkim różnice między scenariuszami.`)}
        </p>
      </div>

      <div>
        <Prose class="about__body">
          <h3>Co model robi</h3>
          <ol>
            <li><strong>Startuje od rejestru, nie od szacunku.</strong> {typo(`Punkt wyjścia to ${formatPL(REGISTER_TOTAL)} lekarzy wykonujących zawód w jedenastu grupach wieku.`)}<NoteRef notes={notes} id="nil" /></li>
            <li><strong>Wiąże wiek z rocznikiem naboru.</strong> {typo('Lekarz, który ma dziś 48 lat, zaczynał studia ok. 1997 r. Zmiana naboru w tamtym roku skaluje ten rocznik proporcjonalnie — dlatego zmiana przeszłości od razu zmienia stan na dziś.')}</li>
            <li>
              <strong>Dolicza nowe roczniki po odsiewie i wyjazdach.</strong>{' '}
              {typo(`Z każdego przyszłego rocznika odpada ${Math.round((1 - MEASURED.graduate) * 100)}% przyjętych, a ${Math.round(MEASURED.abroad * 100)}% absolwentów nie pracuje w Polsce; co roku dochodzi ${formatPL(MEASURED.inflow)} lekarzy z dyplomem zagranicznym. Dane:`)}{' '}
              {typo('aplikacja MZ „Studenci i absolwenci kierunków medycznych”')}<NoteRef notes={notes} id="mz" /> i {typo('statystyki LEK z CEM')}<NoteRef notes={notes} id="cem" />{odsiew && <>, zestawione w <a href={odsiew}>analizie o odsiewie</a></>}.
            </li>
            <li><strong>Odejmuje odchodzących.</strong> {typo(`Po osiągnięciu wybranego wieku (domyślnie ${DEFAULTS.retireAge} lat) rocznik wygasa przez pięć lat. Dotyczy to też ${thousands(OVER_70)} osób powyżej 70 lat, które rejestr wciąż liczy jako wykonujące zawód.`)}</li>
          </ol>

          <h3>Czego model nie robi</h3>
          <ul>
            <li><strong>Nie prognozuje losów rocznika.</strong> {typo('Odsiew, wyjazdy i napływ to trzy stałe liczby. Kto kończy studia z opóźnieniem, w modelu przepada, a wyjazdy są zmierzone tylko w pierwszych sześciu latach po dyplomie. Obie krzywe liczone są tak samo, więc różnica między nimi zostaje wiarygodna.')}</li>
            <li><strong>Nie liczy etatów ani godzin.</strong> {typo(`Lekarz w modelu to osoba w rejestrze. Z pacjentem pracuje ${formatPL(GUS_WITH_PATIENTS)} z nich`)}<NoteRef notes={notes} id="gus" /> — stąd kropkowana linia na wykresie.</li>
            <li><strong>Nie rozróżnia dziedzin ani regionów.</strong> {typo('Braki są specjalizacyjne i lokalne, a model daje jedną liczbę na cały kraj.')}{specjalizacje && <> Miejsca specjalizacyjne mają własne wąskie gardło — pokazujemy je w zestawieniu <a href={`${specjalizacje}#miejsca-specjalizacyjne`}>według specjalizacji</a>.</>}</li>
            <li><strong>Nie zna popytu.</strong> {typo('Pokazuje podaż, a nie potrzeby starzejącego się społeczeństwa. Francuski trybunał obrachunkowy po pół wieku regulowania liczby lekarzy stwierdził, że wspólnej metody liczenia potrzeb wciąż nie ma.')}<NoteRef notes={notes} id="ccomptes" /></li>
            <li><strong>Napływ z zagranicy liczy na skróty.</strong> {typo('Stała liczba rocznie — bez wieku i bez wiedzy, ilu zostaje na stałe, bo takich danych nikt nie publikuje.')}</li>
          </ul>
        </Prose>

        <p class="about__sources">
          {typo(`Nabór to miejsca na studiach lekarskich po polsku (stacjonarne, niestacjonarne i pula dla cudzoziemców); studia anglojęzyczne są poza modelem, bo zostaje po nich w Polsce mniej niż 1% absolwentów. Lata 2012–${LIMIT_TODAY_LABEL.slice(0, 4)} to dokładne limity z rozporządzeń MZ w wersji końcowej, po nowelizacjach (ta sama tabela co w analizie o English Division), 1987–2011 — punkty kontrolne (1987: ${formatPL(6000)}, 1990: ${formatPL(3300)}, 2003: ${formatPL(2090)}) z latami pośrednimi interpolowanymi.`)}
          {ciecie && <> Szerzej w analizie <a href={ciecie}>o cięciu limitów</a>.</>}
          {' '}{typo(`Warianty cięcia A–C to analiza zespołu ekspertów NIL z czerwca 2024 r., przeliczona proporcjonalnie z ${formatPL(NIL_BASE)} miejsc z projektu rozporządzenia na 2024/25 na dzisiejszy limit ${formatPL(LIMIT_TODAY)}.`)}
        </p>

        <NoteList notes={notes} class="about__notes" />
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .sim-page { padding-top: clamp(28px, 4vw, 48px); padding-bottom: clamp(56px, 6vw, 96px); }
  .sim-page__head { margin-bottom: clamp(28px, 3vw, 40px); }
  .sim-page__intro {
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 24px clamp(32px, 5vw, 80px); align-items: end; margin-top: 32px;
  }
  .sim-page__title { font-size: clamp(2.375rem, 4.4vw, 3.875rem); margin-bottom: 18px; }
  .sim-page__lead { font-size: 1.125rem; max-width: 38em; }
  .sim-page__meta { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .sim-page__meta > div { padding: 12px 16px 12px 0; border-bottom: 1px solid var(--line); }
  .sim-page__meta dt { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .sim-page__meta dd { font: 400 1.0625rem/1.2 var(--f-display); letter-spacing: -0.01em; color: var(--ink); }

  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 40px clamp(40px, 6vw, 96px); align-items: start; }
  .about__title { margin: 14px 0 20px; }
  .about__lead { font-size: 1.0625rem; line-height: 1.65; color: var(--text-strong); }
  .about__body :global(h3:first-child) { margin-top: 0; }
  .about__notes { margin-top: 32px; }
  .about__sources { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line-2); font-size: 0.90625rem; line-height: 1.6; color: var(--muted); }
  /* Linki z szablonu strony dostają atrybut zakresu, więc wygląd jak w Prose ustawiamy tutaj; numery przypisów stylują się same (styles/footnotes.css) */
  .about__body a, .about__sources a { color: var(--blue); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .about__body a:hover, .about__sources a:hover { text-decoration-thickness: 2px; }

  @media (max-width: 960px) {
    .sim-page__intro, .about { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .sim-page__lead { font-size: 1.03125rem; }
  }
</style>
