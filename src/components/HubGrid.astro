---
// Spis huba — wspólny dla /mechanizmy, /dane i /analizy.
// Wcześniej ten sam CSS i ta sama pętla żyły w trzech plikach naraz.
import { TEMATY } from '../lib/pages';
import type { Wpis } from '../lib/pages';

interface Props {
  strony: Wpis[];
  /** Odstęp pionowy — /dane ma nad siatką nagłówek, więc mniejszy. */
  zwarta?: boolean;
  /**
   * Etykieta tematu na karcie. Daje podział na hubie działu BEZ dzielenia siatki
   * na grupy (9 kart w 5 grupach czyta się gorzej niż 9 opisanych kart).
   * Na hubie tematu zbędna — tam wszystkie karty mają ten sam temat.
   */
  temat?: boolean;
}

const { strony, zwarta = false, temat = false } = Astro.props;
---

<ol class={zwarta ? 'hub-spis is-zwarta' : 'hub-spis'}>
  {
    strony.map((s) => (
      <li>
        <a href={s.href}>
          <span class="hub-h">
            {temat && <span class="hub-temat">{TEMATY[s.tematy[0]].label}</span>}
            <span class="hub-t">{s.tytul}</span>
          </span>
          <span class="hub-d">{s.opis}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  /* Spis w liniach, jak na stronie głównej — pozycje w liniach zamiast
     siatki jednakowych kart. Tytuł po lewej, opis po prawej,
     strzałka na końcu wiersza; cały wiersz jest odnośnikiem. */
  .hub-spis { list-style: none; margin: 0 0 0.5rem; padding: 0; }
  .hub-spis.is-zwarta { margin-bottom: 0.25rem; }
  .hub-spis li { border-bottom: 1px solid var(--line); }
  .hub-spis li:last-child { border-bottom: 0; }
  .hub-spis a {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr) 1.5rem; column-gap: 2rem;
    align-items: baseline; margin: 0 -0.75rem; padding: 1rem 0.75rem;
    text-decoration: none; color: inherit;
  }
  .hub-spis a::after { content: "→"; font-weight: 700; color: var(--ink-faint); justify-self: end; }
  .hub-h { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  /* Wiersz jest w całości <a>, więc etykieta tematu NIE może być linkiem
     (zagnieżdżone <a> to niepoprawny HTML). */
  .hub-temat { font-size: var(--fs-label); font-weight: 650; font-stretch: 78%; color: var(--ink-faint); }
  .hub-t { font-size: var(--fs-title-s); font-weight: 760; font-stretch: 108%; line-height: 1.2; color: var(--ink); text-wrap: balance; }
  /* Opisy w rejestrze stron bywają całymi akapitami — dwa wiersze wystarczą,
     reszta jest na podstronie. Pełny opis zostaje w HTML dla czytników
     ekranu i wyszukiwarki. */
  .hub-d {
    font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.5;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
  }
  .hub-spis a:hover { background: var(--paper); }
  .hub-spis a:hover .hub-t { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .hub-spis a:hover::after { color: var(--ink); }
  .hub-spis a:focus-visible { outline-offset: -2px; }

  @media (max-width: 760px) {
    .hub-spis a { grid-template-columns: minmax(0, 1fr) 1.25rem; row-gap: 0.35rem; column-gap: 1rem; }
    .hub-h, .hub-d { grid-column: 1; }
    .hub-spis a::after { grid-column: 2; grid-row: 1; }
    .hub-d { -webkit-line-clamp: 3; line-clamp: 3; }
  }
</style>
