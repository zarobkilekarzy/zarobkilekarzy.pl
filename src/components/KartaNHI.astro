---
import portret from '../assets/tajwan/nosacz-portret.webp';

// Wzór tajwańskiej karty ubezpieczenia NHI (analiza o Tajwanie) — uproszczona ilustracja SVG.
// Dane zmyślone (ten sam „Jan Kowalski” co na przykładowym rachunku), zamiast zdjęcia
// nosacz (src/assets/tajwan/nosacz-portret.webp — przycięty, bez metadanych), zamiast godła
// NHI — uproszczony znak. Objaśnienia zawierają tylko
// to, co tekst analizy podaje ze źródłem (karta od 2004, zapis wizyt, hasło na karcie).
// Karta jest przedmiotem fizycznym, więc ma własne, stałe kolory w obu motywach strony.
// Numerki to przyciski HTML nałożone na SVG (dostępne z klawiatury i dla czytników):
// najechanie/fokus pokazuje popover, klik (dotyk) go przypina, Escape zamyka.
// Lista pod kartą zostaje — to wersja bez JS i podsumowanie dla czytników ekranu.

interface Objasnienie {
  nr: number;
  x: number; // współrzędne numerka w układzie viewBox 856×540
  y: number;
  tytul: string;
  tekst: string;
}

const objasnienia: Objasnienie[] = [
  { nr: 1, x: 139, y: 178, tytul: 'Chip', tekst: 'Przy każdej wizycie placówka zapisuje na nim wizytę i jej kolejny numer, a dane w ciągu 24 godzin trafiają do NHIA. Pacjent może ustawić na karcie hasło, które blokuje odczyt jego danych.' },
  { nr: 2, x: 232, y: 228, tytul: 'Imię i nazwisko', tekst: 'Posiadacza karty — tu zmyślone.' },
  { nr: 3, x: 232, y: 318, tytul: 'Numer identyfikacyjny', tekst: 'Posiadacza karty — tu zmyślony.' },
  { nr: 4, x: 232, y: 368, tytul: 'Data urodzenia', tekst: 'W kalendarzu Republiki Chińskiej: 89/01/01 to 1 stycznia 2000 r.' },
  { nr: 5, x: 822, y: 168, tytul: 'Zdjęcie', tekst: 'Zdjęcie posiadacza — tu, zamiast prawdziwej osoby, nosacz.' },
  { nr: 6, x: 50, y: 458, tytul: 'Numer karty', tekst: 'Tu zmyślony.' },
  { nr: 7, x: 400, y: 446, tytul: '樣本 — „wzór”', tekst: 'Tak oznacza się przykładowe karty.' },
];
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(2)}%`;
---

<figure class="karta" data-karta>
  <div class="karta-scena">
  <svg
    class="karta-svg"
    viewBox="0 0 856 540"
    role="img"
    aria-labelledby="karta-tytul karta-opis"
  >
    <title id="karta-tytul">Wzór tajwańskiej karty ubezpieczenia zdrowotnego NHI</title>
    <desc id="karta-opis">
      Karta z chipem, napisem 全民健康保險 / National Health Insurance, imieniem i nazwiskiem
      Jan Kowalski, numerem identyfikacyjnym, datą urodzenia 89/01/01, numerem karty
      i czerwonym napisem 樣本 (wzór). W miejscu zdjęcia — portret nosacza.
    </desc>
    <defs>
      <linearGradient id="karta-tlo" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e4f1f7" />
        <stop offset="0.55" stop-color="#f6faf3" />
        <stop offset="1" stop-color="#dcefe6" />
      </linearGradient>
      <linearGradient id="karta-chip" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f3d27a" />
        <stop offset="0.5" stop-color="#d8a93c" />
        <stop offset="1" stop-color="#b98a22" />
      </linearGradient>
      <clipPath id="karta-ramka"><rect x="0" y="0" width="856" height="540" rx="34" /></clipPath>
      <clipPath id="karta-foto-clip"><rect x="606" y="150" width="200" height="252" rx="6" /></clipPath>
    </defs>

    <g clip-path="url(#karta-ramka)">
      <rect width="856" height="540" fill="url(#karta-tlo)" />
      <!-- delikatna gilosza (zabezpieczenie graficzne) -->
      <g fill="none" stroke="#9cc7b4" stroke-opacity="0.35" stroke-width="1.2">
        <path d="M0 330 C 140 270, 280 390, 420 330 S 700 270, 856 330" />
        <path d="M0 350 C 140 290, 280 410, 420 350 S 700 290, 856 350" />
        <path d="M0 370 C 140 310, 280 430, 420 370 S 700 310, 856 370" />
        <path d="M0 470 C 160 420, 300 520, 460 470 S 720 420, 856 470" />
        <circle cx="560" cy="250" r="120" />
        <circle cx="560" cy="250" r="150" />
        <circle cx="560" cy="250" r="180" />
      </g>
      <rect x="0" y="118" width="856" height="2" fill="#7fb59a" fill-opacity="0.5" />
    </g>
    <rect x="1" y="1" width="854" height="538" rx="34" fill="none" stroke="#b9cdd8" stroke-width="2" />

    <!-- uproszczony znak (nie godło NHI) -->
    <g transform="translate(70 26)">
      <circle cx="38" cy="38" r="36" fill="#ffffff" stroke="#2f8f57" stroke-width="5" />
      <circle cx="27" cy="25" r="7" fill="#2f8f57" />
      <circle cx="49" cy="25" r="7" fill="#2f8f57" />
      <rect x="20" y="35" width="14" height="26" rx="6" fill="#2f8f57" />
      <rect x="42" y="35" width="14" height="26" rx="6" fill="#2f8f57" />
      <rect x="28" y="42" width="20" height="7" rx="3" fill="#2f8f57" />
    </g>
    <text x="170" y="66" class="k-zh k-tytul">全民健康保險</text>
    <text x="171" y="100" class="k-en">NATIONAL HEALTH INSURANCE</text>

    <!-- znacznik kierunku wkładania i chip -->
    <path d="M38 252 L62 230 L62 274 Z" fill="#3a9b5c" />
    <g transform="translate(78 196)">
      <rect width="122" height="98" rx="16" fill="url(#karta-chip)" stroke="#a37a1e" stroke-width="2" />
      <g fill="none" stroke="#8a6414" stroke-width="2.4" stroke-linecap="round">
        <path d="M0 33 H40 M0 65 H40 M82 33 H122 M82 65 H122" />
        <path d="M40 14 V84 M82 14 V84" />
        <rect x="40" y="33" width="42" height="32" rx="6" />
      </g>
    </g>

    <!-- dane posiadacza (zmyślone) -->
    <text x="250" y="262" class="k-imie">Jan Kowalski</text>
    <text x="252" y="330" class="k-dane">A123456789</text>
    <text x="252" y="380" class="k-dane">89/01/01</text>
    <text x="420" y="466" class="k-zh k-wzor">樣　本</text>
    <text x="70" y="472" class="k-numer">0000 1234 5678</text>

    <!-- „zdjęcie” — nosacz zamiast prawdziwego posiadacza -->
    <rect x="606" y="150" width="200" height="252" rx="6" fill="#ffffff" />
    <image
      href={portret.src}
      x="606" y="150" width="200" height="252"
      preserveAspectRatio="xMidYMid slice"
      clip-path="url(#karta-foto-clip)"
    />
    <rect x="606" y="150" width="200" height="252" rx="6" fill="none" stroke="#c4d2dc" stroke-width="2" />

  </svg>
  {objasnienia.map((o) => (
    <button
      type="button"
      class="karta-nr"
      style={`left:${pct(o.x, 856)};top:${pct(o.y, 540)}`}
      data-nr={o.nr}
      data-tytul={o.tytul}
      data-tekst={o.tekst}
      aria-label={`${o.nr}. ${o.tytul}: ${o.tekst}`}
      aria-expanded="false"
      aria-controls="karta-pop"
    >{o.nr}</button>
  ))}
  <div class="karta-pop" id="karta-pop" role="tooltip" hidden data-karta-pop>
    <strong data-karta-pop-tytul></strong>
    <span data-karta-pop-tekst></span>
  </div>
  </div>

  <ol class="karta-legenda">
    {objasnienia.map((o) => <li><strong>{o.tytul}.</strong> {o.tekst}</li>)}
  </ol>

  <figcaption>
    Uproszczona ilustracja karty ubezpieczenia NHI. Dane, zdjęcie i znak w lewym górnym
    rogu są zmyślone.
  </figcaption>
</figure>

<style>
  .karta { margin: 2rem 0 1.5rem; }
  .karta-scena { position: relative; max-width: 520px; margin: 0 auto; }
  .karta-svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.22));
  }
  .k-zh { font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", "Heiti TC", sans-serif; }
  .k-tytul { font-size: 52px; font-weight: 700; fill: #23744a; letter-spacing: 6px; }
  .k-en {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    font-weight: 700;
    fill: #23744a;
    letter-spacing: 1px;
  }
  .k-imie { font-family: var(--font-sans); font-size: 54px; font-weight: 600; fill: #111; }
  .k-dane { font-family: var(--font-sans); font-size: 34px; font-weight: 700; fill: #111; letter-spacing: 1px; }
  .k-numer { font-family: var(--font-mono); font-size: 26px; fill: #222; letter-spacing: 2px; }
  .k-wzor {
    font-family: "Noto Serif TC", "PMingLiU", "Songti TC", serif;
    font-size: 72px;
    fill: #d32f2f;
    letter-spacing: 4px;
  }
  .karta-nr {
    position: absolute;
    width: 1.55rem;
    height: 1.55rem;
    margin: -0.775rem 0 0 -0.775rem;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font: 700 0.78rem/1 var(--font-sans);
    cursor: help;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .karta-nr:hover,
  .karta-nr:focus-visible,
  .karta-nr[aria-expanded='true'] {
    transform: scale(1.18);
    box-shadow: 0 0 0 4px rgba(42, 120, 214, 0.35), 0 2px 6px rgba(0, 0, 0, 0.3);
    outline: none;
  }
  .karta-pop {
    position: absolute;
    z-index: 10;
    width: min(17rem, 90%);
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.45);
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .karta-pop strong { display: block; margin-bottom: 0.15rem; }
  .karta-pop span { color: var(--ink-soft); }
  @media (prefers-reduced-motion: reduce) { .karta-nr { transition: none; } }

  .karta-legenda {
    max-width: 560px;
    margin: 1.2rem auto 0;
    padding-left: 1.6rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .karta-legenda li { margin: 0.25rem 0; }
  .karta-legenda li::marker { color: var(--brand-link); font-weight: 700; }
  .karta-legenda strong { color: var(--ink); }
  .karta figcaption {
    max-width: 560px;
    margin: 0.6rem auto 0;
    font-size: 0.8rem;
    color: var(--ink-faint);
    line-height: 1.45;
  }
</style>

<script>
  for (const karta of document.querySelectorAll<HTMLElement>('[data-karta]')) {
    const scena = karta.querySelector<HTMLElement>('.karta-scena');
    const pop = karta.querySelector<HTMLElement>('[data-karta-pop]');
    const tytul = karta.querySelector<HTMLElement>('[data-karta-pop-tytul]');
    const tekst = karta.querySelector<HTMLElement>('[data-karta-pop-tekst]');
    const przyciski = [...karta.querySelectorAll<HTMLButtonElement>('.karta-nr')];
    if (!scena || !pop || !tytul || !tekst) continue;
    let przypiety: HTMLButtonElement | null = null;

    const pokaz = (b: HTMLButtonElement) => {
      tytul.textContent = b.dataset.tytul ?? '';
      tekst.textContent = b.dataset.tekst ?? '';
      for (const x of przyciski) x.setAttribute('aria-expanded', String(x === b));
      pop.hidden = false;
      // Pozycja: nad numerkiem, a gdy brak miejsca — pod nim; w poziomie w granicach karty.
      const s = scena.getBoundingClientRect();
      const r = b.getBoundingClientRect();
      const w = pop.offsetWidth;
      const h = pop.offsetHeight;
      const srodek = r.left - s.left + r.width / 2;
      pop.style.left = `${Math.max(0, Math.min(srodek - w / 2, s.width - w))}px`;
      const nad = r.top - s.top - h - 8;
      pop.style.top = `${nad >= 0 ? nad : r.bottom - s.top + 8}px`;
    };
    const ukryj = () => {
      pop.hidden = true;
      for (const x of przyciski) x.setAttribute('aria-expanded', 'false');
    };
    const przywroc = () => (przypiety ? pokaz(przypiety) : ukryj());

    for (const b of przyciski) {
      b.addEventListener('mouseenter', () => pokaz(b));
      b.addEventListener('focus', () => pokaz(b));
      b.addEventListener('mouseleave', przywroc);
      b.addEventListener('blur', przywroc);
      b.addEventListener('click', () => {
        przypiety = przypiety === b ? null : b;
        if (przypiety) pokaz(b);
        else ukryj();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        przypiety = null;
        ukryj();
      }
    });
    document.addEventListener('click', (e) => {
      if (przypiety && e.target instanceof Node && !scena.contains(e.target)) {
        przypiety = null;
        ukryj();
      }
    });
  }
</script>
