---
import Section from '@/components/layout/Section.astro';
import Split from '@/components/layout/Split.astro';
import Actions from '@/components/layout/Actions.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Button from '@/components/ui/Button.astro';
import Photo from '@/components/ui/Photo.astro';
import Badge from '@/components/ui/Badge.astro';
import CheckList from '@/components/blocks/CheckList.astro';
import { rights } from '@/data/home';

import patientImg from '@/assets/img/pacjent-konsultacja.jpg';
---
<Section id="pacjent" aria-labelledby="pacjent-title">
  <Split cols="minmax(0, .95fr) minmax(0, 1.05fr)" gap="clamp(40px, 7vw, 112px)" media="start" mediaMax="560px">
    {/* Zdjęcie 5:4 w kadrze 4:5 — rysowane ~1,5× szerzej niż kadr; kadr do 560 px (mediaMax) → obraz do ~880 px */}
    <Photo
      slot="media"
      src={patientImg}
      alt="Lekarz omawia z pacjentem wydruk dokumentacji medycznej"
      ratio="4/5"
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1025px) 850px, min(148vw, 880px)"
      frame
    >
      <Badge variant="stat" value="0 zł" label="pierwsza kopia dokumentacji medycznej" note="art. 28 ustawy o prawach pacjenta" />
    </Photo>

    <Eyebrow>Dla pacjenta</Eyebrow>
    <Heading id="pacjent-title" class="patient__title">Znaj swoje prawa u&nbsp;lekarza</Heading>
    <p class="lead patient__lead">Krótko i&nbsp;konkretnie: co Ci przysługuje, na jakiej podstawie i&nbsp;gdzie się zwrócić, gdy coś pójdzie nie tak.</p>
    <CheckList items={rights} class="patient__rights" />
    <Actions stack="mobile" gap="sm">
      <Button href="/prawa-pacjenta/">Poznaj prawa pacjenta</Button>
      <Button href="/prawa-pacjenta/druk/" variant="ghost" icon="print">Karta do druku</Button>
    </Actions>
  </Split>
</Section>

<style>
  .patient__title { margin-bottom: 20px; }
  .patient__lead { margin-bottom: 36px; }
  .patient__rights { margin-bottom: 40px; }
</style>
