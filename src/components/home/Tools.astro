---
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import QuestionTeaser from '@/components/egzamin/QuestionTeaser.astro';
import ToolCard from '@/components/blocks/ToolCard.astro';
import { tools } from '@/data/home';
import { FIELDS, RULES, sampleQuestion } from '@/data/egzamin';

const fieldLabel = FIELDS[sampleQuestion.exam].find((f) => f.id === sampleQuestion.field)?.label ?? sampleQuestion.field;
const facts = [
  { value: String(RULES.questions), label: 'pytań' },
  { value: String(RULES.minutes / 60), label: 'godziny' },
  { value: `${Math.round(RULES.threshold * 100)}%`, label: 'próg' },
];
---
<Section id="narzedzia" space="bottom" aria-labelledby="tools-title">
  <SectionHead
    eyebrow="Narzędzia"
    title="Sprawdź sam"
    id="tools-title"
    layout="row"
    aside="Interaktywne narzędzia oparte na jawnych danych. Bez logowania, bez zbierania odpowiedzi."
  />

  <div class="tools">
    <QuestionTeaser
      question={sampleQuestion}
      fieldLabel={fieldLabel}
      facts={facts}
      label="Zdaj LEK · pytanie przykładowe"
      note="Tak wygląda tryb nauki: po odpowiedzi klucz i to, jak odpowiadała sala. Symulator korzysta z jawnej bazy CEM."
      cta={{ label: 'Rozwiąż pełny test', href: '/egzamin/' }}
    />
    <div class="tools__side">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </div>
</Section>

<style>
  .tools { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 24px; }
  .tools__side { display: grid; gap: 24px; }

  @media (max-width: 1024px) {
    .tools { grid-template-columns: 1fr; }
    .tools__side { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 720px) {
    .tools__side { grid-template-columns: 1fr; }
  }
</style>
