    padding: 0.9rem 1rem; margin-bottom: 0.6rem;
  }
  .wm-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .wm-grow { flex: 1 1 16rem; }
  .wm-field span { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); }
  .wm-field input, .wm-field select {
    font: inherit; color: var(--ink); background: var(--surface);
    border: 1px solid var(--line-2); border-radius: 8px; padding: 0.45rem 0.6rem; min-width: 11rem;
  }
  .wm-field input:focus-visible, .wm-field select:focus-visible { outline: 2px solid var(--brand-link); outline-offset: 1px; }
  .wm-check { display: flex; align-items: center; gap: 0.45rem; font-size: 0.9rem; color: var(--ink-soft); padding-bottom: 0.5rem; cursor: pointer; }
  .wm-check input { width: 1.05rem; height: 1.05rem; accent-color: var(--brand-link); }
  .wm-count { font-size: 0.85rem; color: var(--ink-faint); margin: 0 0 0.9rem; }

  /* — tabela — */
  .wm-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .wm-scroll:focus-visible { outline: 2px solid var(--brand-link); }
  .wm-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; min-width: 69rem; }
  .wm-table th, .wm-table td { padding: 0.5rem 0.65rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .wm-table thead th { position: sticky; top: 0; background: var(--paper); z-index: 1; border-bottom: 1px solid var(--line-2); padding: 0; }
  .wm-table thead button {
    all: unset; box-sizing: border-box; display: block; width: 100%; cursor: pointer;
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--ink-soft); padding: 0.55rem 0.65rem; white-space: nowrap;
  }
  .wm-table thead .wm-th { display: flex; align-items: center; padding-right: 0.5rem; }
  .wm-table thead .wm-th button { width: auto; flex: 1 1 auto; }
  .wm-table thead .num .wm-th { justify-content: flex-end; }
  .wm-table thead button:hover { color: var(--brand-link); }
  .wm-table thead button:focus-visible { outline: 2px solid var(--brand-link); outline-offset: -2px; }
  .wm-table thead th[aria-sort] button { color: var(--brand-link); }
  .wm-table thead th[aria-sort='ascending'] button::after { content: ' ↑'; }
  .wm-table thead th[aria-sort='descending'] button::after { content: ' ↓'; }
  .wm-table tbody tr:hover { background: var(--surface-2); }
  .wm-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wm-name a { color: var(--ink); text-decoration-color: var(--line-2); }
  .wm-name a:hover { color: var(--brand-link); }
  .wm-city { display: block; font-size: 0.78rem; color: var(--ink-faint); }
  .wm-psz {
    display: inline-block; margin-top: 0.2rem; font-size: 0.66rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand-link);
    border: 1px solid var(--line-2); border-radius: 999px; padding: 0.02rem 0.4rem;
  }
  .wm-woj { white-space: nowrap; color: var(--ink-soft); }

  /* — rozwijanie wiersza — */
  .wm-toggle {
    all: unset; box-sizing: border-box; float: left; cursor: pointer;
    width: 1.15rem; height: 1.15rem; margin: 0.05rem 0.4rem 0 0;
    display: inline-grid; place-items: center;
    border: 1px solid var(--line-2); border-radius: 5px; background: var(--paper);
  }
  .wm-toggle:hover { border-color: var(--brand-link); }
  .wm-toggle:focus-visible { outline: 2px solid var(--brand-link); outline-offset: 1px; }
  .wm-toggle-ico { display: block; width: 0; height: 0;
    border-left: 4px solid var(--ink-soft); border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent; margin-left: 1px; }
  .wm-toggle[aria-expanded='true'] { border-color: var(--brand-link); background: var(--surface-2); }
  .wm-toggle[aria-expanded='true'] .wm-toggle-ico {
    border-left: 3.5px solid transparent; border-right: 3.5px solid transparent;
    border-top: 4px solid var(--brand-link); border-bottom: 0; margin: 1px 0 0;
  }

  .wm-detail > td { background: var(--paper); padding: 0.9rem 1.1rem 1.1rem; }
  .wm-uwaga {
    margin: 0 0 0.85rem; padding: 0.6rem 0.8rem; max-width: 52rem;
    font-size: 0.82rem; line-height: 1.55; color: var(--ink-soft);
    background: var(--amber-50); border-left: 3px solid var(--amber); border-radius: 0 6px 6px 0;
  }
  .wm-uwaga strong { color: var(--ink); }
  .wm-dist-head { margin: 0 0 0.6rem; font-size: 0.85rem; color: var(--ink-soft); }
  .wm-dist-head strong { color: var(--ink); }
  .wm-bars { display: grid; gap: 0.28rem; max-width: 34rem; }
  .wm-bar-row { display: grid; grid-template-columns: 8.5rem 1fr 2.2rem; align-items: center; gap: 0.55rem; }
  .wm-bar-lab { font-size: 0.76rem; color: var(--ink-faint); text-align: right; white-space: nowrap; }
  .wm-bar-track { height: 0.72rem; background: var(--paper-2); border: 1px solid var(--line); border-radius: 3px; overflow: hidden; }
  .wm-bar { display: block; height: 100%; background: var(--brand-link); border-radius: 3px; min-width: 1px; }
  .wm-bar.is-lo { background: var(--neutral-fill); }
  .wm-bar.is-hi { background: var(--amber); }
  .wm-bar-val { font-size: 0.78rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .wm-dist-foot { margin: 0.7rem 0 0; font-size: 0.78rem; color: var(--ink-faint); max-width: 46rem; line-height: 1.5; }
  .wm-dist-foot strong { color: var(--ink-soft); }
  .wm-pop { color: var(--ink-soft); }
  .wm-pop-typ {
    display: block; font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.04em;
  }

  .wm-badge {
    display: inline-block; font-size: 0.72rem; font-weight: 600; border-radius: 999px;
    padding: 0.1rem 0.55rem; white-space: nowrap; border: 1px solid transparent;
  }
  .wm-badge.is-ok { color: var(--ok); background: var(--ok-50); border-color: var(--ok); }
  .wm-badge.is-alert { color: var(--alert); background: var(--alert-50); border-color: var(--alert); }
  .wm-badge.is-mid { color: var(--ink-soft); background: var(--paper); border-color: var(--line-2); }
  .wm-badge.is-mute { color: var(--ink-faint); background: transparent; border-color: var(--line-2); border-style: dashed; }

  /* — pusty wynik — */
  .wm-empty {
    margin: 1rem 0 0; padding: 1rem 1.1rem; font-size: 0.92rem; color: var(--ink-soft);
    background: var(--paper); border: 1px dashed var(--line-2); border-radius: 12px;
  }
  .wm-empty strong { color: var(--ink); }
  .wm-empty button {
    font: inherit; color: var(--brand-link); background: none; border: 0; padding: 0;
    cursor: pointer; text-decoration: underline;
  }
  .wm-empty button:focus-visible { outline: 2px solid var(--brand-link); outline-offset: 2px; }

  /* — stronicowanie — */
  .wm-pager { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 1rem 0 2rem; }
  .wm-pager[hidden] { display: none; } /* [hidden] przegrywa z display:flex */
  .wm-pager button {
    font: inherit; font-size: 0.88rem; color: var(--brand-link); background: var(--surface);
    border: 1px solid var(--line-2); border-radius: 8px; padding: 0.4rem 0.9rem; cursor: pointer;
  }
  .wm-pager button:hover:not(:disabled) { border-color: var(--brand-link); }
  .wm-pager button:focus-visible { outline: 2px solid var(--brand-link); outline-offset: 1px; }
  .wm-pager button:disabled { color: var(--ink-faint); cursor: default; opacity: 0.6; }
  .wm-pager span { font-size: 0.88rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
</style>

<script is:inline>
  (function () {
    var table = document.getElementById('wm-table');
    if (!table) return;
    var tbody = table.tBodies[0];
    // Wiersze danych i doczepione do nich szuflady z wykresem. Szuflada NIE jest
    // wierszem danych: nie sortuje się, nie liczy do wyników, jedzie za swoim.
    var all = Array.prototype.slice.call(tbody.rows).filter(function (r) {
      return !r.classList.contains('wm-detail');
    });
    var detailOf = function (row) {
      var next = row.nextElementSibling;
      return next && next.classList.contains('wm-detail') ? next : null;
    };
    var q = document.getElementById('wm-q');
    var woj = document.getElementById('wm-woj');
    var kat = document.getElementById('wm-kat');
    var lud = document.getElementById('wm-lud');
    var tylkoListy = document.getElementById('wm-tylko-listy');
    var tylkoPsz = document.getElementById('wm-tylko-psz');
    var perPage = document.getElementById('wm-pp');
    var count = document.getElementById('wm-count');
    var empty = document.getElementById('wm-empty');
    var reset = document.getElementById('wm-reset');
    var scroll = table.closest('.wm-scroll');
    var pager = { prev: document.getElementById('wm-prev'), next: document.getElementById('wm-next'), info: document.getElementById('wm-page') };
    var pagerNav = document.querySelector('.wm-pager');
    var page = 1;

    // Filtr wyznacza pasujące wiersze, paginacja pokazuje wycinek — w kolejności
    // DOM, którą ustawia sortowanie.
    function applyFilter() {
      var needle = q.value.trim().toLowerCase();
      var w = woj.value, k = kat.value, l = lud.value, listy = tylkoListy.checked, psz = tylkoPsz.checked;
      // Iterujemy po tbody.rows — to kolejność po sortowaniu.
      var matched = [];
      var dataRows = Array.prototype.slice.call(tbody.rows).filter(function (r) {
        return !r.classList.contains('wm-detail');
      });
      for (var i = 0; i < dataRows.length; i++) {
        var r = dataRows[i], d = r.dataset;
        var ok =
          (!needle || d.nazwa.indexOf(needle) !== -1) &&
          (!w || d.woj === w) &&
          (!k || d.kat === k) &&
          (!l || d.lud === l) &&
          (!listy || d.n !== '-1') &&
          (!psz || d.psz === '1');
        r.hidden = true;
        var det = detailOf(r);
        if (det) det.hidden = true;
        if (ok) matched.push(r);
      }
      var pp = parseInt(perPage.value, 10) || matched.length || 1;
      var pages = Math.max(1, Math.ceil(matched.length / pp));
      if (page > pages) page = pages;
      var start = (page - 1) * pp;
      matched.slice(start, start + pp).forEach(function (r) {
        r.hidden = false;
        var det = detailOf(r);
        // Szuflada wraca tylko tam, gdzie użytkownik ją otworzył.
        if (det) det.hidden = det.dataset.open !== '1';
      });

      var shown = matched.length;
      count.textContent = 'Placówek: ' + shown.toLocaleString('pl-PL') + (shown < all.length ? ' (z ' + all.length.toLocaleString('pl-PL') + ')' : '');
      // Pusta tabela nic nie tłumaczy — przy zerze pokazujemy komunikat i chowamy
      // samą tabelę razem ze stronicowaniem.
      empty.hidden = shown > 0;
      scroll.hidden = shown === 0;
      pagerNav.hidden = shown === 0;
      pager.info.textContent = 'strona ' + page + ' z ' + pages;
      pager.prev.disabled = page <= 1;
      pager.next.disabled = page >= pages;
    }

    // Sortowanie: klik w nagłówek; drugi klik odwraca. Wiersze bez danych (-1)
    // zawsze na końcu, niezależnie od kierunku.
    var current = { key: 'fundusz', dir: -1 };
    function applySort() {
      var key = current.key, dir = current.dir;
      var btn = table.querySelector('[data-sort="' + key + '"]');
      var type = btn.dataset.type;
      var sorted = all.slice().sort(function (a, b) {
        if (type === 'num') {
          var av = parseFloat(a.dataset[key]), bv = parseFloat(b.dataset[key]);
          if (av === -1 && bv === -1) return 0;
          if (av === -1) return 1;
          if (bv === -1) return -1;
          return (av - bv) * dir;
        }
        return a.dataset[key].localeCompare(b.dataset[key], 'pl') * dir;
      });
      for (var i = 0; i < sorted.length; i++) {
        var det = detailOf(sorted[i]);
        tbody.appendChild(sorted[i]);
        if (det) tbody.appendChild(det); // szuflada zawsze tuż za swoim wierszem
      }
      var ths = table.tHead.rows[0].cells;
      for (var j = 0; j < ths.length; j++) ths[j].removeAttribute('aria-sort');
      btn.closest('th').setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
    }

    tbody.addEventListener('click', function (e) {
      var btn = e.target.closest('.wm-toggle');
      if (!btn) return;
      var det = document.getElementById(btn.dataset.detail);
      if (!det) return;
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      det.hidden = open;
      if (open) delete det.dataset.open; else det.dataset.open = '1';
    });

    table.tHead.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-sort]');
      if (!btn) return;
      var key = btn.dataset.sort;
      if (current.key === key) current.dir = -current.dir;
      else current = { key: key, dir: btn.dataset.type === 'num' ? -1 : 1 };
      page = 1;
      applySort();
      applyFilter();
    });

    [q, woj, kat, lud, tylkoListy, tylkoPsz, perPage].forEach(function (el) {
      el.addEventListener('input', function () { page = 1; applyFilter(); });
    });
    reset.addEventListener('click', function () {
      q.value = '';
      woj.value = kat.value = lud.value = '';
      tylkoListy.checked = tylkoPsz.checked = false;
      page = 1;
      applyFilter();
      q.focus();
    });
    pager.prev.addEventListener('click', function () { if (page > 1) { page--; applyFilter(); } });
    pager.next.addEventListener('click', function () { page++; applyFilter(); });
    applySort();
    applyFilter();
  })();
</script>
