---
/** Lista materiałów: metadane, tytuł, dwuwierszowy lead. Artykuły albo ich tłumaczenia (strony /en/). */
import Meta from '@/components/ui/Meta.astro';
import Icon from '@/components/ui/Icon.astro';
import { articleHref, type Article } from '@/lib/content';
import { formatDateIn, typo } from '@/lib/format';
import { localeOf } from '@/i18n/locales';
import { uiOf } from '@/i18n/ui';
import { SECTIONS_EN, enHref, type Translated } from '@/i18n/translations';

type Props = { articles: Article[] } | { translations: Translated[] };

const props = Astro.props;
const locale = localeOf(Astro.url.pathname);
const t = uiOf(Astro.url).article;
// Tłumaczenie: tytuł i lead po angielsku, dział i daty z polskiego oryginału
const items = 'translations' in props
  ? props.translations.map((tr) => ({ href: enHref(tr), source: tr.source, label: SECTIONS_EN[tr.source.data.category].label, title: tr.article.data.title, summary: tr.article.data.summary }))
  : props.articles.map((a) => ({ href: articleHref(a), source: a, label: undefined, title: a.data.title, summary: a.data.summary }));
---
<ol class="feed">
  {items.map((a) => (
    <li class="feed__item" data-reveal>
      <a href={a.href}>
        <Meta category={a.source.data.category} label={a.label} date={a.source.data.date} extra={a.source.data.updated && t.updatedOn(formatDateIn(a.source.data.updated, locale))} />
        <h3 class="feed__title">{typo(a.title)}</h3>
        <p class="feed__desc">{typo(a.summary)}</p>
        <Icon name="arrow-ne" class="feed__arrow" />
      </a>
    </li>
  ))}
</ol>

<style>
  .feed { border-top: 1px solid var(--ink); }
  .feed__item a {
    position: relative; display: block;
    padding: 22px 48px 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .feed__title { font: 500 1.25rem/1.25 var(--f-display); letter-spacing: -0.02em; color: var(--ink); margin: 10px 0 8px; transition: color .2s; }
  .feed__desc {
    font-size: 0.90625rem; line-height: 1.55;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  }
  .feed__arrow { position: absolute; top: 24px; right: 0; color: var(--line-2); transition: color .2s, transform .3s var(--ease); }
  .feed__item a:hover .feed__title { color: var(--blue); }
  .feed__item a:hover .feed__arrow { color: var(--blue); transform: translate(2px, -2px); }
</style>
