---
/**
 * Karta profilu w serwisie X — przedstawienie osoby albo podziękowanie (np. za pomoc przy danych).
 * Bez skryptu i ramki X: dane w propsach, awatar z lokalnej kopii w src/assets. Czytelnik nie wysyła
 * żadnego zapytania do X, dopóki sam nie kliknie w link do profilu.
 * Wszystkie linki karty (profil i strona z profilu) mają rel="nofollow noopener" — podziękowanie nie przekazuje
 * „mocy” SEO cudzym profilom i stronom.
 *
 *   <XProfile name="nicolabo" handle="nicobogu" avatar={img} eyebrow="Ekstrakcja danych"
 *             link={{ label: 'Hospitalizacje w Polsce', href: 'https://…' }}>
 *     Za co dziękujemy — jedno, dwa zdania.
 *   </XProfile>
 *
 * size="compact" — mniejsza karta do wtrąceń (lista kierunków, koniec artykułu): awatar obok nazwy,
 * jedno zdanie kontekstu ze slotu, link do profilu i link z profilu w jednym wierszu, w tym samym stylu. Bez opisu z profilu (`bio`).
 *
 * width — ile miejsca zajmuje karta (niezależnie od `size`):
 *   fill — całą szerokość rodzica: komórka siatki, kolumna boczna (domyślnie dla size="full"),
 *   md   — do 560 px: karta wtrącona w tekst artykułu (domyślnie dla size="compact"),
 *   sm   — do 400 px: krótkie podziękowanie, karta obok innej treści.
 */
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import { linkAttrs } from '@/lib/links';
import { uiOf } from '@/i18n/ui';

interface Props extends HTMLAttributes<'article'> {
  name: string;
  /** nazwa konta bez „@” */
  handle: string;
  /** lokalna kopia awatara; bez niej — inicjał */
  avatar?: ImageMetadata;
  /** etykieta nad kartą: rola osoby w projekcie */
  eyebrow?: string;
  /** opis z profilu, jeśli to coś więcej niż link (tylko w pełnej karcie) */
  bio?: string;
  /** strona lub projekt podlinkowany w profilu */
  link?: { label: string; href: string };
  size?: 'full' | 'compact';
  /** szerokość karty — zob. opis wyżej; domyślnie fill (full) albo md (compact) */
  width?: 'fill' | 'md' | 'sm';
  /** false = bez linków (wzór na fikcyjnym koncie — nie odsyłamy do cudzego ani nieistniejącego profilu) */
  linked?: boolean;
}

const { name, handle, avatar, eyebrow, bio, link, size = 'full', width, linked = true, class: className, ...rest } = Astro.props;
const compact = size === 'compact';
const w = width ?? (compact ? 'md' : 'fill');
const url = `https://x.com/${handle}`;
const host = link && new URL(link.href).host;
/** etykieta = sam adres (np. „basal.si5.pl”) → bez powtórzenia hosta obok */
const showHost = link && link.label.replace(/^www\./, '') !== host?.replace(/^www\./, '');
const REL = 'nofollow noopener';
const t = uiOf(Astro.url).xProfile;
---
<article class:list={['xp', `xp--${w}`, { 'xp--compact': compact }, className]} aria-label={t.card(name, handle)} {...rest}>
  <div class="xp__top">
    {eyebrow && <p class="xp__eyebrow">{eyebrow}</p>}
    <svg class="xp__x" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
  </div>

  <div class="xp__id">
    {avatar
      ? <Image class="xp__avatar" src={avatar} width={128} height={128} alt="" />
      : <span class="xp__avatar xp__avatar--initial" aria-hidden="true">{name.charAt(0)}</span>}
    <div class="xp__who">
      <p class="xp__name">{name}</p>
      <p class="xp__handle">@{handle}</p>
    </div>
  </div>

  {Astro.slots.has('default') && <div class="xp__credit"><slot /></div>}
  {bio && !compact && <p class="xp__bio">{bio}</p>}

  {linked && <div class="xp__actions">
    {link && !compact && (
      <a class="xp__link" {...{ ...linkAttrs(link.href), rel: REL }}>
        <span class="xp__link-label">{t.inProfile}</span>
        <span class="xp__link-title">{link.label}</span>
        {showHost ? <span class="xp__link-host">{host} ↗</span> : <span class="xp__link-host" aria-hidden="true">↗</span>}
      </a>
    )}
    <LinkArrow href={url} rel={REL} class="xp__cta">{compact ? t.profile : t.profileOf(handle)}</LinkArrow>
    {link && compact && <LinkArrow href={link.href} rel={REL} class="xp__cta">{link.label}</LinkArrow>}
  </div>}
</article>

<style>
  .xp {
    position: relative; display: flex; flex-direction: column; gap: 20px;
    padding: 24px; background: var(--bg); border: 1px solid var(--line-2);
  }
  .xp::before { content: ""; position: absolute; top: -4px; left: -4px; width: 7px; height: 7px; background: var(--ink); }

  /* Szerokość: fill = cała szerokość rodzica; md i sm — karta przy lewej krawędzi, reszta miejsca zostaje tekstowi */
  .xp--md { max-width: 560px; }
  .xp--sm { max-width: 400px; }

  .xp__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .xp__eyebrow { font: 500 0.6875rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .xp__x { flex: none; margin-left: auto; fill: var(--ink); }

  .xp__id { display: flex; align-items: center; gap: 16px; }
  .xp__avatar { flex: none; width: 64px; height: 64px; object-fit: cover; background: var(--bg-soft); }
  .xp__avatar--initial {
    display: grid; place-items: center; background: var(--blue-fill); color: #fff;
    font: 400 1.875rem/1 var(--f-display); text-transform: uppercase;
  }
  .xp__name { font: 400 1.5rem/1.1 var(--f-display); letter-spacing: -0.02em; color: var(--ink); }
  .xp__handle { margin-top: 4px; font: 400 0.8125rem/1.3 var(--f-mono); color: var(--muted); }

  .xp__credit { font-size: 0.96875rem; line-height: 1.6; color: var(--text); }
  .xp__credit :global(strong) { color: var(--ink); font-weight: 600; }
  .xp__bio { font-size: 0.90625rem; line-height: 1.55; color: var(--text); }

  /* W pełnej karcie link z profilu i link do profilu to osobne pozycje kolumny */
  .xp__actions { display: contents; }

  .xp__link {
    display: grid; gap: 3px; padding: 12px 14px; border: 1px solid var(--line);
    background: var(--bg-soft); transition: border-color .2s;
  }
  .xp__link:hover { border-color: var(--blue); }
  .xp__link-label { font: 500 0.65625rem/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .xp__link-title { font-weight: 500; color: var(--ink); }
  .xp__link-host { font: 400 0.78125rem/1.3 var(--f-mono); color: var(--blue); }

  .xp__cta { align-self: flex-start; margin-top: auto; }

  /* ---------- Kompakt: awatar | etykieta, nazwa, kontekst, linki ---------- */
  .xp--compact {
    display: grid; grid-template-columns: 48px minmax(0, 1fr);
    grid-template-areas: "av top" "av who" ". credit" ". actions";
    column-gap: 16px; padding: 18px 20px 20px;
  }
  .xp--compact .xp__top { grid-area: top; }
  .xp--compact .xp__x { width: 15px; height: 15px; }
  .xp--compact .xp__id { display: contents; }
  .xp--compact .xp__avatar { grid-area: av; width: 48px; height: 48px; align-self: start; }
  .xp--compact .xp__avatar--initial { font-size: 1.375rem; }
  .xp--compact .xp__who { grid-area: who; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin-top: 3px; }
  .xp--compact .xp__name { font-size: 1.1875rem; }
  .xp--compact .xp__handle { margin-top: 0; font-size: 0.75rem; }
  .xp--compact .xp__credit { grid-area: credit; margin-top: 12px; font-size: 0.90625rem; line-height: 1.55; }

  .xp--compact .xp__actions {
    grid-area: actions; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 22px; margin-top: 14px;
  }
  /* w kompakcie link z profilu to drugi LinkArrow — oba linki wyglądają tak samo */
  .xp--compact .xp__cta { margin-top: 0; }

  @media (max-width: 480px) {
    .xp--compact { grid-template-areas: "av top" "av who" "credit credit" "actions actions"; column-gap: 14px; padding: 16px; }
  }
</style>
