---
/** Ikona ze sprite'a (ui/Sprite.astro). Kolor dziedziczy z `currentColor`. */
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '@/icons';

interface Props extends HTMLAttributes<'svg'> {
  name: IconName;
  size?: number;
}

const { name, size = 20, class: className, ...rest } = Astro.props;
---
<svg class:list={['icon', className]} width={size} height={size} aria-hidden="true" {...rest}><use href={`#i-${name}`} /></svg>

<style>
  .icon { flex: none; }
</style>
