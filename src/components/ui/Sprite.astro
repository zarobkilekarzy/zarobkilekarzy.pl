---
/** Sprite SVG generowany z rejestru src/icons.ts — renderowany raz w layoucie. */
import { icons } from '@/icons';
---
<svg class="sprite" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {Object.entries(icons).map(([name, markup]) => <symbol id={`i-${name}`} viewBox="0 0 24 24" set:html={markup} />)}
</svg>

<style>
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
