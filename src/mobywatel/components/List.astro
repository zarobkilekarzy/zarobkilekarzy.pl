---
/** Grupa wierszy (mobywatel/Row) na zaokrąglonej karcie, z opcjonalnym nagłówkiem nad nią. */
interface Props {
  title?: string;
}

const { title } = Astro.props;
---
<div class="mob-list">
  {title && <h2 class="mob-list__title">{title}</h2>}
  <ul class="mob-list__items" role="list">
    <slot />
  </ul>
</div>

<style>
  .mob-list__title {
    margin: 0 0 8px;
    color: var(--muted);
    font: 500 0.8125rem/1.3 var(--f-body);
  }
  .mob-list__items {
    margin: 0; padding: 0; list-style: none;
    background: var(--surface);
    border-radius: var(--mob-r);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .mob-list__items > :global(li + li) { border-top: 1px solid var(--line); }
</style>
